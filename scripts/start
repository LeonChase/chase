#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ ! -f vendor/autoload.php ]; then echo 'Bitte zuerst ./scripts/setup ausführen.' >&2; exit 1; fi
# Refresh service discovery after git updates, including newly added commands.
./scripts/php bin/console cache:clear --no-warmup --quiet
./scripts/php bin/console doctrine:migrations:migrate --no-interaction --quiet
./scripts/php bin/console app:materials:auto --no-interaction
exec ./scripts/php -d upload_max_filesize=32M -d post_max_size=36M -S "${CHASE_LISTEN:-127.0.0.1:8000}" -t public public/router.php
