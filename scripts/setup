#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if ! command -v php >/dev/null 2>&1 && [ ! -x .tools/bin/php ]; then ./scripts/bootstrap-runtime; fi
if [ -x .tools/bin/php ]; then PATH="$PWD/.tools/bin:$PATH"; export PATH; fi
if ! command -v composer >/dev/null 2>&1; then echo 'Composer benötigt. Unter Debian 13: ./scripts/bootstrap-runtime' >&2; exit 1; fi
if [ "${CHASE_CODELOAD_CACHE:-0}" = 1 ]; then ./scripts/cache-composer-dist; fi
composer install --no-interaction --prefer-dist
./scripts/php scripts/initialize.php
./scripts/php bin/console cache:clear
./scripts/php bin/console doctrine:migrations:migrate --no-interaction
./scripts/php bin/console app:demo:seed
./scripts/php bin/console cache:warmup
echo 'Fertig. Start: ./scripts/start · Zugangsdaten: ./scripts/demo-access'
