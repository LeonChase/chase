<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory="var/phpunit-cache" failOnRisky="true" failOnWarning="true">
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="APP_SECRET" value="isolated-phpunit-local-test-secret" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel" force="true"/>
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/phpunit.db" force="true"/>
        <env name="EXTERNAL_APIS_ENABLED" value="0" force="true"/>
    </php>
    <testsuites>
        <testsuite name="CHASE local portal"><directory>tests/Functional</directory><directory>tests/Service</directory><directory>tests/Unit</directory></testsuite>
    </testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
