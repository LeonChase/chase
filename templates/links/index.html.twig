{% extends 'base.html.twig' %}
{% block title %}Links & Tools{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/network.css">{% endblock %}
{% block body %}<section class="links-workspace"><header class="network-toolbar"><h1>Links & Tools</h1><form method="get" class="network-search" role="search"><label class="sr-only" for="link-search">Links suchen</label>{{ icon('search') }}<input id="link-search" name="q" value="{{ q }}" placeholder="Website oder Tool suchen" maxlength="200"><input type="hidden" name="category" value="{{ category }}"><button class="icon-button" aria-label="Suchen">{{ icon('arrow-right') }}</button></form><a class="icon-button {{ onlyFavorites ? 'is-selected' : '' }}" href="/links?favorites={{ onlyFavorites ? '0' : '1' }}" aria-label="{{ onlyFavorites ? 'Alle Links' : 'Favoriten' }}" title="Favoriten">{{ icon('bookmark') }}</a></header><nav class="link-categories" aria-label="Link-Kategorien"><a href="/links" class="{{ category == '' ? 'active' : '' }}">Alle</a>{% for label in categories %}<a href="/links?category={{ label|url_encode }}" class="{{ category == label ? 'active' : '' }}">{{ label }}</a>{% endfor %}</nav><div class="links-grid">{% for link in links %}<article class="tool-link-card"><span class="tool-link-icon">{{ icon(link.category == 'Immobilien' ? 'building' : (link.category == 'Bewertung & Recht' ? 'shield' : (link.category == 'Marketing' ? 'megaphone' : 'link'))) }}</span><form method="post" action="/links/{{ link.id }}/favorite"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="icon-button {{ link.id in favorites ? 'is-selected' : '' }}" aria-label="{{ link.id in favorites ? 'Favorit entfernen' : 'Als Favorit merken' }}: {{ link.title }}" title="Merken">{{ icon('bookmark') }}</button></form><a href="{{ link.url }}" target="_blank" rel="noopener noreferrer"><h2>{{ link.title }} {{ icon('arrow-up-right') }}</h2><p>{{ link.description }}</p><small>{{ link.url|replace({'https://':'','www.':''})|split('/')[0] }}</small></a></article>{% else %}<p class="muted">Keine passenden Links.</p>{% endfor %}</div><footer class="network-footnote">Externe Websites · keine automatische Anmeldung oder Datenübertragung</footer></section>{% endblock %}
