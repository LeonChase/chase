{% extends 'base.html.twig' %}{% block title %}Portalhilfe{% endblock %}{% block body %}<div class="page-heading"><div><span class="eyebrow">Einfach weiterkommen</span><h1>Wie können wir helfen?</h1><p class="muted">Ihr lokaler Wegweiser durch das Partnerportal. Keine Datenübertragung an einen KI-Dienst.</p></div><a class="btn btn-secondary" href="/messages">Partnermanagement kontaktieren</a></div><section class="card stack"><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label for="help-question">Was möchten Sie erledigen?</label><input id="help-question" name="question" value="{{ question }}" maxlength="500" placeholder="Zum Beispiel: Wie bestelle ich Werbemittel?" required><button class="btn btn-primary">Anleitung finden</button></form>{% for answer in answers %}<article class="alert" style="display:block"><h2>{{ answer.title }}</h2><p>{{ answer.text }}</p><a class="text-link" href="{{ answer.url }}">Diesen Bereich öffnen →</a></article>{% endfor %}</section><div class="grid grid-3" style="margin-top:24px">{% for topic in topics %}<a class="card" href="/help/assistant?q={{ topic.muster[0]|url_encode }}"><h3>{{ topic.title }}</h3><span class="text-link">Kurzanleitung →</span></a>{% endfor %}</div>{% endblock %}