{% set fieldPrefix=editorKey|default('') %}
<div class="planning-record-editor" data-record-title="{{ item.title ? 'Aufgabe bearbeiten' : 'Neue Aufgabe' }}">
{% if errors|default([]) %}<div class="alert" role="alert">{{ errors|join(' ') }}</div>{% endif %}
<form method="post" action="{{ item.title ? '/tasks/' ~ item.id ~ '/edit' : '/tasks/new' }}" class="stack task-edit-form" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="{{ fieldPrefix }}title">Aufgabe</label><input id="{{ fieldPrefix }}title" name="title" required maxlength="250" value="{{ data.title|default('') }}" autocomplete="off"></div><div class="task-editor-fields"><div class="field"><label for="{{ fieldPrefix }}dueDate">Fällig am</label><input type="date" id="{{ fieldPrefix }}dueDate" name="dueDate" value="{{ data.dueDate|default('') }}"></div><div class="field"><label for="{{ fieldPrefix }}priority">Priorität</label><select id="{{ fieldPrefix }}priority" name="priority">{% for priority in ['Niedrig','Mittel','Hoch'] %}<option {{ data.priority|default('Mittel') == priority ? 'selected' }}>{{ priority }}</option>{% endfor %}</select></div><div class="field"><label for="{{ fieldPrefix }}status">Status</label><select id="{{ fieldPrefix }}status" name="status">{% for status in statuses %}<option {{ data.status|default('Offen') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="{{ fieldPrefix }}recurrence">Wiederholung</label><select name="recurrence" id="{{ fieldPrefix }}recurrence">{% for value,label in {'none':'Keine','daily':'Täglich','weekly':'Wöchentlich','monthly':'Monatlich'} %}<option value="{{ value }}" {{ data.recurrence|default('none') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div></div>
<details class="planning-editor-section"><summary>Checkliste & Notizen</summary><div class="field"><label for="{{ fieldPrefix }}checklistText">Teilschritte (eine Zeile je Schritt)</label><textarea id="{{ fieldPrefix }}checklistText" name="checklistText" rows="3" maxlength="6000">{{ data.checklistText|default(data.checklist|default([])|map(step => step.title)|join('\n')) }}</textarea></div><div class="field"><label for="{{ fieldPrefix }}notes">Notizen</label><textarea rows="3" name="notes" id="{{ fieldPrefix }}notes" maxlength="5000">{{ data.notes|default('') }}</textarea></div></details>
<details class="planning-editor-section"><summary>Verknüpfungen</summary><div class="task-editor-fields"><div class="field"><label for="{{ fieldPrefix }}propertyId">Objekt</label><select id="{{ fieldPrefix }}propertyId" name="propertyId"><option value="">Kein Objekt</option>{% for property in properties %}<option value="{{ property.id }}" {{ data.propertyId|default('') == property.id ? 'selected' }}>{{ property.title }}</option>{% endfor %}</select></div><div class="field"><label for="{{ fieldPrefix }}leadId">Lead</label><select id="{{ fieldPrefix }}leadId" name="leadId"><option value="">Kein Lead</option>{% for lead in leads %}<option value="{{ lead.id }}" {{ data.leadId|default('') == lead.id ? 'selected' }}>{{ lead.title }}</option>{% endfor %}</select></div></div></details><p class="planning-form-error" data-form-error role="alert"></p><div><button class="btn btn-primary btn-small">Speichern</button></div></form>
{% if item.title %}<section id="{{ fieldPrefix }}checklist" class="task-checklist">{% for step in item.data.checklist|default([]) %}<form class="task-checklist-step" method="post" action="/tasks/{{ item.id }}/checklist" data-planning-form {% if fragment|default(false) %}data-refresh-dialog="/tasks/{{ item.id }}/edit?fragment=1"{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="stepId" value="{{ step.id }}"><input type="hidden" name="done" value="{{ step.done ? '0' : '1' }}"><button class="todo-check {{ step.done ? 'checked' }}" aria-label="{{ step.title }} {{ step.done ? 'wieder öffnen' : 'abhaken' }}">{{ step.done ? '✓' : '' }}</button><span class="{{ step.done ? 'checklist-done' }}">{{ step.title }}</span></form>{% endfor %}</section>
<div class="planning-record-actions">{% if item.ownerId == app.user.id %}<details class="planning-editor-section task-offer-section"><summary>{{ icon('users') }} Aufgabe anbieten</summary>{% if contacts %}<form method="post" action="/tasks/{{ item.id }}/offer" class="stack" data-planning-form {% if fragment|default(false) %}data-refresh-dialog="/tasks/{{ item.id }}/edit?fragment=1"{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label class="sr-only" for="{{ fieldPrefix }}recipientId">Interner Kontakt</label><select name="recipientId" id="{{ fieldPrefix }}recipientId" required><option value="">Kontakt wählen</option>{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.name }}</option>{% endfor %}</select><small class="muted">Annahme erstellt eine eigene Kopie. Objektberechtigungen bleiben bestehen.</small><button class="btn btn-secondary btn-small">Anbieten</button></form>{% else %}<p class="muted">Keine freigegebenen Kontakte.</p>{% endif %}{% for invitation in invitations|default([]) %}<small class="muted">{{ {'pending':'Offen','accepted':'Angenommen','declined':'Abgelehnt'}[invitation.data.status|default('pending')]|default('Anfrage') }}</small>{% endfor %}</details>{% endif %}<form method="post" action="/tasks/{{ item.id }}/delete" data-planning-form data-planning-confirm="Aufgabe löschen?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="planning-icon" aria-label="Aufgabe löschen" title="Aufgabe löschen">{{ icon('trash') }}</button></form></div>{% if item.data.nextTaskId|default('') %}<a class="planning-next-repeat" href="/tasks/{{ item.data.nextTaskId }}/edit" data-record-editor>Nächste Wiederholung →</a>{% endif %}{% endif %}
</div>
