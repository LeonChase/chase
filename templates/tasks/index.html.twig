{% extends 'base.html.twig' %}
{% block title %}Aufgaben · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block javascripts %}<script src="/assets/planning.js" defer></script>{% endblock %}
{% block body %}
<section class="planning-workspace-root task-workspace" data-task-layout="{{ layout }}" aria-label="Aufgabenplaner">
<header class="planning-topline"><h1>Aufgaben</h1><div class="planning-tools">
<form class="planning-layout-switch" method="post" action="/tasks/layout" data-layout-form aria-label="Darstellung"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="planning-icon {{ layout == 'list' ? 'active' }}" name="layout" value="list" aria-label="Nur Aufgaben" aria-pressed="{{ layout == 'list' ? 'true' : 'false' }}" title="Nur Aufgaben">{{ icon('check-square') }}</button><button class="planning-icon {{ layout == 'split' ? 'active' }}" name="layout" value="split" aria-label="Aufgaben und Kalender" aria-pressed="{{ layout == 'split' ? 'true' : 'false' }}" title="Aufgaben und Kalender">{{ icon('panel-left') }}</button><button class="planning-icon {{ layout == 'calendar' ? 'active' }}" name="layout" value="calendar" aria-label="Nur Kalender" aria-pressed="{{ layout == 'calendar' ? 'true' : 'false' }}" title="Nur Kalender">{{ icon('calendar') }}</button></form>
<details class="planning-menu"><summary class="planning-icon" aria-label="Aufgaben filtern" title="Aufgaben filtern"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8Z"/></svg></summary><form method="get" class="planning-popover stack"><h2>Aufgaben filtern</h2><input type="hidden" name="view" value="{{ view }}"><div class="field"><label for="task-period">Zeitraum</label><select id="task-period" name="period">{% for key,label in {'':'Alle Aufgaben','today':'Heute','overdue':'Überfällig','week':'Diese Woche','important':'Wichtig','completed':'Erledigt'} %}<option value="{{ key }}" {{ filters.period|default('') == key ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div><div class="field"><label for="task-query">Suchen</label><input id="task-query" name="q" value="{{ filters.q|default('') }}" placeholder="Titel oder Notiz"></div><div class="field"><label for="task-filter-status">Status</label><select id="task-filter-status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="task-filter-sort">Sortieren</label><select id="task-filter-sort" name="sort"><option value="due">Fälligkeit</option><option value="newest" {{ filters.sort|default('') == 'newest' ? 'selected' }}>Neueste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Titel A–Z</option></select></div><button class="btn btn-primary btn-small">Anwenden</button><a href="/tasks">Zurücksetzen</a></form></details>
<button class="planning-icon" type="button" data-open-dialog="task-invitations-dialog" aria-label="Aufgabenanfragen" title="Aufgabenanfragen">{{ icon('users') }}{% set pending=0 %}{% for invitation in invitations %}{% if invitation.recipientId == app.user.id and invitation.data.status|default('') == 'pending' %}{% set pending=pending+1 %}{% endif %}{% endfor %}{% if pending %}<span class="planning-count">{{ pending }}</span>{% endif %}</button>
<button class="planning-icon" type="button" data-open-dialog="task-calendar-dialog" aria-label="Kalender importieren oder exportieren" title="Kalenderdateien">{{ icon('download') }}</button><a class="btn btn-primary btn-small task-add-button" href="/tasks/new{{ filters.date|default('') ? '?date=' ~ filters.date : '' }}" data-record-editor aria-label="Aufgabe hinzufügen">{{ icon('plus') }}<span>Aufgabe</span></a>
</div></header>
<div class="planning-status" role="status" aria-live="polite" data-planning-status></div>
<div class="task-planner-layout"><section class="task-list-pane planning-pane" aria-label="Aufgabenliste"><div class="planning-pane-heading"><h2>{{ filters.date|default('') ? selected|date('d.m.Y') : {'today':'Heute','overdue':'Überfällig','week':'Diese Woche','important':'Wichtig','completed':'Erledigt'}[filters.period|default('')]|default('Aufgaben') }}</h2><span class="muted">{{ items|length }}</span>{% if filters.date|default('') or filters.period|default('') or filters.q|default('') or filters.status|default('') %}<a href="/tasks" class="planning-icon" aria-label="Aufgabenfilter zurücksetzen" title="Filter zurücksetzen">{{ icon('x') }}</a>{% endif %}</div>
<div class="todo-list planning-pane-scroll" data-pane-scroll="tasks">{% for item in items %}{% set done = item.data.status|default('Offen') == 'Erledigt' %}{% set overdue = item.data.dueDate|default('') and item.data.dueDate < today|date('Y-m-d') and not done %}<article class="todo-item {{ done ? 'is-complete' }}" data-task-id="{{ item.id }}"><form method="post" action="/tasks/{{ item.id }}/status" class="todo-completion" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="{{ done ? 'Offen' : 'Erledigt' }}"><button class="todo-check" aria-label="{{ item.title }} {{ done ? 'wieder öffnen' : 'erledigen' }}" title="{{ done ? 'Wieder öffnen' : 'Erledigen' }}">{{ done ? '✓' : '' }}</button></form>
<details class="todo-details" data-task-editor="{{ item.id }}"><summary><span class="todo-title">{{ item.title }}</span><span class="todo-meta"><span class="{{ overdue ? 'todo-overdue' }}">{{ item.data.dueDate|default('') ? item.data.dueDate|date('d.m.Y','Europe/Berlin') : '' }}{{ overdue ? ' · überfällig' }}</span>{% if item.data.recurrence|default('none') != 'none' %}<span>↻</span>{% endif %}{% if item.data.checklist|default([]) %}{% set checked=0 %}{% for step in item.data.checklist %}{% if step.done %}{% set checked=checked+1 %}{% endif %}{% endfor %}<span>✓ {{ checked }}/{{ item.data.checklist|length }}</span>{% endif %}{% if item.data.status|default('Offen') == 'In Arbeit' %}<span>In Arbeit</span>{% endif %}</span></summary><div class="todo-inline-editor">{% include 'tasks/_editor.html.twig' with {data:item.data|merge({title:item.title}),errors:[],editorKey:'inline-' ~ item.id ~ '-',fragment:false,invitations:[]} %}</div></details>
<form method="post" action="/tasks/{{ item.id }}/priority" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="priority" value="{{ item.data.priority|default('Mittel') == 'Hoch' ? 'Mittel' : 'Hoch' }}"><button class="todo-star {{ item.data.priority|default('Mittel') == 'Hoch' ? 'is-important' }}" aria-label="{{ item.title }} {{ item.data.priority|default('Mittel') == 'Hoch' ? 'nicht mehr als wichtig markieren' : 'als wichtig markieren' }}" title="Priorität {{ item.data.priority|default('Mittel') }}">{{ item.data.priority|default('Mittel') == 'Hoch' ? '★' : '☆' }}</button></form></article>{% else %}<p class="planning-empty">Keine Aufgaben.</p>{% endfor %}</div>
<form class="task-quick-add" method="post" action="/tasks/new" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="Offen"><input type="hidden" name="priority" value="Mittel"><input type="hidden" name="recurrence" value="none"><label class="sr-only" for="quick-task-title">Aufgabe hinzufügen</label><input id="quick-task-title" name="title" required maxlength="250" placeholder="+ Aufgabe hinzufügen" autocomplete="off"><input type="date" name="dueDate" value="{{ filters.date|default('') }}" aria-label="Fälligkeit der neuen Aufgabe" title="Fälligkeit"><button class="planning-icon" type="submit" aria-label="Neue Aufgabe speichern" title="Speichern">{{ icon('plus') }}</button><p class="planning-form-error" data-form-error role="alert"></p></form>
</section>
<section class="task-calendar-pane planning-pane" aria-label="Aufgabenkalender"><div class="task-calendar-toolbar"><h2>{% if view == 'week' %}{{ first|date('d.m.') }} – {{ last|date('d.m.Y') }}{% else %}{{ ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'][anchor|date('n') - 1] }} {{ anchor|date('Y') }}{% endif %}</h2><div class="task-calendar-nav"><a href="/tasks?view={{ view }}&date={{ (view == 'week' ? selected|date_modify('-1 week') : anchor|date_modify('-1 month'))|date('Y-m-d') }}" class="planning-icon" aria-label="{{ view == 'week' ? 'Vorherige Woche' : 'Vorheriger Monat' }}">{{ icon('chevron-left') }}</a><a href="/tasks?view={{ view }}&date={{ today|date('Y-m-d') }}">Heute</a><a href="/tasks?view={{ view }}&date={{ (view == 'week' ? selected|date_modify('+1 week') : anchor|date_modify('+1 month'))|date('Y-m-d') }}" class="planning-icon" aria-label="{{ view == 'week' ? 'Nächste Woche' : 'Nächster Monat' }}">{{ icon('chevron-right') }}</a></div><div class="task-view-switch"><a href="/tasks?view=month&date={{ selected|date('Y-m-d') }}" class="{{ view == 'month' ? 'active' }}">Monat</a><a href="/tasks?view=week&date={{ selected|date('Y-m-d') }}" class="{{ view == 'week' ? 'active' }}">Woche</a></div></div>
<div class="task-calendar-grid calendar-{{ view }}" style="--calendar-rows:{{ calendar|length / 7 }}" aria-label="Tage mit offenen Aufgaben">{% for label in ['Mo','Di','Mi','Do','Fr','Sa','So'] %}<div class="task-weekday" aria-hidden="true">{{ label }}</div>{% endfor %}{% for day in calendar %}<div class="task-day {{ day.today ? 'is-today' }} {{ day.selected ? 'is-selected' }} {{ not day.inMonth and view == 'month' ? 'outside-month' }}"><a class="task-day-number" href="/tasks?date={{ day.date }}&view={{ view }}" aria-label="{{ day.date|date('d.m.Y') }}: {{ day.tasks|length }} offene Aufgaben">{{ day.day }}</a><div class="task-day-events">{% for task in day.tasks|slice(0,3) %}<a class="task-calendar-event {{ task.data.priority|default('') == 'Hoch' ? 'is-important' }}" href="/tasks/{{ task.id }}/edit" data-record-editor title="{{ task.title }}">{{ task.title }}</a>{% endfor %}{% if day.tasks|length > 3 %}<a class="task-day-more" href="/tasks?date={{ day.date }}&view={{ view }}">+{{ day.tasks|length - 3 }}</a>{% endif %}</div><a href="/tasks/new?date={{ day.date }}" data-record-editor class="task-calendar-add" aria-label="Aufgabe am {{ day.date|date('d.m.Y') }} hinzufügen">+</a></div>{% endfor %}</div></section></div>
<dialog class="planning-dialog" id="task-invitations-dialog" aria-labelledby="task-invitations-title"><div class="planning-dialog-heading"><h2 id="task-invitations-title">Aufgabenanfragen</h2><button type="button" class="planning-icon" data-close-dialog aria-label="Schließen">{{ icon('x') }}</button></div><div id="task-invitations">{% for invitation in invitations %}{% set incoming=invitation.recipientId == app.user.id %}{% set state=invitation.data.status|default('pending') %}<article class="task-invitation" data-invitation-id="{{ invitation.id }}"><strong>{{ invitation.title }}</strong><p class="muted">{{ incoming ? 'Von' : 'An' }} {{ names[incoming ? invitation.ownerId : invitation.recipientId]|default('Interner Kontakt') }} · {{ invitation.data.dueDate|default('') ? invitation.data.dueDate|date('d.m.Y') : 'Ohne Termin' }}</p><span class="badge">{{ {'pending':'Offen','accepted':'Angenommen','declined':'Abgelehnt'}[state]|default(state) }}</span>{% if incoming and state == 'pending' %}<form method="post" action="/tasks/invitations/{{ invitation.id }}/respond" class="task-invitation-actions" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-primary btn-small" name="decision" value="accept">Annehmen</button><button class="btn btn-secondary btn-small" name="decision" value="decline">Ablehnen</button></form>{% elseif incoming and state == 'accepted' and invitation.data.acceptedTaskId|default('') %}<a href="/tasks/{{ invitation.data.acceptedTaskId }}/edit" data-record-editor>Eigene Aufgabe öffnen →</a>{% endif %}</article>{% else %}<p class="planning-empty">Keine Aufgabenanfragen.</p>{% endfor %}</div></dialog>
<dialog class="planning-dialog planning-small-dialog" id="task-calendar-dialog" aria-labelledby="task-calendar-title"><div class="planning-dialog-heading"><h2 id="task-calendar-title">Kalenderdateien</h2><button type="button" class="planning-icon" data-close-dialog aria-label="Schließen">{{ icon('x') }}</button></div><p class="muted">Lokaler Dateiaustausch mit Google Kalender oder Outlook. Keine laufende Synchronisation.</p><a href="/tasks/calendar.ics" class="btn btn-secondary">{{ icon('download') }} Eigene Aufgaben als .ics</a><p class="muted">Enthält Titel, Termine und Notizen eigener Aufgaben.</p><form method="post" action="/tasks/calendar/import" enctype="multipart/form-data" class="stack" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="calendar">.ics importieren (max. 1 MB)</label><input id="calendar" name="calendar" type="file" accept=".ics,text/calendar" required></div><small class="muted">Einfache Termine am Starttag; keine Serien oder Erinnerungen. Gleiche Termin-IDs werden übersprungen.</small><button class="btn btn-primary">Importieren</button></form></dialog>
{% include 'tasks/_record_dialog.html.twig' %}
</section>
{% endblock %}
