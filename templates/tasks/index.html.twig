{% extends 'base.html.twig' %}
{% block title %}Aufgaben & Kalender · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">DEIN TAG, GUT ORGANISIERT</p><h1>Aufgaben & Kalender</h1><p class="muted">Prioritäten setzen. Freiraum schaffen.</p></div><a class="btn btn-primary" href="/tasks/new{{ filters.date|default('') ? '?date=' ~ filters.date : '' }}">{{ icon('plus') }} Aufgabe anlegen</a></div>
<nav class="tabs task-tabs" aria-label="Aufgabenfilter">{% for key,label in {'':'Alle Aufgaben','today':'Heute','overdue':'Überfällig','week':'Diese Woche','important':'Wichtig','completed':'Erledigt'} %}<a href="/tasks{{ key ? '?period=' ~ key : '' }}" class="{{ filters.period|default('') == key and not filters.date|default('') ? 'active' }}">{{ label }}</a>{% endfor %}</nav>
<div class="task-planner-layout">
<div class="stack task-list-column">
<section class="card task-list-panel"><div class="card-heading"><div><span class="eyebrow">DEINE TO-DOS</span><h2>{{ filters.date|default('') ? selected|date('d.m.Y') : 'Alles im Blick' }}</h2></div><span class="badge">{{ items|length }} Aufgaben</span></div>
<form method="get" class="task-filter-form"><input type="hidden" name="period" value="{{ filters.period|default('') }}"><input type="hidden" name="date" value="{{ filters.date|default('') }}"><input type="hidden" name="view" value="{{ view }}"><div class="field"><label for="q">Suchen</label><input id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Titel oder Notiz"></div><div class="task-filter-grid"><div class="field"><label for="status">Status</label><select id="status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="priority">Priorität</label><select id="priority" name="priority"><option value="">Alle Prioritäten</option>{% for value in ['Niedrig','Mittel','Hoch'] %}<option {{ filters.priority|default('') == value ? 'selected' }}>{{ value }}</option>{% endfor %}</select></div><div class="field"><label for="sort">Sortieren</label><select id="sort" name="sort"><option value="due" {{ filters.sort|default('due') == 'due' ? 'selected' }}>Fälligkeit</option><option value="newest" {{ filters.sort|default('') == 'newest' ? 'selected' }}>Neueste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Titel A–Z</option></select></div></div><div class="task-filter-actions"><button class="btn btn-secondary btn-small">Anwenden</button><a href="/tasks">Zurücksetzen</a></div></form>
<div class="todo-list">{% for item in items %}{% set done = item.data.status|default('Offen') == 'Erledigt' %}{% set overdue = item.data.dueDate|default('') and item.data.dueDate < today|date('Y-m-d') and not done %}<article class="todo-item {{ done ? 'is-complete' }}" data-task-id="{{ item.id }}"><form method="post" action="/tasks/{{ item.id }}/status" class="todo-completion"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="{{ done ? 'Offen' : 'Erledigt' }}"><button class="todo-check" aria-label="{{ item.title }} {{ done ? 'wieder öffnen' : 'erledigen' }}" title="{{ done ? 'Wieder öffnen' : 'Erledigen' }}">{{ done ? '✓' : '' }}</button></form><div class="todo-content"><a class="todo-title" href="/tasks/{{ item.id }}/edit">{{ item.title }}</a><div class="todo-meta"><span class="{{ overdue ? 'todo-overdue' }}">{{ item.data.dueDate|default('') ? item.data.dueDate|date('d.m.Y','Europe/Berlin') : 'Ohne Termin' }}{{ overdue ? ' · überfällig' }}</span><span>{{ item.data.status|default('Offen') }}</span>{% if item.data.recurrence|default('none') != 'none' %}<span>↻ {{ {'daily':'Täglich','weekly':'Wöchentlich','monthly':'Monatlich'}[item.data.recurrence]|default('Wiederkehrend') }}</span>{% endif %}{% if item.data.checklist|default([]) %}{% set checked=0 %}{% for step in item.data.checklist %}{% if step.done %}{% set checked=checked+1 %}{% endif %}{% endfor %}<span>✓ {{ checked }}/{{ item.data.checklist|length }} Schritte</span>{% endif %}</div>{% if item.data.propertyId|default('') %}<a class="todo-relation" href="/properties/{{ item.data.propertyId }}">Objektakte öffnen →</a>{% elseif item.data.leadId|default('') %}<a class="todo-relation" href="/leads/{{ item.data.leadId }}">Demo-Lead öffnen →</a>{% endif %}</div><span class="todo-priority {{ item.data.priority|default('Mittel') == 'Hoch' ? 'is-important' }}" title="Priorität {{ item.data.priority|default('Mittel') }}" aria-label="Priorität {{ item.data.priority|default('Mittel') }}">{{ item.data.priority|default('Mittel') == 'Hoch' ? '★' : '·' }}</span></article>{% else %}<div class="empty-state"><h3>Platz für den nächsten Schritt.</h3><p>Für diese Auswahl gibt es noch keine Aufgaben.</p><a class="btn btn-primary" href="/tasks/new{{ filters.date|default('') ? '?date=' ~ filters.date : '' }}">Aufgabe anlegen</a></div>{% endfor %}</div></section>
{% if invitations %}<section class="card" id="task-invitations"><div class="card-heading"><div><span class="eyebrow">ZUSAMMENARBEIT</span><h2>Aufgabenanfragen</h2></div></div><p class="muted">Erst Ihre Annahme legt eine eigene Aufgabe an. Die ursprüngliche Aufgabe bleibt beim Absender.</p>{% for invitation in invitations %}{% set incoming = invitation.recipientId == app.user.id %}{% set state = invitation.data.status|default('pending') %}<article class="task-invitation" data-invitation-id="{{ invitation.id }}"><strong>{{ invitation.title }}</strong><p class="muted">{{ incoming ? 'Von' : 'An' }} {{ names[incoming ? invitation.ownerId : invitation.recipientId]|default('Interner Kontakt') }} · {{ invitation.data.dueDate|default('') ? invitation.data.dueDate|date('d.m.Y') : 'Ohne Termin' }} · {{ invitation.data.priority|default('Mittel') }}</p><span class="badge">{{ {'pending':'Offen','accepted':'Angenommen','declined':'Abgelehnt'}[state]|default(state) }}</span>{% if incoming and state == 'pending' %}<form method="post" action="/tasks/invitations/{{ invitation.id }}/respond" class="task-invitation-actions"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-primary btn-small" name="decision" value="accept">Annehmen</button><button class="btn btn-secondary btn-small" name="decision" value="decline">Ablehnen</button></form>{% elseif incoming and state == 'accepted' and invitation.data.acceptedTaskId|default('') %}<a class="text-link" href="/tasks/{{ invitation.data.acceptedTaskId }}/edit">Eigene Aufgabe öffnen →</a>{% endif %}</article>{% endfor %}</section>{% endif %}
</div>
<aside class="stack task-calendar-column" aria-label="Aufgabenkalender"><section class="card task-calendar"><div class="card-heading"><div><span class="eyebrow">DEINE ZEIT</span><h2>{% if view == 'week' %}{{ first|date('d.m.') }} – {{ last|date('d.m.Y') }}{% else %}{{ ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'][anchor|date('n') - 1] }} {{ anchor|date('Y') }}{% endif %}</h2></div></div><div class="task-calendar-controls"><div class="task-view-switch"><a href="/tasks?view=month&date={{ selected|date('Y-m-d') }}" class="{{ view == 'month' ? 'active' }}">Monat</a><a href="/tasks?view=week&date={{ selected|date('Y-m-d') }}" class="{{ view == 'week' ? 'active' }}">Woche</a></div><div class="task-calendar-nav"><a href="/tasks?view={{ view }}&date={{ (view == 'week' ? selected|date_modify('-1 week') : anchor|date_modify('-1 month'))|date('Y-m-d') }}" aria-label="{{ view == 'week' ? 'Vorherige Woche' : 'Vorheriger Monat' }}">←</a><a href="/tasks?view={{ view }}&date={{ today|date('Y-m-d') }}">Heute</a><a href="/tasks?view={{ view }}&date={{ (view == 'week' ? selected|date_modify('+1 week') : anchor|date_modify('+1 month'))|date('Y-m-d') }}" aria-label="{{ view == 'week' ? 'Nächste Woche' : 'Nächster Monat' }}">→</a></div></div>
<div class="task-calendar-grid" role="list" aria-label="Tage mit offenen Aufgaben">{% for label in ['Mo','Di','Mi','Do','Fr','Sa','So'] %}<div class="task-weekday" aria-hidden="true">{{ label }}</div>{% endfor %}{% for day in calendar %}<div class="task-day {{ day.today ? 'is-today' }} {{ day.selected ? 'is-selected' }} {{ not day.inMonth and view == 'month' ? 'outside-month' }}" role="listitem"><a class="task-day-number" href="/tasks?date={{ day.date }}&view={{ view }}" aria-label="{{ day.date|date('d.m.Y') }}: {{ day.tasks|length }} offene Aufgaben" {{ day.selected ? 'aria-current="date"' }}>{{ day.day }}</a>{% for task in day.tasks|slice(0,2) %}<a class="task-calendar-event {{ task.data.priority|default('') == 'Hoch' ? 'is-important' }}" href="/tasks/{{ task.id }}/edit" title="{{ task.title }}">{{ task.title }}</a>{% endfor %}{% if day.tasks|length > 2 %}<a class="task-day-more" href="/tasks?date={{ day.date }}&view={{ view }}">+{{ day.tasks|length - 2 }} weitere</a>{% endif %}</div>{% endfor %}</div><p class="task-calendar-caption">Tag auswählen, Aufgaben links planen. Offene Aufgaben · Europe/Berlin.</p></section>
<section class="card task-calendar-exchange"><h3>Mit Ihrem Kalender arbeiten</h3><p class="muted">Kalenderdateien lokal mit Google Kalender oder Outlook austauschen. Eine laufende Synchronisation ist nicht verbunden.</p><a href="/tasks/calendar.ics" class="btn btn-secondary btn-small">{{ icon('download') }} Eigene Aufgaben als .ics</a><p class="muted">Die Datei enthält Titel, Termine und Notizen Ihrer eigenen Aufgaben. Nur vertraulich weitergeben.</p><details><summary>.ics-Kalender importieren</summary><form method="post" action="/tasks/calendar/import" enctype="multipart/form-data" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="calendar">Kalenderdatei (max. 1 MB)</label><input id="calendar" name="calendar" type="file" accept=".ics,text/calendar" required></div><p class="muted">Einfache Termine werden als eigene Aufgaben am Starttag übernommen. Serien, Absagen und Erinnerungen werden nicht übernommen. Wiederholter Import derselben Termin-ID erzeugt keine Dubletten.</p><button class="btn btn-secondary btn-small">Lokal importieren</button></form></details><p class="muted">Lokaler Planer mit Checklisten und Wiederholungen; keine vollständige Microsoft To Do-/Kalender-Anbindung.</p></section>
</aside></div>
{% endblock %}
