{% extends 'base.html.twig' %}{% block title %}Aufgaben & Checklisten · CHASE{% endblock %}{% block body %}
<div class="page-heading"><div><p class="eyebrow">DEIN TAG, GUT ORGANISIERT</p><h1>Aufgaben & Checklisten</h1><p class="muted">Kleine Schritte. Gute Ergebnisse.</p></div><a class="btn btn-primary" href="/tasks/new">+ Aufgabe anlegen</a></div>
<div class="tabs"><a href="/tasks" class="{{ filters.period|default('') == '' ? 'active' }}">Alle Aufgaben</a><a href="/tasks?period=today" class="{{ filters.period|default('') == 'today' ? 'active' }}">Heute</a><a href="/tasks?period=overdue" class="{{ filters.period|default('') == 'overdue' ? 'active' }}">Überfällig</a><a href="/tasks?period=week" class="{{ filters.period|default('') == 'week' ? 'active' }}">Diese Woche</a></div>
<form method="get" class="card toolbar"><input type="hidden" name="period" value="{{ filters.period|default('') }}"><div class="field"><label for="q">Aufgabe suchen</label><input id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Titel oder Notiz"></div><div class="field"><label for="status">Status</label><select id="status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="priority">Priorität</label><select id="priority" name="priority"><option value="">Alle Prioritäten</option>{% for value in ['Niedrig','Mittel','Hoch'] %}<option {{ filters.priority|default('') == value ? 'selected' }}>{{ value }}</option>{% endfor %}</select></div><div class="field"><label for="sort">Sortieren</label><select id="sort" name="sort"><option value="due" {{ filters.sort|default('due') == 'due' ? 'selected' }}>Fälligkeit</option><option value="newest" {{ filters.sort|default('') == 'newest' ? 'selected' }}>Neueste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Titel A–Z</option></select></div><button class="btn btn-secondary">Filtern</button><a href="/tasks">Zurücksetzen</a></form>
<div class="card table-wrap"><table><thead><tr><th>Aufgabe</th><th>Fälligkeit</th><th>Priorität</th><th>Status</th><th>Aktion</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="/tasks/{{ item.id }}/edit"><strong>{{ item.title }}</strong></a><br><small class="muted">{% if item.data.propertyId|default('') %}<a href="/properties/{{ item.data.propertyId }}">Objekt öffnen</a>{% elseif item.data.leadId|default('') %}<a href="/leads/{{ item.data.leadId }}">Demo-Lead öffnen</a>{% else %}Allgemeine Aufgabe{% endif %}</small></td><td>{{ item.data.dueDate|default('') ? item.data.dueDate|date('d.m.Y','Europe/Berlin') : 'Ohne Termin' }}</td><td><span class="badge">{{ item.data.priority|default('Mittel') }}</span></td><td><span class="badge">{{ item.data.status|default('Offen') }}</span></td><td><div class="toolbar"><a href="/tasks/{{ item.id }}/edit">Bearbeiten</a><form method="post" action="/tasks/{{ item.id }}/status"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="{{ item.data.status|default('') == 'Erledigt' ? 'Offen' : 'Erledigt' }}"><button class="btn btn-secondary" aria-label="{{ item.title }} {{ item.data.status|default('') == 'Erledigt' ? 'wieder öffnen' : 'erledigen' }}">{{ item.data.status|default('') == 'Erledigt' ? 'Wieder öffnen' : '✓ Erledigen' }}</button></form></div></td></tr>{% else %}<tr><td colspan="5"><div class="empty-state"><h2>Alles im Blick.</h2><p>Keine Aufgabe für diese Auswahl gefunden.</p><a href="/tasks/new" class="btn btn-primary">Aufgabe anlegen</a></div></td></tr>{% endfor %}</tbody></table></div><p class="muted">Zeitraum: Deutschland (Europe/Berlin) · Outlook / Microsoft To Do Integration geplant.</p>
{% endblock %}
