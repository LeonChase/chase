{% extends 'base.html.twig' %}
{% block title %}Aufgabe · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block javascripts %}<script src="/assets/planning.js" defer></script>{% endblock %}
{% block body %}<section class="planning-workspace-root planning-record-page"><header class="planning-topline"><h1>{{ item.title ? 'Aufgabe bearbeiten' : 'Neue Aufgabe' }}</h1><a class="planning-icon" href="/tasks" aria-label="Zurück zu Aufgaben">{{ icon('x') }}</a></header><div class="planning-pane planning-pane-scroll">{% include 'tasks/_editor.html.twig' %}</div></section>{% endblock %}
