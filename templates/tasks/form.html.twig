{% extends 'base.html.twig' %}{% block title %}Aufgabe bearbeiten · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block body %}
<div class="page-heading"><div><a href="/tasks" class="muted">← Aufgaben & Kalender</a><h1>{{ item.title ? 'Aufgabe bearbeiten' : 'Neue Aufgabe' }}</h1><p class="muted">Ein klarer nächster Schritt für Ihren Arbeitstag.</p></div><span class="badge">Lokal nutzbar</span></div>
{% if errors %}<div class="alert" role="alert"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<div class="task-editor-layout"><form method="post" class="card stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="title">Aufgabe *</label><input id="title" name="title" required maxlength="250" value="{{ data.title|default('') }}" placeholder="Was möchten Sie erledigen?"></div><div class="form-grid"><div class="field"><label for="status">Status</label><select id="status" name="status">{% for status in statuses %}<option {{ data.status|default('Offen') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="priority">Priorität</label><select id="priority" name="priority">{% for priority in ['Niedrig','Mittel','Hoch'] %}<option {{ data.priority|default('Mittel') == priority ? 'selected' }}>{{ priority }}</option>{% endfor %}</select></div><div class="field"><label for="dueDate">Fälligkeit</label><input type="date" id="dueDate" name="dueDate" value="{{ data.dueDate|default('') }}"></div><div class="field"><label for="recurrence">Wiederholung</label><select name="recurrence" id="recurrence">{% for value,label in {'none':'Keine Wiederholung','daily':'Täglich','weekly':'Wöchentlich','monthly':'Monatlich'} %}<option value="{{ value }}" {{ data.recurrence|default('none') == value ? 'selected' }}>{{ label }}</option>{% endfor %}</select><small class="muted">Über „Erledigen“ in der Aufgabenliste entsteht die nächste Aufgabe, gerechnet ab der Fälligkeit.</small></div><div class="field"><label for="propertyId">Verknüpftes Objekt</label><select id="propertyId" name="propertyId"><option value="">Keine Objektverknüpfung</option>{% for property in properties %}<option value="{{ property.id }}" {{ data.propertyId|default('') == property.id ? 'selected' }}>{{ property.title }}</option>{% endfor %}</select></div><div class="field"><label for="leadId">Verknüpfter Demo-Lead</label><select id="leadId" name="leadId"><option value="">Keine Leadverknüpfung</option>{% for lead in leads %}<option value="{{ lead.id }}" {{ data.leadId|default('') == lead.id ? 'selected' }}>{{ lead.title }}</option>{% endfor %}</select></div></div><div class="field"><label for="checklistText">Checkliste / Teilschritte</label><textarea id="checklistText" name="checklistText" rows="5" maxlength="6000" placeholder="Unterlagen zusammenstellen&#10;Rückfragen klären&#10;Termin vorbereiten">{{ data.checklistText|default('') }}</textarea><small class="muted">Ein Schritt je Zeile, höchstens 30 Schritte. Unveränderte Schritte behalten ihren Haken.</small></div><div class="field"><label for="notes">Notizen</label><textarea rows="5" name="notes" id="notes" maxlength="5000">{{ data.notes|default('') }}</textarea></div><div class="form-actions"><button class="btn btn-primary">Aufgabe speichern</button><a class="btn btn-secondary" href="/tasks">Abbrechen</a></div></form>
<div class="stack">{% if item.title %}<section class="card" id="checklist"><h2>Schritt für Schritt</h2>{% for step in item.data.checklist|default([]) %}<form class="task-checklist-step" method="post" action="/tasks/{{ item.id }}/checklist"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="stepId" value="{{ step.id }}"><input type="hidden" name="done" value="{{ step.done ? '0' : '1' }}"><button class="todo-check {{ step.done ? 'checked' }}" aria-label="{{ step.title }} {{ step.done ? 'wieder öffnen' : 'abhaken' }}">{{ step.done ? '✓' : '' }}</button><span class="{{ step.done ? 'checklist-done' }}">{{ step.title }}</span></form>{% else %}<p class="muted">Tragen Sie links Ihre Teilschritte ein. Nach dem Speichern können Sie sie hier einzeln abhaken.</p>{% endfor %}{% if item.data.nextTaskId|default('') %}<p><a href="/tasks/{{ item.data.nextTaskId }}/edit">Nächste Wiederholung öffnen →</a></p>{% endif %}</section>
{% if item.ownerId == app.user.id %}<section class="card"><span class="eyebrow">ZUSAMMENARBEIT</span><h2>Aufgabe anbieten</h2><p class="muted">Ein interner Kontakt kann annehmen oder ablehnen. Geteilt werden Titel, Fälligkeit und Priorität. Ihre Aufgabe bleibt erhalten; private Objektdaten werden nicht freigegeben.</p>{% if contacts %}<form method="post" action="/tasks/{{ item.id }}/offer" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="recipientId">Interner Kontakt</label><select name="recipientId" id="recipientId" required><option value="">Bitte auswählen</option>{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.name }} · {{ contact.region }}</option>{% endfor %}</select></div><button class="btn btn-secondary">Zur Übernahme anbieten</button></form>{% else %}<p class="muted">Aktuell sind keine aktiven, freigegebenen Kontakte verfügbar.</p>{% endif %}{% for invitation in invitations %}<p class="muted">{{ invitation.createdAt|date('d.m.Y') }} · {{ {'pending':'Anfrage offen','accepted':'Anfrage angenommen','declined':'Anfrage abgelehnt'}[invitation.data.status|default('pending')]|default('Anfrage') }}</p>{% endfor %}</section>{% endif %}
<form method="post" action="/tasks/{{ item.id }}/delete" data-confirm="Diese Aufgabe wirklich löschen?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Aufgabe löschen</button></form>{% else %}<section class="card"><h2>Gut vorbereitet</h2><p class="muted">Nach dem Speichern stehen die Checkliste und Aufgabenanfragen an sichtbare interne Kontakte bereit. Kalenderdienste sind nicht live verbunden.</p></section>{% endif %}</div></div>
{% endblock %}
