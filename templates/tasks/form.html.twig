{% extends 'base.html.twig' %}{% block title %}Aufgabe bearbeiten · CHASE{% endblock %}{% block body %}
<div class="page-heading"><div><a href="/tasks" class="muted">← Aufgaben</a><h1>{{ item.title ? 'Aufgabe bearbeiten' : 'Neue Aufgabe' }}</h1><p class="muted">Ein klarer nächster Schritt für deinen Arbeitstag.</p></div><span class="badge">Lokal nutzbar</span></div>
{% if errors %}<div class="alert" role="alert"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<form method="post" class="card stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="title">Aufgabe *</label><input id="title" name="title" required maxlength="250" value="{{ data.title|default('') }}" placeholder="Was möchtest du erledigen?"></div><div class="form-grid"><div class="field"><label for="status">Status</label><select id="status" name="status">{% for status in statuses %}<option {{ data.status|default('Offen') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="priority">Priorität</label><select id="priority" name="priority">{% for priority in ['Niedrig','Mittel','Hoch'] %}<option {{ data.priority|default('Mittel') == priority ? 'selected' }}>{{ priority }}</option>{% endfor %}</select></div><div class="field"><label for="dueDate">Fälligkeit</label><input type="date" id="dueDate" name="dueDate" value="{{ data.dueDate|default('') }}"></div><div class="field"><label>Verantwortlich</label><input value="{{ app.user.name }} (Demo)" disabled></div><div class="field"><label for="propertyId">Verknüpftes Objekt</label><select id="propertyId" name="propertyId"><option value="">Keine Objektverknüpfung</option>{% for property in properties %}<option value="{{ property.id }}" {{ data.propertyId|default('') == property.id ? 'selected' }}>{{ property.title }}</option>{% endfor %}</select></div><div class="field"><label for="leadId">Verknüpfter Demo-Lead</label><select id="leadId" name="leadId"><option value="">Keine Leadverknüpfung</option>{% for lead in leads %}<option value="{{ lead.id }}" {{ data.leadId|default('') == lead.id ? 'selected' }}>{{ lead.title }}</option>{% endfor %}</select></div></div><div class="field"><label for="notes">Notizen</label><textarea rows="5" name="notes" id="notes" maxlength="5000">{{ data.notes|default('') }}</textarea></div><div class="toolbar"><button class="btn btn-primary">Aufgabe speichern</button><a class="btn btn-secondary" href="/tasks">Abbrechen</a></div></form>
{% if item.title %}<form method="post" action="/tasks/{{ item.id }}/delete" style="margin-top:24px"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Aufgabe löschen</button></form>{% endif %}
{% endblock %}
