<!doctype html>
<html lang="de" data-theme="{{ app.user.preferences.theme|default('light') }}" data-authenticated="{{ app.user ? 'true' : 'false' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ff6a00">
    <meta name="portal-csrf" content="{{ csrf_token('portal') }}">
    <title>{% block title %}Dashboard{% endblock %} · CHASE Partnerportal</title>
    <script>try{const r=document.documentElement,t=localStorage.getItem('chase-theme');if(r.dataset.authenticated!=='true'&&(t==='dark'||t==='light'))r.dataset.theme=t;if(localStorage.getItem('chase-sidebar')==='collapsed')r.classList.add('sidebar-collapsed')}catch(e){}</script>
    <link rel="stylesheet" href="/assets/app.css">
    {% block stylesheets %}{% endblock %}
    <script src="/assets/app.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
{% block shell %}
{% set current = app.request.pathInfo %}
<div class="app-shell">
    <div class="drawer-overlay" data-close-sidebar></div>
    <aside class="sidebar" id="main-navigation" aria-label="Hauptnavigation">
        <a class="brand" href="/" aria-label="CHASE Immobilien – Dashboard">
            <img class="brand-image brand-logo-light" src="/assets/brand/chase-orange.png" alt="CHASE Immobilien" width="166" height="58"><img class="brand-image brand-logo-dark" src="/assets/brand/chase-white.png" alt="CHASE Immobilien" width="166" height="58">
        </a>
        <div class="workspace-label"><span class="workspace-dot"></span><span>PARTNERPORTAL</span><span class="version-label">2.0</span></div>
        <nav class="main-nav">
            <div class="nav-group-label">MEIN ARBEITSPLATZ</div>
            {% set navigation = [
                ['/', 'home', 'Dashboard'],
                ['/properties', 'building', 'Meine Immobilien'],
                ['/leads', 'users', 'Akquise & Leads'],
                ['/documents', 'file-text', 'Dokumente'],
                ['/academy', 'graduation-cap', 'Wissen / Academy'],
                ['/advertising', 'megaphone', 'Werbekatalog'],
                ['/tasks', 'check-square', 'Aufgaben & Checklisten']
            ] %}
            {% for item in navigation %}
                {% set active = item[0] == '/' ? current == '/' : current starts with item[0] %}
                <a class="nav-link {{ active ? 'active' : '' }}" href="{{ item[0] }}" title="{{ item[2] }}" {% if active %}aria-current="page"{% endif %}>
                    {{ icon(item[1]) }}<span>{{ item[2] }}</span>
                    {% if item[0] == '/news' and portal.unreadNews > 0 %}<b class="nav-count">{{ portal.unreadNews }}</b>{% endif %}
                    {% if item[0] == '/studio' %}<small class="nav-new">DEMO</small>{% endif %}
                </a>
                {% if item[0] == '/properties' %}<a class="nav-link nav-sub-link {{ current starts with '/valuation' ? 'active' : '' }}" href="/valuation" title="Immobilienbewertung" {% if current starts with '/valuation' %}aria-current="page"{% endif %}>{{ icon('house') }}<span>Immobilienbewertung</span></a>{% endif %}
            {% endfor %}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="nav-divider"></div>
                <a class="nav-link {{ current starts with '/admin' ? 'active' : '' }}" href="/admin" title="Admin-Center">{{ icon('shield') }}<span>Admin-Center</span></a>
            {% endif %}
        </nav>
        <div class="sidebar-bottom">
            <a class="sidebar-help" href="/help"><span class="help-icon">{{ icon('help-circle') }}</span><span><strong>Gemeinsam weiterkommen.</strong><small>Hilfe & Ansprechpartner</small></span>{{ icon('arrow-up-right') }}</a>
            <button type="button" class="sidebar-collapse" data-toggle-sidebar aria-label="Seitenleiste einklappen" aria-expanded="true">{{ icon('panel-left') }}<span>Seitenleiste einklappen</span></button>
            <span class="sidebar-copyright">© {{ 'now'|date('Y') }} CHASE Immobilien</span>
        </div>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <div class="topbar-location">
                <button class="icon-button mobile-menu" type="button" data-open-sidebar aria-controls="main-navigation" aria-expanded="false" aria-label="Menü öffnen">{{ icon('menu') }}</button>
                <span class="topbar-portal">Partnerportal <span class="topbar-slash">/</span> <strong>{% block breadcrumb %}Mein Arbeitsplatz{% endblock %}</strong></span>
            </div>
            <form class="global-search" action="/search" method="get" role="search">
                <label class="sr-only" for="global-search">Portal durchsuchen</label>
                {{ icon('search') }}<input id="global-search" name="q" type="search" placeholder="Suchen nach Objekten, Wissen, Dokumenten …" value="{{ current == '/search' ? app.request.query.get('q') : '' }}" autocomplete="off"><kbd>⌘ K</kbd>
            </form>
            <div class="topbar-tools">
                <button class="icon-button theme-toggle" type="button" data-toggle-theme aria-label="Dunklen Modus aktivieren" title="Hell / Dunkel umschalten"><span class="theme-sun">{{ icon('sun') }}</span><span class="theme-moon">{{ icon('moon') }}</span></button>
                <a class="icon-button message-button" href="/messages" aria-label="Nachrichten und Kontakt{% if portal.unreadMessages|default(0) > 0 %}, {{ portal.unreadMessages }} ungelesen{% endif %}" title="Nachrichten & Kontakt">{{ icon('message-circle') }}{% if portal.unreadMessages|default(0) > 0 %}<span class="notification-dot"></span>{% endif %}</a>
                <a class="icon-button header-help" href="/help/assistant" aria-label="Portalhilfe öffnen" title="Wo finde ich was?">{{ icon('help-circle') }}</a>
                <a class="icon-button notification-button" href="/news" aria-label="Nachrichten{% if portal.unreadNews > 0 %}, {{ portal.unreadNews }} ungelesen{% endif %}">{{ icon('bell') }}{% if portal.unreadNews > 0 %}<span class="nav-count header-news-count">{{ portal.unreadNews }}</span>{% endif %}</a>
                <span class="topbar-divider"></span>
                <div class="profile-dropdown">
                    <button class="profile-trigger" type="button" data-profile-toggle aria-expanded="false" aria-controls="profile-menu">
                        <span class="avatar">{% if app.user.preferences.avatarFilename|default('') %}<img src="/profile/avatar/{{ app.user.id }}" alt="Ihr Profilbild" width="35" height="35">{% else %}{{ portal.initials }}{% endif %}</span><span class="profile-info"><strong>{{ app.user.name }}</strong><small>{{ app.user.region }}</small></span>{{ icon('chevron-down') }}
                    </button>
                    <div class="profile-menu" id="profile-menu" hidden>
                        <div class="profile-menu-label">MEIN KONTO · DEMO</div>
                        <a href="/profile">{{ icon('users') }}Mein Profil & Einstellungen</a>
                        <a href="/help">{{ icon('help-circle') }}Hilfe & Ansprechpartner</a>
                        <form action="/logout" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button type="submit">{{ icon('log-out') }}Abmelden</button></form>
                    </div>
                </div>
            </div>
        </header>
        <main class="main-content" id="main-content" tabindex="-1">
            <div class="flash-stack" aria-live="polite">
                {% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}" role="status"><span>{{ icon(type == 'error' ? 'help-circle' : 'check') }}</span><span>{{ message }}</span><button class="icon-button" type="button" data-dismiss-alert aria-label="Meldung schließen">{{ icon('x') }}</button></div>{% endfor %}{% endfor %}
            </div>
            {% block body %}{% endblock %}
            <footer class="page-footer"><span><span class="status-dot"></span>Lokaler Prototyp · CHASE-Materialien & Beispieldaten</span><a href="/help">Integrationen & Hilfe {{ icon('arrow-up-right') }}</a></footer>
        </main>
    </div>
</div>
{% endblock %}
<div class="toast-region" aria-live="polite" aria-atomic="true"></div>
{% block javascripts %}{% endblock %}
</body>
</html>
