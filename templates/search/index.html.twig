{% extends 'base.html.twig' %}
{% block title %}Suche · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Schnell das Richtige finden</span><h1>Globale Suche</h1><p>Ihre Immobilien, freigegebene Dokumente, Wissen und interne News.</p></div>{% if q %}<span class="badge">{{ total }} Treffer</span>{% endif %}</div>
<form method="get" class="card toolbar" role="search"><div class="field" style="flex:1"><label for="global-query">Was suchen Sie?</label><input id="global-query" type="search" name="q" value="{{ q }}" placeholder="Immobilie, Stichwort oder Thema …" maxlength="200" autofocus></div><button class="btn btn-primary" type="submit">Suchen</button></form>
{% if not q %}<div class="card empty-state"><h2>Ein Suchfeld für Ihren Arbeitsalltag</h2><p>Geben Sie zum Beispiel „Exposé“, „Marketing“ oder einen Ort ein. Sie sehen ausschließlich Inhalte, für die Ihr Konto freigegeben ist.</p></div>{% elseif not total %}<div class="card empty-state"><h2>Keine Treffer für „{{ q }}“</h2><p>Versuchen Sie einen anderen Begriff oder ein kürzeres Stichwort.</p></div>{% else %}<div class="stack">{% for label, results in groups %}{% if results %}<section class="card stack"><div class="toolbar"><h2>{{ label }}</h2><span class="badge">{{ results|length }}</span></div>{% for result in results %}{% set item = result.record %}{% set url = result.type == 'property' ? '/properties/' ~ item.id : (result.type == 'document' ? path('app_document',{id:item.id}) : (result.type == 'academy' ? path('app_academy_article',{id:item.id}) : path('app_news_article',{id:item.id}))) %}<article class="search-result"><a href="{{ url }}"><h3>{{ item.title }}</h3></a><p class="muted">{{ item.data.description|default(item.data.teaser|default(item.data.summary|default(item.data.city|default(item.data.location|default(item.data.region|default('')))))) }}</p><span class="badge">{{ item.data.category|default(item.data.status|default('Eigene Immobilie')) }}</span></article>{% endfor %}</section>{% endif %}{% endfor %}</div>{% endif %}
<p class="muted"><small>Jeder Treffer wird serverseitig auf Ihre Freigaben geprüft. Region oder Administrationsrolle allein gewähren keinen Zugriff auf fremde Kundendaten.</small></p>
{% endblock %}
