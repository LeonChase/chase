{% extends 'base.html.twig' %}
{% block title %}Suche{% endblock %}
{% block breadcrumb %}Suche{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Schnell das Richtige finden</span><h1>Globale Suche</h1><p>Ihre Immobilien, Unterlagen, Lerninhalte und Immobilienbegriffe.</p></div>{% if q %}<span class="badge">{{ total }} Treffer</span>{% endif %}</div>
<form method="get" class="card toolbar" role="search"><div class="field" style="flex:1"><label for="global-query">Was suchen Sie?</label><input id="global-query" type="search" name="q" value="{{ q }}" placeholder="Immobilie, Dokument oder Begriff …" maxlength="200" autofocus></div><button class="btn btn-primary" type="submit">Suchen</button></form>
{% if not q %}<div class="card empty-state"><h2>Ein Suchfeld für Ihren Arbeitsalltag</h2><p>Geben Sie zum Beispiel „Exposé“, „Erbbaurecht“ oder einen Ort ein. Sie sehen ausschließlich Inhalte, für die Ihr Konto freigegeben ist.</p><a class="btn btn-secondary" href="{{ path('app_lexicon') }}">Im Immobilienlexikon nachschlagen</a></div>{% elseif not total %}<div class="card empty-state"><h2>Keine Treffer für „{{ q }}“</h2><p>Versuchen Sie einen anderen Begriff oder ein kürzeres Stichwort.</p></div>{% else %}<div class="stack">
{% if lexiconResults|default([]) %}<section class="card stack"><div class="toolbar"><h2>Immobilienlexikon</h2><span class="badge">{{ lexiconResults|length }} Begriffe</span></div>{% for entry in lexiconResults|slice(0,12) %}<article class="search-result"><a href="{{ path('app_lexicon_term',{id:entry.id}) }}"><h3>{{ entry.term }}</h3></a><p class="muted">{{ entry.definition|slice(0,240) }}{{ entry.definition|length > 240 ? ' …' : '' }}</p><small class="muted">Bereitgestelltes CHASE-Lexikon · Original-Seite {{ entry.page }}</small></article>{% endfor %}{% if lexiconResults|length > 12 %}<a class="btn btn-secondary" href="{{ path('app_lexicon',{q:q}) }}">Alle {{ lexiconResults|length }} Begriffe ansehen →</a>{% endif %}</section>{% endif %}
{% for label,results in groups %}{% if results %}<section class="card stack"><div class="toolbar"><h2>{{ label }}</h2><span class="badge">{{ results|length }}</span></div>{% for result in results %}{% set item = result.record %}{% set url = result.type == 'property' ? '/properties/' ~ item.id : (result.type == 'document' ? path('app_document',{id:item.id}) : (result.type == 'academy' ? path('app_academy_article',{id:item.id}) : path('app_news_article',{id:item.id}))) %}<article class="search-result"><a href="{{ url }}"><h3>{{ item.title }}</h3></a><p class="muted">{{ item.data.description|default(item.data.teaser|default(item.data.summary|default(item.data.city|default(item.data.location|default(item.data.region|default('')))))) }}</p><span class="badge">{{ item.data.category|default(item.data.status|default('Eigene Immobilie')) }}</span>{% if item.data.provided|default(false) %}<small class="muted">Bereitgestellte Unterlage</small>{% endif %}</article>{% endfor %}</section>{% endif %}{% endfor %}</div>{% endif %}
<p class="muted"><small>Jeder Treffer wird serverseitig auf Ihre Freigaben geprüft. Immobilienlexikon: sachliche Definitionen aus dem bereitgestellten Original.</small></p>
{% endblock %}
