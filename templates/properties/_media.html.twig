{% set list = kind == 'image' ? images : documents %}
{% set anchor = kind == 'image' ? 'images' : 'documents' %}
{% set categories = [] %}{% for category in imageCategories|merge(documentCategories) %}{% if category not in categories %}{% set categories = categories|merge([category]) %}{% endif %}{% endfor %}
{% if saved %}
<form method="post" action="/properties/{{ item.id }}/media" enctype="multipart/form-data" class="property-upload" data-object-action>
    <input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_workspace" value="1"><input type="hidden" name="kind" value="{{ kind }}">
    <span class="property-upload-icon">{{ icon(kind == 'image' ? 'image' : 'file-text') }}</span>
    <div class="field"><label for="upload-{{ kind }}">{{ kind == 'image' ? 'Bilder auswählen' : 'Unterlagen auswählen' }}</label><input id="upload-{{ kind }}" type="file" name="media[]" multiple accept="{{ kind == 'image' ? '.jpg,.jpeg,.png,.webp' : '.pdf,.jpg,.jpeg,.png,.webp' }}" required><small>Bis zu 12 Dateien · je 8 MB · zusammen 16 MB. {{ kind == 'image' ? 'JPG, PNG, WebP.' : 'PDF, JPG, PNG, WebP.' }} Private Originale; kein externer Upload.</small></div>
    <button class="btn btn-secondary">{{ icon('plus') }}Hochladen</button>
</form>
{% if list %}
<div class="property-media-grid {{ kind == 'document' ? 'property-document-grid' }}">
{% for asset in list %}
{% set firstAsset = loop.first %}{% set lastAsset = loop.last %}<article class="property-media-card" id="asset-{{ asset.id }}">
    {% if asset.data.mime|default('') starts with 'image/' %}<a class="property-media-preview" href="/media/{{ asset.id }}" target="_blank" rel="noopener"><img src="/media/{{ asset.id }}" alt="{{ asset.data.caption|default(asset.title) }}" loading="lazy"></a>{% else %}<a class="property-document-preview" href="/media/{{ asset.id }}">{{ icon('file-text') }}<strong>PDF</strong><span>Original herunterladen</span></a>{% endif %}
    <div class="property-media-body"><div class="property-media-title"><strong>{{ asset.title }}</strong><span class="badge">{{ asset.data.category|default('Sonstiges') }}</span></div><small class="muted">{{ asset.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · {{ (asset.data.size|default(0) / 1024)|number_format(0,',','.') }} KB</small>
        <details class="property-media-edit"><summary>Beschriften & einsortieren {{ icon('chevron-down') }}</summary>
        <form method="post" action="/properties/{{ item.id }}/media/{{ asset.id }}/metadata" class="stack" data-object-action>
            <input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_workspace" value="1">
            <div class="field"><label for="asset-title-{{ asset.id }}">Anzeigename</label><input id="asset-title-{{ asset.id }}" name="title" value="{{ asset.title }}" maxlength="180" required></div>
            <div class="field"><label for="asset-caption-{{ asset.id }}">{{ kind == 'image' ? 'Bildbeschreibung / gesicherte Fakten' : 'Kurze Inhaltsnotiz' }}</label><textarea id="asset-caption-{{ asset.id }}" name="caption" rows="2" maxlength="500">{{ asset.data.caption|default('') }}</textarea></div>
            <div class="form-grid"><div class="field"><label for="asset-category-{{ asset.id }}">Kategorie</label><select id="asset-category-{{ asset.id }}" name="category">{% for category in categories %}<option {{ asset.data.category|default('Sonstiges') == category ? 'selected' }}>{{ category }}</option>{% endfor %}</select></div><div class="field"><label for="asset-position-{{ asset.id }}">Reihenfolge</label><input id="asset-position-{{ asset.id }}" name="position" type="number" min="0" max="9999" step="1" value="{{ asset.data.position|default(loop.index * 10) }}" required></div></div>
            <div class="field"><label for="asset-kind-{{ asset.id }}">Ablage</label><select id="asset-kind-{{ asset.id }}" name="kind">{% if asset.data.mime|default('') starts with 'image/' %}<option value="image" {{ kind == 'image' ? 'selected' }}>Bilder</option>{% endif %}<option value="document" {{ kind == 'document' ? 'selected' }}>Unterlagen</option></select><small>Skizzen und gescannte Grundrisse unter Unterlagen ablegen. Bitte passende Kategorie vor dem Speichern wählen.</small></div>
            {% if kind == 'image' %}<label class="property-check"><input type="checkbox" name="factsConfirmed" value="1" {{ asset.data.factsConfirmed|default(false) ? 'checked' }}>Beschreibung fachlich geprüft – als Textquelle verwenden</label><small class="muted">Die lokale Textfunktion analysiert keine Bildinhalte. Nur bestätigte Beschriftungen können Fakten ergänzen.</small>{% endif %}
            <small class="muted">Originalname: {{ asset.data.originalName|default(asset.title) }}. Das Original wird nicht umbenannt oder verändert.</small><button class="btn btn-secondary">Dateiangaben speichern</button>
        </form></details>
        <div class="property-media-actions"><a class="text-link" href="/media/{{ asset.id }}" target="_blank" rel="noopener">{{ kind == 'image' ? 'Original ansehen' : 'Herunterladen' }} {{ icon('arrow-up-right') }}</a><div class="property-order-buttons">{% for direction,label in {'up':'Nach vorn','down':'Nach hinten'} %}<form method="post" action="/properties/{{ item.id }}/media/{{ asset.id }}/move" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_workspace" value="1"><input type="hidden" name="direction" value="{{ direction }}"><button class="icon-button" aria-label="{{ asset.title }}: {{ label }}" title="{{ label }}" {{ (direction == 'up' and firstAsset) or (direction == 'down' and lastAsset) ? 'disabled' }}>{{ icon(direction == 'up' ? 'arrow-up' : 'arrow-down') }}</button></form>{% endfor %}</div></div>
        <details class="property-media-remove"><summary>Datei entfernen</summary><p>Entfernt diese Datei und das private Original endgültig aus dem Portal.</p><form method="post" action="/properties/{{ item.id }}/media/{{ asset.id }}/delete" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_workspace" value="1"><button class="btn btn-danger btn-small">Datei endgültig entfernen</button></form></details>
    </div>
</article>
{% endfor %}
</div>
{% else %}<div class="property-inline-empty">{{ icon(kind == 'image' ? 'image' : 'file-text') }}<div><strong>{{ kind == 'image' ? 'Deine Bilder erzählen die Geschichte.' : 'Alle Unterlagen am richtigen Ort.' }}</strong><p>{{ kind == 'image' ? 'Lade Originalbilder hoch und beschrifte sie mit bestätigten Angaben.' : 'Füge z. B. Grundriss, Energieausweis oder Abrechnung hinzu. Zugang bleibt objektbezogen geschützt.' }}</p></div></div>{% endif %}
{% else %}<div class="property-inline-empty">{{ icon('save') }}<div><strong>Einmal speichern, dann direkt hochladen.</strong><p>Ergänze oben die Pflichtfelder. Danach kannst du hier mit Bildern und Unterlagen weiterarbeiten.</p><button class="btn btn-secondary" form="property-data-form" name="returnSection" value="{{ anchor }}">Speichern & hier weiter</button></div></div>{% endif %}
