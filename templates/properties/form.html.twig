{% extends 'base.html.twig' %}
{% block title %}Objekt bearbeiten · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><a href="/properties" class="muted">← Meine Immobilien</a><h1>{{ item.title ? 'Objekt bearbeiten' : 'Neues Objekt' }}</h1><p class="muted">Erfasse bekannte Fakten. Unbekannte Angaben bleiben leer.</p></div><span class="badge">Lokal nutzbar · Demo</span></div>
{% if errors %}<div class="alert" role="alert"><strong>Bitte prüfe deine Eingaben.</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">
<section class="card"><h2>Die wichtigsten Angaben</h2><div class="form-grid"><div class="field"><label for="title">Bezeichnung *</label><input id="title" name="title" required maxlength="250" value="{{ data.title|default('') }}"></div><div class="field"><label for="internalId">Interne Objekt-ID</label><input id="internalId" name="internalId" maxlength="250" value="{{ data.internalId|default('') }}" placeholder="z. B. CHASE-DEMO-101"></div><div class="field"><label for="propertyType">Objektart *</label><select id="propertyType" name="propertyType" required><option value="">Bitte wählen</option>{% for type in types %}<option {{ data.propertyType|default('') == type ? 'selected' }}>{{ type }}</option>{% endfor %}</select></div><div class="field"><label for="marketingType">Vermarktung</label><select id="marketingType" name="marketingType">{% for type in ['Kauf','Miete'] %}<option {{ data.marketingType|default('Kauf') == type ? 'selected' }}>{{ type }}</option>{% endfor %}</select></div><div class="field"><label for="status">Status</label><select id="status" name="status">{% for status in statuses %}<option {{ data.status|default('Entwurf') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label>Verantwortlich</label><input value="{{ app.user.name }} · eigenes Demo-Konto" disabled><small class="muted">Die bestehende Eigentümerzuweisung bleibt beim Bearbeiten erhalten.</small></div></div></section>
<section class="card"><h2>Standort & Objektdaten</h2><div class="form-grid">{% for field,label in {'city':'Ort *','district':'Stadtteil','region':'Region *','address':'Adresse (optional)'} %}<div class="field"><label for="{{ field }}">{{ label }}</label><input id="{{ field }}" name="{{ field }}" value="{{ attribute(data,field)|default('') }}" maxlength="250" {{ field in ['city','region'] ? 'required' }}></div>{% endfor %}{% for field,label in {'areaSqm':'Wohnfläche (m²)','usableAreaSqm':'Nutzfläche (m²)','plotSqm':'Grundstück (m²)','rooms':'Zimmer','yearBuilt':'Baujahr','priceEur':'Kaufpreis (EUR)','rentEur':'Monatliche Kaltmiete (EUR)'} %}<div class="field"><label for="{{ field }}">{{ label }}</label><input id="{{ field }}" name="{{ field }}" type="number" min="{{ field == 'yearBuilt' ? '1000' : '0.01' }}" max="{{ field == 'yearBuilt' ? 'now'|date('Y') + 5 : '1000000000' }}" step="{{ field == 'yearBuilt' ? '1' : '0.01' }}" value="{{ attribute(data,field)|default('') }}"></div>{% endfor %}<div class="field"><label for="condition">Zustand</label><input id="condition" name="condition" maxlength="250" value="{{ data.condition|default('') }}"></div></div></section>
<section class="card"><h2>Ausstattung & Freigaben</h2><div class="form-grid"><div class="field"><label for="features">Ausstattung (ein Merkmal pro Zeile)</label><textarea id="features" name="features" rows="5">{{ data.features|default([])|join('\n') }}</textarea></div><div class="field"><label for="sellingPoints">Bestätigte Highlights (ein Punkt pro Zeile)</label><textarea id="sellingPoints" name="sellingPoints" rows="5">{{ data.sellingPoints|default([])|join('\n') }}</textarea></div><div class="field"><label for="energyData">Bekannte Energiekennwerte</label><textarea id="energyData" name="energyData" rows="3" maxlength="5000">{{ data.energyData|default('') }}</textarea><small class="muted">Fehlende Pflichtangaben vor Veröffentlichung manuell prüfen.</small></div><div class="field"><label for="dataSharing">Datenfreigaben / Freigabevermerk</label><input id="dataSharing" name="dataSharing" maxlength="250" value="{{ data.dataSharing|default('') }}" placeholder="z. B. nur intern freigegeben"></div><div class="field"><label for="source">Quelle</label><input id="source" name="source" maxlength="250" value="{{ data.source|default('Lokale Demo-Erfassung') }}"></div><div class="field"><label for="notes">Interne Notizen</label><textarea id="notes" name="notes" maxlength="5000" rows="4">{{ data.notes|default('') }}</textarea></div></div></section>
<div class="toolbar"><button class="btn btn-primary">Objekt speichern</button><a class="btn btn-secondary" href="/properties">Abbrechen</a></div><p class="muted">Bitte ausschließlich synthetische Demo-Daten verwenden. Alle Angaben werden lokal gespeichert.</p>
</form>{% endblock %}
