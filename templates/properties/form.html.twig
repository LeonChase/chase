{% extends 'base.html.twig' %}
{% import 'properties/_field.html.twig' as fields %}
{% block title %}{{ saved ? item.title : 'Neues Objekt' }}{% endblock %}
{% block breadcrumb %}Meine Immobilien / Objektarbeitsplatz{% endblock %}
{% block stylesheets %}{% include 'properties/_workspace_styles.html.twig' %}{% endblock %}
{% block body %}
{% set steps = {'start':'Start','base':'Grunddaten','equipment':'Ausstattung & Energie','condition':'Zustand','images':'Bilder','documents':'Unterlagen','pricing':'Preis & Provision','texts':'Exposé-Texte','marketing':'Vermarktung'} %}
{% set groupTitles = {'address':'Anschrift ergänzen','contact':'Ansprechpartner zum Objekt','owners':'Eigentümer & Hausverwaltung (intern)','extended':'Weitere Flächen, Einheiten & Nutzung','energy':'Heizung & Energieausweis','construction':'Bauweise & weitere Ausstattung','commission':'Provision & Vereinbarung','release':'Quelle & Datenfreigabe','internal':'Interne Notiz'} %}
<div class="property-editor">
<div class="page-heading property-page-heading"><div class="property-title-line"><a class="icon-button" href="/properties" aria-label="Zur Immobilienübersicht" title="Meine Immobilien">{{ icon('arrow-left') }}</a><h1>{{ saved ? item.title : 'Objekt anlegen' }}</h1></div><div class="property-heading-actions"><span class="property-save-notice" id="property-dirty-notice" role="status" hidden>Ungespeichert</span>{% if saved %}<span class="badge">{{ data.status|default('Entwurf') }}</span>{% endif %}<button type="submit" form="property-data-form" class="btn btn-primary">{{ icon('save') }}Speichern</button></div></div>
{% if errors %}<div class="alert alert-error property-validation" role="alert" tabindex="-1"><div><strong>Bitte prüfe die markierten Angaben.</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul><p>Es wurden keine Änderungen gespeichert.</p></div></div>{% endif %}

<form method="post" action="{{ saved ? '/properties/' ~ item.id ~ '/edit' : '/properties/new' }}" id="property-data-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_activeStep" value="{{ initialSection }}" data-active-step-input></form>
<div class="property-workspace" data-property-workspace data-initial-section="{{ initialSection }}" data-property-saved="{{ saved ? 'true' : 'false' }}" data-workspace-errors="{{ errors ? 'true' : 'false' }}" data-step-storage="chase-object-step:{{ app.user.id }}:{{ saved ? item.id : 'new' }}">
<aside class="property-stepper"><nav aria-label="Abschnitte der Objektaufnahme">{% for key,label in steps %}<a href="?step={{ key }}#{{ key }}" data-workspace-step="{{ key }}" class="{{ initialSection == key ? 'active' }}"><span>{{ '%02d'|format(loop.index) }}</span><strong>{{ label }}</strong>{% if key == 'images' and images %}<small>{{ images|length }}</small>{% elseif key == 'documents' and documents %}<small>{{ documents|length }}</small>{% endif %}</a>{% endfor %}</nav><div class="property-stepper-note">{% if saved %}<a href="?step=activity#activity" data-workspace-step="activity" class="property-history-link">{{ icon('clock') }}Verlauf</a><small>Stand {{ item.updatedAt|date('d.m.Y H:i','Europe/Berlin') }}</small>{% else %}<small>Neues Objekt</small>{% endif %}</div></aside>
<div class="property-workspace-content">
{% for sectionKey in ['start','base','equipment','condition'] %}
{% set section = attribute(sections,sectionKey) %}
<section class="property-section" id="{{ sectionKey }}" data-workspace-panel {% if initialSection != sectionKey %}hidden{% endif %}>
<header class="property-section-heading"><span class="property-section-number">{{ '%02d'|format(loop.index) }}</span><div><h2>{{ section.title }}</h2><p>{{ section.subtitle }}</p></div><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header>
<div class="property-section-body">
{% set primaryGroup = sectionKey == 'start' ? 'basic' : (sectionKey == 'equipment' ? 'features' : 'core') %}
{% if sectionKey == 'equipment' %}<div class="property-feature-choices" aria-label="Ausstattung schnell ergänzen">{% for feature in ['Balkon','Terrasse','Garten','Gäste-WC','Einbauküche','Aufzug','Garage','Barrierearm'] %}<label><input type="checkbox" data-feature-chip value="{{ feature }}">{{ feature }}</label>{% endfor %}</div>{% endif %}
<div class="form-grid property-form-grid">{% for name,field in section.fields %}{% if field.group == primaryGroup %}{{ fields.render(name,field,data) }}{% endif %}{% endfor %}</div>
{% set groups = [] %}{% for field in section.fields %}{% if field.group != primaryGroup and field.group not in groups %}{% set groups = groups|merge([field.group]) %}{% endif %}{% endfor %}
<div class="property-subsections">{% for group in groups %}<details class="property-subsection" {{ errors ? 'open' }}><summary><strong>{{ attribute(groupTitles,group)|default(group) }}</strong><span>{{ icon('plus') }}</span></summary><div class="form-grid property-form-grid">{% for name,field in section.fields %}{% if field.group == group %}{{ fields.render(name,field,data) }}{% endif %}{% endfor %}</div>{% if group == 'owners' %}<small class="property-data-note">Kontaktangaben bleiben intern.</small>{% endif %}</details>{% endfor %}</div>
{% if sectionKey == 'condition' %}
<div class="property-modernisation"><h3>Modernisierungen</h3><input form="property-data-form" type="hidden" name="modernisations_present" value="1">
{% set rows = data.modernisations|default([]) %}{% if rows is empty %}{% set rows = [{'component':'Fenster','year':'','details':''}] %}{% endif %}
<div class="table-wrap property-modernisation-table"><table><thead><tr><th scope="col">Bauteil</th><th scope="col">Jahr</th><th scope="col">Maßnahme / Quelle</th><th scope="col"><span class="sr-only">Entfernen</span></th></tr></thead><tbody data-modernisation-rows>{% for row in rows %}<tr><td><select form="property-data-form" name="modernisations[{{ loop.index0 }}][component]" aria-label="Bauteil, Zeile {{ loop.index }}">{% for component in modernisationComponents %}<option {{ row.component|default('') == component ? 'selected' }}>{{ component }}</option>{% endfor %}</select></td><td><input form="property-data-form" type="number" name="modernisations[{{ loop.index0 }}][year]" value="{{ row.year|default('') }}" min="1900" max="{{ 'now'|date('Y') + 5 }}" step="1" aria-label="Modernisierungsjahr, Zeile {{ loop.index }}" placeholder="Jahr"></td><td><input form="property-data-form" name="modernisations[{{ loop.index0 }}][details]" value="{{ row.details|default('') }}" maxlength="1000" aria-label="Maßnahme und Quelle, Zeile {{ loop.index }}" placeholder="z. B. Fenster erneuert; Eigentümerangabe"></td><td><button class="icon-button" type="button" data-remove-modernisation aria-label="Zeile {{ loop.index }} entfernen">{{ icon('x') }}</button></td></tr>{% endfor %}</tbody></table></div>
<button type="button" class="btn btn-secondary btn-small" data-add-modernisation>{{ icon('plus') }}Weitere Maßnahme</button>
<template id="modernisation-row-template"><tr><td><select form="property-data-form" name="modernisations[__INDEX__][component]" aria-label="Bauteil">{% for component in modernisationComponents %}<option>{{ component }}</option>{% endfor %}</select></td><td><input form="property-data-form" type="number" name="modernisations[__INDEX__][year]" min="1900" max="{{ 'now'|date('Y') + 5 }}" step="1" placeholder="Jahr" aria-label="Modernisierungsjahr"></td><td><input form="property-data-form" name="modernisations[__INDEX__][details]" maxlength="1000" placeholder="Maßnahme und Quelle" aria-label="Maßnahme und Quelle"></td><td><button class="icon-button" type="button" data-remove-modernisation aria-label="Zeile entfernen">{{ icon('x') }}</button></td></tr></template>
</div>{% endif %}
</div></section>
{% endfor %}
<section class="property-section" id="images" data-workspace-panel {% if initialSection != 'images' %}hidden{% endif %}><header class="property-section-heading"><span class="property-section-number">05</span><div><h2>Bilder</h2><p>Originale hochladen, sinnvoll ordnen und mit gesicherten Fakten beschriften.</p></div><span class="property-section-count">{{ images|length }}</span><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header><div class="property-section-body">{% include 'properties/_media.html.twig' with {kind:'image'} %}{% if saved %}{% include 'properties/_ai_tools.html.twig' ignore missing with {section:'images'} %}{% endif %}</div></section>
<section class="property-section" id="documents" data-workspace-panel {% if initialSection != 'documents' %}hidden{% endif %}><header class="property-section-heading"><span class="property-section-number">06</span><div><h2>Unterlagen</h2><p>Grundrisse, Belege und Dokumente. Geschützt an einem Ort.</p></div><span class="property-section-count">{{ documents|length }}</span><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header><div class="property-section-body">{% include 'properties/_media.html.twig' with {kind:'document'} %}{% if saved %}{% include 'properties/_ai_tools.html.twig' ignore missing with {section:'documents'} %}{% endif %}</div></section>
{% set section = sections.pricing %}<section class="property-section" id="pricing" data-workspace-panel {% if initialSection != 'pricing' %}hidden{% endif %}><header class="property-section-heading"><span class="property-section-number">07</span><div><h2>Preis & Provision</h2><p>Preisgrundlagen nachvollziehbar erfassen, Vereinbarungen getrennt festhalten.</p></div><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header><div class="property-section-body"><div class="form-grid property-form-grid">{% for name,field in section.fields %}{% if field.group == 'price' %}{{ fields.render(name,field,data) }}{% endif %}{% endfor %}</div><div class="property-valuation-callout"><span>{{ icon('house') }}</span><div><h3>Den Preis fundiert vorbereiten.</h3><p>CHASE-Rechenwege für Sachwert, Ertragswert und Vergleichswert – mit nachvollziehbaren Eingaben. Quellen und Aktualität von Faktoren bleiben sichtbar; keine automatische Marktwertzusage.</p></div>{% if saved %}<a class="btn btn-secondary" href="/properties/{{ item.id }}/valuation">Bewertung öffnen {{ icon('arrow-up-right') }}</a>{% else %}<button class="btn btn-secondary" form="property-data-form" name="returnSection" value="pricing">Speichern & Bewertung vorbereiten</button>{% endif %}</div>{% if valuations %}<div class="property-valuation-history"><h3>Gespeicherte Bewertungsvorbereitungen</h3>{% for valuation in valuations|slice(0,3) %}<a href="/properties/{{ item.id }}/valuation?result={{ valuation.id }}" class="property-activity"><small>{{ valuation.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</small><span>{{ valuation.title }}</span>{% if valuation.data.calculation.offer.value|default(null) %}<strong>{{ valuation.data.calculation.offer.value|number_format(0,',','.') }} €</strong>{% endif %}{{ icon('arrow-up-right') }}</a>{% endfor %}<p class="muted">Gespeicherte Rechenstände – keine aktuelle oder verbindliche Marktwertzusage.</p></div>{% endif %}<div class="property-subsections">{% for group in ['commission','release'] %}<details class="property-subsection" {{ errors ? 'open' }}><summary><strong>{{ attribute(groupTitles,group) }}</strong>{{ icon('plus') }}</summary><div class="form-grid property-form-grid">{% for name,field in section.fields %}{% if field.group == group %}{{ fields.render(name,field,data) }}{% endif %}{% endfor %}</div></details>{% endfor %}</div></div></section>
<section class="property-section" id="texts" data-workspace-panel {% if initialSection != 'texts' %}hidden{% endif %}><header class="property-section-heading"><span class="property-section-number">08</span><div><h2>Exposé-Texte</h2><p>Objektbeschreibung, Ausstattung und Lage aus den gespeicherten Fakten.</p></div><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header><div class="property-section-body">{% if saved %}{% include 'properties/_ai_tools.html.twig' ignore missing with {section:'texts'} %}{% set legacyPosts = posts|filter(p => p.data.tool|default('') not in ['property_expose','property_social']) %}{% if legacyPosts %}<details class="property-subsection"><summary><strong>Weitere gespeicherte Texte & Versionen ({{ legacyPosts|length }})</strong>{{ icon('plus') }}</summary>{% for post in legacyPosts %}<article class="property-saved-text"><div><h3>{{ post.title }}</h3><span class="badge">{{ post.data.status|default('Entwurf') }}</span></div><small class="muted">{{ post.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Version {{ post.data.version|default(1) }}</small><p>{{ post.data.content|default(post.data.text|default(post.data.body|default('')))|nl2br }}</p></article>{% endfor %}</details>{% endif %}{% else %}<div class="property-inline-empty">{{ icon('file-text') }}<div><strong>Zuerst die Fakten, dann die Texte.</strong><p>Speichere dein Objekt. Die Textfunktionen verwenden danach seine bestätigten Angaben.</p><button class="btn btn-secondary" form="property-data-form" name="returnSection" value="texts">Speichern & zu den Texten</button></div></div>{% endif %}</div></section>
<section class="property-section" id="marketing" data-workspace-panel {% if initialSection != 'marketing' %}hidden{% endif %}><header class="property-section-heading"><span class="property-section-number">09</span><div><h2>Veröffentlichung & Vermarktung</h2><p>Freigabe vorbereiten, Social-Inhalte erstellen und intern abstimmen.</p></div><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header><div class="property-section-body">
<div class="property-ready-card"><h3>Interne Freigabe</h3><input type="hidden" form="property-data-form" name="readyForReview" value="0"><label class="property-check"><input form="property-data-form" type="checkbox" name="readyForReview" value="1" {{ data.readyForReview|default(false) ? 'checked' }}>Zur internen Prüfung vorbereitet</label><div class="property-ready-actions"><button class="btn btn-primary" form="property-data-form" name="returnSection" value="marketing">Stand speichern</button>{% if saved %}<a class="btn btn-secondary" href="/messages?property={{ item.id }}">Ansprechpartner kontaktieren {{ icon('arrow-right') }}</a>{% endif %}</div></div>
{% if saved %}{% include 'properties/_ai_tools.html.twig' ignore missing with {section:'marketing'} %}<details class="property-subsection"><summary><strong>Vermarktungscheckliste</strong>{{ icon('plus') }}</summary><p class="muted">Arbeitsvorlage, keine rechtliche Vollständigkeitsprüfung.</p><form method="post" action="/properties/{{ item.id }}/checklist" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_workspace" value="1">{% for check in checklist %}<label class="property-check"><input type="checkbox" name="checks[]" value="{{ check }}" {{ check in item.data.checklist|default([]) ? 'checked' }}>{{ check }}</label>{% endfor %}<button class="btn btn-secondary" style="margin-top:15px">Checkliste speichern</button></form></details><details class="property-subsection"><summary><strong>Aufgaben zu diesem Objekt ({{ tasks|length }})</strong>{{ icon('plus') }}</summary>{% for task in tasks %}<p class="property-task-link"><a href="/tasks/{{ task.id }}/edit">{{ task.title }}</a><span class="badge">{{ task.data.status|default('Offen') }}</span></p>{% else %}<p>Noch keine Aufgabe verknüpft.</p>{% endfor %}<a class="text-link" href="/tasks/new?property={{ item.id }}">Aufgabe anlegen {{ icon('arrow-right') }}</a></details>{% endif %}
<p class="property-private-note">{{ icon('lock') }}Externe Portale, Social-Veröffentlichung, Interessentenversand und Bild-/Video-APIs sind ohne eingerichtete Verbindung deaktiviert.</p>
</div></section>
{% if saved %}<section class="property-section property-history" id="activity" data-workspace-panel {% if initialSection != 'activity' %}hidden{% endif %}><header class="property-section-heading"><span>{{ icon('clock') }}</span><div><h2>Änderungsverlauf</h2><p>Zuletzt gespeichert {{ item.updatedAt|date('d.m.Y H:i','Europe/Berlin') }}</p></div><span class="property-section-chevron">{{ icon('chevron-down') }}</span></header><div class="property-section-body">{% for activity in activities|slice(0,20) %}<p class="property-activity"><small>{{ activity.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</small><span>{{ activity.title }}</span></p>{% else %}<p>Noch keine Änderungen protokolliert.</p>{% endfor %}{% if item.data.externalId|default('') %}<p class="property-private-note">CRM: {{ item.data.externalId }} · {{ item.data.lastSync|default('') ? item.data.lastSync|date('d.m.Y H:i','Europe/Berlin') : 'Importzeit nicht erfasst' }} · Demo, keine Live-Verbindung.</p>{% endif %}<form method="post" action="/properties/{{ item.id }}/archive" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Objekt archivieren</button></form></div></section>{% endif %}
<div class="property-step-controls"><button class="btn btn-secondary" type="button" data-workspace-prev>{{ icon('arrow-left') }}Zurück</button><span class="property-step-status" aria-live="polite"><strong data-current-step-label>Start</strong><small data-current-step-number>1 / 9</small></span><button class="btn btn-primary" type="button" data-workspace-next><span data-workspace-next-label>Weiter</span>{{ icon('arrow-right') }}</button></div>
</div></div></div>
{% endblock %}
{% block javascripts %}{% include 'properties/_workspace_script.html.twig' %}<script src="/assets/property-ai.js" defer></script>{% endblock %}
