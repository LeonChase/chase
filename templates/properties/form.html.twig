{% extends 'base.html.twig' %}
{% import 'properties/_field.html.twig' as fields %}
{% block title %}{{ saved ? item.title : 'Immobilie anlegen' }}{% endblock %}
{% block breadcrumb %}Immobilien{% endblock %}
{% block stylesheets %}{% include 'properties/_workspace_styles.html.twig' %}<link rel="stylesheet" href="/assets/property-wizard.css">{% endblock %}
{% block body %}
{% set initialChapter = wizardPages[initialSection].chapter|default('start') %}
<div class="property-editor property-wizard">
 <div class="page-heading property-page-heading">
  <div class="property-title-line"><a class="icon-button" href="/properties" aria-label="Zur Immobilienübersicht">{{ icon('chevron-left') }}</a><h1>{{ saved ? item.title : 'Immobilie anlegen' }}</h1></div>
  <div class="property-heading-actions"><span class="property-save-notice" id="property-dirty-notice" role="status" hidden>Ungespeichert</span>{% if saved %}<span class="badge">{{ data.status|default('Entwurf') }}</span>{% endif %}<button type="submit" form="property-data-form" class="btn btn-primary">{{ icon('check') }}Speichern</button></div>
 </div>
 {% if errors %}<div class="alert alert-error property-validation" role="alert" tabindex="-1"><strong>Bitte die Angaben prüfen.</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
 <form method="post" action="{{ saved ? '/properties/' ~ item.id ~ '/edit' : '/properties/new' }}" id="property-data-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_activeStep" value="{{ initialSection }}" data-active-step-input></form>
 <div class="property-workspace" data-property-workspace data-initial-section="{{ initialSection }}" data-property-saved="{{ saved ? 'true' : 'false' }}" data-workspace-errors="{{ errors ? 'true' : 'false' }}" data-step-storage="chase-object-step:{{ app.user.id }}:{{ saved ? item.id : 'new' }}">
  <aside class="property-stepper">
   <span class="property-stepper-label">OBJEKTAKTE</span>
   <nav aria-label="Abschnitte der Objektaufnahme">{% for chapterKey,chapter in chapters %}<a href="?step={{ chapter.first }}#{{ chapter.first }}" data-workspace-step="{{ chapter.first }}" data-workspace-chapter="{{ chapterKey }}" class="{{ initialChapter == chapterKey ? 'active' }}"><span class="property-chapter-icon">{{ icon(chapter.icon) }}</span><strong>{{ chapter.title }}</strong><small>{{ '%02d'|format(loop.index) }}</small></a>{% endfor %}</nav>
   <div class="property-stepper-note">{% if saved %}<a href="?step=activity#activity" data-workspace-step="activity" class="property-history-link">{{ icon('clock') }}Verlauf</a><small>Stand {{ item.updatedAt|date('d.m.Y H:i','Europe/Berlin') }}</small>{% else %}<small>Neue Immobilie</small>{% endif %}</div>
  </aside>
  <div class="property-workspace-content">
   <div class="property-page-tabs" aria-label="Seiten im Abschnitt">{% for chapterKey,chapter in chapters %}<nav data-chapter-tabs="{{ chapterKey }}" aria-label="{{ chapter.title }}" {% if initialChapter != chapterKey %}hidden{% endif %}>{% for pageKey,page in wizardPages %}{% if page.chapter == chapterKey %}<a href="?step={{ pageKey }}#{{ pageKey }}" data-workspace-step="{{ pageKey }}" class="{{ initialSection == pageKey ? 'active' }}">{{ page.title }}</a>{% endif %}{% endfor %}</nav>{% endfor %}</div>
   {% for pageKey,page in wizardPages %}
   <section class="property-section" id="{{ pageKey }}" data-workspace-panel data-page-chapter="{{ page.chapter }}" {% if initialSection != pageKey %}hidden{% endif %}>
    <header class="property-section-heading"><div><span class="property-page-caption">{{ chapters[page.chapter].title }}</span><h2>{{ page.title }}</h2></div>{% if page.chapter == 'contacts' or pageKey == 'notes' %}<span class="property-private-label">{{ icon('lock') }}Intern</span>{% endif %}{% if pageKey == 'images' %}<span class="badge">{{ images|length }}</span>{% elseif pageKey == 'documents' %}<span class="badge">{{ documents|length }}</span>{% endif %}</header>
    <div class="property-section-body">
     {% if pageKey == 'equipment' %}<div class="property-feature-choices" aria-label="Ausstattung schnell ergänzen">{% for feature in ['Balkon','Terrasse','Garten','Gäste-WC','Einbauküche','Aufzug','Garage','Barrierearm'] %}<label><input type="checkbox" data-feature-chip value="{{ feature }}">{{ feature }}</label>{% endfor %}</div>{% endif %}
     {% if page.fields %}<div class="form-grid property-form-grid">{% for name,field in page.fields %}{{ fields.render(name,field,data) }}{% endfor %}</div>{% endif %}
     {% if pageKey == 'modernisations' %}{% include 'properties/_modernisations.html.twig' %}{% endif %}
     {% if pageKey in ['images','documents'] %}
      {% if saved %}<div class="property-panel-tools"><button type="button" class="btn btn-secondary btn-small" data-property-dialog="property-tool-{{ pageKey }}">{{ icon('sparkles') }}{{ pageKey == 'images' ? 'Bildwerkzeuge' : 'Unterlagen prüfen' }}</button></div>{% endif %}
      {% include 'properties/_media.html.twig' with {kind:pageKey == 'images' ? 'image' : 'document'} %}
      {% if saved %}<dialog id="property-tool-{{ pageKey }}" class="property-tool-dialog"><header><h2>{{ pageKey == 'images' ? 'Bildwerkzeuge' : 'Unterlagenprüfung' }}</h2><button type="button" class="icon-button" data-property-dialog-close aria-label="Werkzeug schließen">{{ icon('x') }}</button></header><div class="property-tool-dialog-body">{% include 'properties/_ai_tools.html.twig' with {section:pageKey} %}</div></dialog>{% endif %}
     {% elseif pageKey == 'pricing' %}<div class="property-price-shortcuts">{% if saved %}<a class="text-link" href="/properties/{{ item.id }}/valuation">{{ icon('house') }}Bewertung öffnen {{ icon('arrow-up-right') }}</a>{% else %}<button class="text-link" form="property-data-form" name="returnSection" value="pricing">Speichern & Bewertung öffnen {{ icon('arrow-right') }}</button>{% endif %}{% if valuations %}<span class="muted">{{ valuations|length }} gespeicherte Rechenstände</span>{% endif %}</div>
     {% elseif pageKey in ['texts','marketing'] %}
      {% if saved %}
       <div class="property-tool-launch"><span>{{ icon(pageKey == 'texts' ? 'file-text' : 'megaphone') }}</span><div><h3>{{ pageKey == 'texts' ? 'Dein Exposé aus den Objektfakten' : 'Deine Vermarktung vorbereiten' }}</h3><p>{{ pageKey == 'texts' ? 'Beschreibung, Ausstattung und Lage bearbeiten.' : 'Social-Beitrag und Bildersequenz zusammenstellen.' }}</p></div><button class="btn btn-primary" type="button" data-property-dialog="property-tool-{{ pageKey }}">{{ pageKey == 'texts' ? 'Texte öffnen' : 'Vermarktung öffnen' }}{{ icon('arrow-right') }}</button></div>
       {% set pagePosts = pageKey == 'texts' ? posts|filter(p => p.data.tool|default('') == 'property_expose') : posts|filter(p => p.data.tool|default('') == 'property_social') %}
       {% if pagePosts %}<div class="property-draft-cards">{% for post in pagePosts|slice(0,3) %}<button type="button" class="property-draft-card" data-property-dialog="property-tool-{{ pageKey }}">{{ icon('file-text') }}<span><strong>{{ post.title }}</strong><small>{{ post.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Version {{ post.data.version|default(1) }}</small></span>{{ icon('chevron-right') }}</button>{% endfor %}</div>{% endif %}
       <dialog id="property-tool-{{ pageKey }}" class="property-tool-dialog"><header><h2>{{ pageKey == 'texts' ? 'Exposé-Texte' : 'Vermarktung' }}</h2><button type="button" class="icon-button" data-property-dialog-close aria-label="Werkzeug schließen">{{ icon('x') }}</button></header><div class="property-tool-dialog-body">{% include 'properties/_ai_tools.html.twig' with {section:pageKey} %}{% if pageKey == 'texts' %}{% for post in posts|filter(p => p.data.tool|default('') not in ['property_expose','property_social']) %}<article class="property-saved-text"><h3>{{ post.title }}</h3><p>{{ post.data.content|default(post.data.text|default(post.data.body|default('')))|nl2br }}</p></article>{% endfor %}{% endif %}</div></dialog>
      {% else %}<div class="property-inline-empty">{{ icon('file-text') }}<div><strong>Die Objektfakten zuerst speichern.</strong><button class="btn btn-secondary" form="property-data-form" name="returnSection" value="{{ pageKey }}">Speichern & öffnen {{ icon('arrow-right') }}</button></div></div>{% endif %}
     {% elseif pageKey == 'review' %}
      <div class="property-review-grid"><div><input type="hidden" form="property-data-form" name="readyForReview" value="0"><label class="property-check"><input form="property-data-form" type="checkbox" name="readyForReview" value="1" {{ data.readyForReview|default(false) ? 'checked' }}>Zur internen Prüfung vorbereitet</label>{% if saved %}<a class="text-link" href="/messages?property={{ item.id }}">{{ icon('message-circle') }}Intern abstimmen</a>{% endif %}
      {% if saved %}<form method="post" action="/properties/{{ item.id }}/checklist" data-object-action class="property-review-checks"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="_workspace" value="1">{% for check in checklist %}<label class="property-check"><input type="checkbox" name="checks[]" value="{{ check }}" {{ check in item.data.checklist|default([]) ? 'checked' }}>{{ check }}</label>{% endfor %}<button class="btn btn-secondary btn-small">Checkliste speichern</button></form>{% endif %}</div>
      <div><h3>Aufgaben</h3>{% for task in tasks|slice(0,4) %}<a class="property-task-link" href="/tasks?task={{ task.id }}"><span>{{ task.title }}</span>{{ icon('chevron-right') }}</a>{% else %}<p class="muted">Keine verknüpften Aufgaben.</p>{% endfor %}{% if saved %}<a class="text-link" href="/tasks/new?property={{ item.id }}">{{ icon('plus') }}Aufgabe anlegen</a>{% endif %}</div></div>
      <small class="property-private-note">{{ icon('lock') }}Nur interne Vorbereitung. Kein automatisches Veröffentlichen.</small>
     {% endif %}
    </div>
   </section>
   {% endfor %}
   {% if saved %}<section class="property-section property-history" id="activity" data-workspace-panel data-page-chapter="activity" {% if initialSection != 'activity' %}hidden{% endif %}><header class="property-section-heading"><div><h2>Verlauf</h2></div></header><div class="property-section-body">{% for activity in activities|slice(0,20) %}<p class="property-activity"><small>{{ activity.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</small><span>{{ activity.title }}</span></p>{% else %}<p>Noch keine Änderungen.</p>{% endfor %}{% if item.data.externalId|default('') %}<p class="property-private-note">CRM: {{ item.data.externalId }} · Demo, keine Live-Verbindung.</p>{% endif %}<form method="post" action="/properties/{{ item.id }}/archive" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Immobilie archivieren</button></form></div></section>{% endif %}
   <div class="property-step-controls"><button class="btn btn-secondary" type="button" data-workspace-prev>{{ icon('chevron-left') }}Zurück</button><span class="property-step-status" aria-live="polite"><strong data-current-step-label>{{ wizardPages[initialSection].title|default('Start') }}</strong><small data-current-step-number></small></span><button class="btn btn-primary" type="button" data-workspace-next><span data-workspace-next-label>Weiter</span>{{ icon('arrow-right') }}</button></div>
  </div>
 </div>
</div>
{% endblock %}
{% block javascripts %}{% include 'properties/_workspace_script.html.twig' %}<script src="/assets/property-ai.js" defer></script>{% endblock %}
