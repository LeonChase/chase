<script>
(()=>{
const workspace=document.querySelector('[data-property-workspace]'),form=document.getElementById('property-data-form');if(!workspace||!form)return;
const panels=[...workspace.querySelectorAll('[data-workspace-panel]')],links=[...workspace.querySelectorAll('[data-workspace-step]')],mainSteps=['start','base','equipment','condition','images','documents','pricing','texts','marketing'];
const notice=document.getElementById('property-dirty-notice'),activeInput=form.querySelector('[data-active-step-input]'),previous=workspace.querySelector('[data-workspace-prev]'),next=workspace.querySelector('[data-workspace-next]');let dirty=false,leaving=false,active='start';
const valid=id=>panels.some(panel=>panel.id===id);
const changed=()=>{dirty=true;if(notice){notice.hidden=false;notice.textContent='Ungespeichert';}};
const requireSaved=()=>{if(!dirty)return true;if(notice){notice.hidden=false;notice.textContent='Bitte erst speichern';}document.querySelector('.property-heading-actions button[form="property-data-form"]')?.focus({preventScroll:true});return false;};
window.chasePropertyHasUnsavedChanges=()=>dirty;window.chaseEnsurePropertySaved=requireSaved;
const show=(id,{historyMode='none',focus=false}={})=>{
 if(!valid(id))id='start';active=id;
 panels.forEach(panel=>{panel.hidden=panel.id!==id;panel.setAttribute('aria-hidden',panel.hidden?'true':'false');});
 links.forEach(link=>{const current=link.dataset.workspaceStep===id;link.classList.toggle('active',current);if(current)link.setAttribute('aria-current','step');else link.removeAttribute('aria-current');if(current&&link.parentElement.tagName==='NAV'){const nav=link.parentElement,a=link.getBoundingClientRect(),b=nav.getBoundingClientRect();if(a.left<b.left||a.right>b.right)nav.scrollLeft+=a.left-b.left-(b.width-a.width)/2;}});
 if(activeInput)activeInput.value=id;
 const index=mainSteps.indexOf(id),label=panels.find(panel=>panel.id===id)?.querySelector('h2')?.textContent||id;
 workspace.querySelector('[data-current-step-label]').textContent=label;workspace.querySelector('[data-current-step-number]').textContent=index<0?'':`${index+1} / ${mainSteps.length}`;
 if(previous)previous.disabled=index===0;if(next)next.querySelector('[data-workspace-next-label]').textContent=index===mainSteps.length-1?'Speichern':(index<0?'Zum Start':'Weiter');
 if(workspace.dataset.propertySaved==='true'){try{localStorage.setItem(workspace.dataset.stepStorage,id);}catch(e){}}
 if(historyMode!=='none'){const url=new URL(location.href);url.hash=id;url.searchParams.set('step',id);url.searchParams.delete('tab');history[historyMode==='push'?'pushState':'replaceState']({propertyStep:id},'',url);}
 if(focus){const heading=panels.find(panel=>panel.id===id)?.querySelector('.property-section-heading');if(heading){heading.tabIndex=-1;heading.focus({preventScroll:true});}}
};
const fromUrl=()=>{let id='';try{id=decodeURIComponent(location.hash.slice(1));}catch(e){}if(valid(id))return id;const query=new URLSearchParams(location.search);if(valid(query.get('step')))return query.get('step');if(query.has('tab'))return workspace.dataset.initialSection||'start';if(workspace.dataset.propertySaved==='true'){try{id=localStorage.getItem(workspace.dataset.stepStorage)||'';}catch(e){}}return valid(id)?id:(workspace.dataset.initialSection||'start');};
show(workspace.dataset.workspaceErrors==='true'?workspace.dataset.initialSection:fromUrl(),{historyMode:'replace'});
workspace.addEventListener('click',event=>{const link=event.target.closest('[data-workspace-step]');if(link&&valid(link.dataset.workspaceStep)){event.preventDefault();show(link.dataset.workspaceStep,{historyMode:'push'});}});
workspace.querySelector('.property-stepper')?.addEventListener('keydown',event=>{if(!event.target.matches('[data-workspace-step]')||!['ArrowDown','ArrowUp','ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();let index=links.indexOf(event.target);index=event.key==='Home'?0:(event.key==='End'?links.length-1:(index+(event.key==='ArrowDown'||event.key==='ArrowRight'?1:-1)+links.length)%links.length);links[index].focus({preventScroll:true});show(links[index].dataset.workspaceStep,{historyMode:'push'});});
previous?.addEventListener('click',()=>{const index=mainSteps.indexOf(active);show(index<0?'marketing':mainSteps[Math.max(0,index-1)],{historyMode:'push',focus:true});});
next?.addEventListener('click',()=>{const index=mainSteps.indexOf(active);if(index===mainSteps.length-1)form.requestSubmit();else show(index<0?'start':mainSteps[index+1],{historyMode:'push',focus:true});});
window.addEventListener('popstate',()=>show(fromUrl()));window.addEventListener('hashchange',()=>show(fromUrl()));
document.addEventListener('input',event=>{if(event.target.form===form)changed();});document.addEventListener('change',event=>{if(event.target.form===form)changed();});
document.addEventListener('submit',event=>{if(event.target===form){leaving=true;return;}if(workspace.contains(event.target)){if(!requireSaved()){event.preventDefault();event.stopImmediatePropagation();}else leaving=true;}},true);
window.addEventListener('beforeunload',event=>{if(dirty&&!leaving){event.preventDefault();event.returnValue='';}});
document.addEventListener('invalid',event=>{if(event.target.form!==form)return;const panel=event.target.closest('[data-workspace-panel]');if(panel)show(panel.id,{historyMode:'replace'});let node=event.target.closest('details');while(node){node.open=true;node=node.parentElement.closest('details');}},true);
const featureText=document.getElementById('property-features');if(featureText){const chips=[...workspace.querySelectorAll('[data-feature-chip]')],read=()=>featureText.value.split(/[\n\r,]+/).map(s=>s.trim()).filter(Boolean);const refresh=()=>{const selected=read().map(s=>s.toLocaleLowerCase('de'));chips.forEach(chip=>chip.checked=selected.includes(chip.value.toLocaleLowerCase('de')));};refresh();featureText.addEventListener('input',refresh);chips.forEach(chip=>chip.addEventListener('change',()=>{let selected=read().filter(s=>s.toLocaleLowerCase('de')!==chip.value.toLocaleLowerCase('de'));if(chip.checked)selected.push(chip.value);featureText.value=selected.join('\n');featureText.dispatchEvent(new Event('input',{bubbles:true}));}));}
const rows=workspace.querySelector('[data-modernisation-rows]'),add=workspace.querySelector('[data-add-modernisation]'),template=document.getElementById('modernisation-row-template');let nextRow=rows?Math.max(0,...[...rows.querySelectorAll('[name]')].map(el=>Number(el.name.match(/modernisations\[(\d+)\]/)?.[1]||0)))+1:0;
const updateLimit=()=>{if(add)add.disabled=rows.children.length>=12;};if(rows&&add&&template){updateLimit();add.addEventListener('click',()=>{if(rows.children.length>=12)return;rows.insertAdjacentHTML('beforeend',template.innerHTML.replaceAll('__INDEX__',String(nextRow++)));updateLimit();changed();rows.lastElementChild.querySelector('select')?.focus();});rows.addEventListener('click',event=>{const remove=event.target.closest('[data-remove-modernisation]');if(remove){remove.closest('tr').remove();updateLimit();changed();}});}
})();
</script>
