{% if saved|default(false) %}
<div class="property-ai-tools" data-property-ai-section="{{ section }}">
{% if section == 'texts' %}
<div class="property-ai-intro"><div><span class="badge">Aus deinen gespeicherten Fakten</span><h3>Drei Abschnitte. Ein einheitliches Exposé.</h3><p class="muted">Objektbeschreibung, Ausstattung und Lage folgen festen Vorlagen. Je Abschnitt höchstens 2.000 Zeichen. Nur fachlich bestätigte Bildbeschriftungen ergänzen die Objektdaten – die Bilder selbst werden nicht analysiert.</p></div><form method="post" action="{{ path('property_ai_generate',{id:item.id}) }}" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-primary">{{ icon('sparkles') }}Drei Exposé-Texte vorbereiten</button><small class="muted" style="display:block;margin-top:8px">Lokale Textvorlage · 1 Demo-Credit · 0,00 € externe Kosten</small></form></div>
{% set aiTextPosts = posts|default([])|filter(p => p.data.tool|default('') == 'property_expose') %}
{% for post in aiTextPosts %}
<details class="property-ai-draft" {{ loop.first ? 'open' : '' }}><summary><strong>{{ loop.first ? 'Aktueller Exposé-Entwurf' : 'Weiterer Exposé-Entwurf' }}</strong><span class="badge">Version {{ post.data.version|default(1) }} · {{ post.data.status|default('Entwurf') }}</span></summary>
<form method="post" action="{{ path('property_ai_save',{id:item.id,postId:post.id}) }}" class="stack" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">
{% for key,label in {description:'Objektbeschreibung',equipment:'Ausstattung',location:'Lagebeschreibung'} %}<div class="field"><div class="toolbar"><label for="{{ key }}-{{ post.id }}">{{ label }}</label><small class="muted" data-character-count-for="{{ key }}-{{ post.id }}">{{ post.data.sections[key]|default('')|length }} / 2.000</small></div><textarea id="{{ key }}-{{ post.id }}" name="{{ key }}" rows="8" maxlength="2000" required data-property-text>{{ post.data.sections[key]|default('') }}</textarea><button class="text-link" type="button" data-copy-target="{{ key }}-{{ post.id }}">Text kopieren</button></div>{% endfor %}
<label class="property-check"><input type="checkbox" name="approved" value="1" {{ post.data.approved|default(false) ? 'checked' }}>Ich habe die Angaben fachlich geprüft und gebe diese Version frei.</label><div class="toolbar"><button class="btn btn-primary">Neue Textversion speichern</button><a class="btn btn-secondary" href="{{ path('studio_pdf',{id:post.id}) }}">PDF · Demo-Muster</a><a class="text-link" href="{{ path('studio_export',{id:post.id}) }}">Markdown</a></div></form>
<details><summary>Quellen & Versionsverlauf</summary><p class="muted">Quelle: gespeicherte Objektakte zum Erstellungszeitpunkt. Keine Übernahme von Eigentümerkontakten oder internen Notizen. Energieangaben und gesetzliche Pflichtangaben vor Vermarktung gesondert prüfen.</p>{% for source in post.data.source.confirmedImageCaptions|default([]) %}<p><strong>Manuell bestätigte Bildbeschriftung:</strong> {{ source.caption }}</p>{% else %}<p class="muted">Keine bestätigte Bildbeschriftung als Quelle verwendet.</p>{% endfor %}{% for version in post.data.versions|default([])|reverse %}<details><summary>Version {{ version.number }} · {{ version.time|date('d.m.Y H:i','Europe/Berlin') }} · {{ version.approved ? 'Freigegeben' : 'Entwurf' }}</summary><p style="white-space:pre-wrap;overflow-wrap:anywhere">{{ version.text }}</p></details>{% endfor %}</details></details>
{% else %}<p class="muted">Noch keine objektbezogenen Exposé-Texte. Speichere zuerst deine Eckdaten und bestätige passende Bildbeschriftungen.</p>{% endfor %}

{% elseif section == 'images' %}
<details class="property-ai-draft"><summary><strong>{{ icon('sparkles') }}Bildoptimierung & Home Staging</strong><span class="badge">Lokal ansehen · API vorbereiten</span></summary>
<p class="muted">Wähle Originalbilder aus der Objektakte. Helligkeit und Kontrast funktionieren direkt in der Bildschirmvorschau. Die übrigen Bearbeitungen werden ausschließlich als gewünschter Workflow gespeichert.</p>
<form method="post" action="{{ path('property_media_workflow',{id:item.id}) }}" class="stack" data-object-action data-image-workflow><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">
<div class="property-ai-media-picker">{% for image in images %}<label class="property-ai-media-choice"><input type="checkbox" name="mediaIds[]" value="{{ image.id }}" data-source-url="/media/{{ image.id }}" data-source-label="{{ image.title }}"><img src="/media/{{ image.id }}" alt="{{ image.title }}" loading="lazy"><span>{{ image.title }}</span></label>{% else %}<p class="muted">Lade oben zuerst eigene Originalbilder hoch.</p>{% endfor %}</div>
<div class="form-grid"><div class="field"><label for="image-brightness-{{ item.id }}">Helligkeit der Vorschau</label><input id="image-brightness-{{ item.id }}" type="range" min="60" max="140" name="brightness" value="100" data-local-brightness><small data-brightness-label>100 %</small></div><div class="field"><label for="image-contrast-{{ item.id }}">Kontrast der Vorschau</label><input id="image-contrast-{{ item.id }}" type="range" min="60" max="140" name="contrast" value="100" data-local-contrast><small data-contrast-label>100 %</small></div></div>
<div data-local-image-preview class="property-ai-preview"><p class="muted">Ausgewählte Bilder erscheinen hier. Das gespeicherte Original bleibt unverändert.</p></div>
<div class="form-grid"><div class="field"><label for="image-workflow-type-{{ item.id }}">Gewünschte Vorbereitung</label><select name="type" id="image-workflow-type-{{ item.id }}"><option value="image">Bildoptimierung</option><option value="staging">Virtuelles Home Staging</option></select></div></div>
<fieldset class="property-ai-options"><legend>Gewünschte Bildbearbeitung</legend>{% for value,label in {brightness:'Helligkeit',contrast:'Kontrast',redact_people:'Personen unkenntlich machen · API fehlt',redact_personal:'Persönliche Gegenstände unkenntlich machen · API fehlt',sky:'Grauen Himmel austauschen · API fehlt',perspective:'Perspektive korrigieren · API fehlt'} %}<label class="property-check"><input type="checkbox" name="actions[]" value="{{ value }}">{{ label }}</label>{% endfor %}</fieldset>
<fieldset class="property-ai-options"><legend>Einrichtungsstil für Home Staging</legend>{% for value,label in {modern:'Modern',scandinavian:'Skandinavisch',minimal:'Minimalistisch',classic:'Klassisch'} %}<label class="property-check"><input type="checkbox" name="styles[]" value="{{ value }}">{{ label }}</label>{% endfor %}</fieldset>
<p class="muted">Keine baulichen Veränderungen oder erfundenen Maße. Spätere generierte Varianten müssen ausdrücklich als Visualisierung / KI-Generierung gekennzeichnet werden. Hier wird keine generierte Variante erzeugt.</p><button class="btn btn-secondary" {{ not images ? 'disabled' }}>Auswahl & gewünschten Workflow speichern</button></form></details>

{% elseif section == 'documents' %}
<details class="property-ai-draft"><summary><strong>{{ icon('sparkles') }}Grundriss & Dokumentenprüfung</strong><span class="badge">Originalbasiert · manuelle Prüfhilfe</span></summary>
<p class="muted">Grundrissvorbereitung benötigt einen hochgeladenen Grundriss oder eine Skizze mit entsprechender Kategorie. Es werden keine neuen Maße erfunden. Dokumente werden weder automatisch ausgelesen noch geschwärzt oder durch KI umbenannt.</p>
<form method="post" action="{{ path('property_media_workflow',{id:item.id}) }}" class="stack" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="document-workflow-{{ item.id }}">Vorbereitung</label><select id="document-workflow-{{ item.id }}" name="type"><option value="doccheck">Manuelle Dokumentenprüfung</option><option value="groundplan">CHASE-Grundriss vorbereiten · API fehlt</option><option value="redaction">Sensible Inhalte / Schwärzung vorbereiten · API fehlt</option></select></div>
<fieldset class="property-ai-options"><legend>Originalunterlagen auswählen</legend>{% for document in documents %}<label class="property-check"><input type="checkbox" name="mediaIds[]" value="{{ document.id }}"><span>{{ document.title }} <small class="muted">· {{ document.data.category|default('Sonstiges') }}</small></span></label>{% else %}<p class="muted">Lade oben eine Originalunterlage hoch und ordne die passende Kategorie zu.</p>{% endfor %}</fieldset>
<fieldset class="property-ai-options"><legend>Manuell von dir geprüft</legend>{% for value,label in {complete:'Dokument auf Vollständigkeit geprüft',property:'Objektbezug mit dem Original abgeglichen',energy:'Energieangaben anhand der Quelle geprüft',sensitive:'Sensible Daten identifiziert',expert:'Fachliche Prüfung / offene Rechtsfragen vermerkt'} %}<label class="property-check"><input type="checkbox" name="checks[]" value="{{ value }}">{{ label }}</label>{% endfor %}</fieldset><div class="field"><label for="document-notes-{{ item.id }}">Prüfnotiz / Quelle / Seitenzahl</label><textarea id="document-notes-{{ item.id }}" name="notes" maxlength="2000" rows="3" placeholder="Eigene Prüfergebnisse und offene Punkte; keine automatische Auswertung."></textarea></div>
<p class="muted">Keine Rechtsberatung und keine verlässliche Schwärzung: Eine grafische schwarze Box entfernt keine Inhalte. Das Original bleibt erhalten. Anzeigenamen und Kategorien kannst du direkt an der Datei manuell ändern.</p><button class="btn btn-secondary" {{ not documents ? 'disabled' }}>Auswahl & Prüfschritte lokal speichern</button></form></details>

{% elseif section == 'marketing' %}
<div class="property-ai-intro"><div><h3>Aus der Objektakte in die Vermarktung.</h3><p class="muted">Kurzer Beitrag aus gespeicherten Fakten und ausgewählten Bildern. Veröffentlichung, Bildgenerierung und Videoexport benötigen eine eingerichtete externe Anbindung.</p></div><a class="btn btn-secondary" href="/messages?property={{ item.id }}">{{ icon('message-circle') }}Intern zur Prüfung senden</a></div>
<form method="post" action="{{ path('property_social_generate',{id:item.id}) }}" class="stack" data-object-action data-social-workflow><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="property-ai-media-picker">{% for image in images %}<label class="property-ai-media-choice"><input type="checkbox" name="mediaIds[]" value="{{ image.id }}" data-source-url="/media/{{ image.id }}" data-source-label="{{ image.title }}"><img src="/media/{{ image.id }}" alt="{{ image.title }}" loading="lazy"><span>{{ image.title }}</span></label>{% endfor %}</div><div class="toolbar"><div class="field"><label for="social-channel-{{ item.id }}">Kanal für den Entwurf</label><select id="social-channel-{{ item.id }}" name="channel"><option>Instagram</option><option>Facebook</option><option>LinkedIn</option></select></div><button class="btn btn-primary">{{ icon('sparkles') }}Kurzen CHASE-Beitrag erstellen</button></div><small class="muted">1 Demo-Credit · Kein automatisches Veröffentlichen, kein Versand an Interessenten.</small><div data-object-storyboard class="property-ai-preview"><p class="muted">Bilder auswählen, um die echte lokale Sequenzvorschau zu sehen.</p></div><div class="toolbar"><button class="btn btn-secondary" type="button" data-storyboard-play disabled>Bildersequenz ansehen</button><button class="btn btn-secondary" type="submit" formaction="{{ path('property_media_workflow',{id:item.id}) }}" name="type" value="storyboard" {{ not images ? 'disabled' }}>Storyboard-Auswahl speichern</button></div><p class="muted">Nur eine lokale Bildersequenz. Kein echtes Reel und kein Videoexport. Originale bleiben unverändert.</p></form>
{% for post in posts|default([])|filter(p=>p.data.tool|default('')=='property_social') %}<details class="property-ai-draft" {{ loop.first ? 'open' : '' }}><summary><strong>Social-Entwurf · {{ post.data.channel|default('Instagram') }}</strong><span class="badge">{{ post.data.status|default('Entwurf') }} · Version {{ post.data.version|default(1) }}</span></summary><form method="post" action="{{ path('property_social_save',{id:item.id,postId:post.id}) }}" class="stack" data-object-action><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="social-caption-{{ post.id }}">Beitragstext</label><textarea name="caption" id="social-caption-{{ post.id }}" rows="6" maxlength="2000" required>{{ post.data.caption }}</textarea></div><label class="property-check"><input type="checkbox" name="approved" value="1" {{ post.data.approved|default(false) ? 'checked' }}>Text und Bildrechte manuell geprüft</label><div class="toolbar"><button class="btn btn-secondary">Beitragsversion speichern</button><button class="text-link" type="button" data-copy-target="social-caption-{{ post.id }}">Kopieren</button></div></form><p class="muted">{{ post.data.mediaIds|default([])|length }} Originalbild(er) verknüpft. Nicht veröffentlicht.</p></details>{% endfor %}
<p class="muted">Eine interne Nachricht gibt keine neuen Objektberechtigungen. Der gewählte Empfänger muss bereits ausdrücklich Zugriff auf diese Objektakte haben.</p>
{% endif %}

{% set sectionTypes = section == 'images' ? ['image','staging'] : (section == 'documents' ? ['groundplan','doccheck','redaction'] : (section == 'marketing' ? ['storyboard'] : [])) %}
{% set jobs = aiWorkflows|default([])|filter(job=>job.data.type|default('') in sectionTypes) %}
{% if jobs %}<details class="property-ai-draft"><summary>Gespeicherte Vorbereitungen <span class="badge">{{ jobs|length }}</span></summary>{% for job in jobs %}<article style="padding:14px 0;border-bottom:1px solid var(--border)"><strong>{{ job.title }}</strong><small class="muted" style="display:block">{{ job.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · {{ job.data.status }}</small><p>{% for source in job.data.sources %}{{ source.title }}{{ not loop.last ? ' · ' : '' }}{% endfor %}</p>{% set actionLabels = {brightness:'Helligkeit',contrast:'Kontrast',redact_people:'Personen unkenntlich machen',redact_personal:'Persönliches unkenntlich machen',sky:'Himmel austauschen',perspective:'Perspektive korrigieren'} %}{% if job.data.actions|default([]) %}<p>Gewünscht: {% for action in job.data.actions %}{{ actionLabels[action]|default(action) }}{{ not loop.last ? ', ' : '' }}{% endfor %}. Bildschirmvorschau: {{ job.data.brightness|default(100) }} % Helligkeit, {{ job.data.contrast|default(100) }} % Kontrast.</p>{% endif %}{% set styleLabels = {modern:'Modern',scandinavian:'Skandinavisch',minimal:'Minimalistisch',classic:'Klassisch'} %}{% if job.data.styles|default([]) %}<p>Stil: {% for style in job.data.styles %}{{ styleLabels[style]|default(style) }}{{ not loop.last ? ', ' : '' }}{% endfor %}.</p>{% endif %}{% if job.data.manualChecks|default([]) %}<p class="muted">{{ job.data.manualChecks|length }} Prüfschritt(e) manuell abgehakt. Keine automatische Dokumentenanalyse.</p>{% endif %}{% if job.data.notes|default('') %}<p style="white-space:pre-wrap">{{ job.data.notes }}</p>{% endif %}<span class="badge">Originale erhalten · keine externe Verarbeitung</span></article>{% endfor %}</details>{% endif %}
<span class="muted" data-property-ai-feedback aria-live="polite"></span>
</div>
{% endif %}
