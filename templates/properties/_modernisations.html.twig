<div class="property-modernisation">
 <input form="property-data-form" type="hidden" name="modernisations_present" value="1">
 {% set rows = data.modernisations|default([]) %}{% if rows is empty %}{% set rows = [{'component':'Fenster','year':'','details':''}] %}{% endif %}
 <div class="property-modernisation-toolbar"><div class="property-modernisation-pages"><button type="button" class="icon-button" data-modernisation-prev aria-label="Vorherige Maßnahme">{{ icon('chevron-left') }}</button><span data-modernisation-position>1 / {{ rows|length }}</span><button type="button" class="icon-button" data-modernisation-next aria-label="Nächste Maßnahme">{{ icon('chevron-right') }}</button></div><button type="button" class="btn btn-secondary btn-small" data-add-modernisation>{{ icon('plus') }}Maßnahme hinzufügen</button></div>
 <div data-modernisation-rows>{% for row in rows %}<div class="property-modernisation-card" data-modernisation-row {% if not loop.first %}hidden{% endif %}><div class="form-grid"><div class="field"><label for="modernisation-component-{{ loop.index0 }}">Bauteil</label><select form="property-data-form" id="modernisation-component-{{ loop.index0 }}" name="modernisations[{{ loop.index0 }}][component]">{% for component in modernisationComponents %}<option {{ row.component|default('') == component ? 'selected' }}>{{ component }}</option>{% endfor %}</select></div><div class="field"><label for="modernisation-year-{{ loop.index0 }}">Jahr</label><input form="property-data-form" id="modernisation-year-{{ loop.index0 }}" type="number" name="modernisations[{{ loop.index0 }}][year]" value="{{ row.year|default('') }}" min="1900" max="{{ 'now'|date('Y') + 5 }}" step="1" placeholder="Jahr"></div><div class="field property-field-wide"><label for="modernisation-details-{{ loop.index0 }}">Maßnahme / Quelle</label><textarea form="property-data-form" id="modernisation-details-{{ loop.index0 }}" name="modernisations[{{ loop.index0 }}][details]" maxlength="1000" rows="3" placeholder="Zum Beispiel Fenster erneuert; Eigentümerangabe">{{ row.details|default('') }}</textarea></div></div><button class="text-link" type="button" data-remove-modernisation>{{ icon('trash') }}Maßnahme entfernen</button></div>{% endfor %}</div>
 <template id="modernisation-row-template"><div class="property-modernisation-card" data-modernisation-row><div class="form-grid"><div class="field"><label for="modernisation-component-__INDEX__">Bauteil</label><select form="property-data-form" id="modernisation-component-__INDEX__" name="modernisations[__INDEX__][component]">{% for component in modernisationComponents %}<option>{{ component }}</option>{% endfor %}</select></div><div class="field"><label for="modernisation-year-__INDEX__">Jahr</label><input form="property-data-form" id="modernisation-year-__INDEX__" type="number" name="modernisations[__INDEX__][year]" min="1900" max="{{ 'now'|date('Y') + 5 }}" step="1" placeholder="Jahr"></div><div class="field property-field-wide"><label for="modernisation-details-__INDEX__">Maßnahme / Quelle</label><textarea form="property-data-form" id="modernisation-details-__INDEX__" name="modernisations[__INDEX__][details]" maxlength="1000" rows="3"></textarea></div></div><button class="text-link" type="button" data-remove-modernisation>{{ icon('trash') }}Maßnahme entfernen</button></div></template>
</div>
