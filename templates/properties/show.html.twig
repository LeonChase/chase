{% extends 'base.html.twig' %}
{% block title %}{{ item.title }} · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><a class="muted" href="/properties">← Meine Immobilien</a><h1>{{ item.title }}</h1><p class="muted">{{ item.data.propertyType|default('Immobilie') }} · {{ item.data.city|default('Ort fehlt') }} · {{ item.data.internalId|default(item.id) }}</p></div><div class="toolbar"><span class="badge">{{ item.data.status|default('Entwurf') }}</span><a href="/properties/{{ item.id }}/edit" class="btn btn-secondary">Bearbeiten</a></div></div>
<div class="card toolbar" style="justify-content:space-between"><span>Dein nächster Schritt: aus Fakten gute Inhalte machen.</span><div class="toolbar"><a class="btn btn-primary" href="/studio?property={{ item.id }}">Exposé erstellen</a><a class="btn btn-secondary" href="/marketing/new?property={{ item.id }}">Social Post erstellen</a><a class="btn btn-secondary" href="/tasks/new?property={{ item.id }}">+ Aufgabe</a></div></div>
<nav class="tabs" aria-label="Objektbereiche">{% for key,label in {'overview':'Übersicht','media':'Medien','documents':'Dokumente','texts':'KI & Texte','marketing':'Vermarktung','checklist':'Checkliste','activity':'Aktivitäten'} %}<a href="/properties/{{ item.id }}?tab={{ key }}" class="{{ tab == key ? 'active' }}" {% if tab == key %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>
{% if tab == 'overview' %}
<section class="card" style="margin-bottom:24px"><h2>Deine Objektpipeline</h2><div class="toolbar" style="margin-bottom:20px">{% for status in statuses %}<span class="badge" style="{{ item.data.status|default('Entwurf') == status ? 'background:var(--orange,#ff6a00);color:#fff' }}">{{ status }}</span>{% if not loop.last %}<span class="muted" aria-hidden="true">→</span>{% endif %}{% endfor %}</div><form method="post" action="/properties/{{ item.id }}/status" class="toolbar"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="pipeline-status">Status aktualisieren</label><select id="pipeline-status" name="status">{% for status in statuses %}<option {{ item.data.status|default('Entwurf') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><button class="btn btn-secondary">Status speichern</button></form><p class="muted">Interne Planung. Keine automatische Veröffentlichung.</p></section>
<div class="grid grid-3">{% for label,value in {'Wohnfläche':item.data.areaSqm|default(null) ? item.data.areaSqm|number_format(0,',','.') ~ ' m²' : 'Angabe fehlt','Zimmer':item.data.rooms|default('Angabe fehlt'),'Preis':item.data.priceEur|default(null) ? item.data.priceEur|number_format(0,',','.') ~ ' €' : 'Angabe fehlt'} %}<div class="card"><p class="muted">{{ label }}</p><h2>{{ value }}</h2></div>{% endfor %}</div>
<div class="grid grid-2" style="margin-top:24px"><section class="card"><h2>Die Fakten</h2><dl>{% for field,label in {'marketingType':'Vermarktung','region':'Region','district':'Stadtteil','address':'Adresse (intern)','condition':'Zustand','yearBuilt':'Baujahr','usableAreaSqm':'Nutzfläche (m²)','plotSqm':'Grundstück (m²)','rentEur':'Kaltmiete (EUR)','energyData':'Energieangaben','dataSharing':'Datenfreigabe','source':'Quelle'} %}<div style="display:flex;justify-content:space-between;gap:20px;padding:10px 0;border-bottom:1px solid var(--border,#eee)"><dt class="muted">{{ label }}</dt><dd style="margin:0;text-align:right">{{ attribute(item.data,field)|default('Angabe fehlt') }}</dd></div>{% endfor %}</dl><p class="muted">Erfasst {{ item.createdAt|date('d.m.Y H:i', 'Europe/Berlin') }} · zuletzt aktualisiert {{ item.updatedAt|date('d.m.Y H:i', 'Europe/Berlin') }}</p></section><div class="stack"><section class="card"><h2>Ausstattung & Highlights</h2><div class="toolbar">{% for feature in item.data.features|default([]) %}<span class="badge">{{ feature }}</span>{% else %}<p class="muted">Noch keine Ausstattung erfasst.</p>{% endfor %}</div><ul>{% for point in item.data.sellingPoints|default([]) %}<li>{{ point }}</li>{% endfor %}</ul><h3>Interne Notiz</h3><p style="white-space:pre-line">{{ item.data.notes|default('Noch keine Notiz hinterlegt.') }}</p></section><section class="card"><h2>Aufgaben zu diesem Objekt</h2>{% for task in tasks %}<p><a href="/tasks/{{ task.id }}/edit">{{ task.title }}</a> <span class="badge">{{ task.data.status|default('Offen') }}</span></p>{% else %}<p class="muted">Noch keine Aufgabe verknüpft.</p>{% endfor %}<a href="/tasks/new?property={{ item.id }}">Aufgabe anlegen →</a></section></div></div>
{% if item.data.status|default('') != 'Archiviert' %}<form method="post" action="/properties/{{ item.id }}/archive" style="margin-top:24px"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Objekt archivieren</button></form>{% endif %}
{% elseif tab in ['media','documents'] %}
<section class="card"><h2>{{ tab == 'documents' ? 'Private Objektdokumente' : 'Deine Medienbibliothek' }}</h2><p class="muted">JPG, PNG, WebP oder PDF · maximal 8 MB je Datei · private Speicherung mit Zugriffsprüfung. Kein externer Upload.</p><form method="post" action="/properties/{{ item.id }}/media" enctype="multipart/form-data" class="toolbar"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="media">Datei auswählen</label><input type="file" id="media" name="media" accept=".jpg,.jpeg,.png,.webp,.pdf" required></div><button class="btn btn-primary">Privat hochladen</button></form></section>
<div class="grid grid-3" style="margin-top:24px">{% set shown = 0 %}{% for asset in media %}{% if tab == 'media' or asset.data.mime == 'application/pdf' %}{% set shown = shown + 1 %}<article class="card">{% if asset.data.mime starts with 'image/' %}<a href="/media/{{ asset.id }}"><img src="/media/{{ asset.id }}" alt="{{ asset.title }}" style="width:100%;height:180px;object-fit:cover;border-radius:10px" loading="lazy"></a>{% else %}<div class="badge">PDF · privates Original</div>{% endif %}<h3>{{ asset.title }}</h3><p class="muted">{{ (asset.data.size / 1024)|number_format(0,',','.') }} KB · {{ asset.createdAt|date('d.m.Y') }}</p><a href="/media/{{ asset.id }}">{{ asset.data.mime == 'application/pdf' ? 'Datei herunterladen' : 'Original ansehen' }} →</a></article>{% endif %}{% endfor %}{% if shown == 0 %}<div class="card empty-state"><h3>Hier ist Platz für deine Dateien.</h3><p>Originale bleiben privat und unverändert erhalten.</p></div>{% endif %}</div>
{% elseif tab == 'texts' %}
<section class="card"><div class="page-heading"><div><h2>Gespeicherte Texte & Versionen</h2><p class="muted">Regelbasierte Demo-Ergebnisse. Vor Verwendung fachlich prüfen und freigeben.</p></div><a class="btn btn-primary" href="/studio?property={{ item.id }}">Neuen Text erstellen</a></div>{% for post in posts %}<article style="border-top:1px solid var(--border,#eee);padding:20px 0"><h3><a href="/studio/content/{{ post.id }}">{{ post.title }}</a></h3><span class="badge">{{ post.data.status|default('Entwurf') }}</span> <span class="muted">{{ post.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Version {{ post.data.version|default(1) }} · {{ post.data.mode|default('Offline-Demo') }}</span><p style="white-space:pre-line">{{ post.data.body|default(post.data.text|default(post.data.content|default(''))) }}</p>{% if post.data.channel|default('') %}<a href="/marketing">Im Marketing öffnen →</a>{% endif %}</article>{% else %}<div class="empty-state"><h3>Dein erstes Exposé wartet.</h3><p>Übernimm die bekannten Objektfakten direkt in den Textgenerator.</p></div>{% endfor %}</section>
{% elseif tab == 'marketing' %}
<section class="card"><h2>Vermarktung vorbereiten</h2><p class="muted">Erstelle Entwürfe und plane sie intern. Es erfolgt keine automatische Veröffentlichung.</p><div class="toolbar"><a class="btn btn-primary" href="/marketing/new?property={{ item.id }}">Social Post erstellen</a><a class="btn btn-secondary" href="/marketing">Marketingkalender</a><a class="btn btn-secondary" href="/properties/{{ item.id }}?tab=checklist">Checkliste öffnen</a></div>{% for post in posts %}<div style="padding:20px 0;border-top:1px solid var(--border,#eee)"><strong>{{ post.title }}</strong><p>{{ post.data.channel|default('Textentwurf') }} · {{ post.data.status|default('Entwurf') }}{% if post.data.plannedAt|default('') %} · {{ post.data.plannedAt|date('d.m.Y') }}{% endif %}</p></div>{% endfor %}</section>
{% elseif tab == 'checklist' %}
<section class="card"><h2>Gemeinsam sauber vorbereiten.</h2><p class="muted">Arbeitsvorlage für die Objektvermarktung. Diese Checkliste ersetzt keine rechtliche oder fachliche Vollständigkeitsprüfung.</p><form method="post" action="/properties/{{ item.id }}/checklist"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">{% for check in checklist %}<label style="display:flex;align-items:center;gap:12px;padding:17px 0;border-bottom:1px solid var(--border,#eee)"><input type="checkbox" name="checks[]" value="{{ check }}" {{ check in item.data.checklist|default([]) ? 'checked' }} style="width:20px;height:20px">{{ check }}</label>{% endfor %}<button class="btn btn-primary" style="margin-top:22px">Checkliste speichern</button></form></section>
{% elseif tab == 'activity' %}
<section class="card"><h2>Aktivitäten</h2><p class="muted">Lokale Änderungen an diesem Objekt, chronologisch protokolliert.</p>{% for activity in activities|reverse %}<p><span class="badge">{{ activity.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</span> {{ activity.title }}</p>{% else %}<div class="empty-state"><p>Noch keine Änderungen protokolliert.</p></div>{% endfor %}{% if item.data.externalId|default('') %}<hr><h3>CRM-Importstatus</h3><p>onOffice Demo · {{ item.data.externalId }}</p><p class="muted">Letzter lokaler Import: {{ item.data.lastSync|default('') ? item.data.lastSync|date('d.m.Y H:i','Europe/Berlin') : 'Noch nicht importiert' }}. Keine Live-Verbindung.</p>{% endif %}</section>
{% endif %}
<p class="muted" style="margin-top:24px">Vollständig fiktives Demo-Objekt · Keine Übermittlung an die produktive CHASE-Website.</p>
{% endblock %}
