{% extends 'base.html.twig' %}
{% block title %}Immobilien{% endblock %}
{% block breadcrumb %}Immobilien{% endblock %}
{% block stylesheets %}
<style>
.property-index{display:flex;flex-direction:column;gap:15px;height:calc(100dvh - 155px);min-height:350px}.property-index .page-heading{margin:0;align-items:center;gap:15px}.property-index .page-heading h1{font-size:24px;letter-spacing:-.035em}.property-index-title{display:flex;align-items:center;gap:12px}.property-index-title>small{display:inline-grid;place-items:center;min-width:24px;height:24px;padding:0 6px;font-size:10px;border-radius:6px;background:var(--surface);border:1px solid var(--line);color:var(--muted)}.property-index-actions{display:flex;align-items:center;gap:8px}.property-index-actions .btn{font-size:11px;min-height:38px;padding:8px 13px}.property-index-search{display:flex;align-items:center;gap:9px;min-width:0}.property-search-input{display:flex;align-items:center;gap:9px;flex:1;max-width:470px;border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:0 11px;height:40px;min-width:0}.property-search-input>svg{width:17px;height:17px;color:var(--muted)}.property-search-input input{min-width:0;width:100%;border:0!important;box-shadow:none!important;background:transparent!important;font-size:11px!important;min-height:0!important;padding:7px 0!important;outline:0!important}.property-search-input:focus-within{border-color:var(--accent);box-shadow:0 0 0 2px #ff6a0015}.property-index-search>.btn{min-height:40px;padding:8px 12px;font-size:11px}.property-filter-menu{position:relative;flex-shrink:0}.property-filter-menu>summary{display:flex;align-items:center;gap:7px;list-style:none;cursor:pointer;border:1px solid var(--line);background:var(--surface);padding:8px 11px;border-radius:9px;font-size:11px;min-height:40px;white-space:nowrap}.property-filter-menu>summary::-webkit-details-marker{display:none}.property-filter-menu>summary svg{width:16px;height:16px}.property-filter-menu[open]>summary{border-color:var(--accent);color:var(--accent)}.property-filter-count{display:grid;place-items:center;background:var(--accent);color:white;min-width:15px;height:15px;border-radius:4px;padding:0 3px;font-size:8px}.property-filter-panel{position:absolute;right:0;top:48px;width:540px;max-width:calc(100vw - 40px);padding:20px;border:1px solid var(--line);background:var(--surface);border-radius:12px;box-shadow:var(--shadow-raised);z-index:24}.property-filter-panel .form-grid{gap:15px}.property-filter-panel .field label{font-size:10px}.property-filter-panel select,.property-filter-panel input{font-size:11px;min-height:37px}.property-filter-actions{display:flex;align-items:center;gap:15px;justify-content:flex-end;margin-top:18px;padding-top:15px;border-top:1px solid var(--line)}.property-filter-actions a{font-size:10px;color:var(--muted)}.property-filter-actions .btn{min-height:35px;font-size:10px}.property-view-switch{display:flex;align-items:center;padding:3px;gap:3px;border:1px solid var(--line);border-radius:9px;background:var(--surface);margin-left:auto;flex-shrink:0}.property-view-switch a{display:grid;place-items:center;width:31px;height:31px;border-radius:6px;color:var(--muted)}.property-view-switch a[aria-current=true]{background:var(--accent-soft);color:var(--accent)}.property-view-switch svg{width:16px;height:16px}.property-index-focus{font-size:10px;color:var(--accent-dark);margin:0;padding:0 1px}.property-list-results{min-height:0;flex:1;overflow:auto;scrollbar-width:thin;padding:1px 3px 10px 1px}.property-list-results>.grid{align-items:start;gap:16px}.property-list-results .property-card{padding:17px}.property-card-art{height:120px;border-radius:10px;background:linear-gradient(135deg,#f3ebe4,#e3e9e6);display:flex;align-items:center;justify-content:center;color:#6b736f;position:relative;margin-bottom:14px;overflow:hidden}.property-card-art>svg{width:82px;height:76px}.property-card-art>.badge{position:absolute;top:10px;left:10px;font-size:8px;background:var(--surface)}.property-card-art>small{position:absolute;right:9px;bottom:7px;font-size:8px;color:#54615c}.property-card-meta{font-size:9px;line-height:1.8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.property-list-results .property-card h2{font-size:14px;line-height:1.5;letter-spacing:-.02em;margin-top:5px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;min-height:42px}.property-card-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:12px;margin-top:12px;border-top:1px solid var(--line);font-size:10px}.property-card-footer a{color:var(--accent-dark);font-weight:600;white-space:nowrap}.property-list-results>.table-wrap{border:1px solid var(--line);border-radius:12px;background:var(--surface)}.property-list-results>.table-wrap th{position:sticky;top:0;z-index:1}.property-list-results .empty-state{padding:35px 20px}.property-list-results .empty-state h2{font-size:18px}.property-list-results .empty-state p{font-size:11px;margin-top:8px}.property-list-results .empty-state .btn{margin-top:16px}.property-index .icon-button{border:1px solid var(--line);background:var(--surface);width:38px;height:38px}.property-index .property-index-actions .icon-button svg{width:17px;height:17px}
@media(max-width:1000px){.property-list-results>.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.property-filter-panel{width:460px}}
@media(max-width:620px){.property-index{height:calc(100dvh - 133px);min-height:0;gap:12px}.property-index .page-heading{flex-direction:row;align-items:center;gap:10px}.property-index .page-heading h1{font-size:21px}.property-index-title{gap:7px}.property-index-title>small{font-size:9px;min-width:20px;height:20px}.property-index-actions{gap:6px;flex-shrink:0}.property-index-actions .btn{font-size:10px;min-height:35px;padding:7px 10px}.property-index-actions .btn svg{display:none}.property-index .property-index-actions .icon-button{width:33px;height:35px}.property-index-search{gap:6px}.property-search-input{height:39px;padding:0 9px}.property-search-input input{font-size:12px!important}.property-search-input input::placeholder{font-size:10px}.property-search-input>svg{width:15px;height:15px}.property-index-search>.btn{width:35px;padding:0;min-height:39px}.property-index-search>.btn span{display:none}.property-filter-menu>summary{padding:8px 9px;min-height:39px;gap:4px}.property-filter-menu>summary>span:not(.property-filter-count){display:none}.property-filter-panel{position:fixed;top:116px;left:16px;right:16px;max-width:none;width:auto;max-height:calc(100dvh - 145px);overflow:auto;padding:17px}.property-filter-panel .form-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 11px}.property-filter-panel select,.property-filter-panel input{font-size:14px}.property-filter-panel .field label{font-size:10px}.property-view-switch{margin-left:0;padding:2px}.property-view-switch a{width:27px;height:32px}.property-list-results>.grid{grid-template-columns:1fr;gap:12px}.property-list-results .property-card{padding:14px}.property-card-art{height:135px;margin-bottom:12px}.property-list-results .property-card h2{font-size:15px;min-height:0;-webkit-line-clamp:2}.property-card-meta{font-size:10px}.property-card-footer{font-size:11px}.property-index-focus{font-size:10px}}
</style>
{% endblock %}
{% block body %}
{% set focus = filters.focus|default('') %}
{% set objectAnchor = focus == 'texts' ? '#texts' : (focus == 'media' ? '#images' : '') %}
{% set activeFilterCount = 0 %}{% for key in ['status','type','region','owner','from','to'] %}{% if attribute(filters,key)|default('') %}{% set activeFilterCount = activeFilterCount + 1 %}{% endif %}{% endfor %}
<section class="property-index">
<div class="page-heading"><div class="property-index-title"><h1>Immobilien</h1><small aria-label="{{ items|length }} Objekte">{{ items|length }}</small></div><div class="property-index-actions"><a class="icon-button" href="/crm" title="onOffice Demo-Import" aria-label="onOffice Demo-Import">{{ icon('download') }}</a><a class="btn btn-primary" href="/properties/new{{ objectAnchor }}">{{ icon('plus') }}Objekt anlegen</a></div></div>
<form method="get" class="property-index-search" aria-label="Immobilien suchen und filtern">
<input type="hidden" name="focus" value="{{ focus in ['texts','media'] ? focus : '' }}"><input type="hidden" name="view" value="{{ filters.view|default('cards') }}">
<div class="property-search-input">{{ icon('search') }}<label for="property-q" class="sr-only">Immobilien suchen</label><input id="property-q" type="search" name="q" placeholder="Objekt, Ort oder Nummer" value="{{ filters.q|default('') }}"></div><button class="btn btn-secondary" aria-label="Immobilien suchen">{{ icon('search') }}<span>Suchen</span></button>
<details class="property-filter-menu"><summary title="Filter und Sortierung">{{ icon('filter') }}<span>Filter</span>{% if activeFilterCount %}<span class="property-filter-count">{{ activeFilterCount }}</span>{% endif %}</summary><div class="property-filter-panel"><div class="form-grid">
<div class="field"><label for="property-status">Status</label><select id="property-status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-type">Objektart</label><select id="property-type" name="type"><option value="">Alle Objektarten</option>{% for type in types %}<option {{ filters.type|default('') == type ? 'selected' }}>{{ type }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-region">Region</label><select id="property-region" name="region"><option value="">Alle Regionen</option>{% for region in regions %}<option {{ filters.region|default('') == region ? 'selected' }}>{{ region }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-owner">Verantwortlich</label><select id="property-owner" name="owner"><option value="">Alle zugewiesenen</option>{% for id,name in owners %}<option value="{{ id }}" {{ filters.owner|default('') == id ? 'selected' }}>{{ name }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-sort">Sortieren</label><select id="property-sort" name="sort"><option value="newest">Neueste zuerst</option><option value="oldest" {{ filters.sort|default('') == 'oldest' ? 'selected' }}>Älteste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Bezeichnung A–Z</option></select></div>
<div class="field"><label for="from">Erstellt ab</label><input type="date" id="from" name="from" value="{{ filters.from|default('') }}"></div><div class="field"><label for="to">Erstellt bis</label><input type="date" id="to" name="to" value="{{ filters.to|default('') }}"></div>
</div><div class="property-filter-actions"><a href="{{ path('properties', focus in ['texts','media'] ? {focus:focus,view:filters.view|default('cards')} : {view:filters.view|default('cards')}) }}">Zurücksetzen</a><button class="btn btn-primary">Anwenden</button></div></div></details>
<nav class="property-view-switch" aria-label="Objektansicht"><a href="{{ path('properties',filters|merge({view:'cards'})) }}" aria-label="Kartenansicht" title="Kartenansicht" aria-current="{{ filters.view|default('cards') != 'table' ? 'true' : 'false' }}">{{ icon('grid') }}</a><a href="{{ path('properties',filters|merge({view:'table'})) }}" aria-label="Tabellenansicht" title="Tabellenansicht" aria-current="{{ filters.view|default('cards') == 'table' ? 'true' : 'false' }}">{{ icon('list') }}</a></nav>
</form>
{% if focus in ['texts','media'] %}<p class="property-index-focus">{{ focus == 'texts' ? 'Objekt für Exposé-Texte auswählen' : 'Objekt für Bilder & Visualisierung auswählen' }}</p>{% endif %}
<div class="property-list-results" aria-label="Immobilien" tabindex="0">
{% if items is empty %}<div class="card empty-state"><h2>Keine Objekte gefunden</h2><p>{{ activeFilterCount or filters.q|default('') ? 'Passe deine Suche oder Filter an.' : 'Lege dein erstes Objekt an.' }}</p><a class="btn btn-primary" href="/properties/new{{ objectAnchor }}">Objekt anlegen</a></div>
{% elseif filters.view|default('') == 'table' %}
<div class="table-wrap"><table><thead><tr><th>Objekt</th><th>Ort / Region</th><th>Fläche</th><th>Status</th><th>Aktion</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="/properties/{{ item.id }}{{ objectAnchor }}"><strong>{{ item.title }}</strong></a><br><small class="muted">{{ item.data.internalId|default(item.id) }}</small>{% if item.data.isDemo|default(false) %} <span class="badge">Demo</span>{% endif %}</td><td>{{ item.data.city|default('Angabe fehlt') }}<br><small class="muted">{{ item.data.region|default('') }}</small></td><td>{{ item.data.areaSqm|default(null) ? item.data.areaSqm|number_format(0,',','.') ~ ' m²' : 'Angabe fehlt' }}</td><td><span class="badge">{{ item.data.status|default('Entwurf') }}</span></td><td><a href="/properties/{{ item.id }}/edit{{ objectAnchor }}">Bearbeiten →</a></td></tr>{% endfor %}</tbody></table></div>
{% else %}
<div class="grid grid-3">{% for item in items %}<article class="card property-card"><a class="property-card-art" href="/properties/{{ item.id }}{{ objectAnchor }}" aria-label="{{ item.title }} öffnen"><svg width="92" height="84" viewBox="0 0 92 84" fill="none" aria-hidden="true"><path d="M7 39 46 9l39 30M17 34v41h58V34M36 75V49h20v26M23 43h8v9h-8m38-9h8v9h-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="badge">{{ item.data.status|default('Entwurf') }}</span><small>{{ item.data.isDemo|default(false) ? 'Demo · ' : '' }}Symbolbild</small></a><p class="muted property-card-meta">{{ item.data.propertyType|default('Immobilie') }} · {{ item.data.city|default('Ort fehlt') }}</p><h2><a href="/properties/{{ item.id }}{{ objectAnchor }}">{{ item.title }}</a></h2><div class="property-card-footer"><span>{{ item.data.rooms|default('–') }} Zimmer · {{ item.data.areaSqm|default(null) ? item.data.areaSqm|number_format(0,',','.') ~ ' m²' : 'Fläche fehlt' }}</span><a href="/properties/{{ item.id }}{{ objectAnchor }}">Öffnen →</a></div></article>{% endfor %}</div>
{% endif %}
</div></section>
{% endblock %}
