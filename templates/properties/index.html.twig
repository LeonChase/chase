{% extends 'base.html.twig' %}
{% block title %}Meine Immobilien · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">DEIN OBJEKTCOCKPIT</p><h1>Meine Immobilien</h1><p class="muted">Alles rund um deine Objekte. Sicher an einem Ort.</p></div><div class="toolbar"><a class="btn btn-secondary" href="/crm">onOffice Demo-Import</a><a class="btn btn-primary" href="/properties/new">+ Objekt anlegen</a></div></div>
<form class="card toolbar" method="get" aria-label="Immobilien filtern">
<div class="field"><label for="property-q">Suche</label><input id="property-q" name="q" placeholder="Titel, Ort oder Objekt-ID" value="{{ filters.q|default('') }}"></div>
<div class="field"><label for="property-status">Status</label><select id="property-status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-type">Objektart</label><select id="property-type" name="type"><option value="">Alle Objektarten</option>{% for type in types %}<option {{ filters.type|default('') == type ? 'selected' }}>{{ type }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-region">Region</label><select id="property-region" name="region"><option value="">Alle Regionen</option>{% for region in regions %}<option {{ filters.region|default('') == region ? 'selected' }}>{{ region }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-owner">Verantwortlich</label><select id="property-owner" name="owner"><option value="">Alle zugewiesenen</option>{% for id,name in owners %}<option value="{{ id }}" {{ filters.owner|default('') == id ? 'selected' }}>{{ name }}</option>{% endfor %}</select></div>
<div class="field"><label for="property-sort">Sortieren</label><select id="property-sort" name="sort"><option value="newest">Neueste zuerst</option><option value="oldest" {{ filters.sort|default('') == 'oldest' ? 'selected' }}>Älteste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Bezeichnung A–Z</option></select></div>
<div class="field"><label for="property-view">Ansicht</label><select id="property-view" name="view"><option value="cards">Karten</option><option value="table" {{ filters.view|default('') == 'table' ? 'selected' }}>Tabelle</option></select></div>
<details><summary>Zeitraum</summary><div class="form-grid"><div class="field"><label for="from">Erstellt ab</label><input type="date" id="from" name="from" value="{{ filters.from|default('') }}"></div><div class="field"><label for="to">Erstellt bis</label><input type="date" id="to" name="to" value="{{ filters.to|default('') }}"></div></div></details>
<button class="btn btn-secondary">Filtern</button><a href="/properties" class="muted">Zurücksetzen</a>
</form>
<p class="muted">{{ items|length }} zugängliche Demo-Objekte · ausschließlich eigene oder ausdrücklich zugewiesene Datensätze</p>
{% if items is empty %}<div class="card empty-state"><h2>Raum für dein nächstes Objekt.</h2><p>Lege dein erstes Demo-Objekt an oder ändere die Filter.</p><a class="btn btn-primary" href="/properties/new">Objekt anlegen</a></div>
{% elseif filters.view|default('') == 'table' %}
<div class="card table-wrap"><table><thead><tr><th>Objekt</th><th>Ort / Region</th><th>Fläche</th><th>Status</th><th>Aktion</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="/properties/{{ item.id }}"><strong>{{ item.title }}</strong></a><br><small class="muted">{{ item.data.internalId|default(item.id) }}</small></td><td>{{ item.data.city|default('Angabe fehlt') }}<br><small class="muted">{{ item.data.region|default('') }}</small></td><td>{{ item.data.areaSqm|default(null) ? item.data.areaSqm|number_format(0,',','.') ~ ' m²' : 'Angabe fehlt' }}</td><td><span class="badge">{{ item.data.status|default('Entwurf') }}</span></td><td><a href="/properties/{{ item.id }}/edit">Bearbeiten →</a></td></tr>{% endfor %}</tbody></table></div>
{% else %}
<div class="grid grid-3">{% for item in items %}<article class="card property-card"><div style="height:140px;border-radius:12px;background:linear-gradient(135deg,#f3ebe4,#e3e9e6);display:flex;align-items:center;justify-content:center;color:#6b736f;position:relative;margin-bottom:20px"><svg width="92" height="84" viewBox="0 0 92 84" fill="none" aria-hidden="true"><path d="M7 39 46 9l39 30M17 34v41h58V34M36 75V49h20v26M23 43h8v9h-8m38-9h8v9h-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="badge" style="position:absolute;top:12px;left:12px">{{ item.data.status|default('Entwurf') }}</span><small style="position:absolute;right:12px;bottom:8px">Demo-Objekt · Symbolbild</small></div><p class="muted">{{ item.data.propertyType|default('Immobilie') }} · {{ item.data.city|default('Ort fehlt') }}</p><h2 style="font-size:1.12rem"><a href="/properties/{{ item.id }}">{{ item.title }}</a></h2><p class="muted">{{ item.data.region|default('Region fehlt') }}</p><div class="toolbar" style="justify-content:space-between;border-top:1px solid var(--border,#eee);padding-top:16px;margin-top:18px"><span>{{ item.data.rooms|default('–') }} Zimmer <span class="muted">·</span> {{ item.data.areaSqm|default(null) ? item.data.areaSqm|number_format(0,',','.') ~ ' m²' : 'Fläche fehlt' }}</span><a href="/properties/{{ item.id }}" aria-label="{{ item.title }} öffnen">Öffnen →</a></div></article>{% endfor %}</div>
{% endif %}
{% endblock %}
