{% extends 'base.html.twig' %}{% block title %}Nachrichten{% endblock %}{% block body %}
<div class="page-heading"><div><span class="eyebrow">Kurze Wege. Gute Zusammenarbeit.</span><h1>Ihr direkter Draht.</h1><p class="muted">Interne Nachrichten an Partner und Partnermanagement. Kein E-Mail-Versand.</p></div><a class="btn btn-secondary" href="/network">Partner finden</a></div>
{% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}
<div class="grid grid-2"><section class="card stack"><h2>Eine Nachricht schreiben</h2><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="propertyId" value="{{ property ? property.id : '' }}">{% if property %}<div class="alert">Objektbezug: {{ property.title }}. Der Empfänger benötigt eine ausdrückliche Freigabe.</div>{% endif %}<div class="field"><label for="recipient">Empfänger</label><select id="recipient" name="recipientId" required><option value="">Kontakt auswählen</option>{% for person in contacts %}<option value="{{ person.id }}" {{ app.request.get('recipientId') == person.id ? 'selected' : '' }}>{{ person.name }} · {{ person.region }}</option>{% endfor %}</select></div><div class="field"><label for="message-title">Betreff</label><input id="message-title" name="title" required maxlength="180" value="{{ app.request.method == 'POST' ? app.request.request.get('title') : (property ? 'Bitte Objekt prüfen: '~property.title : '') }}"></div><div class="field"><label for="message-body">Nachricht</label><textarea id="message-body" name="body" required maxlength="5000" rows="7">{{ app.request.method == 'POST' ? app.request.request.get('body') : '' }}</textarea></div><button class="btn btn-primary">Intern senden {{ icon('arrow-right') }}</button></form></section><section class="card stack"><h2>Posteingang & Gesendet</h2>{% for message in messages %}<a class="message-row" href="/messages/{{ message.id }}" style="display:block;border-bottom:1px solid var(--border);padding:16px 0"><span class="badge">{{ message.ownerId == app.user.id ? 'Gesendet' : (message.data.readAt|default(null) ? 'Gelesen' : 'Neu') }}</span><h3>{{ message.title }}</h3><p class="muted">{{ names[message.ownerId == app.user.id ? message.recipientId : message.ownerId]|default('Interner Kontakt') }} · {{ message.createdAt|date('d.m.Y H:i') }}</p></a>{% else %}<div class="empty-state">Hier beginnt Ihr Gespräch. Noch keine internen Nachrichten vorhanden.</div>{% endfor %}</section></div>{% endblock %}