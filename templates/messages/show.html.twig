{% extends 'base.html.twig' %}{% block title %}Interne Nachricht{% endblock %}{% block body %}<div class="page-heading"><div><span class="eyebrow">Interne Kommunikation</span><h1>{{ message.title }}</h1><p class="muted">{{ other ? other.name : 'Interner Kontakt' }} · {{ message.createdAt|date('d.m.Y H:i') }}</p></div><a class="btn btn-secondary" href="/messages">Alle Nachrichten</a></div><article class="card stack"><div style="white-space:pre-wrap;overflow-wrap:anywhere">{{ message.data.body }}</div>{% if message.data.propertyId|default('') %}<a class="btn btn-secondary" href="/properties/{{ message.data.propertyId }}">Objektakte öffnen</a><small class="muted">Der Objektlink hebt keine bestehende Zugriffsbeschränkung auf.</small>{% endif %}{% if message.recipientId == app.user.id and not message.data.readAt|default(null) %}<form method="post" action="/messages/{{ message.id }}/read"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-primary">Als gelesen markieren</button></form>{% endif %}<a class="text-link" href="/messages?recipientId={{ other ? other.id : '' }}">Neue Nachricht an diesen Kontakt →</a></article>{% endblock %}