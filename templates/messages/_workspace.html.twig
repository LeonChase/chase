<section class="chat-workspace" aria-label="Interne Nachrichten">
 <aside class="chat-inbox">
  <div class="chat-inbox-heading"><h1>Nachrichten</h1><details class="chat-new"><summary class="icon-button" aria-label="Neues Gespräch" title="Neues Gespräch">{{ icon('edit') }}</summary><form action="/messages" method="get" class="chat-picker"><label for="chat-contact">Kontakt auswählen</label><select id="chat-contact" name="recipientId" required><option value="">Kontakt …</option>{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.name }}</option>{% endfor %}</select>{% if property %}<input type="hidden" name="property" value="{{ property.id }}">{% endif %}<button class="btn btn-primary" type="submit">Gespräch öffnen</button></form></details></div>
  <div class="chat-mailboxes" role="group" aria-label="Postfach"><button type="button" class="active" data-chat-mailbox="all">Alle</button><button type="button" data-chat-mailbox="inbox">Eingang</button><button type="button" data-chat-mailbox="sent">Gesendet</button></div>
  <nav class="chat-thread-list" aria-label="Gespräche">{% for id,thread in threads %}<a href="/messages?recipientId={{ id }}" class="chat-thread {{ selected and selected.id == id ? 'active' : '' }}" data-chat-thread data-inbox="{{ thread.inbox ? 'true' : 'false' }}" data-sent="{{ thread.sent ? 'true' : 'false' }}" {% if selected and selected.id == id %}aria-current="true"{% endif %}><span class="avatar">{{ thread.person.name|slice(0,1)|upper }}</span><span class="chat-thread-summary"><strong>{{ thread.person.name }}</strong><small>{{ thread.last.data.body|slice(0,65) }}</small></span>{% if thread.unread %}<b class="chat-unread">{{ thread.unread }}</b>{% endif %}</a>{% else %}<p class="muted chat-empty">Noch keine Gespräche.</p>{% endfor %}</nav>
  <a href="/network" class="chat-directory">{{ icon('users') }} Partnerverzeichnis</a>
 </aside>
 <div class="chat-conversation" data-chat-recipient="{{ selected ? selected.id : '' }}">
 {% if selected %}
  <header class="chat-conversation-heading"><span class="avatar">{{ selected.name|slice(0,1)|upper }}</span><div><h2>{{ selected.name }}</h2><small class="muted">{{ selected.active ? selected.region : 'Kontakt derzeit inaktiv' }}</small></div><span class="badge">Intern</span></header>
  <div class="chat-stream" role="log" aria-label="Gespräch mit {{ selected.name }}" aria-live="polite" aria-relevant="additions text">{% include 'messages/_thread.html.twig' %}</div>
  <div class="chat-composer-container">
   {% if error %}<p class="alert alert-error" role="alert">{{ error }}</p>{% endif %}
   {% if canSend %}<form action="/messages" method="post" class="chat-composer" data-chat-send><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="recipientId" value="{{ selected.id }}"><input type="hidden" name="propertyId" value="{{ property ? property.id : '' }}">{% if property %}<span class="chat-property">{{ icon('building') }} {{ property.title }}</span>{% endif %}<label class="sr-only" for="chat-body">Nachricht an {{ selected.name }}</label><textarea id="chat-body" name="body" rows="2" maxlength="5000" required placeholder="Nachricht schreiben …">{{ app.request.method == 'POST' and error ? app.request.request.get('body') : '' }}</textarea><button type="submit" class="btn btn-primary" aria-label="Nachricht senden" title="Nachricht senden">{{ icon('arrow-right') }}</button><span class="chat-send-status sr-only" role="status"></span></form>{% else %}<p class="muted">Dieser Kontakt kann derzeit keine neuen Nachrichten empfangen.</p>{% endif %}
  </div>
 {% else %}<div class="chat-welcome"><span class="chat-welcome-icon">{{ icon('message-circle') }}</span><h2>Ein Gespräch beginnen</h2><form action="/messages" method="get"><label class="sr-only" for="first-contact">Kontakt auswählen</label>{% if property %}<input type="hidden" name="property" value="{{ property.id }}">{% endif %}<select id="first-contact" name="recipientId" required><option value="">Kontakt auswählen …</option>{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.name }}</option>{% endfor %}</select><button class="btn btn-primary">Öffnen</button></form>{% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}</div>{% endif %}
 </div>
</section>
