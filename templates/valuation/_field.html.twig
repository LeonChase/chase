{% set labels = {'modYear':'Modifiziertes Baujahr','landArea':'Grundstücksfläche','nhk':'Baukostenkennwert (NHK 2010)','grossRentAnnual':'Jahreskaltmiete','rentQm':'Alternativ: Miete je m²','commissionRate':'Courtage','priceAssumption':'Eigener Angebotspreis','cfg_bpi':'Baupreisindex','cfg_ageRate':'Alterswertminderung pro Jahr'} %}
<div class="field" {% if methods|default('') %}data-valuation-basis="{{ methods }}"{% endif %}><div class="valuation-field-label"><label for="{{ key }}">{{ labels[key]|default(definition[0]) }}</label><button type="button" class="valuation-info-button" data-valuation-info="{{ key }}" aria-label="Info: {{ definition[0] }}">i</button></div><div class="valuation-input-unit"><input id="{{ key }}" name="{{ key }}" type="text" inputmode="decimal" value="{{ attribute(data,key)|default('') }}" autocomplete="off" maxlength="40" data-valuation-number><span>{{ definition[1] }}</span></div></div>
