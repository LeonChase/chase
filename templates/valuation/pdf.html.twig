<!doctype html><html lang="de"><head><meta charset="utf-8"><style>
@page{margin:25px 30px}body{font-family:"DejaVu Sans",sans-serif;font-size:8px;color:#151923}h1{font-size:20px;margin:0 0 3px}h2{font-size:11px;margin:9px 0 4px}.brand{color:#ff6a00;font-weight:bold;font-size:14px}.meta{color:#555;margin-bottom:12px}.inputs,.results{width:100%;border-collapse:collapse}.inputs td{padding:4px 6px;border:1px solid #e7e7e7}.inputs .label{color:#666;font-size:7px}.inputs strong{display:block;font-size:9px}.results{margin-top:12px;table-layout:fixed}.results>tbody>tr>td{vertical-align:top;padding:10px;border:1px solid #ddd;width:25%}.amount{font-size:18px;color:#e85e00;margin:8px 0}.steps{width:100%;font-size:7px;border-collapse:collapse}.steps td{padding:4px 0;border-bottom:1px solid #eee}.steps td+td{text-align:right}.note{font-size:7px;color:#555;margin:12px 0 0;border-top:1px solid #ddd;padding-top:7px}.sources{font-size:7px;color:#555}
</style></head><body><span class="brand">CHASE IMMOBILIEN</span><h1>Immobilienbewertung · Schnellkalkulation</h1><div class="meta">{{ property ? property.title : 'Freie Berechnung' }} · Stichtag {{ valuationDate|date('d.m.Y') }} · Rechenmodell {{ result.version }}</div>
{% for title,fields in groups %}<h2>{{ title }}</h2><table class="inputs"><tr>{% for key,definition in fields %}<td><span class="label">{{ definition[0] }}</span><strong>{{ attribute(result.input,key)|number_format(key == 'modYear' ? 0 : 2,',','.') }} {{ definition[1] }}</strong></td>{% endfor %}</tr></table>{% endfor %}
<table class="results"><tr>{% for key,label in {'sw':'Sachwert','ew':'Ertragswert','vw':'Vergleichswert'} %}{% set method=attribute(result,key) %}<td><h2>{{ label }}</h2><p class="amount">{{ method.ok ? method.value|number_format(0,',','.') ~ ' €' : '—' }}</p>{% if method.ok %}<table class="steps">{% if key=='sw' %}{% set rows={'Herstellungskosten':method.normalHK,'− Alterswertminderung':method.ageDepAmt,'+ Außenanlagen':method.outdoor,'+ Bodenwert':result.common.landValue,'Vorläufiger Sachwert':method.preliminary,'Nach Sachwertfaktor':method.afterFactor,'Zu-/Abschläge':result.input.adjustments} %}{% elseif key=='ew' %}{% set rows={'Jahresrohertrag':method.grossAnnual,'− Bewirtschaftung':method.mgmtCost,'− Bodenverzinsung':method.landInterest,'Gebäudereinertrag':method.buildingNet,'Kapitalisierter Gebäudeertrag':method.buildingIncome,'+ Bodenwert':result.common.landValue,'Zu-/Abschläge':result.input.adjustments} %}{% else %}{% set rows={'Wohnfläche × Vergleichspreis':method.base,'Zu-/Abschläge':result.input.adjustments} %}{% endif %}{% for step,value in rows %}<tr><td>{{ step }}</td><td>{{ value|number_format(2,',','.') }} €</td></tr>{% endfor %}</table>{% if key=='ew' %}<p>Restnutzungsdauer {{ method.rnd }} J. · Vervielfältiger {{ method.multiplier|number_format(4,',','.') }}</p>{% endif %}{% else %}<p>Erforderlich: {{ method.missing|join(', ') }}</p>{% endif %}</td>{% endfor %}<td><h2>{{ result.offer.provided ? 'Eigener Angebotspreis' : 'Preisorientierung der Vorlage' }}</h2><p class="amount">{{ result.offer.ok ? result.offer.value|number_format(0,',','.') ~ ' €' : '—' }}</p><table class="steps"><tr><td>Faktor zum Jahresrohertrag</td><td>{{ result.offer.factor|number_format(2,',','.') }}</td></tr><tr><td>Rohertragsrendite</td><td>{{ (result.offer.yieldRate*100)|number_format(2,',','.') }} %</td></tr><tr><td>Rechnerische Courtage</td><td>{{ result.offer.provision|number_format(2,',','.') }} €</td></tr></table></td></tr></table>
<p class="note">Unverbindliche Schnellkalkulation, keine Verkehrswertermittlung und keine Marktpreisempfehlung. Vorbelegte Annahmen stammen aus dem bereitgestellten CHASE-HTML-Rechner, nicht aus einem aktuellen amtlichen Datenfeed. Werte, Indexbasis 2010, Region, Modell, Bodenanteile und Quellen fachlich prüfen. Ohne eigenen Preis wird der höchste positive vollständig berechenbare Verfahrenswert angezeigt. Keine automatische Quellenaktualisierung und keine externe Datenübertragung.</p>
{% if sourceSnapshots %}<p class="sources"><strong>Manuell dokumentierte Quellen:</strong>{% for key,source in sourceSnapshots %}<br>{{ source.sourceTitle }} · {{ source.region }} · Datenstichtag {{ source.sourceDate }} · Prüfquartal {{ source.quarter }} · {{ source.sourceUrl }}{% endfor %}</p>{% endif %}</body></html>
