{% extends 'base.html.twig' %}
{% block title %}Immobilienbewertung{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="/assets/valuation.css">{% endblock %}
{% block body %}
<div class="page-heading"><div><a class="muted" href="{{ property ? '/properties/' ~ property.id ~ '/edit#pricing' : '/properties' }}">← {{ property ? 'Zur Objektaufnahme' : 'Meine Immobilien' }}</a><span class="eyebrow">PREIS & PROVISION</span><h1>Werte nachvollziehbar herleiten.</h1><p class="muted">Sachwert, Ertragswert und Vergleichswert aus Ihrem bestehenden CHASE-Rechner.</p></div><a class="btn btn-secondary" href="{{ path('valuation_sources') }}">Faktoren & Quellen {{ icon('arrow-up-right') }}</a></div>
<div class="valuation-context card"><span class="valuation-context-icon">{{ icon('house') }}</span><div>{% if property %}<strong>{{ property.title }}</strong><p>{{ property.data.city|default('Ort fehlt') }} · Eckdaten aus dem Objekt übernommen</p>{% else %}<strong>Freie Kalkulation</strong><p>Wählen Sie ein Objekt, um bekannte Eckdaten zu übernehmen.</p>{% endif %}</div><form method="get" action="/valuation" class="valuation-picker"><label class="sr-only" for="valuation-property">Objekt wählen</label><select id="valuation-property" name="property"><option value="">Ohne Objekt</option>{% for item in properties %}<option value="{{ item.id }}" {{ property and property.id == item.id ? 'selected' }}>{{ item.title }}</option>{% endfor %}</select><button class="btn btn-secondary">Übernehmen</button></form></div>
<div class="valuation-note"><span>{{ icon('info') }}</span><p><strong>Ihre Rechenhilfe, kein Gutachten.</strong> Vorbelegte Annahmen stammen aus Ihrer HTML-Vorlage; aktuelle amtliche Faktoren sind nicht verbunden. Jede Eingabe bleibt änderbar. Modifiziertes Baujahr, Bodenanteil und regionale Modellkonformität bitte fachlich prüfen.</p></div>
{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}
{% if saved %}<p class="muted">Gespeicherter Stand vom {{ saved.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Änderungen erzeugen eine neue Berechnung.</p>{% endif %}
<form method="post" class="valuation-form" data-valuation-form>
<input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="propertyId" value="{{ property ? property.id : '' }}">
<div class="valuation-layout"><div class="valuation-inputs">
<section class="card valuation-date"><div><span class="eyebrow">DER STICHTAG</span><h2>Wann soll gerechnet werden?</h2><p class="muted">Das Jahr steuert Alter und Restnutzungsdauer.</p></div><div class="field"><label for="valuationDate">Bewertungsstichtag</label><input id="valuationDate" name="valuationDate" type="date" min="1900-01-01" max="2200-12-31" value="{{ valuationDate }}" required></div></section>
{% for title, fields in groups %}<details class="card valuation-section" {{ loop.index < 3 ? 'open' }}><summary><span class="valuation-section-number">{{ '%02d'|format(loop.index) }}</span><span><strong>{{ title }}</strong><small>{{ loop.index == 1 ? 'Gebäude und Boden sauber trennen' : (loop.index == 2 ? 'Mieteinnahmen und Vergleichsdaten' : (loop.index == 3 ? 'Eigener Preis und optionale Courtage' : 'Ungeprüfte Vorbelegung · bitte prüfen')) }}</small></span>{{ icon('chevron-down') }}</summary><div class="form-grid valuation-fields">
{% for key, definition in fields %}<div class="field"><label for="{{ key }}">{{ definition[0] }}</label><div class="valuation-input-unit"><input id="{{ key }}" name="{{ key }}" type="text" inputmode="decimal" value="{{ attribute(data,key)|default('') }}" autocomplete="off" maxlength="40" data-valuation-number><span>{{ definition[1] }}</span></div>
{% if key in factors|keys %}<label class="sr-only" for="source-{{ key }}">Quelle für {{ definition[0] }}</label><select id="source-{{ key }}" name="sources[{{ key }}]" data-source-for="{{ key }}"><option value="">Manuelle Eingabe · keine geprüfte Quelle</option>{% for source in sources %}{% if source.data.factor == key %}<option value="{{ source.id }}" data-value="{{ source.data.value }}" {{ attribute(sourceBindings,key)|default('') == source.id ? 'selected' }}>{{ source.data.region }} · {{ source.data.quarter }} · {{ source.data.value|number_format(2,',','.') }}</option>{% endif %}{% endfor %}</select>{% endif %}
{% if key == 'bgf' %}<small class="muted">BGF ist nicht gleich Wohnfläche.</small>{% elseif key == 'modYear' %}<small class="muted">Baujahr ggf. übernommen; Modernisierungen nicht automatisch eingerechnet.</small>{% elseif key == 'grossRentAnnual' %}<small class="muted">Ein Jahresrohertrag hat Vorrang vor der Miete je m².</small>{% elseif key == 'adjustments' %}<small class="muted">Wirkt am Ende auf alle drei Verfahren.</small>{% elseif key == 'cfg_bpi' %}<small class="muted">Vorlagenwert 198,2, ohne aktuellen Quellenbeleg. Werte &gt; 10 werden durch 100 geteilt.</small>{% elseif key == 'commissionRate' %}<small class="muted">Rechenanzeige; keine automatische rechtliche Provisionsprüfung.</small>{% endif %}</div>{% endfor %}
</div></details>{% endfor %}
<p class="valuation-input-hint">Zahlen bitte ohne Tausenderpunkte eingeben, z. B. <strong>250000</strong> oder <strong>1234,56</strong>. Punkt oder Komma als Dezimalzeichen ist möglich.</p>
<div class="valuation-actions"><button class="btn btn-secondary" name="action" value="calculate">Nur berechnen</button><button class="btn btn-primary" name="action" value="save">Berechnen & speichern {{ icon('check') }}</button><span class="muted" aria-live="polite" data-valuation-change>Die Berechnung erfolgt lokal auf dem Server.</span></div>
</div><aside class="valuation-results" aria-label="Berechnungsergebnisse" id="valuation-results">
{% include 'valuation/_results.html.twig' %}
</aside></div></form>
<section class="card valuation-history"><div class="section-heading"><div><span class="eyebrow">NACHVOLLZIEHBAR GESPEICHERT</span><h2>{{ property ? 'Berechnungen zu diesem Objekt' : 'Meine Berechnungen' }}</h2></div></div>{% for item in valuations %}<a class="valuation-history-row" href="{{ item.data.propertyId|default('') ? path('property_valuation',{id:item.data.propertyId,result:item.id}) : path('valuation',{result:item.id}) }}"><div><strong>{{ item.title }}</strong><small>{{ item.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Stichtag {{ item.data.valuationDate|default(item.createdAt|date('Y-m-d'))|date('d.m.Y') }}</small></div><span>{{ item.data.calculation.offer.value|default(item.data.result|default(0))|number_format(0,',','.') }} € {{ icon('arrow-right') }}</span></a>{% else %}<p class="muted">Noch keine Berechnung gespeichert. Eingaben, Rechenschritte und Quellen werden gemeinsam festgehalten.</p>{% endfor %}</section>
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="/assets/valuation.js" defer></script>{% endblock %}
