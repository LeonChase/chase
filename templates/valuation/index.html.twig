{% extends 'base.html.twig' %}
{% block title %}Immobilienbewertung{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="/assets/valuation.css">{% endblock %}
{% block body %}
<div class="valuation-workspace">
<header class="valuation-toolbar"><div class="valuation-title"><a class="icon-button" href="{{ property ? '/properties/' ~ property.id ~ '/edit#pricing' : '/properties' }}" aria-label="Zur Objektaufnahme">{{ icon('chevron-left') }}</a><h1>Immobilienbewertung</h1></div><div class="valuation-toolbar-actions"><a class="icon-button" href="{{ path('valuation_sources') }}" title="Faktoren & Quellen" aria-label="Faktoren & Quellen">{{ icon('file-text') }}</a><button class="icon-button" type="button" data-valuation-open="valuation-history" title="Gespeicherte Berechnungen" aria-label="Gespeicherte Berechnungen">{{ icon('clock') }}</button><button class="icon-button" type="button" data-valuation-info="model" aria-label="Hinweise zum Rechenmodell">{{ icon('help-circle') }}</button></div></header>
<form method="get" action="/valuation" class="valuation-object-picker"><label for="valuation-property" class="sr-only">Objekt wählen</label><select id="valuation-property" name="property"><option value="">Freie Berechnung</option>{% for item in properties %}<option value="{{ item.id }}" {{ property and property.id == item.id ? 'selected' }}>{{ item.title }}</option>{% endfor %}</select><button class="btn btn-secondary btn-small" title="Objektdaten übernehmen" aria-label="Objektdaten übernehmen">Übernehmen {{ icon('arrow-right') }}</button><span class="valuation-factor-state">{{ icon('shield') }}Lokal berechnet</span></form>
{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}
<form method="post" class="valuation-form" data-valuation-form>
<input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="propertyId" value="{{ property ? property.id : '' }}">
{% set definitions = {} %}{% for fields in groups %}{% set definitions = definitions|merge(fields) %}{% endfor %}
<div class="valuation-main">
<section class="valuation-input-panel" aria-label="Bewertungseingaben">
<nav class="valuation-method-tabs" role="tablist" aria-label="Bewertungsverfahren">
{% for key,label in {'sw':'Sachwert','ew':'Ertragswert','vw':'Vergleichswert'} %}<button type="button" role="tab" id="valuation-tab-{{ key }}" aria-controls="valuation-panel-{{ key }}" aria-selected="{{ key == 'sw' ? 'true' : 'false' }}" tabindex="{{ key == 'sw' ? '0' : '-1' }}" data-valuation-method="{{ key }}">{{ label }}</button>{% endfor %}
</nav>
<div class="valuation-basis"><h2>Objektdaten</h2><div class="valuation-fields-grid">
{% for key in ['livingArea','landArea','modYear','brw'] %}{% include 'valuation/_field.html.twig' with {key:key,definition:definitions[key],methods:key == 'livingArea' ? 'ew vw' : 'sw ew'} %}{% endfor %}
</div></div>
{% for method,settings in {'sw':{title:'Gebäudewert',fields:['bgf','nhk','marketFactor']},'ew':{title:'Miete & Ertrag',fields:['grossRentAnnual','rentQm','lz']},'vw':{title:'Vergleichspreis',fields:['compQmPrice']}} %}
<section class="valuation-method-panel" id="valuation-panel-{{ method }}" role="tabpanel" aria-labelledby="valuation-tab-{{ method }}" data-valuation-panel="{{ method }}"><h2>{{ settings.title }}</h2><div class="valuation-fields-grid">{% for key in settings.fields %}{% include 'valuation/_field.html.twig' with {key:key,definition:definitions[key]} %}{% endfor %}</div></section>
{% endfor %}
<div class="valuation-input-bottom"><button type="button" class="valuation-settings-trigger" data-valuation-open="valuation-settings">{{ icon('settings') }}Annahmen & Preisvorgabe {{ icon('chevron-right') }}</button><button type="button" class="valuation-settings-trigger" data-valuation-open="valuation-source-picker">{{ icon('file-text') }}Quellen zuordnen {{ icon('chevron-right') }}</button></div>
</section>
<aside class="valuation-output-panel" aria-label="Ergebnisübersicht"><div class="valuation-output-heading"><h2>Deine Berechnung</h2><span class="valuation-live-dot" aria-hidden="true"></span></div><div id="valuation-results" class="valuation-results" aria-label="Berechnungsergebnisse" aria-live="polite">{% include 'valuation/_results.html.twig' %}</div><p class="valuation-output-note">Unverbindliche Schnellkalkulation <button type="button" class="valuation-info-button" data-valuation-info="model" aria-label="Hinweise zur Schnellkalkulation">i</button></p></aside>
</div>
<div class="valuation-commandbar"><div class="valuation-date"><label for="valuationDate">Stichtag</label><input id="valuationDate" name="valuationDate" type="date" min="1900-01-01" max="2200-12-31" value="{{ valuationDate }}" required></div><span class="valuation-live-status muted" aria-live="polite" data-valuation-change>Berechnung wird aktualisiert</span><button class="btn btn-secondary btn-small" name="action" value="calculate" data-manual-calculate>Berechnen</button><button class="btn btn-secondary btn-small" name="action" value="pdf" title="Aktuelle Berechnung als PDF" aria-label="PDF-Druck">{{ icon('download') }}PDF</button><button class="btn btn-primary btn-small" name="action" value="save">{{ icon('check') }}Speichern</button></div>
<dialog id="valuation-settings" class="valuation-dialog"><div class="valuation-dialog-heading"><h2>Annahmen & Preisvorgabe</h2><button type="button" class="icon-button" data-valuation-close aria-label="Schließen">{{ icon('x') }}</button></div><div class="valuation-settings-grid">{% for key in ['priceAssumption','commissionRate','adjustments','cfg_bpi','cfg_outdoor','cfg_mgmt','cfg_totalLife','cfg_ageRate'] %}{% include 'valuation/_field.html.twig' with {key:key,definition:definitions[key]} %}{% endfor %}</div><p class="muted">Vorlagenannahmen bitte für das Objekt prüfen. Keine automatische Aktualisierung von Marktdaten.</p><button class="btn btn-primary btn-small" type="button" data-valuation-close>Übernehmen</button></dialog>
<dialog id="valuation-source-picker" class="valuation-dialog"><div class="valuation-dialog-heading"><h2>Faktoren & Quellen</h2><button type="button" class="icon-button" data-valuation-close aria-label="Schließen">{{ icon('x') }}</button></div><div class="valuation-source-pickers">{% for key,label in factors %}<div class="field"><label for="source-{{ key }}">{{ label }}</label><select id="source-{{ key }}" name="sources[{{ key }}]" data-source-for="{{ key }}"><option value="">Manuelle Eingabe · ohne Quellenbeleg</option>{% for source in sources %}{% if source.data.factor == key %}<option value="{{ source.id }}" data-value="{{ source.data.value }}" {{ attribute(sourceBindings,key)|default('') == source.id ? 'selected' }}>{{ source.data.region }} · {{ source.data.quarter }} · {{ source.data.value|number_format(2,',','.') }}</option>{% endif %}{% endfor %}</select></div>{% endfor %}</div><p class="muted">Aktuelle amtliche Faktoren sind nicht verbunden. Übernommene Werte und Quellen werden mit der Berechnung gespeichert.</p><a class="btn btn-secondary btn-small" href="{{ path('valuation_sources') }}">Quellen verwalten</a></dialog>
</form>
<dialog id="valuation-history" class="valuation-dialog"><div class="valuation-dialog-heading"><h2>Gespeicherte Berechnungen</h2><button type="button" class="icon-button" data-valuation-close aria-label="Schließen">{{ icon('x') }}</button></div>{% for item in valuations %}<a class="valuation-history-row" href="{{ item.data.propertyId|default('') ? path('property_valuation',{id:item.data.propertyId,result:item.id}) : path('valuation',{result:item.id}) }}"><div><strong>{{ item.title }}</strong><small>{{ item.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · {{ item.data.valuationDate|default(item.createdAt|date('Y-m-d'))|date('d.m.Y') }}</small></div><span>{{ item.data.calculation.offer.value|default(item.data.result|default(0))|number_format(0,',','.') }} €</span></a>{% else %}<p class="muted">Noch keine Berechnung gespeichert.</p>{% endfor %}</dialog>
<dialog id="valuation-breakdown" class="valuation-dialog"><div class="valuation-dialog-heading"><h2 data-valuation-breakdown-title>Rechenweg</h2><button type="button" class="icon-button" data-valuation-close aria-label="Schließen">{{ icon('x') }}</button></div><div class="valuation-breakdown" data-valuation-breakdown-body></div></dialog>
<dialog id="valuation-info" class="valuation-dialog"><div class="valuation-dialog-heading"><h2 data-valuation-info-title>Hinweis</h2><button type="button" class="icon-button" data-valuation-close aria-label="Schließen">{{ icon('x') }}</button></div><div data-valuation-info-body></div></dialog>
{% set help = {
'bgf':'Brutto-Grundfläche einschließlich Konstruktionsflächen, beispielsweise laut DIN-277-Berechnung. Nicht mit Wohnfläche gleichsetzen.',
'nhk':'NHK-2010-Kostenkennwert je m² BGF. Passend zu Gebäudetyp und Ausstattungsstandard fachlich bestimmen. Der Baupreisindex rechnet den Ansatz hoch.',
'modYear':'Modifiziertes Baujahr nach fachlich bewerteten Modernisierungen. Ein letztes Modernisierungsjahr wird nicht automatisch als fiktives Baujahr angesetzt.',
'landArea':'Grundstücksfläche laut Unterlagen. Bei Wohnungseigentum den fachlich zugeordneten Bodenanteil berücksichtigen, nicht ungeprüft das ganze Grundstück.',
'brw':'Bodenrichtwert für die passende Zone und den Datenstichtag recherchieren. Erschließung und Modellbezug prüfen. Quelle über das Datenbanksymbol dokumentieren.',
'marketFactor':'Regionaler und modellabhängiger Sachwertfaktor. Quelle, Teilmarkt und Bewertungsmodell müssen zu den übrigen Eingaben passen.',
'livingArea':'Wohnfläche laut nachvollziehbarer Berechnung; Basis für Vergleichswert und alternativ den Jahresrohertrag.',
'grossRentAnnual':'Jährliche Soll-Kaltmiete vor Bewirtschaftungskosten. Ein eingetragener Jahresrohertrag hat Vorrang vor der Miete je m².',
'rentQm':'Monatliche Kaltmiete pro m². Wenn kein Jahresrohertrag eingetragen ist: Miete × Wohnfläche × 12.',
'lz':'Liegenschaftszinssatz in Prozent. Regional, objektbezogen und modellkonform wählen. Es wird kein aktueller Zins automatisch abgerufen.',
'compQmPrice':'Nachvollziehbarer Vergleichspreis je m². Angebote und tatsächliche Verkäufe unterscheiden; Quelle und Vergleichbarkeit prüfen.',
'adjustments':'Begründete pauschale Zu- oder Abschläge in Euro. Der Betrag wird im bestehenden Modell am Ende zu jedem Verfahren addiert.',
'priceAssumption':'Ein eigener Angebotspreis hat Vorrang. Ohne eigenen Preis wird die Regel der Vorlage verwendet: höchster positiver, vollständig berechenbarer Verfahrenswert.',
'commissionRate':'Eingegebener Courtagesatz × Angebotspreis. Rechenanzeige, keine rechtliche Prüfung oder Provisionsvereinbarung.',
'cfg_bpi':'Vorlagenwert 198,2 ohne aktuellen Quellenbeleg. Basis 2010 = 100 beachten. Wie im Original: Werte über 10 ÷ 100, kleinere Werte direkt als Faktor.',
'cfg_outdoor':'Pauschaler Zuschlag auf den Gebäudewert. Vorlagenannahme 5 %, für das konkrete Objekt prüfen.',
'cfg_mgmt':'Pauschaler Abzug vom Jahresrohertrag. Vorlagenannahme 20 %, keine automatische Prüfung tatsächlicher Kosten.',
'cfg_totalLife':'Gesamtnutzungsdauer als Modellannahme. Vorlagenwert 80 Jahre; Restnutzungsdauer wird wie im Original auf 0 bis 120 Jahre begrenzt.',
'cfg_ageRate':'Jährlicher linearer Abschlag. Vorlagenannahme 1,25 %. Gesamtabschlag wird auf 0 bis 100 % begrenzt.',
'model':'Unverbindliche Schnellkalkulation nach Ihrem bestehenden CHASE-Rechner. Keine Verkehrswertermittlung und keine KI- oder Marktpreisprognose. Faktoren werden manuell gepflegt; kein aktueller amtlicher Datenfeed verbunden. Region, Stichtag, Indexbasis und Modellkonformität fachlich prüfen. Zahlen ohne Tausenderpunkte eingeben, zum Beispiel 250000 oder 1234,56. Der PDF-Druck verwendet ausschließlich Ihre aktuelle lokale Berechnung.'
} %}
{% for key,text in help %}<template id="valuation-help-{{ key }}"><p>{{ text }}</p>{% if key in ['brw','marketFactor','lz','compQmPrice','cfg_bpi','model'] %}<p><a class="text-link" href="{{ path('valuation_sources') }}">Faktoren & Quellen →</a></p>{% endif %}</template>{% endfor %}
</div>
{% endblock %}
{% block javascripts %}{{ parent() }}<script src="/assets/valuation.js" defer></script>{% endblock %}
