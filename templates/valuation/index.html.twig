{% extends 'base.html.twig' %}
{% block title %}Immobilienbewertung · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Immobilienbewertung</span><h1>Eine erste Rechnung. Kein Gutachten.</h1><p class="muted">Ein nachvollziehbares mathematisches Beispiel mit Ihren Eingaben.</p></div><span class="badge">Demo-Rechner · lokal</span></div>
<div class="alert"><strong>Keine Markt- oder Verkehrswertermittlung.</strong> Der Rechner verwendet keine Marktdaten. Ein frei eingegebener Faktor multipliziert die Jahresnettokaltmiete. Er ersetzt keine fachliche Bewertung.</div>
{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
<div class="grid grid-2" style="align-items:start"><section class="card"><h2>Rechenbeispiel vorbereiten</h2><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="propertyId">Objekt verknüpfen (optional)</label><select name="propertyId" id="propertyId"><option value="">Ohne Objekt</option>{% for property in properties %}<option value="{{ property.id }}">{{ property.title }}</option>{% endfor %}</select></div><div class="field"><label for="monthlyRent">Monatliche Nettokaltmiete in €</label><input type="number" name="monthlyRent" id="monthlyRent" required min="0.01" max="10000000" step="0.01" placeholder="Ihre eigene Eingabe"></div><div class="field"><label for="factor">Frei gewählter Faktor</label><input type="number" name="factor" id="factor" required min="0.01" max="100" step="0.01" placeholder="Keine Empfehlung durch CHASE"><small class="muted">Der Faktor wird ausschließlich von Ihnen festgelegt.</small></div><button class="btn btn-primary">Demo-Ergebnis berechnen & speichern</button></form></section><section class="card">{% if result %}<span class="badge">Mathematisches Demo-Ergebnis</span><p style="font-size:clamp(32px,4vw,52px);font-weight:700;color:#FF6A00;margin:20px 0">{{ result.result|number_format(2, ',', '.') }} €</p><p>{{ result.monthlyRent|number_format(2, ',', '.') }} € × 12 Monate = {{ result.annualRent|number_format(2, ',', '.') }} € Jahresnettokaltmiete</p><p>× Ihr Faktor {{ result.factor|number_format(2, ',', '.') }}</p><p class="muted">{{ result.disclaimer }}</p>{% else %}<h2>Jeder Schritt bleibt nachvollziehbar.</h2><p>Monatsnettokaltmiete × 12 × Ihr Faktor</p><p class="muted">Ein produktiver Bewertungsanbieter ist nicht verbunden. Lagequalität, Zustand, Bodenwert, Kosten, Leerstand, Zinsen und rechtliche Gegebenheiten werden hier nicht bewertet.</p>{% endif %}</section></div>
<section class="card" style="margin-top:24px"><h2>Gespeicherte Rechenbeispiele</h2>{% for valuation in valuations %}<a class="list-row" style="display:block;padding:14px 0;border-bottom:1px solid var(--border,#e6e7ea)" href="{{ path('valuation',{result:valuation.id}) }}"><strong>{{ valuation.title }}</strong><span style="float:right">{{ valuation.data.result|number_format(2, ',', '.') }} €</span><br><small class="muted">{{ valuation.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · nur Demo-Rechnung</small></a>{% else %}<p class="empty-state">Ihre gespeicherten Berechnungen erscheinen hier.</p>{% endfor %}</section>
{% endblock %}
