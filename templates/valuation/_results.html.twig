{% if result %}
{% for key,label in {'sw':'Sachwert','ew':'Ertragswert','vw':'Vergleichswert'} %}{% set method = attribute(result,key) %}<section class="card valuation-result {{ method.ok ? 'is-ready' : '' }}" data-result="{{ key }}"><div class="valuation-result-title"><h2>{{ label }}</h2><span class="badge">{{ method.ok ? 'Berechnet' : 'Angaben fehlen' }}</span></div>{% if method.ok %}<strong class="valuation-amount">{{ method.value|number_format(0,',','.') }} <small>€</small></strong><details class="valuation-steps"><summary>Rechenweg ansehen {{ icon('chevron-down') }}</summary><dl>
{% if key == 'sw' %}{% set rows={'NHK: BGF × Kostenkennwert × Indexfaktor':method.normalHK,'− Alterswertminderung':method.ageDepAmt,'= Gebäudewert':method.buildingValue,'+ Außenanlagen':method.outdoor,'+ Bodenwert':result.common.landValue,'= Vorläufiger Sachwert':method.preliminary,'× Sachwertfaktor: Ergebnis':method.afterFactor,'± Zu-/Abschläge':result.input.adjustments} %}
{% elseif key == 'ew' %}{% set rows={'Jahresrohertrag':method.grossAnnual,'− Bewirtschaftungskosten':method.mgmtCost,'= Jahresreinertrag':method.netAnnual,'− Bodenwertverzinsung':method.landInterest,'= Gebäudereinertrag':method.buildingNet,'× Vervielfältiger: Gebäudeertrag':method.buildingIncome,'+ Bodenwert':result.common.landValue,'= Vorläufiger Ertragswert':method.preliminary,'± Zu-/Abschläge':result.input.adjustments} %}<p class="muted">Restnutzungsdauer {{ method.rnd|number_format(0,',','.') }} Jahre · Vervielfältiger {{ method.multiplier|number_format(4,',','.') }}</p>
{% else %}{% set rows={'Wohnfläche × Vergleichspreis':method.base,'± Zu-/Abschläge':result.input.adjustments} %}{% endif %}
{% for step,value in rows %}<div><dt>{{ step }}</dt><dd>{{ value|number_format(2,',','.') }} €</dd></div>{% endfor %}<div class="valuation-total"><dt>= {{ label }}</dt><dd>{{ method.value|number_format(2,',','.') }} €</dd></div></dl></details>{% else %}<p class="valuation-empty-amount">—</p><p class="muted">Noch erforderlich: {{ method.missing|join(', ') }}.</p>{% endif %}</section>{% endfor %}
<section class="card valuation-offer"><span class="eyebrow">{{ result.offer.provided ? 'IHR EIGENER ANGEBOTSPREIS' : 'PREISORIENTIERUNG DER VORLAGE' }}</span><h2>{{ result.offer.ok ? result.offer.value|number_format(0,',','.') ~ ' €' : 'Noch offen' }}</h2>{% if result.offer.ok %}<p>{{ result.offer.provided ? 'Der von Ihnen eingegebene Angebotspreis wird verwendet.' : 'Höchster positiver Wert der vollständig berechneten Verfahren.' }}</p><dl><div><dt>Faktor zum Jahresrohertrag</dt><dd>{{ result.offer.factor ? result.offer.factor|number_format(2,',','.') : '—' }}</dd></div><div><dt>Rohertragsrendite</dt><dd>{{ result.offer.yieldRate ? (result.offer.yieldRate * 100)|number_format(2,',','.') ~ ' %' : '—' }}</dd></div><div><dt>Rechnerische Courtage</dt><dd>{{ result.offer.provision|number_format(2,',','.') }} €</dd></div></dl>{% endif %}<small>Keine Marktpreisempfehlung und keine Verkehrswertermittlung.</small></section>
<details class="card valuation-assumptions"><summary>Modellgrenzen & Hinweise</summary>{% for warning in result.warnings %}<p class="muted">{{ warning }}</p>{% endfor %}{% if saved and saved.data.sourceSnapshots|default([]) %}<h3>Gespeicherte Quellen</h3>{% for field,source in saved.data.sourceSnapshots %}<p><a href="{{ source.sourceUrl }}" target="_blank" rel="noopener noreferrer">{{ source.sourceTitle }}</a><br><small class="muted">{{ source.region }} · Prüfung {{ source.quarter }} · Datenstichtag {{ source.sourceDate|date('d.m.Y') }}</small></p>{% endfor %}{% endif %}</details>
{% else %}<section class="card valuation-start"><span class="valuation-start-icon">{{ icon('calculator') }}</span><span class="eyebrow">KLARHEIT FÜR IHR OBJEKT</span><h2>Drei Verfahren.<br>Ein nachvollziehbarer Weg.</h2><p class="muted">Tragen Sie bekannte Werte ein. Vollständige Verfahren werden berechnet, fehlende Angaben bleiben sichtbar.</p><ol><li>Eckdaten prüfen</li><li>Faktoren mit Quelle ergänzen</li><li>Berechnen und lokal speichern</li></ol><a class="text-link" href="{{ path('valuation_sources') }}">Faktoren & Quellen öffnen →</a></section>{% endif %}
