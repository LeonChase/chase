{% for key,label in {'sw':'Sachwert','ew':'Ertragswert','vw':'Vergleichswert'} %}{% set method=result ? attribute(result,key) : null %}<section class="valuation-result {{ method and method.ok ? 'is-ready' : '' }}" data-result="{{ key }}"><div class="valuation-result-title"><h2>{{ label }}</h2><span class="valuation-ready-dot {{ method and method.ok ? 'ready' }}" title="{{ method and method.ok ? 'Berechnet' : 'Angaben fehlen' }}"></span></div><strong class="valuation-amount">{{ method and method.ok ? method.value|number_format(0,',','.') ~ ' €' : '—' }}</strong>{% if method and method.ok %}<details class="valuation-steps"><summary>Rechenweg {{ icon('chevron-down') }}</summary><dl>
{% if key=='sw' %}{% set rows={'Herstellungskosten':method.normalHK,'− Alterswertminderung':method.ageDepAmt,'+ Außenanlagen':method.outdoor,'+ Bodenwert':result.common.landValue,'Vorläufiger Sachwert':method.preliminary,'Nach Sachwertfaktor':method.afterFactor,'Zu-/Abschläge':result.input.adjustments} %}{% elseif key=='ew' %}{% set rows={'Jahresrohertrag':method.grossAnnual,'− Bewirtschaftung':method.mgmtCost,'− Bodenverzinsung':method.landInterest,'Gebäudereinertrag':method.buildingNet,'Gebäudeertragswert':method.buildingIncome,'+ Bodenwert':result.common.landValue,'Zu-/Abschläge':result.input.adjustments} %}{% else %}{% set rows={'Wohnfläche × Vergleichspreis':method.base,'Zu-/Abschläge':result.input.adjustments} %}{% endif %}{% for step,value in rows %}<div><dt>{{ step }}</dt><dd>{{ value|number_format(2,',','.') }} €</dd></div>{% endfor %}{% if key=='ew' %}<div><dt>Restnutzungsdauer / Vervielfältiger</dt><dd>{{ method.rnd }} J. / {{ method.multiplier|number_format(4,',','.') }}</dd></div>{% endif %}</dl></details>{% else %}<p class="valuation-missing">{{ method ? method.missing|join(', ') : 'Eingaben ergänzen' }}</p>{% endif %}</section>{% endfor %}
<section class="valuation-result valuation-offer"><div class="valuation-result-title"><h2>{{ result and result.offer.provided ? 'Angebotspreis' : 'Preisorientierung' }}</h2><button type="button" class="valuation-info-button" data-valuation-info="priceAssumption" aria-label="Info: Preisorientierung">i</button></div><strong class="valuation-offer-amount">{{ result and result.offer.ok ? result.offer.value|number_format(0,',','.') ~ ' €' : '—' }}</strong><dl><div><dt>Faktor</dt><dd>{{ result and result.offer.factor ? result.offer.factor|number_format(2,',','.') : '—' }}</dd></div><div><dt>Rohertragsrendite</dt><dd>{{ result and result.offer.yieldRate ? (result.offer.yieldRate*100)|number_format(2,',','.') ~ ' %' : '—' }}</dd></div><div><dt>Courtage</dt><dd>{{ result and result.offer.provision ? result.offer.provision|number_format(2,',','.') ~ ' €' : '—' }}</dd></div></dl></section>
