{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}News & Netzwerk · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Gemeinsam informiert</span><h1>News & Netzwerk</h1><p>Neuigkeiten, Ideen und Wissen aus der CHASE Zentrale.</p></div><a class="btn btn-secondary" href="{{ path('app_network') }}">Partnernetzwerk öffnen</a></div>
<div class="tabs"><a class="active" href="{{ path('app_news') }}">News aus der Zentrale</a><a href="{{ path('app_network') }}">Partnernetzwerk</a></div>
<div class="alert">Synthetische interne Demo-News. Hier werden keine aktuellen Immobilien-Marktdaten oder verbindlichen Unternehmensmeldungen behauptet.</div>
{{ parts.filters(categories, q, category, false, false, unreadOnly, true) }}
<div class="grid grid-2">{% for item in items %}<article class="card stack"><div class="toolbar">{{ parts.category(item.data.category|default('Unternehmen'), true) }}{% if item.data.pinned|default(false) %}<span class="badge">Angepinnt</span>{% endif %}{% if item.id not in read %}<span class="badge badge-accent">Neu</span>{% endif %}</div><small class="muted">{{ item.data.publishedAt|default(item.createdAt|date('c'))|date('d.m.Y', 'Europe/Berlin') }}</small><h2><a href="{{ path('app_news_article', {id:item.id}) }}">{{ item.title }}</a></h2><p class="muted">{{ item.data.summary|default('Eine interne Nachricht für CHASE-Partner.') }}</p><div class="toolbar"><a class="btn btn-primary" href="{{ path('app_news_article', {id:item.id}) }}">Beitrag lesen</a><form method="post" action="{{ path('app_content_preference', {kind:'read', type:'news', id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="back" value="list"><button class="btn btn-secondary" type="submit">{{ item.id in read ? 'Als ungelesen markieren' : 'Als gelesen markieren' }}</button></form></div></article>{% else %}<div class="card empty-state"><h2>Sie sind auf dem neuesten Stand</h2><p>Keine passenden Nachrichten gefunden.</p><a class="btn btn-secondary" href="{{ path('app_news') }}">Alle Nachrichten</a></div>{% endfor %}</div>
{% endblock %}
