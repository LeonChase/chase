{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}Wissen / Academy{% endblock %}
{% block breadcrumb %}Wissen / Academy{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Wissen, das Sie weiterbringt</span><h1>Wissen / Academy</h1><p>Nachschlagen, verstehen und Schritt für Schritt weiterkommen.</p></div><a class="btn btn-primary" href="{{ path('app_lexicon') }}">Immobilienlexikon öffnen →</a></div>
<div class="grid grid-2"><section class="card academy-path"><span class="badge">Ihr Lernpfad</span><h2>Makler-Onboarding</h2><p class="muted">Ein klarer Start in Ihren Makleralltag. Speichern Sie Ihren persönlichen Lernfortschritt.</p><progress value="{{ learned|length }}" max="{{ all|length ?: 1 }}" aria-label="Lernfortschritt" style="width:100%;accent-color:var(--accent,#FF6A00)">{{ learned|length }} / {{ all|length }}</progress><div class="toolbar"><span class="muted">{{ learned|length }} von {{ all|length }} abgeschlossen</span><a class="btn btn-secondary" href="{{ all|length ? path('app_academy_article',{id:all[0].id}) : path('app_help') }}">{{ learned|length ? 'Weiterlernen' : 'Lernpfad starten' }}</a></div></section><section class="card stack" style="background:linear-gradient(135deg,var(--surface,#fff),rgba(255,106,0,.065))"><span class="badge">Bereitgestelltes CHASE-Lexikon</span><h2>Immobilienwissen von A bis Z</h2><p class="muted">{{ lexiconCount|default(0) }} Begriffe mit den Erklärungen aus Ihrem Original-Lexikon. Schnell durchsuchbar – auch über die Suche oben.</p><form method="get" action="{{ path('app_lexicon') }}" class="toolbar"><div class="field" style="flex:1"><label class="sr-only" for="academy-lexicon-query">Begriff im Lexikon suchen</label><input id="academy-lexicon-query" name="q" placeholder="Zum Beispiel: Erbbaurecht …" maxlength="150"></div><button class="btn btn-primary" type="submit">Nachschlagen</button></form></section></div>
{{ parts.filters(categories,q,category,favoriteOnly,true,false,false) }}
<div class="grid grid-3">{% for item in items %}<article class="card stack"><div class="content-symbol" aria-hidden="true">{{ item.data.kind|default('article') == 'video' ? '▷' : '▧' }}</div>{{ parts.category(item.data.category|default('Wissen'),item.data.isDemo|default(true)) }}<h2><a href="{{ path('app_academy_article',{id:item.id}) }}">{{ item.title }}</a></h2><p class="muted">{{ item.data.teaser|default('Ein Lernbaustein für Ihren Makleralltag.') }}</p><small class="muted">{{ item.data.kind|default('article') == 'video' ? 'Internes Lernvideo' : item.data.readingMinutes|default(5) ~ ' Minuten Lesezeit' }}{% if item.id in learned %} · ✓ Abgeschlossen{% endif %}</small><div class="toolbar"><a class="btn btn-primary" href="{{ path('app_academy_article',{id:item.id}) }}">{{ item.data.kind|default('article') == 'video' ? 'Video ansehen' : (item.id in learned ? 'Erneut lesen' : 'Jetzt lesen') }}</a>{{ parts.favorite('academy',item,favorites,'list') }}</div></article>{% else %}<div class="card empty-state"><h2>Kein Lerninhalt gefunden</h2><p>Passen Sie Ihre Suche an.</p><a class="btn btn-secondary" href="{{ path('app_academy') }}">Alle Inhalte</a></div>{% endfor %}</div>
{% if is_granted('ROLE_ADMIN') %}<details class="card" style="margin-top:24px"><summary style="font-weight:700;cursor:pointer">Lernvideo intern bereitstellen</summary><p class="muted">Ein lokales MP4- oder WebM-Video bis 12 MiB. Die Datei bleibt im geschützten Portal, ohne externen Upload.</p><form method="post" action="{{ path('app_academy_video_upload') }}" enctype="multipart/form-data" class="form-grid"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="academy-video-title">Titel des Lernvideos</label><input id="academy-video-title" name="title" minlength="3" maxlength="180" required></div><div class="field"><label for="academy-video-file">Videodatei (MP4 / WebM)</label><input id="academy-video-file" type="file" name="video" accept="video/mp4,video/webm" required></div><button class="btn btn-primary" type="submit">Lernvideo speichern</button></form></details>{% endif %}
<p class="muted"><small>Interne Lerninhalte dienen der Orientierung. Sie ersetzen keine Fachberatung oder zertifizierte Pflichtschulung.</small></p>
{% endblock %}
