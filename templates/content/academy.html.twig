{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}Wissen / Academy{% endblock %}
{% block breadcrumb %}Wissen / Academy{% endblock %}
{% block stylesheets %}<style>
.academy-workspace{height:100%;min-height:0;display:flex;flex-direction:column;gap:12px}.academy-title{display:flex;align-items:center;gap:10px}.academy-title h1{font-size:24px;margin:0;flex:1}.academy-title .icon-button{width:35px;height:35px}.academy-onboarding{display:flex;align-items:center;gap:18px;padding:16px 20px!important;flex:none}.academy-onboarding h2{font-size:14px;white-space:nowrap;margin:0}.academy-onboarding progress{flex:1;min-width:70px;height:7px;accent-color:var(--accent,#ff6a00)}.academy-onboarding small{font-size:11px;white-space:nowrap;color:var(--muted)}.academy-onboarding .btn{font-size:11px;padding:8px 12px}.academy-search{display:flex;gap:8px;align-items:center}.academy-search input{flex:1;height:40px}.academy-results{flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:14px}.academy-items{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-content:start}.academy-item{padding:16px!important;display:flex;flex-direction:column;gap:9px}.academy-item h2{font-size:14px;line-height:1.45;margin:0}.academy-item h2 a:hover{color:var(--accent,#ff6a00)}.academy-item p{font-size:11px;line-height:1.6;margin:0;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.academy-item footer{display:flex;align-items:center;gap:8px;margin-top:auto}.academy-item footer small{flex:1;font-size:10px;color:var(--muted)}.academy-item footer .icon-button{width:30px;height:30px}.academy-item .badge{font-size:9px;width:fit-content}.academy-item form{margin:0}.academy-results-label{display:flex;gap:8px;align-items:center;font-size:12px;margin:2px 0}.academy-results-label span{font-size:10px;color:var(--muted)}.academy-upload{position:relative}.academy-upload summary{list-style:none;cursor:pointer}.academy-upload summary::-webkit-details-marker{display:none}.academy-upload-form{position:absolute;right:0;top:45px;z-index:5;width:330px;max-width:calc(100vw - 40px);background:var(--surface,#fff);border:1px solid var(--border,#ddd);box-shadow:0 15px 45px #0002;padding:18px;border-radius:12px;display:grid;gap:12px}@media(max-width:1100px){.academy-items{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.academy-title h1{font-size:21px}.academy-onboarding{gap:10px;padding:12px!important;flex-wrap:wrap}.academy-onboarding h2{font-size:12px}.academy-onboarding progress{order:3;flex-basis:100%}.academy-onboarding small{margin-left:auto}.academy-items{grid-template-columns:1fr}.academy-item{padding:13px!important}.academy-item h2{font-size:13px}.academy-onboarding .btn{font-size:10px;padding:7px 9px}}
</style>{% endblock %}
{% block body %}
<div class="academy-workspace">
<header class="academy-title"><h1>Wissen / Academy</h1><a class="icon-button" href="{{ path('app_lexicon') }}" aria-label="Immobilienlexikon öffnen" title="Immobilienlexikon">{{ icon('book-open') }}</a>{% if is_granted('ROLE_ADMIN') %}<details class="academy-upload"><summary class="icon-button" aria-label="Lernvideo hinzufügen" title="Lernvideo hinzufügen">{{ icon('plus') }}</summary><form method="post" action="{{ path('app_academy_video_upload') }}" enctype="multipart/form-data" class="academy-upload-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="academy-video-title">Titel</label><input id="academy-video-title" name="title" minlength="3" maxlength="180" required></div><div class="field"><label for="academy-video-file">Video · MP4 / WebM, bis 12 MiB</label><input id="academy-video-file" type="file" name="video" accept="video/mp4,video/webm" required></div><button class="btn btn-primary" type="submit">Speichern</button></form></details>{% endif %}</header>
<section class="card academy-onboarding" aria-label="Lernpfad Makler-Onboarding"><h2>Makler-Onboarding</h2><progress value="{{ learned|length }}" max="{{ all|length ?: 1 }}" aria-label="Lernfortschritt">{{ learned|length }} / {{ all|length }}</progress><small>{{ learned|length }} von {{ all|length }} abgeschlossen</small><a class="btn btn-secondary" href="{{ all|length ? path('app_academy_article',{id:all[0].id}) : path('app_help') }}">{{ learned|length ? 'Weiter' : 'Starten' }} →</a></section>
<form method="get" class="academy-search" role="search" aria-label="Academy durchsuchen"><label class="sr-only" for="academy-query">Ratgeber, Videos und Begriffe suchen</label><input type="search" id="academy-query" name="q" value="{{ q }}" placeholder="Ratgeber, Videos oder Begriffe suchen …" maxlength="200"><button class="icon-button" type="submit" aria-label="Academy durchsuchen" title="Suchen">{{ icon('search') }}</button>{% if q %}<a class="icon-button" href="{{ path('app_academy') }}" aria-label="Suche zurücksetzen" title="Zurücksetzen">{{ icon('x') }}</a>{% endif %}</form>
<div class="academy-results">
{% if items %}{% if q %}<h2 class="academy-results-label">Artikel & Videos <span>{{ items|length }}</span></h2>{% endif %}<div class="academy-items">{% for item in items %}<article class="card academy-item"><span class="badge">{{ item.data.kind|default('article') == 'video' ? 'Video' : item.data.category|default('Wissen') }}</span><h2><a href="{{ path('app_academy_article',{id:item.id}) }}">{{ item.title }}</a></h2><p>{{ item.data.teaser|default('') }}</p><footer><small>{{ item.data.kind|default('article') == 'video' ? 'Lernvideo' : item.data.readingMinutes|default(5) ~ ' Min.' }}{% if item.id in learned %} · ✓ Abgeschlossen{% endif %}</small><form method="post" action="{{ path('app_content_preference',{kind:'favorite',type:'academy',id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="back" value="list"><button class="icon-button" type="submit" title="{{ item.id in favorites ? 'Nicht mehr merken' : 'Merken' }}" aria-label="{{ item.id in favorites ? 'Aus Merkliste entfernen: ' : 'Merken: ' }}{{ item.title }}" aria-pressed="{{ item.id in favorites ? 'true' : 'false' }}">{{ item.id in favorites ? '★' : '☆' }}</button></form><a class="icon-button" href="{{ path('app_academy_article',{id:item.id}) }}" aria-label="{{ item.title }} öffnen" title="Öffnen">{{ icon(item.data.kind|default('article') == 'video' ? 'play' : 'arrow-right') }}</a></footer></article>{% endfor %}</div>{% endif %}
{% if lexiconResults %}<h2 class="academy-results-label">Immobilienlexikon <span>{{ lexiconResults|length }} Begriffe</span></h2><div class="academy-items">{% for entry in lexiconResults %}<article class="card academy-item"><span class="badge">Lexikon · Seite {{ entry.page }}</span><h2><a href="{{ path('app_lexicon_term',{id:entry.id}) }}">{{ entry.term }}</a></h2><p>{{ entry.definition }}</p><footer><small>CHASE-Originallexikon</small><a class="icon-button" href="{{ path('app_lexicon_term',{id:entry.id}) }}" aria-label="{{ entry.term }} nachschlagen" title="Nachschlagen">{{ icon('arrow-right') }}</a></footer></article>{% endfor %}</div>{% endif %}
{% if not items and not lexiconResults %}<div class="empty-state"><p>Keine passenden Inhalte.</p></div>{% endif %}
</div></div>
{% endblock %}
