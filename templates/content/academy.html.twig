{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}Wissen / Academy · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Wissen, das Sie weiterbringt</span><h1>Wissen / Academy</h1><p>Praktische Lernbausteine für Ihren Alltag mit CHASE.</p></div><span class="badge">{{ learned|length }} von {{ all|length }} abgeschlossen</span></div>
<section class="card academy-path"><div class="toolbar"><div><span class="badge">Lernpfad</span><h2>Ihr Makler-Onboarding</h2><p class="muted">Schritt für Schritt zu einem sicheren Start. Ihr Fortschritt wird nur für Ihr Konto gespeichert.</p></div><a class="btn btn-primary" href="{{ all|length ? path('app_academy_article', {id: all[0].id}) : path('app_help') }}">{{ learned|length ? 'Weiterlernen' : 'Lernpfad starten' }}</a></div><progress value="{{ learned|length }}" max="{{ all|length ?: 1 }}" aria-label="Lernfortschritt" style="width:100%;accent-color:var(--accent,#FF6A00)">{{ learned|length }} / {{ all|length }}</progress><p class="muted"><small>Interne Demo-Lerninhalte, keine zertifizierte Pflichtschulung.</small></p></section>
{{ parts.filters(categories, q, category, favoriteOnly, true, false, false) }}
<div class="grid grid-3">{% for item in items %}<article class="card stack"><div class="content-symbol" aria-hidden="true">▧</div>{{ parts.category(item.data.category|default('Wissen'), true) }}<h2><a href="{{ path('app_academy_article', {id:item.id}) }}">{{ item.title }}</a></h2><p class="muted">{{ item.data.teaser|default('Ein Lernbaustein für Ihren Makleralltag.') }}</p><small class="muted">{{ item.data.readingMinutes|default(5) }} Minuten Lesezeit{% if item.id in learned %} · ✓ Abgeschlossen{% endif %}</small><div class="toolbar"><a class="btn btn-primary" href="{{ path('app_academy_article', {id:item.id}) }}">{{ item.id in learned ? 'Erneut lesen' : 'Jetzt lesen' }}</a>{{ parts.favorite('academy', item, favorites, 'list') }}</div></article>{% else %}<div class="card empty-state"><h2>Kein Lerninhalt gefunden</h2><p>Passen Sie Ihre Suche an.</p><a class="btn btn-secondary" href="{{ path('app_academy') }}">Alle Inhalte</a></div>{% endfor %}</div>
{% endblock %}
