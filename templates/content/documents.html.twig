{% extends 'base.html.twig' %}
{% block title %}Dokumente{% endblock %}
{% block breadcrumb %}Dokumente{% endblock %}
{% block stylesheets %}<style>
.documents-workspace{height:100%;min-height:0;display:flex;flex-direction:column;gap:12px}.documents-title{display:flex;align-items:center;justify-content:space-between;gap:12px}.documents-title h1{margin:0;font-size:24px}.documents-title small{font-size:11px;color:var(--muted)}.document-hub{display:grid;grid-template-columns:215px minmax(0,1fr);gap:16px;flex:1;min-height:0}.document-folders{padding:10px!important;overflow:auto;min-height:0}.document-folders a{display:flex;align-items:center;gap:9px;padding:10px;border-radius:8px;font-size:.8rem;line-height:1.35}.document-folders a:hover,.document-folders a.active{background:rgba(255,106,0,.10);color:var(--accent,#ff6a00)}.document-folders a .icon{width:17px;height:17px;flex:none}.document-folders a b{margin-left:auto;font-size:10px;color:var(--muted);font-weight:500}.document-content{display:flex;flex-direction:column;min-width:0;min-height:0;gap:10px}.document-filter{display:flex;gap:8px;align-items:center;position:relative}.document-filter .document-search{flex:1;min-width:0}.document-filter select{width:170px}.document-filter input,.document-filter select{height:39px}.document-filter>button{height:39px;flex:none}.document-options{position:relative}.document-options summary{list-style:none;cursor:pointer}.document-options summary::-webkit-details-marker{display:none}.document-options-panel{position:absolute;right:0;top:45px;z-index:8;background:var(--surface,#fff);border:1px solid var(--border,#e4e8ef);border-radius:12px;padding:16px;box-shadow:0 12px 35px #0002;width:265px;display:grid;gap:12px}.document-options-panel select{width:100%}.document-list{padding:0 16px!important;overflow:auto;min-height:0;flex:1}.document-row{display:grid;grid-template-columns:minmax(0,1fr) 58px 90px auto;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--border,#e9e9ee)}.document-row:last-child{border-bottom:0}.document-row h2{font-size:.82rem;margin:0 0 3px;line-height:1.35}.document-row h2 a:hover{color:var(--accent,#ff6a00)}.document-row p{font-size:10px;margin:0}.document-file{display:flex;gap:10px;align-items:center;min-width:0}.document-file>.icon{width:20px;height:24px;flex:none;color:var(--accent,#ff6a00)}.document-row-actions{display:flex;gap:4px;align-items:center}.document-row-actions .icon-button{width:31px;height:31px}.document-row-actions form{margin:0}.document-row time{font-size:11px;color:var(--muted)}.document-row .badge{font-size:9px;padding:3px 6px}.document-pagination{display:flex;gap:9px;justify-content:space-between;align-items:center;min-height:28px;font-size:11px;color:var(--muted)}.document-pagination nav{display:flex;gap:8px;align-items:center}.document-pagination .icon-button{width:28px;height:28px}.document-row-heading{position:sticky;top:0;z-index:1;background:var(--surface,#fff);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;padding:10px 0}.document-mobile-date{display:none}@media(max-width:1050px){.document-hub{grid-template-columns:180px minmax(0,1fr);gap:12px}.document-row{grid-template-columns:minmax(0,1fr) 50px auto}.document-row>time{display:none}.document-mobile-date{display:inline}.document-filter select{width:145px}}@media(max-width:750px){.documents-title h1{font-size:21px}.documents-title small{font-size:9px}.document-hub{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr);gap:10px}.document-folders{display:flex;overflow-x:auto;padding:6px!important;gap:3px}.document-folders a{white-space:nowrap;flex:none;padding:8px;font-size:11px}.document-folders a b{display:none}.document-filter>select{width:115px;font-size:11px}.document-row{grid-template-columns:minmax(0,1fr) auto;gap:7px}.document-row>.badge{display:none}.document-row-heading{display:none}.document-row h2{font-size:12px}.document-list{padding:0 11px!important}.document-file{gap:8px}.document-row-actions .icon-button{width:29px;height:29px}.document-options-panel{width:240px}.document-pagination{font-size:10px}.document-mobile-date{display:inline}}
</style>{% endblock %}
{% block body %}
<div class="documents-workspace">
<header class="documents-title"><h1>Dokumente</h1>{% if lastUpload %}<small>Stand {{ lastUpload|date('d.m.Y H:i','Europe/Berlin') }}</small>{% endif %}</header>
<div class="document-hub">
<nav class="card document-folders" aria-label="Dokumentkategorien"><a href="{{ path('app_documents') }}" class="{{ category == '' ? 'active' : '' }}">{{ icon('file-text') }} Alle Unterlagen<b>{{ counts|reduce((sum,count)=>sum+count,0) }}</b></a>{% for folder in categories %}<a href="{{ path('app_documents',{category:folder}) }}" class="{{ category == folder ? 'active' : '' }}" {{ category == folder ? 'aria-current="page"' : '' }}>{{ icon('folder') }}<span>{{ folder }}</span><b>{{ counts[folder]|default(0) }}</b></a>{% endfor %}</nav>
<section class="document-content">
<form method="get" class="document-filter" aria-label="Dokumente suchen und sortieren"><input type="hidden" name="category" value="{{ category }}">{% if showDemo %}<input type="hidden" name="demo" value="1">{% endif %}<label class="sr-only" for="document-q">Unterlagen durchsuchen</label><input class="document-search" id="document-q" type="search" name="q" value="{{ q }}" placeholder="Unterlagen suchen …" maxlength="200"><label class="sr-only" for="document-sort">Sortieren</label><select name="sort" id="document-sort">{% for key,label in {'uploaded_desc':'Zuletzt hochgeladen','uploaded_asc':'Älteste zuerst','title_asc':'Name A–Z','title_desc':'Name Z–A','type':'Dateityp'} %}<option value="{{ key }}" {{ sort == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><details class="document-options"><summary class="icon-button" aria-label="Weitere Filter" title="Weitere Filter">{{ icon('sliders') }}</summary><div class="document-options-panel"><div class="field"><label for="document-format">Dateityp</label><select name="format" id="document-format"><option value="">Alle Typen</option>{% for item in formats %}<option value="{{ item }}" {{ format == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div>{% if folders %}<div class="field"><label for="document-folder">Unterordner</label><select id="document-folder" name="folder"><option value="">Alle Unterordner</option>{% for folder in folders %}<option value="{{ folder }}" {{ subfolder == folder ? 'selected' : '' }}>{{ folder }}</option>{% endfor %}</select></div>{% endif %}<label class="checkbox-field"><input type="checkbox" name="favorites" value="1" {{ favoriteOnly ? 'checked' : '' }}> Merkliste</label><button class="btn btn-primary" type="submit">Anwenden</button><a href="{{ path('app_documents',{category:category}) }}">Zurücksetzen</a>{% if hasProvided %}<a href="{{ path('app_documents',{demo:showDemo ? 0 : 1}) }}">{{ showDemo ? 'Demo-Muster ausblenden' : 'Ältere Demo-Muster anzeigen' }}</a>{% endif %}</div></details><button class="icon-button" type="submit" aria-label="Suche und Sortierung anwenden" title="Suchen">{{ icon('search') }}</button></form>
<div class="card document-list" aria-label="Dokumentliste"><div class="document-row document-row-heading" aria-hidden="true"><span>Dokument</span><span>Typ</span><time>Hochgeladen</time><span></span></div>{% for item in items %}<article class="document-row"><div class="document-file">{{ icon(item.data.format|default('TXT') == 'URL' ? 'arrow-up-right' : 'file-text') }}<div><h2><a href="{{ path('app_document',{id:item.id}) }}">{{ item.title }}</a></h2><p class="muted">{{ item.data.subfolder|default('') ?: item.data.category|default('Vorlagen') }}{% if item.data.isDemo|default(false) %} · Demo{% endif %}<span class="document-mobile-date"> · {{ item.data.uploadedAt|default(item.createdAt|date('c'))|date('d.m.Y','Europe/Berlin') }}</span></p></div></div><span class="badge">{{ item.data.format|default('TXT-DEMO') }}</span><time datetime="{{ item.data.uploadedAt|default(item.createdAt|date('c')) }}">{{ item.data.uploadedAt|default(item.createdAt|date('c'))|date('d.m.Y','Europe/Berlin') }}</time><div class="document-row-actions"><form method="post" action="{{ path('app_content_preference',{kind:'favorite',type:'document',id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="back" value="list"><button class="icon-button" type="submit" title="{{ item.id in favorites ? 'Aus Merkliste entfernen' : 'Merken' }}" aria-label="{{ item.id in favorites ? 'Aus Merkliste entfernen: ' : 'Merken: ' }}{{ item.title }}" aria-pressed="{{ item.id in favorites ? 'true' : 'false' }}">{{ item.id in favorites ? '★' : '☆' }}</button></form><a class="icon-button" href="{{ path('app_document_download',{id:item.id}) }}" title="Herunterladen" aria-label="{{ item.title }} herunterladen">{{ icon('download') }}</a></div></article>{% else %}<div class="empty-state"><p>Keine passenden Unterlagen.</p><a class="btn btn-secondary" href="{{ path('app_documents',{category:category}) }}">Filter zurücksetzen</a></div>{% endfor %}</div>
<footer class="document-pagination"><span>{{ total }} Unterlagen{% if category %} · {{ category }}{% endif %}</span><nav aria-label="Ergebnisseiten">{% if page > 1 %}<a class="icon-button" href="{{ path('app_documents',app.request.query.all|merge({page:page-1})) }}" aria-label="Vorherige Seite">{{ icon('chevron-left') }}</a>{% endif %}{% if pages > 1 %}<span>{{ page }} / {{ pages }}</span>{% endif %}{% if page < pages %}<a class="icon-button" href="{{ path('app_documents',app.request.query.all|merge({page:page+1})) }}" aria-label="Nächste Seite">{{ icon('chevron-right') }}</a>{% endif %}</nav></footer>
</section></div></div>
{% endblock %}
