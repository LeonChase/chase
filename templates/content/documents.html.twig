{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}Dokumente{% endblock %}
{% block breadcrumb %}Dokumente{% endblock %}
{% block stylesheets %}<style>
.document-hub{display:grid;grid-template-columns:235px minmax(0,1fr);gap:24px;align-items:start}.document-folders{padding:14px!important;position:sticky;top:98px}.document-folders a{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:9px;font-size:.86rem;color:var(--text);line-height:1.4}.document-folders a:hover,.document-folders a.active{background:rgba(255,106,0,.10);color:var(--accent,#ff6a00)}.document-folders a b{margin-left:auto;font-size:.72rem;color:var(--muted);font-weight:500}.document-folders h2{padding:7px 12px;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.document-filter{display:flex;flex-wrap:wrap;gap:12px;align-items:end}.document-filter .field{flex:1;min-width:125px}.document-filter .search-field{flex:2;min-width:200px}.document-list{padding:0 22px}.document-row{display:grid;grid-template-columns:minmax(0,1fr) 66px 125px auto;gap:16px;align-items:center;padding:18px 0;border-bottom:1px solid var(--border,#e9e9ee)}.document-row:last-child{border-bottom:0}.document-row h2{font-size:.93rem;margin:0 0 5px}.document-row h2 a:hover{color:var(--accent,#ff6a00)}.document-row p{font-size:.76rem;margin:0}.document-file{display:flex;gap:12px;align-items:center;min-width:0}.document-file .content-symbol{width:40px;height:46px;flex:none;margin:0;font-size:20px}.document-row-actions{display:flex;gap:6px;align-items:center}.document-row-actions .btn{font-size:.78rem;padding:9px 11px}.document-row-actions form .btn{width:36px;height:36px;padding:0;font-size:1.1rem}.document-row time{font-size:.78rem;color:var(--muted)}.document-pagination{display:flex;gap:8px;justify-content:center;align-items:center;margin-top:20px}.document-hub .stack{min-width:0}.document-path{overflow-wrap:anywhere}.document-row-heading{font-size:.69rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;padding-bottom:10px}.document-row-heading .document-file{padding-left:52px}@media(max-width:1100px){.document-hub{grid-template-columns:190px minmax(0,1fr);gap:15px}.document-row{grid-template-columns:minmax(0,1fr) 60px auto}.document-row time{display:none}.document-row-heading time{display:none}}@media(max-width:750px){.document-hub{grid-template-columns:1fr}.document-folders{position:static;display:flex;overflow-x:auto;gap:4px}.document-folders h2{display:none}.document-folders a{white-space:nowrap;flex:none}.document-row{grid-template-columns:minmax(0,1fr) auto;gap:9px}.document-row>.badge{display:none}.document-row-actions>a.btn{font-size:0}.document-row-actions>a.btn svg{width:17px;height:17px}.document-row-heading{display:none}.document-list{padding:0 15px}.document-filter .field{min-width:calc(50% - 12px)}}
</style>{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Alles griffbereit</span><h1>Dokumente</h1><p>Ihre Arbeitsunterlagen. Klar geordnet und schnell gefunden.</p></div><span class="badge">{{ total }} {{ total == 1 ? 'Unterlage' : 'Unterlagen' }}</span></div>
<div class="document-hub">
<nav class="card document-folders" aria-label="Dokumentkategorien"><h2>Bibliothek</h2><a href="{{ path('app_documents') }}" class="{{ category == '' ? 'active' : '' }}">{{ icon('file-text') }} Alle Unterlagen<b>{{ counts|reduce((sum, count) => sum + count, 0) }}</b></a>{% for folder in categories %}<a href="{{ path('app_documents',{category:folder}) }}" class="{{ category == folder ? 'active' : '' }}" {{ category == folder ? 'aria-current="page"' : '' }}>{{ icon('folder') }}<span>{{ folder }}</span><b>{{ counts[folder]|default(0) }}</b></a>{% endfor %}</nav>
<div class="stack"><section class="card"><form method="get" class="document-filter" aria-label="Dokumente suchen und sortieren"><input type="hidden" name="category" value="{{ category }}">{% if showDemo %}<input type="hidden" name="demo" value="1">{% endif %}<div class="field search-field"><label for="document-q">Unterlagen durchsuchen</label><input id="document-q" type="search" name="q" value="{{ q }}" placeholder="Titel, Inhalt oder Stichwort …" maxlength="200"></div><div class="field"><label for="document-format">Dateityp</label><select name="format" id="document-format"><option value="">Alle Typen</option>{% for item in formats %}<option value="{{ item }}" {{ format == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div><div class="field"><label for="document-sort">Sortieren</label><select name="sort" id="document-sort">{% for key,label in {'uploaded_desc':'Zuletzt hochgeladen','uploaded_asc':'Älteste zuerst','title_asc':'Name A–Z','title_desc':'Name Z–A','type':'Dateityp'} %}<option value="{{ key }}" {{ sort == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>{% if folders %}<div class="field"><label for="document-folder">Unterordner</label><select id="document-folder" name="folder"><option value="">Alle Unterordner</option>{% for folder in folders %}<option value="{{ folder }}" {{ subfolder == folder ? 'selected' : '' }}>{{ folder }}</option>{% endfor %}</select></div>{% endif %}<label class="checkbox-field"><input type="checkbox" name="favorites" value="1" {{ favoriteOnly ? 'checked' : '' }}> Merkliste</label><button class="btn btn-primary" type="submit">Anwenden</button></form></section>
<div class="toolbar"><div><strong>{{ category ?: 'Alle Unterlagen' }}</strong>{% if q %}<span class="muted"> · Suche „{{ q }}“</span>{% endif %}</div>{% if lastUpload %}<small class="muted">Letzter Upload: {{ lastUpload|date('d.m.Y H:i','Europe/Berlin') }}</small>{% endif %}</div>
<section class="card document-list" aria-label="Dokumentliste"><div class="document-row document-row-heading" aria-hidden="true"><span class="document-file">Dokument / Unterordner</span><span>Dateityp</span><time>Hochgeladen</time><span>Aktionen</span></div>{% for item in items %}<article class="document-row"><div class="document-file"><span class="content-symbol" aria-hidden="true">{{ item.data.format|default('TXT') == 'URL' ? '↗' : '▤' }}</span><div><h2><a href="{{ path('app_document',{id:item.id}) }}">{{ item.title }}</a></h2><p class="muted">{{ item.data.category|default('Vorlagen') }}{% if item.data.subfolder|default('') %} / {{ item.data.subfolder }}{% endif %}{% if item.data.isDemo|default(false) %} · Demo-Muster{% endif %}</p></div></div><span class="badge">{{ item.data.format|default('TXT-DEMO') }}</span><time datetime="{{ item.data.uploadedAt|default(item.createdAt|date('c')) }}">{{ item.data.uploadedAt|default(item.createdAt|date('c'))|date('d.m.Y','Europe/Berlin') }}<br><small>{{ item.data.uploadedAt|default(item.createdAt|date('c'))|date('H:i','Europe/Berlin') }} Uhr</small></time><div class="document-row-actions"><form method="post" action="{{ path('app_content_preference',{kind:'favorite',type:'document',id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="back" value="list"><button class="btn btn-secondary" type="submit" aria-label="{{ item.id in favorites ? 'Aus Merkliste entfernen: ' : 'Merken: ' }}{{ item.title }}" aria-pressed="{{ item.id in favorites ? 'true' : 'false' }}">{{ item.id in favorites ? '★' : '☆' }}</button></form><a class="btn btn-secondary" href="{{ path('app_document_download',{id:item.id}) }}" aria-label="{{ item.title }} herunterladen">{{ icon('download') }} Herunterladen</a></div></article>{% else %}<div class="empty-state"><h2>Keine passenden Unterlagen</h2><p>Wählen Sie eine andere Kategorie oder ein kürzeres Stichwort.</p><a class="btn btn-secondary" href="{{ path('app_documents',{category:category}) }}">Filter zurücksetzen</a></div>{% endfor %}</section>
{% if pages > 1 %}<nav class="document-pagination" aria-label="Ergebnisseiten">{% if page > 1 %}<a class="btn btn-secondary" href="{{ path('app_documents',app.request.query.all|merge({page:page-1})) }}">← Zurück</a>{% endif %}<span class="muted">Seite {{ page }} von {{ pages }}</span>{% if page < pages %}<a class="btn btn-secondary" href="{{ path('app_documents',app.request.query.all|merge({page:page+1})) }}">Weiter →</a>{% endif %}</nav>{% endif %}
<p class="muted"><small>{{ hasProvided ? 'Bereitgestellte CHASE-Unterlagen · fachliche Freigabe vor Verwendung prüfen. Originaldateien sind nur nach Anmeldung zugänglich.' : 'Unverbindliche Demo-Muster · vor Verwendung fachlich prüfen.' }}{% if hasProvided %} <a href="{{ path('app_documents',{demo:showDemo ? 0 : 1}) }}">{{ showDemo ? 'Demo-Muster ausblenden' : 'Ältere Demo-Muster einblenden' }}</a>{% endif %}</small></p>
</div></div>
{% endblock %}
