{% extends 'base.html.twig' %}
{% block title %}Werbekatalog{% endblock %}
{% block breadcrumb %}Werbekatalog{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/catalog.css">{% endblock %}
{% block javascripts %}<script src="/assets/catalog.js" defer></script>{% endblock %}
{% block body %}
<div class="catalog-workspace">
<header class="catalog-toolbar"><h1>Werbekatalog <small>{{ items|length }}</small></h1><form method="get" action="{{ path('app_advertising') }}" class="catalog-compact-search"><label class="sr-only" for="catalog-search">Werbemittel suchen</label>{{ icon('search') }}<input id="catalog-search" type="search" name="q" value="{{ q }}" placeholder="Werbemittel suchen" maxlength="200"><input type="hidden" name="category" value="{{ category }}">{% if favoriteOnly %}<input type="hidden" name="favorites" value="1">{% endif %}<label class="sr-only" for="catalog-sort">Werbemittel sortieren</label><select class="catalog-sort" id="catalog-sort" name="sort" onchange="this.form.submit()">{% for value,label in {category:'Kategorie',name:'Name A–Z',newest:'Neueste zuerst'} %}<option value="{{ value }}" {{ sort == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></form><div class="catalog-toolbar-actions"><a class="icon-button {{ favoriteOnly ? 'is-selected' : '' }}" href="{{ path('app_advertising',{favorites:favoriteOnly ? 0 : 1,q:q,category:category,sort:sort}) }}" title="Merkliste" aria-label="Merkliste {{ favoriteOnly ? 'ausblenden' : 'anzeigen' }}">{{ icon('bookmark') }}</a>{% if catalog.available %}<a href="{{ path('app_advertising_original') }}" class="icon-button" title="Originalkatalog als PDF" aria-label="Originalkatalog als PDF herunterladen">{{ icon('file-text') }}</a>{% endif %}{% if is_granted('ROLE_ADMIN') %}<a class="icon-button" href="{{ path('app_advertising_manage') }}" aria-label="Werbemittel und Kategorien verwalten" title="Verwalten">{{ icon('settings') }}</a>{% endif %}<a class="btn btn-primary catalog-cart-link" href="{{ path('app_advertising_cart') }}">{{ icon('shopping-bag') }}<span class="catalog-cart-label">Auswahl</span><b>{{ cartCount }}</b></a></div></header>
<nav class="catalog-category-tabs" aria-label="Werbemittel-Kategorien"><a href="{{ path('app_advertising',{q:q,favorites:favoriteOnly ? 1 : 0,sort:sort}) }}" class="{{ category == '' ? 'active' : '' }}">Alle</a>{% for c in categories %}<a href="{{ path('app_advertising',{q:q,category:c,favorites:favoriteOnly ? 1 : 0,sort:sort}) }}" class="{{ c == category ? 'active' : '' }}">{{ c }}</a>{% endfor %}</nav>
{% if app.request.query.get('tab') == 'requests' %}<div class="catalog-products-scroll requests-scroll">{% include 'catalog/_requests.html.twig' %}</div>{% else %}
<div class="catalog-products-scroll"><div class="catalog-visual-grid">{% for item in items %}{% set meta=metadata[item.id] %}<article class="catalog-product-card catalog-visual-card"><div class="catalog-visual-image">{% if meta.hasImage %}<img src="{{ path('app_advertising_product_image',{id:item.id}) }}" alt="{{ item.title }} – Originalmotiv" loading="lazy" width="500" height="350">{% else %}<span class="catalog-image-missing">{{ icon('images') }}<small>Produktbild folgt</small></span>{% endif %}<form method="post" action="{{ path('app_advertising_favorite',{id:item.id}) }}" class="catalog-image-favorite"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="page" value="{{ page }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="category" value="{{ category }}"><input type="hidden" name="favorites" value="{{ favoriteOnly ? 1 : 0 }}"><input type="hidden" name="sort" value="{{ sort }}"><button type="submit" class="icon-button {{ item.id in favorites ? 'is-selected' : '' }}" aria-label="{{ item.id in favorites ? 'Nicht mehr merken: ' : 'Merken: ' }}{{ item.title }}" aria-pressed="{{ item.id in favorites ? 'true' : 'false' }}">{{ icon('bookmark') }}</button></form>{% if is_granted('ROLE_ADMIN') %}<a class="icon-button catalog-image-edit" href="{{ path('app_advertising_product_edit',{id:item.id}) }}" aria-label="{{ item.title }} bearbeiten" title="Bearbeiten">{{ icon('edit') }}</a>{% endif %}</div><div class="catalog-visual-content"><h2>{{ item.title }}</h2>{% if meta.referenceQuote|default(null) %}<div class="catalog-visual-price">{% set quote=meta.referenceQuote %}<span>{{ quote.amount|number_format(2,',','.') }} € <small>{{ quote.taxMode == 'net' ? 'netto' : 'brutto' }} / {{ quote.quantity }} {{ meta.unit|default('Stück') }}</small></span><a href="{{ quote.url }}" target="_blank" rel="noopener noreferrer" title="Manuell hinterlegter Musterpreis · {{ quote.provider }} · Stand {{ quote.date|date('d.m.Y') }} · kein verbindliches Angebot" aria-label="Preisquelle: {{ quote.provider }}, Stand {{ quote.date|date('d.m.Y') }}">{{ icon('help-circle') }}</a></div>{% endif %}<form class="catalog-card-buy" method="post" action="{{ path('app_advertising_cart_item',{id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="page" value="{{ page }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="category" value="{{ category }}"><input type="hidden" name="favorites" value="{{ favoriteOnly ? 1 : 0 }}"><input type="hidden" name="sort" value="{{ sort }}"><label class="sr-only" for="quantity-{{ item.id }}">Gewünschte Menge für {{ item.title }}</label><span class="catalog-quantity" data-quantity-control><input id="quantity-{{ item.id }}" type="number" name="quantity" min="1" max="999999999" step="1" value="1" inputmode="numeric" required><button type="button" data-quantity-change="-1" aria-label="Menge für {{ item.title }} verringern">−</button><button type="button" data-quantity-change="1" aria-label="Menge für {{ item.title }} erhöhen">+</button></span><small>{{ meta.unit|default('Stück') }}</small><button type="submit" class="btn btn-primary" aria-label="{{ item.title }} in die Auswahl legen">{{ icon('plus') }}{{ icon('shopping-bag') }}</button></form></div></article>{% else %}<div class="empty-state"><h3>Keine passenden Werbemittel</h3><a class="btn btn-secondary" href="{{ path('app_advertising') }}">Alle anzeigen</a></div>{% endfor %}</div></div>
{% endif %}<footer class="catalog-status-bar"><a href="{{ path('app_advertising',{tab:'requests'}) }}">Anfrageentwürfe{% if requests|length %} ({{ requests|length }}){% endif %}</a><small>Lokale Auswahl · keine Bestellung</small>{% if not catalog.previews and is_granted('ROLE_ADMIN') and catalog.available %}<form method="post" action="{{ path('app_advertising_render') }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button type="submit" class="text-link">Produktbilder vorbereiten</button></form>{% endif %}</footer>
</div>
{% endblock %}
