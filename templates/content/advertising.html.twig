{% extends 'base.html.twig' %}
{% block title %}Werbekatalog{% endblock %}
{% block breadcrumb %}Werbekatalog{% endblock %}
{% block body %}
<div class="page-heading catalog-heading"><div><span class="eyebrow">IHR AUFTRITT. UNSERE MARKE.</span><h1>Stark auftreten. CHASE zeigen.</h1><p>Entdecken Sie den CHASE Werbekatalog und stellen Sie Ihre persönliche Auswahl zusammen.</p></div><a class="btn btn-primary catalog-cart-link" href="{{ path('app_advertising_cart') }}">{{ icon('shopping-bag') }}Meine Auswahl <span>{{ cartCount }}</span></a></div>
<nav class="tabs catalog-tabs" aria-label="Werbekatalog-Bereiche"><a href="{{ path('app_advertising') }}" class="{{ app.request.query.get('tab') != 'requests' ? 'active' : '' }}">Katalog entdecken</a><a href="{{ path('app_advertising_cart') }}">Meine Auswahl{% if cartCount %} ({{ cartCount }}){% endif %}</a><a href="{{ path('app_advertising',{tab:'requests'}) }}" class="{{ app.request.query.get('tab') == 'requests' ? 'active' : '' }}">Anfrageentwürfe{% if requests|length %} ({{ requests|length }}){% endif %}</a></nav>
{% if app.request.query.get('tab') == 'requests' %}
    {% include 'catalog/_requests.html.twig' %}
{% else %}
<div class="catalog-layout">
    <section class="catalog-main">
        {% if catalog.available %}
        <div class="catalog-book" id="catalog-viewer" tabindex="0" role="region" aria-label="Blätterbarer CHASE Originalkatalog" data-catalog-viewer>
            <div class="catalog-book-top"><span class="catalog-original-label"><span class="status-dot"></span>CHASE ORIGINALKATALOG</span><a href="{{ path('app_advertising_original') }}" title="Original-PDF herunterladen">{{ icon('download') }}<span>Original-PDF</span></a></div>
            {% if catalog.previews %}<div class="catalog-page-image"><img src="{{ path('app_advertising_page',{page:page}) }}" width="1440" height="810" alt="Originalseite {{ page }} aus dem CHASE Werbekatalog" fetchpriority="high"></div>{% else %}<div class="catalog-no-preview"><img src="/assets/brand/chase-white.png" alt="CHASE Immobilien" width="220" height="77"><h2>Ihr CHASE Werbekatalog.</h2><p>Der Originalkatalog ist sicher hinterlegt. Die optionale Blättervorschau ist noch nicht vorbereitet.</p><a class="btn btn-primary" href="{{ path('app_advertising_original') }}">Original-PDF öffnen {{ icon('download') }}</a>{% if is_granted('ROLE_ADMIN') %}<form method="post" action="{{ path('app_advertising_render') }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary" type="submit">Lokale Blättervorschau vorbereiten</button><small>Benötigt die optionalen lokalen Programme pdfinfo und pdftoppm (Poppler).</small></form>{% endif %}</div>{% endif %}
            <div class="catalog-paging"><a class="catalog-page-button {{ page == 1 ? 'is-disabled' : '' }}" href="{{ path('app_advertising',{page:page > 1 ? page-1 : 1}) }}#catalog-viewer" data-catalog-prev {% if page == 1 %}aria-disabled="true" tabindex="-1"{% endif %} aria-label="Vorherige Katalogseite"><span class="rotate-icon">{{ icon('chevron-right') }}</span><span>Zurück</span></a><form method="get" action="{{ path('app_advertising') }}" class="catalog-page-jump"><label for="catalog-page">Seite</label><input id="catalog-page" name="page" type="number" min="1" max="{{ catalog.pages }}" value="{{ page }}" aria-label="Katalogseite"><span>von {{ catalog.pages }}</span><button type="submit" class="icon-button" title="Seite aufrufen" aria-label="Gewählte Seite aufrufen">{{ icon('arrow-right') }}</button></form><a class="catalog-page-button {{ page == catalog.pages ? 'is-disabled' : '' }}" href="{{ path('app_advertising',{page:page < catalog.pages ? page+1 : catalog.pages}) }}#catalog-viewer" data-catalog-next {% if page == catalog.pages %}aria-disabled="true" tabindex="-1"{% endif %} aria-label="Nächste Katalogseite"><span>Weiter</span>{{ icon('chevron-right') }}</a></div>
        </div>
        <div class="catalog-viewer-caption"><span>Originale unverändert · Seite {{ page }}</span><span>Mit Pfeiltasten oder Wischen blättern</span></div>
        {% else %}
        <div class="catalog-import-note"><span class="eyebrow">IHRE MARKE IN BESTFORM</span><h2>Ein Katalog. Viele Möglichkeiten.</h2><p>Der bereitgestellte CHASE Originalkatalog erscheint hier nach dem privaten Materialimport. Ihre lokale Auswahl und Anfrageentwürfe funktionieren bereits.</p>{% if is_granted('ROLE_ADMIN') %}<a href="/admin/materials" class="btn btn-primary">Originalmaterialien importieren {{ icon('arrow-right') }}</a>{% endif %}</div>
        {% endif %}
        <div class="catalog-section-heading"><div><span class="eyebrow">DAS PASST ZU IHREM AUFTRITT</span><h2>{{ isSearch ? 'Ihre Suchergebnisse' : (items|length ? 'Designs auf dieser Seite' : 'Entdecken Sie die Kollektion') }}</h2></div><small>{{ isSearch ? items|length ~ ' Designs gefunden' : 'Preise auf Anfrage' }}</small></div>
        {% if items|length %}<div class="catalog-product-grid">{% for item in items %}<article class="catalog-product-card"><div class="catalog-product-top"><span class="badge">{{ item.data.category|default('Werbemittel') }}</span><form method="post" action="{{ path('app_advertising_favorite',{id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="page" value="{{ page }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="category" value="{{ category }}"><input type="hidden" name="favorites" value="{{ favoriteOnly ? 1 : 0 }}"><button type="submit" class="icon-button catalog-favorite {{ item.id in favorites ? 'is-favorite' : '' }}" aria-label="{{ item.id in favorites ? 'Aus Merkliste entfernen: ' : 'Merken: ' }}{{ item.title }}" aria-pressed="{{ item.id in favorites ? 'true' : 'false' }}">{{ icon('bookmark') }}</button></form></div><h3>{{ item.title }}</h3><p>{{ item.data.description|default('Ein Werbemittel für Ihren regionalen CHASE-Auftritt.') }}</p><div class="catalog-product-source">{% if item.data.catalogPage|default(0) %}<a href="{{ path('app_advertising',{page:item.data.catalogPage}) }}#catalog-viewer">Originalmotiv · Seite {{ item.data.catalogPage }} {{ icon('arrow-up-right') }}</a>{% else %}<span class="badge badge-demo">Demo-Vorlage</span>{% endif %}<span>{{ item.data.priceLabel|default('Preis auf Anfrage') }}</span></div><form class="catalog-add-form" method="post" action="{{ path('app_advertising_cart_item',{id:item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="page" value="{{ page }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="category" value="{{ category }}"><input type="hidden" name="favorites" value="{{ favoriteOnly ? 1 : 0 }}"><div class="field"><label for="quantity-{{ item.id }}">Gewünschte Menge</label><input id="quantity-{{ item.id }}" name="quantity" type="number" min="1" max="9999" step="1" value="1" inputmode="numeric" required></div><button type="submit" class="btn btn-primary">{{ icon('plus') }}In die Auswahl</button></form></article>{% endfor %}</div>{% elseif isSearch %}<div class="empty-state"><h3>Kein passendes Design gefunden.</h3><p>Versuchen Sie einen anderen Begriff oder eine andere Kategorie.</p><a href="{{ path('app_advertising') }}" class="btn btn-secondary">Alle Kapitel entdecken</a></div>{% else %}<div class="catalog-chapter-grid">{% for chapter in chapters %}<a href="{{ path('app_advertising',{page:chapter.page}) }}#catalog-viewer"><span>{{ '%02d'|format(loop.index) }}</span><div><h3>{{ chapter.title }}</h3><small>Ab Seite {{ chapter.page }}</small></div>{{ icon('arrow-up-right') }}</a>{% endfor %}</div>{% endif %}
    </section>
    <aside class="catalog-sidebar"><section class="card catalog-discover"><span class="eyebrow">FINDEN SIE IHREN AUFTRITT</span><h2>Das richtige Design.</h2><form method="get" action="{{ path('app_advertising') }}" class="stack"><div class="field"><label for="catalog-search">Katalog durchsuchen</label><input type="search" id="catalog-search" name="q" value="{{ q }}" placeholder="Flyer, Kleidung, Schilder …" maxlength="200"></div><div class="field"><label for="catalog-category">Kollektion</label><select name="category" id="catalog-category"><option value="">Alle Kollektionen</option>{% for c in categories %}<option value="{{ c }}" {{ c == category ? 'selected' : '' }}>{{ c }}</option>{% endfor %}</select></div><label class="checkbox-field"><input type="checkbox" name="favorites" value="1" {{ favoriteOnly ? 'checked' : '' }}>Nur gemerkte Designs</label><button class="btn btn-secondary" type="submit">Designs finden {{ icon('search') }}</button>{% if isSearch %}<a class="text-link" href="{{ path('app_advertising') }}">Suche zurücksetzen</a>{% endif %}</form><div class="catalog-contents"><h3>Im Katalog</h3>{% for chapter in chapters %}<a href="{{ path('app_advertising',{page:chapter.page}) }}#catalog-viewer"><span>{{ chapter.title }}</span><small>{{ chapter.page }}</small></a>{% endfor %}</div></section><section class="catalog-selection-card"><span class="catalog-selection-icon">{{ icon('shopping-bag') }}</span><h2>Ihr nächster Auftritt.</h2><p>{{ cartCount ? cartCount ~ ' Designs liegen bereits in Ihrer Auswahl.' : 'Sammeln Sie Ihre Wunschdesigns. Mengen und Wünsche stimmen Sie im nächsten Schritt ab.' }}</p><a class="btn btn-primary" href="{{ path('app_advertising_cart') }}">Auswahl ansehen <span>{{ cartCount }}</span>{{ icon('arrow-right') }}</a><small>Lokaler Entwurf · keine Bestellung</small></section></aside>
</div>
<div class="catalog-integrations-note">{{ icon('help-circle') }}<p>Für Werbemittel sind im Originalkatalog keine Bestellpreise angegeben. <strong>Flyeralarm und automatischer Angebotsversand sind noch nicht verbunden.</strong> Ihre Auswahl und Anfrageentwürfe bleiben sicher im Portal; es wird nichts extern bestellt oder verschickt.</p></div>
{% endif %}
{% endblock %}
