{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}Werbekatalog · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Sichtbar mit CHASE</span><h1>Werbekatalog</h1><p>Ein starker Auftritt. Vom ersten Kontakt bis zum Verkauf.</p></div><a class="btn btn-primary" href="#anfrage">Anfrage zusammenstellen</a></div>
<div class="alert">Demo-Katalog: Sie können Ihre Merkliste und einen lokalen Anfrageentwurf speichern. Es wird nichts bestellt oder an Dritte versendet.</div>
{{ parts.filters(categories, q, category, favoriteOnly, true, false, false) }}
<div class="grid grid-3">{% for item in items %}<article class="card stack"><div class="catalog-art" aria-hidden="true" style="background:linear-gradient(135deg,#151923,#303644);color:#fff;border-radius:12px;padding:30px;min-height:140px;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;letter-spacing:3px">CHASE<span style="color:#FF6A00">.</span></div>{{ parts.category(item.data.category|default('Werbemittel'), true) }}<h2>{{ item.title }}</h2><p class="muted">{{ item.data.description|default('Werbemittel im CHASE-Design.') }}</p><div class="toolbar"><span class="badge">{{ item.data.unit|default('Einheit auf Anfrage') }}</span><strong>{{ item.data.priceLabel|default('Preis auf Anfrage') }}</strong></div>{{ parts.favorite('advertising', item, favorites, 'list') }}</article>{% else %}<div class="card empty-state"><h2>Keine passenden Werbemittel</h2><a class="btn btn-secondary" href="{{ path('app_advertising') }}">Alle Werbemittel</a></div>{% endfor %}</div>
<div class="grid grid-2" style="margin-top:24px"><section class="card stack" id="anfrage"><span class="badge">Lokal nutzbar</span><h2>Ihre Anfrage zusammenstellen</h2><p class="muted">Geben Sie die Anzahl der gewünschten Einheiten an. Zum Beispiel: 2 × 500 Visitenkarten. Die Preise werden später separat angefragt.</p><form class="stack" method="post" action="{{ path('app_advertising_request') }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">{% for item in all %}<div class="field"><label for="quantity-{{ item.id }}">{{ item.title }} <small class="muted">({{ item.data.unit|default('Einheit') }})</small></label><input type="number" id="quantity-{{ item.id }}" name="quantities[{{ item.id }}]" value="0" min="0" max="9999" step="1"></div>{% endfor %}<div class="field"><label for="request-note">Ihre Notiz</label><textarea id="request-note" name="note" maxlength="2000" rows="3" placeholder="Zum Beispiel gewünschte Individualisierung …"></textarea></div><button class="btn btn-primary" type="submit">Lokalen Anfrageentwurf speichern</button><p class="muted"><small>Keine Bestellung, kein Versand, keine Kosten.</small></p></form></section><section class="card stack"><h2>Meine Anfrageentwürfe</h2>{% for draft in requests|reverse %}<article class="card stack"><div class="toolbar"><span class="badge">Lokaler Entwurf</span><small class="muted">{{ draft.createdAt|date('d.m.Y H:i', 'Europe/Berlin') }}</small></div><h3>{{ draft.title }}</h3><ul>{% for item in draft.data.items|default([]) %}<li>{{ item.quantity }} × {{ item.title }} <span class="muted">({{ item.unit }})</span></li>{% endfor %}</ul>{% if draft.data.note|default('') %}<p>{{ draft.data.note }}</p>{% endif %}<div class="toolbar"><a class="btn btn-secondary" href="{{ path('app_advertising_request_download', {id:draft.id}) }}">Entwurf herunterladen</a><form method="post" action="{{ path('app_advertising_request_delete', {id:draft.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary" type="submit">Entwurf löschen</button></form></div></article>{% else %}<div class="empty-state"><p>Noch keine Anfrage gespeichert. Stellen Sie links Ihre erste Auswahl zusammen.</p></div>{% endfor %}</section></div>
{% endblock %}
