{% extends 'base.html.twig' %}
{% block title %}Immobilienlexikon{% endblock %}
{% block breadcrumb %}Academy / Immobilienlexikon{% endblock %}
{% block stylesheets %}<style>.lexicon-workspace{height:100%;min-height:0;display:flex;flex-direction:column;gap:12px}.lexicon-header{display:flex;gap:12px;align-items:center}.lexicon-header h1{font-size:24px;margin:0;flex:1}.lexicon-search{display:flex;gap:8px}.lexicon-search input{flex:1;height:40px}.lexicon-letters{display:flex;gap:4px;overflow-x:auto;flex:none}.lexicon-letters a{min-width:28px;height:29px;display:grid;place-items:center;font-size:11px;border-radius:6px}.lexicon-letters .active{background:var(--accent,#ff6a00);color:#fff}.lexicon-results{overflow:auto;flex:1;min-height:0;align-content:start;gap:12px}.lexicon-results .card{padding:15px}.lexicon-results h2{font-size:14px!important}.lexicon-results p{font-size:11px!important;line-height:1.7!important}.lexicon-results .btn{font-size:10px;padding:7px 9px}.lexicon-status{font-size:10px;color:var(--muted);margin:0}.lexicon-source{font-size:10px;color:var(--muted)}@media(max-width:600px){.lexicon-header h1{font-size:20px}}</style>{% endblock %}
{% block body %}<div class="lexicon-workspace">
<header class="lexicon-header"><a class="icon-button" href="{{ path('app_academy') }}" aria-label="Zur Academy" title="Zur Academy">{{ icon('arrow-left') }}</a><h1>Immobilienlexikon</h1>{% if sourceDocument %}<a class="icon-button" href="{{ path('app_document_download',{id:sourceDocument.id}) }}" aria-label="Original-PDF herunterladen" title="Original-PDF">{{ icon('download') }}</a>{% endif %}</header>
<form method="get" class="lexicon-search" role="search"><label class="sr-only" for="lexicon-q">Begriff oder Stichwort</label><input type="search" id="lexicon-q" name="q" value="{{ q }}" placeholder="Begriff oder Stichwort …" maxlength="150"><button class="icon-button" type="submit" aria-label="Nachschlagen" title="Nachschlagen">{{ icon('search') }}</button></form>
<nav class="lexicon-letters" aria-label="Anfangsbuchstaben"><a class="{{ letter == '' ? 'active' : '' }}" href="{{ path('app_lexicon',{q:q}) }}">Alle</a>{% for char in letters %}<a class="{{ letter == char ? 'active' : '' }}" href="{{ path('app_lexicon',{q:q,letter:char}) }}">{{ char }}</a>{% endfor %}</nav>
<p class="lexicon-status">{{ entries|length }} Begriffe{% if q %} · „{{ q }}“{% endif %}{% if letter %} · {{ letter }}{% endif %}</p>
<div class="grid grid-3 lexicon-results">{% for entry in entries %}<article class="card stack"><h2 style="font-size:1.08rem"><a href="{{ path('app_lexicon_term',{id:entry.id}) }}">{{ entry.term }}</a></h2><p class="muted" style="font-size:.88rem;line-height:1.7">{{ entry.definition|slice(0,200) }}{{ entry.definition|length > 200 ? ' …' : '' }}</p><div class="toolbar"><small class="muted">Original · Seite {{ entry.page }}</small><a class="btn btn-secondary" href="{{ path('app_lexicon_term',{id:entry.id}) }}">Begriff ansehen →</a></div></article>{% else %}<div class="card empty-state"><h2>Kein passender Begriff</h2><p>Versuchen Sie ein kürzeres Stichwort oder wählen Sie einen anderen Anfangsbuchstaben.</p></div>{% endfor %}</div>
<small class="lexicon-source">{{ source.filename|default('CHASE Immobilienlexikon') }} · Fachliche Aktualität im Einzelfall prüfen.</small>
</div>{% endblock %}
