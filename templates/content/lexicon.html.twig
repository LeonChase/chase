{% extends 'base.html.twig' %}
{% block title %}Immobilienlexikon{% endblock %}
{% block breadcrumb %}Academy / Immobilienlexikon{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_academy') }}">← Wissen / Academy</a>
<div class="page-heading"><div><span class="eyebrow">Immobilienwissen verständlich erklärt</span><h1>Immobilienlexikon A–Z</h1><p>{{ lexiconCount }} Begriffe aus dem bereitgestellten CHASE-Lexikon. Direkt nachschlagen und im Alltag weiterkommen.</p></div>{% if sourceDocument %}<a class="btn btn-secondary" href="{{ path('app_document_download',{id:sourceDocument.id}) }}">Original-PDF herunterladen</a>{% endif %}</div>
<form method="get" class="card toolbar" role="search"><div class="field" style="flex:1"><label for="lexicon-q">Begriff oder Stichwort</label><input type="search" id="lexicon-q" name="q" value="{{ q }}" placeholder="Zum Beispiel: Erbbaurecht, Auflassung, Liegenschaftszins …" maxlength="150"></div><button class="btn btn-primary" type="submit">Nachschlagen</button><a class="btn btn-secondary" href="{{ path('app_lexicon') }}">Alle Begriffe</a></form>
<nav class="toolbar" aria-label="Lexikon nach Anfangsbuchstaben" style="flex-wrap:wrap;gap:7px"><a class="btn {{ letter == '' ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('app_lexicon',{q:q}) }}">Alle</a>{% for char in letters %}<a class="btn {{ letter == char ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('app_lexicon',{q:q,letter:char}) }}">{{ char }}</a>{% endfor %}</nav>
<p class="muted">{{ entries|length }} {{ entries|length == 1 ? 'Begriff' : 'Begriffe' }}{% if q %} für „{{ q }}“{% endif %}{% if letter %} · Buchstabe {{ letter }}{% endif %}</p>
<div class="grid grid-3">{% for entry in entries %}<article class="card stack"><h2 style="font-size:1.08rem"><a href="{{ path('app_lexicon_term',{id:entry.id}) }}">{{ entry.term }}</a></h2><p class="muted" style="font-size:.88rem;line-height:1.7">{{ entry.definition|slice(0,200) }}{{ entry.definition|length > 200 ? ' …' : '' }}</p><div class="toolbar"><small class="muted">Original · Seite {{ entry.page }}</small><a class="btn btn-secondary" href="{{ path('app_lexicon_term',{id:entry.id}) }}">Begriff ansehen →</a></div></article>{% else %}<div class="card empty-state"><h2>Kein passender Begriff</h2><p>Versuchen Sie ein kürzeres Stichwort oder wählen Sie einen anderen Anfangsbuchstaben.</p></div>{% endfor %}</div>
<p class="muted"><small>Quelle: {{ source.filename|default('CHASE Immobilienlexikon') }}. Die Definitionen wurden aus der bereitgestellten Datei übernommen; fachliche Aktualität im Einzelfall prüfen.</small></p>
{% endblock %}
