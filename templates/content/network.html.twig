{% extends 'base.html.twig' %}
{% block title %}Partnernetzwerk{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/network.css">{% endblock %}
{% block body %}
<section class="network-workspace" data-network-view="map"><header class="network-toolbar"><h1>Partnernetzwerk <small>{{ partners|length }}</small></h1><form class="network-search" method="get" role="search"><label class="sr-only" for="partner-query">Partner oder Region suchen</label>{{ icon('search') }}<input type="search" name="q" id="partner-query" value="{{ q }}" placeholder="Partner oder Region …" maxlength="200"><button class="icon-button" aria-label="Suchen">{{ icon('arrow-right') }}</button></form><div class="network-view-switch" role="group" aria-label="Netzwerkansicht"><button class="icon-button active" data-network-view-button="map" aria-pressed="true" aria-label="Karte und Partner">{{ icon('map') }}</button><button class="icon-button" data-network-view-button="list" aria-pressed="false" aria-label="Nur Partnerliste">{{ icon('users') }}</button></div></header>
<div class="network-panes"><div class="partner-map"><div class="map-heading"><span>Regionen</span><div><button class="icon-button" data-map-zoom="in" aria-label="Karte vergrößern">{{ icon('plus') }}</button><button class="icon-button" data-map-zoom="out" aria-label="Karte verkleinern">{{ icon('minus') }}</button><button class="icon-button" data-map-zoom="reset" aria-label="Karte zurücksetzen">{{ icon('refresh-cw') }}</button></div></div><svg class="network-map" viewBox="0 0 480 580" role="group" aria-label="Schematische Regionenkarte"><g data-map-content>{% include 'content/_germany_outline.html.twig' %}{% for partner in partners %}{% if locations[partner.id] is defined %}{% set location=locations[partner.id] %}<g class="partner-marker" transform="translate({{ location.x }},{{ location.y }})" tabindex="0" role="button" aria-label="{{ partner.title }} · {{ partner.data.region }}{{ location.approximate ? ' · ungefährer Demo-Regionsmittelpunkt' : '' }}" data-partner-marker="{{ partner.id }}"><title>{{ partner.title }} · {{ partner.data.region }}</title><circle class="marker-halo" r="21"/><circle class="marker-dot" r="13"/><text y="4" text-anchor="middle">{{ partner.title|slice(0,1)|upper }}</text></g>{% endif %}{% endfor %}</g></svg><small class="map-caption">Schematische Karte · Demo-Punkte zeigen ungefähre Regionen, keine Bürostandorte.</small>{% if not locations %}<p class="map-no-locations">Für diese Profile sind noch keine Kartenpositionen hinterlegt.</p>{% endif %}</div>
<div class="partner-list" aria-label="Freigegebene Partner">{% for partner in partners %}<article class="network-partner-card" id="partner-{{ partner.id }}" data-partner-card="{{ partner.id }}" tabindex="-1"><div class="network-partner-heading"><span class="partner-initial">{{ partner.title|slice(0,1)|upper }}</span><div><h2>{{ partner.data.displayName|default(partner.title) }}</h2><p>{{ partner.data.position|default('CHASE Partner') }}</p></div>{% if partner.data.isDemo|default(false) %}<span class="badge">Demo</span>{% endif %}</div><div class="network-partner-region">{{ icon('map-pin') }} {{ partner.data.region|default('Region noch nicht hinterlegt') }}</div><div class="network-partner-actions">{% if locations[partner.id] is defined %}<button class="text-link" data-partner-select="{{ partner.id }}">Auf Karte zeigen</button>{% endif %}{% if contacts[partner.data.userId|default('')] is defined %}<a class="btn btn-secondary btn-small" href="/messages?recipientId={{ partner.data.userId|url_encode }}">{{ icon('message-circle') }} Nachricht</a>{% elseif partner.data.userId|default('') == app.user.id %}<a class="text-link" href="/profile">Mein Profil</a>{% endif %}</div></article>{% else %}<p class="muted network-empty">Keine passenden freigegebenen Partner.</p>{% endfor %}</div></div><footer class="network-footnote">Nur freigegebene Portalprofile · Öffentliche CHASE-Standorte noch nicht abgeglichen</footer></section>
{% endblock %}
{% block javascripts %}<script src="/assets/network.js" defer></script>{% endblock %}
