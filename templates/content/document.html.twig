{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}{{ document.title }}{% endblock %}
{% block breadcrumb %}Dokumente{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_documents',{category:document.data.category|default('')}) }}">← {{ document.data.category|default('Dokumentencenter') }}</a>
<div class="page-heading"><div>{{ parts.category(document.data.category|default('Dokument'), document.data.isDemo|default(false)) }}<h1>{{ document.title }}</h1><p>{{ document.data.provided|default(false) ? 'Bereitgestellte CHASE-Unterlage. Fachliche Freigabe vor Verwendung prüfen.' : document.data.description|default('Unverbindliches Demo-Arbeitsmuster.') }}</p></div><span class="badge">{{ document.data.format|default('TXT-DEMO') }}</span></div>
<div class="grid grid-2"><article class="card stack"><h2>{{ document.data.provided|default(false) ? 'Ihre Originalunterlage' : 'Dokumentvorschau' }}</h2>{% if document.data.filePath|default('') %}<p>Diese Datei wurde unverändert aus Ihren bereitgestellten Unterlagen übernommen. Sie können das Original herunterladen und in einem passenden Programm öffnen.</p>{% if document.data.format|default('') in ['HTML','HTM','SVG','EML'] %}<div class="alert">Diese Datei wird aus Sicherheitsgründen als Download bereitgestellt. Externe Inhalte und enthaltene Programme werden hier nicht ausgeführt.</div>{% endif %}{% if document.data.linkUrl|default('') %}<a class="btn btn-primary" href="{{ document.data.linkUrl }}" target="_blank" rel="noopener noreferrer">Verlinktes Werkzeug öffnen {{ icon('arrow-up-right') }}</a><p class="muted">Sie verlassen das Portal. Der Link stammt aus den bereitgestellten Unterlagen; das Portal ruft dort keine Daten automatisch ab.</p>{% endif %}{% if document.data.searchText|default('') and document.data.format|default('') not in ['HTML','HTM','SVG','EML','URL'] %}<details><summary>Textauszug zur Orientierung</summary><pre style="white-space:pre-wrap;font:inherit;font-size:.86rem;line-height:1.8;overflow-wrap:anywhere">{{ document.data.searchText|slice(0,4000) }}{% if document.data.searchText|length > 4000 %}

… Der vollständige Inhalt befindet sich in der Originaldatei.{% endif %}</pre></details>{% endif %}{% else %}<pre class="document-preview" style="white-space:pre-wrap;font:inherit;line-height:1.8;overflow-wrap:anywhere">{{ document.data.content|default('Demo-Inhalt. Vor Verwendung fachlich prüfen.') }}</pre>{% endif %}<div class="alert">{{ document.data.provided|default(false) ? 'Bereitgestellte Vorlage · die Bereitstellung ersetzt keine fachliche oder juristische Freigabe.' : 'Unverbindliches Demo-Muster · keine Rechtsberatung · keine freigegebene Vertragsvorlage.' }}</div></article><aside class="card stack"><h2>Unterlagendetails</h2><dl class="stack"><div><dt>Kategorie</dt><dd>{{ document.data.category|default('Dokumente') }}{% if document.data.subfolder|default('') %} / {{ document.data.subfolder }}{% endif %}</dd></div><div><dt>Hochgeladen</dt><dd>{{ document.data.uploadedAt|default(document.createdAt|date('c'))|date('d.m.Y H:i','Europe/Berlin') }} Uhr</dd></div><div><dt>Originaldatei</dt><dd style="overflow-wrap:anywhere">{{ document.data.fileName|default(document.title ~ '.txt') }}</dd></div>{% if document.data.size|default(0) %}<div><dt>Dateigröße</dt><dd>{{ (document.data.size / 1024)|number_format(0,',','.') }} KB</dd></div>{% endif %}<div><dt>Freigabe im Portal</dt><dd>{{ document.data.audience|default('Zugriffsberechtigte Partner') }}</dd></div></dl><a class="btn btn-primary" href="{{ path('app_document_download',{id:document.id}) }}">{{ icon('download') }} {{ document.data.provided|default(false) ? 'Original herunterladen' : 'Demo-Muster herunterladen' }}</a>{{ parts.favorite('document',document,favorites,'') }}{% if document.data.catalogOriginal|default(false) %}<a class="btn btn-secondary" href="/advertising">Im Werbekatalog blättern →</a>{% endif %}{% if document.data.lexiconOriginal|default(false) %}<a class="btn btn-secondary" href="{{ path('app_lexicon') }}">Begriffe im Lexikon nachschlagen →</a>{% endif %}{% if document.data.sourcePath|default('') %}<details><summary>Herkunft & Integrität</summary><p class="muted" style="overflow-wrap:anywhere">{{ document.data.sourcePath }}</p><small class="muted">SHA-256: <code style="overflow-wrap:anywhere">{{ document.data.sourceHash }}</code></small></details>{% endif %}</aside></div>
{% endblock %}
