{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}{{ article.title }} · CHASE Academy{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_academy') }}">← Zur Academy</a>
<div class="page-heading"><div>{{ parts.category(article.data.category|default('Wissen'), true) }}<h1>{{ article.title }}</h1><p>{{ article.data.teaser|default('Praxiswissen für Ihren Makleralltag.') }}</p></div><span class="badge">{{ article.data.readingMinutes|default(5) }} Min. Lesezeit</span></div>
<div class="grid grid-2"><article class="card stack">{% if article.data.content is defined and article.data.content is iterable %}{% for section in article.data.content %}<section><h2>{{ section[0]|default('Wissen') }}</h2><p>{{ section[1]|default('') }}</p></section>{% endfor %}{% else %}<p style="white-space:pre-wrap">{{ article.data.content|default('Demo-Lerninhalt') }}</p>{% endif %}<div class="alert">Diese interne Demo vermittelt Orientierung. Fachliche Prüfung und freigegebene Prozesse bleiben erforderlich.</div></article><aside class="card stack"><h2>Ihr Lernfortschritt</h2><p class="muted">{{ article.id in learned ? 'Diese Einheit haben Sie bereits abgeschlossen.' : 'Wenn Sie den Artikel gelesen haben, können Sie die Einheit als abgeschlossen markieren.' }}</p><form method="post" action="{{ path('app_content_preference', {kind:'progress', type:'academy', id:article.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-primary" type="submit">{{ article.id in learned ? 'Lernstatus zurücksetzen' : 'Als abgeschlossen markieren' }}</button></form>{{ parts.favorite('academy', article, favorites, '') }}<h3>Nächster Schritt</h3><p class="muted">Wenden Sie das Gelernte bei Ihrer nächsten Objektaufnahme an und prüfen Sie Ihre Unterlagen.</p><a class="btn btn-secondary" href="{{ path('app_documents') }}">Passende Dokumente ansehen</a></aside></div>
{% endblock %}
