{% extends 'base.html.twig' %}
{% import 'content/_parts.html.twig' as parts %}
{% block title %}{{ article.title }}{% endblock %}
{% block breadcrumb %}Wissen / Academy{% endblock %}
{% block body %}
<a class="back-link" href="{{ path('app_academy') }}">← Zur Academy</a>
<div class="page-heading"><div>{{ parts.category(article.data.category|default('Wissen'),article.data.isDemo|default(true)) }}<h1>{{ article.title }}</h1><p>{{ article.data.teaser|default('Praxiswissen für Ihren Makleralltag.') }}</p></div><span class="badge">{{ article.data.kind|default('article') == 'video' ? 'Lernvideo' : article.data.readingMinutes|default(5) ~ ' Min. Lesezeit' }}</span></div>
<div class="grid grid-2"><article class="card stack">{% if article.data.kind|default('article') == 'video' %}<video controls preload="metadata" playsinline style="width:100%;border-radius:12px;background:#151923" aria-label="{{ article.title }}"><source src="{{ path('app_academy_video',{id:article.id}) }}" type="{{ article.data.mimeType }}">Ihr Browser unterstützt das Videoformat nicht.</video><p class="muted">Privat bereitgestelltes Lernvideo. Hochgeladen am {{ article.data.uploadedAt|date('d.m.Y H:i','Europe/Berlin') }} Uhr.</p>{% elseif article.data.content is defined and article.data.content is iterable %}{% for section in article.data.content %}<section><h2>{{ section[0]|default('Wissen') }}</h2><p>{{ section[1]|default('') }}</p></section>{% endfor %}{% else %}<p style="white-space:pre-wrap">{{ article.data.content|default('Demo-Lerninhalt') }}</p>{% endif %}<div class="alert">Interne Lerninhalte vermitteln Orientierung. Fachliche Prüfung und freigegebene Prozesse bleiben erforderlich.</div></article><aside class="card stack"><h2>Ihr Lernfortschritt</h2><p class="muted">{{ article.id in learned ? 'Diese Einheit haben Sie bereits abgeschlossen.' : 'Wenn Sie die Einheit durchgearbeitet haben, markieren Sie sie als abgeschlossen.' }}</p><form method="post" action="{{ path('app_content_preference',{kind:'progress',type:'academy',id:article.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-primary" type="submit">{{ article.id in learned ? 'Lernstatus zurücksetzen' : 'Als abgeschlossen markieren' }}</button></form>{{ parts.favorite('academy',article,favorites,'') }}<h3>Ein Begriff ist unklar?</h3><p class="muted">Im Immobilienlexikon finden Sie kurze Erklärungen aus Ihren CHASE-Unterlagen.</p><a class="btn btn-secondary" href="{{ path('app_lexicon') }}">Immobilienlexikon öffnen</a><a class="btn btn-secondary" href="{{ path('app_documents') }}">Passende Dokumente ansehen</a></aside></div>
{% endblock %}
