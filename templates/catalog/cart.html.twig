{% extends 'base.html.twig' %}
{% block title %}Meine Werbemittelauswahl{% endblock %}
{% block breadcrumb %}Werbekatalog{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/catalog.css">{% endblock %}
{% block javascripts %}<script src="/assets/catalog.js" defer></script>{% endblock %}
{% block body %}
<div class="page-heading"><div><a class="back-link" href="{{ path('app_advertising') }}">← Zum Werbekatalog</a><h1>Auswahl</h1></div><span class="catalog-cart-total">{{ icon('shopping-bag') }}{{ cartCount }} {{ cartCount == 1 ? 'Design' : 'Designs' }}</span></div>
{% if cart %}
<div class="catalog-cart-layout"><section class="card"><div class="card-heading"><h2>Ihre Wunschdesigns</h2><span class="badge">{{ cartQuantity }} gewünschte Einheiten</span></div><form method="post" action="{{ path('app_advertising_cart') }}" id="catalog-cart-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">{% for entry in cart %}{% set item = entry.product %}<div class="catalog-cart-item"><span class="catalog-cart-item-icon">{{ icon('megaphone') }}</span><div class="catalog-cart-item-title"><span>{{ item.data.category|default('Werbemittel') }}</span><h3>{{ item.title }}</h3></div><div class="field"><label for="cart-{{ item.id }}">Menge</label><span class="catalog-quantity" data-quantity-control><input type="number" name="quantities[{{ item.id }}]" id="cart-{{ item.id }}" value="{{ entry.quantity }}" min="0" max="999999999" step="1" inputmode="numeric" required><button type="button" data-quantity-change="-1" aria-label="Menge für {{ item.title }} verringern">−</button><button type="button" data-quantity-change="1" aria-label="Menge für {{ item.title }} erhöhen">+</button></span></div></div>{% endfor %}<div class="catalog-cart-update"><small>Menge „0“ entfernt ein Design aus Ihrer Auswahl.</small><button class="btn btn-secondary" type="submit">Mengen speichern {{ icon('check') }}</button></div></form><form method="post" action="{{ path('app_advertising_cart_clear') }}" class="catalog-clear-form" data-confirm="Möchten Sie Ihre gesamte Auswahl leeren?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button type="submit" class="text-link">Gesamte Auswahl leeren</button></form></section>
<aside class="catalog-quote-card"><h2>Anfrage vorbereiten</h2><form method="post" action="{{ path('app_advertising_request') }}" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="catalog-note">Wünsche & Hinweise</label><textarea id="catalog-note" name="note" maxlength="2000" rows="4" placeholder="Zum Beispiel Format, Termin, Größe oder Personalisierung …"></textarea><small>Bitte geänderte Mengen zuerst links speichern.</small></div><label class="checkbox-field"><input type="checkbox" name="personalize" value="1" data-catalog-personalize>Personalisierung mit meinem Namen und meiner Region vormerken</label><div class="catalog-personalization" data-catalog-personalization hidden><span class="catalog-personalization-label">KONTAKTBLOCK-VORSCHAU</span><div>{% if app.user.preferences.avatarFilename|default('') %}<img src="/profile/avatar/{{ app.user.id }}" alt="Ihr Profilbild" width="44" height="44">{% else %}<span class="avatar">{{ portal.initials }}</span>{% endif %}<p><strong>{{ app.user.name }}</strong><small>{{ app.user.region }}</small></p><img src="/assets/brand/chase-orange.png" class="personalization-logo" alt="CHASE Immobilien" width="72" height="25"></div><small>Gestaltungsvorschau. Die Originaldesigns werden nicht verändert; es wird keine Druckdatei erzeugt.</small></div><button class="btn btn-primary" type="submit">Anfrageentwurf speichern {{ icon('arrow-right') }}</button></form><div class="catalog-quote-status">{{ icon('lock') }}<span>Lokal gespeichert. Keine Bestellung.<br>Kein automatischer Versand.</span></div></aside></div>
{% else %}<div class="empty-state catalog-empty-cart">{{ icon('shopping-bag') }}<h2>Noch keine Auswahl</h2><p>Werbemittel im Katalog auswählen.</p><a class="btn btn-primary" href="{{ path('app_advertising') }}">Katalog entdecken {{ icon('arrow-right') }}</a></div>{% endif %}
{% if requests %}<div class="catalog-past-requests"><h2>Anfrageentwürfe</h2><p>{{ requests|length }} lokal gespeicherte Anfrage{{ requests|length == 1 ? '' : 'n' }} finden Sie in Ihren Entwürfen.</p><a class="text-link" href="{{ path('app_advertising',{tab:'requests'}) }}">Anfrageentwürfe öffnen {{ icon('arrow-right') }}</a></div>{% endif %}
{% endblock %}
