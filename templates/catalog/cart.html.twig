{% extends 'base.html.twig' %}
{% block title %}Meine Werbemittelauswahl{% endblock %}
{% block breadcrumb %}Werbekatalog{% endblock %}
{% block body %}
<div class="page-heading"><div><a class="back-link" href="{{ path('app_advertising') }}">← Zum Werbekatalog</a><span class="eyebrow">IHR AUFTRITT NIMMT FORM AN</span><h1>Meine Auswahl.</h1><p>Gewünschte Mengen festlegen. Persönliche Wünsche ergänzen. Gemeinsam das passende Angebot vorbereiten.</p></div><span class="catalog-cart-total">{{ icon('shopping-bag') }}{{ cartCount }} {{ cartCount == 1 ? 'Design' : 'Designs' }}</span></div>
{% if cart %}
<div class="catalog-cart-layout"><section class="card"><div class="card-heading"><h2>Ihre Wunschdesigns</h2><span class="badge">{{ cartQuantity }} gewünschte Einheiten</span></div><form method="post" action="{{ path('app_advertising_cart') }}" id="catalog-cart-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">{% for entry in cart %}{% set item = entry.product %}<div class="catalog-cart-item"><span class="catalog-cart-item-icon">{{ icon('megaphone') }}</span><div class="catalog-cart-item-title"><span>{{ item.data.category|default('Werbemittel') }}</span><h3>{{ item.title }}</h3><p>{{ item.data.priceLabel|default('Preis auf Anfrage') }}{% if item.data.catalogPage|default(0) %} · <a href="{{ path('app_advertising',{page:item.data.catalogPage}) }}#catalog-viewer">Motiv auf Seite {{ item.data.catalogPage }}</a>{% endif %}</p></div><div class="field"><label for="cart-{{ item.id }}">Menge</label><input type="number" name="quantities[{{ item.id }}]" id="cart-{{ item.id }}" value="{{ entry.quantity }}" min="0" max="9999" step="1" inputmode="numeric" required></div></div>{% endfor %}<div class="catalog-cart-update"><small>Menge „0“ entfernt ein Design aus Ihrer Auswahl.</small><button class="btn btn-secondary" type="submit">Mengen speichern {{ icon('check') }}</button></div></form><form method="post" action="{{ path('app_advertising_cart_clear') }}" class="catalog-clear-form" data-confirm="Möchten Sie Ihre gesamte Auswahl leeren?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button type="submit" class="text-link">Gesamte Auswahl leeren</button></form></section>
<aside class="catalog-quote-card"><span class="eyebrow">DER NÄCHSTE SCHRITT</span><h2>Ein Angebot.<br>Genau für Sie.</h2><p>Speichern Sie Ihre Auswahl als Anfrageentwurf für die Abstimmung mit dem Partnermanagement.</p><form method="post" action="{{ path('app_advertising_request') }}" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="catalog-note">Wünsche & Hinweise</label><textarea id="catalog-note" name="note" maxlength="2000" rows="4" placeholder="Zum Beispiel Format, Termin, Größe oder Personalisierung …"></textarea><small>Bitte geänderte Mengen zuerst links speichern.</small></div><label class="checkbox-field"><input type="checkbox" name="personalize" value="1" data-catalog-personalize>Personalisierung mit meinem Namen und meiner Region vormerken</label><div class="catalog-personalization" data-catalog-personalization hidden><span class="catalog-personalization-label">KONTAKTBLOCK-VORSCHAU</span><div>{% if app.user.preferences.avatarFilename|default('') %}<img src="/profile/avatar/{{ app.user.id }}" alt="Ihr Profilbild" width="44" height="44">{% else %}<span class="avatar">{{ portal.initials }}</span>{% endif %}<p><strong>{{ app.user.name }}</strong><small>{{ app.user.region }}</small></p><img src="/assets/brand/chase-orange.png" class="personalization-logo" alt="CHASE Immobilien" width="72" height="25"></div><small>Gestaltungsvorschau. Die Originaldesigns werden nicht verändert; es wird keine Druckdatei erzeugt.</small></div><button class="btn btn-primary" type="submit">Anfrageentwurf speichern {{ icon('arrow-right') }}</button></form><div class="catalog-quote-status">{{ icon('lock') }}<span>Lokal gespeichert. Keine Bestellung.<br>Kein automatischer Versand.</span></div><div class="catalog-quote-price"><strong>Preis auf Anfrage</strong><small>Für Werbemittel sind im Katalog keine Bestellpreise angegeben. Eine Flyeralarm-Anbindung ist noch nicht eingerichtet.</small></div></aside></div>
{% else %}<div class="empty-state catalog-empty-cart">{{ icon('shopping-bag') }}<h2>Hier ist Platz für Ihren nächsten Auftritt.</h2><p>Blättern Sie durch den CHASE Katalog und legen Sie Ihre Wunschdesigns mit der gewünschten Menge in die Auswahl.</p><a class="btn btn-primary" href="{{ path('app_advertising') }}">Katalog entdecken {{ icon('arrow-right') }}</a></div>{% endif %}
{% if requests %}<div class="catalog-past-requests"><h2>Schon etwas vorbereitet?</h2><p>{{ requests|length }} lokal gespeicherte Anfrage{{ requests|length == 1 ? '' : 'n' }} finden Sie in Ihren Entwürfen.</p><a class="text-link" href="{{ path('app_advertising',{tab:'requests'}) }}">Anfrageentwürfe öffnen {{ icon('arrow-right') }}</a></div>{% endif %}
{% endblock %}
