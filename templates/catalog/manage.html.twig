{% extends 'base.html.twig' %}
{% block title %}Werbemittel verwalten{% endblock %}
{% block body %}<div class="catalog-admin-workspace"><div class="page-heading"><h1>Werbemittel verwalten</h1><div class="actions"><a class="btn btn-secondary" href="{{ path('app_advertising') }}">Zum Katalog</a><a class="btn btn-primary" href="{{ path('app_advertising_product_new') }}">{{ icon('plus') }}Werbemittel</a></div></div>{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}<div class="catalog-manage-layout"><section class="card catalog-category-manager"><h2>Kategorien</h2><form method="post" class="catalog-category-add"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label class="sr-only" for="category-name">Neue Kategorie</label><input id="category-name" name="name" placeholder="Neue Kategorie" maxlength="60" required><button type="submit" class="btn btn-primary" aria-label="Kategorie anlegen">{{ icon('plus') }}</button></form><div class="catalog-category-list">{% for record in categoryRecords %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="id" value="{{ record.id }}"><label class="sr-only" for="cat-{{ record.id }}">Kategoriename</label><input id="cat-{{ record.id }}" name="name" value="{{ record.title }}" maxlength="60" required><button class="icon-button" type="submit" title="Kategorie speichern" aria-label="{{ record.title }} speichern">{{ icon('check') }}</button></form>{% endfor %}<div class="catalog-source-categories">{% for category in categories %}<span class="badge">{{ category }}</span>{% endfor %}</div></div></section><section class="table-wrap catalog-management-table"><table><thead><tr><th>Werbemittel</th><th>Kategorie</th><th>Startmenge</th><th>Status</th><th></th></tr></thead><tbody>{% for item in all %}<tr><td><strong>{{ item.title }}</strong></td><td>{{ item.data.category|default('–') }}</td><td>{{ item.data.defaultQuantity|default(1) }}</td><td><span class="badge">{{ item.data.active|default(true) ? 'Aktiv' : 'Ausgeblendet' }}</span></td><td><a class="icon-button" href="{{ path('app_advertising_product_edit',{id:item.id}) }}" aria-label="{{ item.title }} bearbeiten">{{ icon('edit') }}</a></td></tr>{% endfor %}</tbody></table></section></div></div>{% endblock %}
