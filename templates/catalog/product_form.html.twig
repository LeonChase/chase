{% extends 'base.html.twig' %}
{% block title %}Werbemittel bearbeiten{% endblock %}
{% block body %}<div class="catalog-editor-workspace"><div class="page-heading"><h1>{{ product.data.manual|default(false) and not product.data.imageFilePath|default('') ? 'Werbemittel anlegen' : 'Werbemittel bearbeiten' }}</h1><a class="btn btn-secondary" href="{{ path('app_advertising_manage') }}">Zur Verwaltung</a></div>{% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}<form method="post" enctype="multipart/form-data" class="card catalog-editor-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="form-grid"><div class="field"><label for="product-title">Name</label><input id="product-title" name="title" value="{{ data.title }}" maxlength="150" required></div><div class="field"><label for="product-category">Kategorie</label><select id="product-category" name="category" required><option value="">Bitte wählen</option>{% for category in categories %}<option {{ category == data.category|default('') ? 'selected' : '' }}>{{ category }}</option>{% endfor %}</select></div><input type="hidden" name="defaultQuantity" value="{{ data.defaultQuantity|default(1) }}"><div class="field"><label for="product-unit">Einheit</label><input id="product-unit" name="unit" maxlength="30" value="{{ data.unit|default('Stück') }}" required></div><div class="field full-width"><label for="product-image">Produktbild</label><input id="product-image" name="image" type="file" accept=".jpg,.jpeg,.png,.webp"><small>JPG, PNG oder WebP · maximal 5 MB · privat gespeichert</small></div><label class="checkbox-field full-width"><input type="checkbox" name="active" value="1" {{ data.active|default(true) ? 'checked' : '' }}>Im Katalog anzeigen</label></div><details class="catalog-price-editor" {{ data.referenceQuote|default(null) ? 'open' : '' }}><summary>Musterpreis mit Quelle hinterlegen</summary>{% set quote=data.referenceQuote|default({}) %}<div class="form-grid"><div class="field"><label for="quote-provider">Anbieter</label><input id="quote-provider" name="quoteProvider" maxlength="120" value="{{ quote.provider|default('') }}"></div><div class="field"><label for="quote-url">Quell-URL</label><input id="quote-url" name="quoteUrl" type="url" maxlength="2000" value="{{ quote.url|default('') }}"></div><div class="field"><label for="quote-date">Preisstand</label><input id="quote-date" name="quoteDate" type="date" max="{{ 'now'|date('Y-m-d') }}" value="{{ quote.date|default('') }}"></div><div class="field"><label for="quote-quantity">Menge des Angebots</label><input id="quote-quantity" name="quoteQuantity" type="number" min="1" max="999999999" value="{{ quote.quantity|default('') }}"></div><div class="field"><label for="quote-amount">Gesamtpreis (EUR)</label><input id="quote-amount" name="quoteAmount" type="number" min="0.01" max="100000" step="0.01" value="{{ quote.amount|default('') }}"></div><div class="field"><label for="quote-tax">Preisangabe</label><select id="quote-tax" name="quoteTaxMode"><option value="gross" {{ quote.taxMode|default('gross') == 'gross' ? 'selected' : '' }}>Brutto</option><option value="net" {{ quote.taxMode|default('gross') == 'net' ? 'selected' : '' }}>Netto</option></select></div></div><small>Manuell belegter Musterpreis für die angegebene Menge. Kein automatischer Preisabgleich und kein verbindliches Angebot.</small></details><div class="form-actions"><button class="btn btn-primary" type="submit">Speichern {{ icon('check') }}</button></div></form></div>{% endblock %}
