<div class="catalog-section-heading"><div><span class="eyebrow">ALLES AN EINEM ORT</span><h2>Meine Angebotsanfragen</h2></div><a href="{{ path('app_advertising_cart') }}" class="btn btn-secondary">Neue Anfrage vorbereiten {{ icon('arrow-right') }}</a></div>
<div class="stack">{% for draft in requests %}<article class="card catalog-request"><div class="catalog-request-heading"><div><span class="badge badge-orange">Lokal gespeichert · nicht versendet</span><h3>{{ draft.title }}</h3><small>{{ draft.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</small></div><a class="btn btn-secondary" href="{{ path('app_advertising_request_download',{id:draft.id}) }}">{{ icon('download') }}Anfrage herunterladen</a></div><ul class="catalog-request-items">{% for item in draft.data.items|default([]) %}<li><strong>{{ item.quantity }} ×</strong><span>{{ item.title }}</span>{% if item.catalogPage|default(null) %}<small>Seite {{ item.catalogPage }}</small>{% endif %}</li>{% endfor %}</ul>{% if draft.data.note|default('') %}<p class="catalog-request-note">{{ draft.data.note }}</p>{% endif %}<div class="catalog-request-footer"><small>Abstimmung mit dem Partnermanagement · Angebot und Versand sind noch nicht angebunden.</small><form method="post" action="{{ path('app_advertising_request_delete',{id:draft.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button type="submit" class="text-link">Entwurf löschen</button></form></div></article>{% else %}<div class="empty-state">{{ icon('shopping-bag') }}<h3>Ihr nächster Auftritt beginnt mit einer Idee.</h3><p>Entdecken Sie den Katalog und speichern Sie Ihre erste Angebotsanfrage.</p><a href="{{ path('app_advertising') }}" class="btn btn-primary">Katalog entdecken {{ icon('arrow-right') }}</a></div>{% endfor %}</div>
