{% extends 'base.html.twig' %}
{% block title %}Mein Profil · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Ihr persönlicher Arbeitsplatz</span><h1>Mein Profil</h1><p>Ihre Angaben, Ihre Sicherheit und Ihre bevorzugte Darstellung.</p></div><span class="badge">Demo-Konto</span></div>
{% if errors %}<div class="alert alert-error" role="alert"><strong>Bitte prüfen Sie Ihre Angaben:</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<div class="grid grid-2"><section class="card stack"><h2>Persönliche Angaben</h2><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="field"><label for="profile-name">Ihr Name</label><input id="profile-name" name="name" value="{{ app.request.method == 'POST' ? app.request.request.get('name') : app.user.name }}" minlength="2" maxlength="100" autocomplete="name" required></div><div class="field"><label for="profile-email">E-Mail-Adresse</label><input id="profile-email" type="email" value="{{ app.user.email }}" readonly aria-describedby="email-hint"><small class="muted" id="email-hint">Anmeldeadresse und Region verwaltet Ihre Administration.</small></div><div class="form-grid"><div class="field"><label for="profile-region">Region</label><input id="profile-region" value="{{ app.user.region }}" readonly></div><div class="field"><label for="profile-role">Rolle</label><input id="profile-role" value="{{ is_granted('ROLE_SUPER_ADMIN') ? 'Technische Administration' : (is_granted('ROLE_ADMIN') ? 'Administration' : (is_granted('ROLE_REGION_MANAGER') ? 'Regionalleitung' : 'Immobilienmakler')) }}" readonly></div></div><label class="checkbox-field"><input type="checkbox" name="directory_visible" value="1" {{ directoryVisible ? 'checked' : '' }}> Mein Name und meine Region dürfen im internen Partnerverzeichnis erscheinen.</label><p class="muted"><small>Private Kontaktdaten werden dort nicht angezeigt. Die Beispielprofile sind synthetische Demo-Daten.</small></p><hr><h2>Passwort ändern</h2><p class="muted">Lassen Sie diese Felder leer, wenn Sie nur Ihr Profil speichern möchten.</p><div class="field"><label for="current-password">Bisheriges Passwort</label><input id="current-password" type="password" name="current_password" autocomplete="current-password"></div><div class="field"><label for="new-password">Neues Passwort</label><input id="new-password" type="password" name="new_password" minlength="12" maxlength="200" autocomplete="new-password" aria-describedby="password-hint"><small id="password-hint" class="muted">Mindestens 12 Zeichen. Verwenden Sie für diese Demo ein eigenes Passwort.</small></div><div class="field"><label for="password-confirmation">Neues Passwort wiederholen</label><input id="password-confirmation" type="password" name="password_confirmation" minlength="12" maxlength="200" autocomplete="new-password"></div><button class="btn btn-primary" type="submit">Profil speichern</button></form></section><div class="stack"><section class="card stack"><h2>Hell oder Dunkel?</h2><p class="muted">Ihre Auswahl bleibt auch nach dem erneuten Anmelden erhalten.</p><form method="post" action="{{ path('app_theme') }}" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label class="checkbox-field"><input type="radio" name="theme" value="light" {{ app.user.preferences.theme|default('light') == 'light' ? 'checked' : '' }}> Hell · klare, warme Arbeitsfläche</label><label class="checkbox-field"><input type="radio" name="theme" value="dark" {{ app.user.preferences.theme|default('light') == 'dark' ? 'checked' : '' }}> Dunkel · ruhiger Fokus</label><button class="btn btn-secondary" type="submit">Darstellung speichern</button></form></section><section class="card stack"><span class="eyebrow">Ihr Gesicht im Netzwerk</span><h2>Mein Profilbild</h2>{% if app.user.preferences.avatarFilename|default('') %}<img src="/profile/avatar/{{ app.user.id }}" alt="Ihr aktuelles Profilbild" width="120" height="150" style="object-fit:cover;border-radius:14px"><form method="post" action="/profile/avatar/remove"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Bild entfernen</button></form>{% else %}<p class="muted">Ein persönliches Bild macht Ihre privaten Landingpage-Vorschauen und Ihr freigegebenes Profil wiedererkennbar.</p>{% endif %}<form method="post" action="/profile/avatar" enctype="multipart/form-data" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label for="avatar-file">Bild auswählen (JPG, PNG, WebP · maximal 4 MB)</label><input id="avatar-file" type="file" name="avatar" accept="image/jpeg,image/png,image/webp" required><button class="btn btn-primary">Profilbild speichern</button></form></section><section class="card stack"><h2>Wir helfen weiter</h2><p class="muted">Informationen zur Bedienung und zu den Grenzen dieser lokalen Demo.</p><a class="btn btn-secondary" href="{{ path('app_help') }}">Hilfe öffnen</a></section></div></div>
{% endblock %}
