{% extends 'base.html.twig' %}
{% block title %}Marketing & Social Media · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Marketing & Social Media</span><h1>Planen. Gestalten. Sichtbar werden.</h1><p class="muted">Ihr Redaktionsplan und Ihre Beiträge an einem Ort.</p></div><div class="toolbar"><a class="btn btn-secondary" href="{{ path('marketing_landing_preview') }}">Landingpage-Vorschau</a><a class="btn btn-primary" href="{{ path('marketing_new') }}">+ Beitrag erstellen</a></div></div>
<div class="alert"><strong>Interne Planung</strong> · „Geplant“ ist ein Termin in Ihrem lokalen Kalender. Instagram, Facebook und LinkedIn sind nicht verbunden. Kein Beitrag wird automatisch veröffentlicht.</div>
<section class="card"><div class="toolbar" style="flex-wrap:wrap"><h2>{{ view == 'week' ? 'Woche vom ' ~ days[0].date|date('d.m.Y') : monthDate|date('m / Y') }}</h2><div class="toolbar"><a class="btn btn-secondary" href="{{ path('marketing',{month:previous|date('Y-m'),view:view,date:previous|date('Y-m-d')}) }}" aria-label="Vorheriger Zeitraum">←</a><a class="btn btn-secondary" href="{{ path('marketing') }}">Heute</a><a class="btn btn-secondary" href="{{ path('marketing',{month:next|date('Y-m'),view:view,date:next|date('Y-m-d')}) }}" aria-label="Nächster Zeitraum">→</a><a class="btn {{ view == 'month' ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('marketing',{month:month,view:'month'}) }}">Monat</a><a class="btn {{ view == 'week' ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('marketing',{month:month,view:'week',date:month ~ '-01'}) }}">Woche</a></div></div>
<div style="overflow-x:auto"><div style="min-width:650px;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:1px;background:var(--border,#e6e7ea);border:1px solid var(--border,#e6e7ea);border-radius:12px;overflow:hidden">{% for label in ['Mo','Di','Mi','Do','Fr','Sa','So'] %}<div style="background:var(--surface,#fff);padding:12px;text-align:center;font-weight:600">{{ label }}</div>{% endfor %}{% for day in days %}<div style="background:var(--surface,#fff);min-height:{{ view == 'week' ? 230 : 112 }}px;padding:9px;opacity:{{ day.current or view == 'week' ? '1' : '.45' }}"><span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;{{ day.today ? 'background:#FF6A00;color:white' : '' }}">{{ day.date|date('j') }}</span>{% for post in scheduled[day.key]|default([]) %}<a href="{{ path('marketing_edit',{id:post.id}) }}" style="display:block;background:rgba(255,106,0,.12);padding:6px;border-radius:6px;font-size:12px;line-height:1.4;margin-top:5px;overflow-wrap:anywhere;color:inherit"><strong>{{ post.data.plannedAt|date('H:i','Europe/Berlin') }}</strong> {{ post.title }}<br><small>{{ post.data.channel|default('Beitrag') }}</small></a>{% endfor %}</div>{% endfor %}</div></div></section>
<div class="grid grid-2" style="align-items:start;margin-top:24px"><section class="card"><h2>Ihre Beiträge</h2>{% for post in posts|reverse %}<a style="display:block;padding:16px 0;border-bottom:1px solid var(--border,#e6e7ea)" href="{{ path('marketing_edit',{id:post.id}) }}"><div class="toolbar"><strong>{{ post.title }}</strong><span class="badge">{{ post.data.status|default('Entwurf') }}</span></div><small class="muted">{{ post.data.channel|default('Social') }} · {{ post.data.plannedAt|default(null) ? post.data.plannedAt|date('d.m.Y H:i','Europe/Berlin') : 'Noch kein Termin' }}</small></a>{% else %}<div class="empty-state">Hier beginnt Ihre nächste Kampagne. Erstellen Sie Ihren ersten Beitrag.</div>{% endfor %}</section><section class="card"><h2>Mit einer Idee starten</h2><p class="muted">Synthetische CHASE-Kampagnenvorlagen. Texte werden lokal erstellt und anschließend von Ihnen geprüft.</p>{% for campaign in campaigns %}<div style="padding:16px 0;border-bottom:1px solid var(--border,#e6e7ea)"><span class="badge">{{ campaign.category }}</span><h3>{{ campaign.title }}</h3><p class="muted">{{ campaign.description }}</p><a class="btn btn-secondary" href="{{ path('marketing_new',{topic:campaign.title,cta:campaign.cta}) }}">Vorlage verwenden →</a></div>{% endfor %}</section></div>
{% endblock %}
