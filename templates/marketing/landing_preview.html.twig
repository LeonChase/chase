{% extends 'base.html.twig' %}
{% block title %}Landingpage-Vorschau · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Marketing & Akquise</span><h1>Eine Idee bekommt ein Gesicht.</h1><p class="muted">Ihre private Landingpage- und Widget-Vorschau – lokal gespeichert, jederzeit bearbeitbar.</p></div><a href="{{ path('marketing') }}" class="btn btn-secondary">Zum Marketingkalender</a></div>
<div class="alert"><strong>Vorschau · nicht live.</strong> Dies ist kein öffentliches Kontaktformular. Es werden keine Interessenten erfasst, keine E-Mails versendet und keine Daten an externe Dienste übertragen. Für eine Veröffentlichung wären eine eigene Integration und ein geprüftes Datenschutz- und Einwilligungskonzept erforderlich.</div>
<nav class="tabs" aria-label="Vorschautyp">{% for key,definition in types %}<a href="{{ path('marketing_landing_preview',{type:key}) }}" class="{{ type == key ? 'active' : '' }}">{{ definition.label }}</a>{% endfor %}</nav>
{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
<div class="grid grid-2" style="align-items:start"><section class="card"><h2>{{ types[type].label }} gestalten</h2><form method="post" action="{{ path('marketing_landing_preview') }}" class="stack" id="preview-editor"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="draft" value="{{ draft ? draft.id : '' }}"><input type="hidden" name="type" value="{{ type }}"><div class="field"><label for="landing-title">Überschrift</label><input id="landing-title" name="title" value="{{ values.title }}" maxlength="180" required></div><div class="field"><label for="landing-intro">Beschreibung</label><textarea id="landing-intro" name="intro" rows="5" maxlength="2000">{{ values.intro }}</textarea></div><div class="field"><label for="landing-cta">Buttontext</label><input id="landing-cta" name="cta" value="{{ values.cta }}" maxlength="80" required></div><button class="btn btn-primary" type="submit">Private Vorschau speichern</button><p class="muted">Es werden ausschließlich Überschrift, Beschreibung und Buttontext in Ihrem eigenen Demo-Konto gespeichert.</p></form></section>
<section class="card" id="landing-preview" aria-label="Nicht öffentliche Landingpage-Vorschau" style="padding:0;overflow:hidden"><div style="background:#151923;color:white;padding:20px 26px;display:flex;justify-content:space-between;gap:16px"><strong>CHASE Immobilien</strong><span style="font-size:12px;color:#ffc395">VORSCHAU · NICHT LIVE</span></div><div style="padding:32px"><span class="badge">{{ types[type].label }} · Demo</span><h2 id="live-title" style="font-size:clamp(25px,3vw,38px);line-height:1.2;margin:22px 0">{{ values.title }}</h2><p id="live-intro" style="white-space:pre-wrap">{{ values.intro }}</p><fieldset disabled style="border:0;padding:0;margin:28px 0 0"><legend style="font-size:13px;margin-bottom:16px">Beispielansicht – alle Kontaktfelder sind deaktiviert</legend><div class="stack">
{% if type == 'valuation' %}<div class="field"><label for="example-address">Ort Ihrer Immobilie</label><input id="example-address" disabled placeholder="Beispiel: Ort / Postleitzahl"></div><div class="field"><label for="example-area">Wohnfläche</label><input id="example-area" disabled placeholder="Beispiel: m²"></div>{% elseif type == 'callback' %}<div class="field"><label for="example-name">Ihr Name</label><input id="example-name" disabled placeholder="Hier können keine Daten eingegeben werden"></div><div class="field"><label for="example-phone">Telefonnummer</label><input id="example-phone" disabled placeholder="Deaktivierte Vorschau"></div>{% elseif type == 'guide' %}<div class="field"><label for="example-email">Ihre E-Mail-Adresse</label><input id="example-email" disabled placeholder="Deaktivierte Vorschau"></div>{% else %}<div class="field"><label for="example-location">Gewünschter Ort</label><input id="example-location" disabled placeholder="Deaktivierte Vorschau"></div><div class="field"><label for="example-budget">Ihr Budget</label><input id="example-budget" disabled placeholder="Deaktivierte Vorschau"></div>{% endif %}
<label style="display:flex;gap:10px;align-items:flex-start;font-size:12px"><input type="checkbox" disabled style="width:auto;margin-top:4px"><span>Platzhalter für eine später fachlich geprüfte Einwilligung. Keine wirksame Einwilligung in dieser Vorschau.</span></label><button class="btn btn-primary" id="live-cta" type="button" disabled aria-disabled="true">{{ values.cta }}</button></div></fieldset><p class="muted" style="font-size:12px;margin-top:18px">Kein Absenden, kein Download und keine Kontaktaufnahme möglich. Ausschließlich private Gestaltungsvorschau.</p></div></section></div>
<script>(() => { [['landing-title','live-title'],['landing-intro','live-intro'],['landing-cta','live-cta']].forEach(([input,output]) => { document.getElementById(input).addEventListener('input', event => { document.getElementById(output).textContent = event.target.value; }); }); })();</script>
{% endblock %}
