{% extends 'base.html.twig' %}
{% block title %}Akquise & Leads · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block javascripts %}<script src="/assets/planning.js" defer></script>{% endblock %}
{% block body %}
<section class="planning-workspace-root lead-workspace">
<header class="planning-topline"><h1>Akquise & Leads</h1><form method="get" class="planning-inline-search" role="search"><input type="hidden" name="view" value="{{ filters.view|default('board') }}"><label class="sr-only" for="lead-search">Leads durchsuchen</label>{{ icon('search') }}<input id="lead-search" name="q" value="{{ filters.q|default('') }}" placeholder="Leads suchen" aria-label="Leads durchsuchen"><button class="planning-icon" aria-label="Leads suchen">{{ icon('arrow-right') }}</button></form><div class="planning-tools"><div class="planning-layout-switch" role="group" aria-label="Lead-Darstellung"><a class="planning-icon {{ filters.view|default('board') != 'list' ? 'active' }}" href="/leads?{{ filters|merge({view:'board'})|url_encode }}" aria-label="Pipeline anzeigen" title="Pipeline">{{ icon('panel-left') }}</a><a class="planning-icon {{ filters.view|default('board') == 'list' ? 'active' }}" href="/leads?{{ filters|merge({view:'list'})|url_encode }}" aria-label="Liste anzeigen" title="Liste">{{ icon('menu') }}</a></div>
<details class="planning-menu"><summary class="planning-icon" aria-label="Leads filtern" title="Leads filtern"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8Z"/></svg></summary><form method="get" class="planning-popover stack"><h2>Leads filtern</h2><input type="hidden" name="view" value="{{ filters.view|default('board') }}"><input type="hidden" name="q" value="{{ filters.q|default('') }}"><div class="field"><label for="lead-filter-status">Status</label><select id="lead-filter-status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="lead-sort">Sortierung</label><select id="lead-sort" name="sort"><option value="newest">Neueste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Name A–Z</option></select></div><button class="btn btn-primary btn-small">Anwenden</button><a href="/leads">Zurücksetzen</a></form></details>
<details class="planning-menu lead-integration-info"><summary class="planning-icon" aria-label="Informationen zu Lead-Quellen" title="Lead-Quellen">{{ icon('help-circle') }}</summary><div class="planning-popover lead-origin-status"><h2>Quellen</h2><p>Hausgold, Aroundhome und Marktbeobachtung sind nicht verbunden.</p><p>Die lokale Demo verwendet synthetische Kontakte. Kein automatischer Abruf oder Versand.</p></div></details><button class="planning-icon lead-quick-trigger" type="button" data-open-dialog="lead-quick-dialog" aria-label="Kontakt schnell erfassen" title="Schnellerfassung"><svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-13h-8Z"/></svg></button><a class="btn btn-primary btn-small lead-add-button" href="/leads/new" data-record-editor>{{ icon('plus') }}<span>Demo-Lead</span></a></div></header>
<div class="planning-status" data-planning-status role="status" aria-live="polite"></div>
{% if filters.status|default('') or filters.q|default('') %}<div class="planning-active-filter"><span>{{ filters.status|default('Alle Status') }}{{ filters.q|default('') ? ' · ' ~ filters.q : '' }}</span><a href="/leads" class="planning-icon" aria-label="Leadfilter zurücksetzen">{{ icon('x') }}</a></div>{% endif %}
{% if filters.view|default('board') == 'list' %}<div class="planning-pane planning-pane-scroll lead-table" data-pane-scroll="leads"><table><thead><tr><th>Kontakt</th><th>Interesse</th><th>Status</th><th>Nächster Schritt</th><th></th></tr></thead><tbody>{% for item in items %}<tr><td><a href="/leads/{{ item.id }}" data-record-editor><strong>{{ item.title }}</strong></a></td><td>{{ item.data.interest|default('') }}</td><td><span class="badge">{{ item.data.status|default('Neu') }}</span></td><td>{% include 'leads/_next_step.html.twig' with {item:item,nextTask:nextTasks[item.id]|default(null)} only %}</td><td><a href="/leads/{{ item.id }}" class="planning-icon" data-record-editor aria-label="{{ item.title }} bearbeiten">{{ icon('edit') }}</a></td></tr>{% else %}<tr><td colspan="5"><p class="planning-empty">Keine Leads.</p></td></tr>{% endfor %}</tbody></table></div>
{% else %}<div class="pipeline-board" aria-label="Akquise-Pipeline" data-pane-scroll="leads">{% for status in statuses %}<section class="pipeline-lane" aria-label="{{ status }}"><div class="pipeline-lane-heading"><h2>{{ status }}</h2><span>{{ lanes[status]|length }}</span></div><div class="pipeline-lane-items">{% for item in lanes[status] %}<article class="pipeline-lead" data-lead-id="{{ item.id }}"><a href="/leads/{{ item.id }}" data-record-editor>{{ item.title }}</a><p>{{ item.data.interest|default('') }}</p>{% include 'leads/_next_step.html.twig' with {item:item,nextTask:nextTasks[item.id]|default(null)} only %}{% set activity=item.data.activities|default([])|last %}{% if activity %}<small class="pipeline-last-activity" title="{{ activity.note }}">{{ activity.date|date('d.m.') }} · {{ activity.note|slice(0,80) }}{{ activity.note|length > 80 ? '…' }}</small>{% endif %}<form class="pipeline-status-form" method="post" action="/leads/{{ item.id }}/status" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label class="sr-only" for="status-{{ item.id }}">Status für {{ item.title }}</label><select id="status-{{ item.id }}" name="status">{% for value in statuses %}<option {{ value == status ? 'selected' }}>{{ value }}</option>{% endfor %}</select><button class="planning-icon" aria-label="Status für {{ item.title }} speichern">{{ icon('arrow-right') }}</button></form></article>{% endfor %}</div></section>{% endfor %}</div>{% endif %}
<dialog id="lead-quick-dialog" class="planning-dialog planning-small-dialog" aria-labelledby="lead-quick-title"><div class="planning-dialog-heading"><h2 id="lead-quick-title">Kontakt schnell erfassen</h2><button class="planning-icon" type="button" data-close-dialog aria-label="Schließen">{{ icon('x') }}</button></div><form method="post" action="/leads/new" class="stack" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="Neu"><input type="hidden" name="source" value="Manuelle Demo-Erfassung"><div class="field"><label for="quick-name">Name (Demo)</label><input id="quick-name" name="name" maxlength="250" required autocomplete="off"></div><div class="field"><label for="quick-interest">Interesse</label><input id="quick-interest" name="interest" maxlength="250" required></div><div class="field"><label for="quick-followup">Nächster Kontakt</label><input type="date" id="quick-followup" name="nextFollowUp"></div><p class="planning-form-error" data-form-error role="alert"></p><button class="btn btn-primary">Anlegen</button></form></dialog>
{% include 'tasks/_record_dialog.html.twig' %}
</section>
{% endblock %}
