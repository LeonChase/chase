{% extends 'base.html.twig' %}
{% block title %}Akquise & Leads · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">BEZIEHUNGEN MIT PERSPEKTIVE</p><h1>Akquise & Leads</h1><p class="muted">Jede Anfrage mit einem klaren nächsten Schritt.</p></div><a class="btn btn-primary" href="/leads/new">{{ icon('plus') }} Demo-Lead anlegen</a></div>
<div class="lead-origin-status" aria-label="Externe Quellen"><span><i></i>Hausgold · nicht verbunden</span><span><i></i>Aroundhome · nicht verbunden</span><span><i></i>Privatanzeigen / Marktbeobachtung · nicht verbunden</span></div>
<p class="muted lead-source-note">Lokale Demo-Pipeline mit synthetischen Kontakten. Es werden keine Portale durchsucht, Anzeigen abgerufen oder Nachrichten automatisch versendet.</p>
<details class="card lead-quick-entry"><summary>+ Kontakt schnell erfassen</summary><form method="post" action="/leads/new" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="Neu"><div class="form-grid"><div class="field"><label for="quick-name">Name (Demo) *</label><input id="quick-name" name="name" maxlength="250" required placeholder="Alex Beispiel (Demo)"></div><div class="field"><label for="quick-interest">Anlass / Interesse *</label><input id="quick-interest" name="interest" maxlength="250" required placeholder="z. B. Verkaufsbewertung"></div><div class="field"><label for="quick-source">Quelle (manuelle Angabe)</label><select id="quick-source" name="source"><option>Manuelle Demo-Erfassung</option><option>Empfehlung (Demo)</option><option>Hausgold (manuelle Demo-Erfassung)</option><option>Aroundhome (manuelle Demo-Erfassung)</option><option>Privatanzeige (manuelle Demo-Erfassung)</option></select></div><div class="field"><label for="quick-followup">Nächster Kontakt</label><input type="date" id="quick-followup" name="nextFollowUp"></div></div><div><button class="btn btn-primary btn-small">In „Neu“ aufnehmen</button></div><small class="muted">Details, Aktivitätsnotizen und eine nächste Aufgabe können Sie anschließend ergänzen.</small></form></details>
<form method="get" class="card toolbar"><input type="hidden" name="view" value="{{ filters.view|default('board') }}"><div class="field"><label for="q">Lead suchen</label><input id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Name, Interesse oder Quelle"></div><div class="field"><label for="status">Pipeline-Status</label><select id="status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="sort">Sortierung</label><select id="sort" name="sort"><option value="newest">Neueste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Name A–Z</option></select></div><button class="btn btn-secondary">Filtern</button><a href="/leads">Zurücksetzen</a><div class="lead-view-controls"><a class="btn btn-secondary btn-small" href="/leads?{{ filters|merge({view:'board'})|url_encode }}" aria-label="Pipeline anzeigen">Pipeline</a><a class="btn btn-secondary btn-small" href="/leads?{{ filters|merge({view:'list'})|url_encode }}" aria-label="Liste anzeigen">Liste</a></div></form>
{% if filters.view|default('board') == 'list' %}
<div class="card table-wrap lead-table"><table><thead><tr><th>Kontakt / Interesse</th><th>Quelle</th><th>Status</th><th>Nächster Schritt</th><th>Aktion</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="/leads/{{ item.id }}"><strong>{{ item.title }}</strong></a><br><small class="muted">{{ item.data.interest|default('Interesse fehlt') }}</small></td><td>{{ item.data.source|default('Manuelle Demo-Erfassung') }}</td><td><span class="badge">{{ item.data.status|default('Neu') }}</span></td><td>{% include 'leads/_next_step.html.twig' with {item:item,nextTask:nextTasks[item.id]|default(null)} only %}</td><td><a href="/leads/{{ item.id }}">Öffnen →</a></td></tr>{% else %}<tr><td colspan="5"><div class="empty-state"><h3>Ihre nächste Chance.</h3><p>Noch keine Kontakte für diese Auswahl.</p></div></td></tr>{% endfor %}</tbody></table></div>
{% else %}
<div class="pipeline-board" aria-label="Akquise-Pipeline">{% for status in statuses %}<section class="pipeline-lane" aria-label="{{ status }}"><div class="pipeline-lane-heading"><h2>{{ status }}</h2><span class="pipeline-lane-count">{{ lanes[status]|length }}</span></div>{% for item in lanes[status] %}<article class="pipeline-lead" data-lead-id="{{ item.id }}"><a href="/leads/{{ item.id }}">{{ item.title }}</a><p>{{ item.data.interest|default('Interesse fehlt') }}</p><small>{{ item.data.source|default('Manuelle Demo-Erfassung') }}</small>{% include 'leads/_next_step.html.twig' with {item:item,nextTask:nextTasks[item.id]|default(null)} only %}{% set activity = item.data.activities|default([])|last %}{% if activity %}<p class="pipeline-last-activity">{{ activity.date|date('d.m.') }} · {{ activity.note|slice(0,100) }}{{ activity.note|length > 100 ? '…' }}</p>{% endif %}<form class="pipeline-status-form" method="post" action="/leads/{{ item.id }}/status"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label class="sr-only" for="status-{{ item.id }}">Status für {{ item.title }}</label><select id="status-{{ item.id }}" name="status">{% for value in statuses %}<option {{ value == status ? 'selected' }}>{{ value }}</option>{% endfor %}</select><button class="btn btn-secondary" aria-label="Pipeline-Status für {{ item.title }} speichern">→</button></form></article>{% else %}<p class="pipeline-empty">Noch kein Kontakt in dieser Phase.</p>{% endfor %}</section>{% endfor %}</div><p class="muted lead-source-note">Die Pipeline lässt sich horizontal durchgehen. Statusänderungen werden im Aktivitätsverlauf gespeichert.</p>
{% endif %}
{% endblock %}
