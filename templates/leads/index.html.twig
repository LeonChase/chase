{% extends 'base.html.twig' %}{% block title %}Akquise & Leads · CHASE{% endblock %}{% block body %}
<div class="page-heading"><div><p class="eyebrow">GUTE BEZIEHUNGEN BEGINNEN HIER</p><h1>Akquise & Leads</h1><p class="muted">Deine interne Pipeline – vom ersten Interesse zum nächsten Schritt.</p></div><a class="btn btn-primary" href="/leads/new">+ Demo-Lead anlegen</a></div>
<div class="alert">Synthetische Demo-Kontakte. Es erfolgt keine Kontaktaufnahme, kein Versand und keine Übertragung an ein CRM.</div>
<form method="get" class="card toolbar"><div class="field"><label for="q">Lead suchen</label><input id="q" name="q" value="{{ filters.q|default('') }}" placeholder="Name, Interesse oder Quelle"></div><div class="field"><label for="status">Pipeline-Status</label><select id="status" name="status"><option value="">Alle Status</option>{% for status in statuses %}<option {{ filters.status|default('') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="sort">Sortierung</label><select id="sort" name="sort"><option value="newest">Neueste zuerst</option><option value="title" {{ filters.sort|default('') == 'title' ? 'selected' }}>Name A–Z</option></select></div><button class="btn btn-secondary">Filtern</button><a href="/leads">Zurücksetzen</a></form>
<div class="grid grid-3" style="margin-bottom:24px">{% for status in statuses %}{% set count = 0 %}{% for item in items %}{% if item.data.status|default('Neu') == status %}{% set count = count + 1 %}{% endif %}{% endfor %}<a class="card" href="/leads?status={{ status|url_encode }}"><span class="muted">{{ status }}</span><strong style="display:block;font-size:1.8rem;margin-top:6px">{{ count }}</strong></a>{% endfor %}</div>
<div class="card table-wrap"><table><thead><tr><th>Kontakt / Interesse</th><th>Quelle</th><th>Status</th><th>Nächster Kontakt</th><th>Aktion</th></tr></thead><tbody>{% for item in items %}<tr><td><a href="/leads/{{ item.id }}"><strong>{{ item.title }}</strong></a><br><small class="muted">{{ item.data.interest|default('Interesse fehlt') }}</small></td><td>{{ item.data.source|default('Manuelle Demo-Erfassung') }}</td><td><span class="badge">{{ item.data.status|default('Neu') }}</span></td><td>{{ item.data.nextFollowUp|default('') ? item.data.nextFollowUp|date('d.m.Y') : 'Noch offen' }}</td><td><a href="/leads/{{ item.id }}">Öffnen →</a></td></tr>{% else %}<tr><td colspan="5"><div class="empty-state"><h2>Deine nächste Chance.</h2><p>Lege einen synthetischen Kontakt an oder passe die Filter an.</p><a href="/leads/new" class="btn btn-primary">Demo-Lead anlegen</a></div></td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
