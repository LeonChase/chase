<div class="pipeline-next-step">{% if nextTask %}<a href="/tasks/{{ nextTask.id }}/edit" data-record-editor>{{ nextTask.title }}</a><small>{{ nextTask.data.dueDate|default('') ? nextTask.data.dueDate|date('d.m.Y') : '' }}</small>{% elseif item.data.nextFollowUp|default('') %}<a href="/tasks/new?lead={{ item.id }}&date={{ item.data.nextFollowUp }}" data-record-editor>{{ item.data.nextFollowUp|date('d.m.Y') }}</a>{% else %}<a href="/tasks/new?lead={{ item.id }}" data-record-editor aria-label="Aufgabe für {{ item.title }} hinzufügen">+ Aufgabe</a>{% endif %}</div>
