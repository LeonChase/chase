<div class="pipeline-next-step">{% if nextTask %}<span class="muted">Nächste Aufgabe</span><a href="/tasks/{{ nextTask.id }}/edit">{{ nextTask.title }}</a><small>{{ nextTask.data.dueDate|default('') ? nextTask.data.dueDate|date('d.m.Y') : 'Ohne Termin' }}</small>{% elseif item.data.nextFollowUp|default('') %}<span class="muted">Nächster Kontakt</span><a href="/tasks/new?lead={{ item.id }}&date={{ item.data.nextFollowUp }}">{{ item.data.nextFollowUp|date('d.m.Y') }} · Aufgabe planen →</a>{% else %}<a href="/tasks/new?lead={{ item.id }}">Nächste Aufgabe planen →</a>{% endif %}</div>
