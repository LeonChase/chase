<div class="planning-record-editor lead-record-editor" data-record-title="{{ item.title ? item.title : 'Neuer Demo-Lead' }}">
{% if errors|default([]) %}<div class="alert" role="alert">{{ errors|join(' ') }}</div>{% endif %}
<form method="post" action="{{ item.title ? '/leads/' ~ item.id : '/leads/new' }}" class="stack lead-edit-form" data-planning-form><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="form-grid"><div class="field"><label for="name">Name (Demo)</label><input id="name" name="name" required maxlength="250" value="{{ data.name|default('') }}"></div><div class="field"><label for="interest">Interesse</label><input id="interest" name="interest" required maxlength="250" value="{{ data.interest|default('') }}"></div><div class="field"><label for="status">Status</label><select id="status" name="status">{% for status in statuses %}<option {{ data.status|default('Neu') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="nextFollowUp">Nächster Kontakt</label><input type="date" id="nextFollowUp" name="nextFollowUp" value="{{ data.nextFollowUp|default('') }}"></div></div>
<details class="planning-editor-section"><summary>Kontaktdaten & Quelle</summary><div class="form-grid"><div class="field"><label for="email">E-Mail (nur .test)</label><input type="email" id="email" name="email" maxlength="250" value="{{ data.email|default('') }}"></div><div class="field"><label for="phone">Telefon (fiktiv)</label><input id="phone" name="phone" maxlength="250" value="{{ data.phone|default('') }}"></div><div class="field"><label for="source">Quelle</label><input id="source" name="source" maxlength="250" value="{{ data.source|default('Manuelle Demo-Erfassung') }}"></div><div class="field"><label for="propertyId">Objekt</label><select id="propertyId" name="propertyId"><option value="">Kein Objekt</option>{% for property in properties %}<option value="{{ property.id }}" {{ data.propertyId|default('') == property.id ? 'selected' }}>{{ property.title }}</option>{% endfor %}</select></div></div></details>
<details class="planning-editor-section"><summary>Notizen</summary><div class="field"><label for="notes">Interne Notizen</label><textarea id="notes" name="notes" rows="3" maxlength="5000">{{ data.notes|default('') }}</textarea></div><div class="field"><label for="activityNote">Neue Aktivität</label><textarea id="activityNote" name="activityNote" rows="2" maxlength="5000">{{ data.activityNote|default('') }}</textarea></div></details><p class="planning-form-error" data-form-error role="alert"></p><div><button class="btn btn-primary btn-small">Speichern</button></div></form>
{% if item.title %}<div class="lead-editor-secondary"><section><div class="planning-section-heading"><h3>Aufgaben</h3><a class="planning-icon" href="/tasks/new?lead={{ item.id }}{{ data.nextFollowUp|default('') ? '&date=' ~ data.nextFollowUp : '' }}" data-record-editor aria-label="Aufgabe für diesen Lead hinzufügen">{{ icon('plus') }}</a></div>{% for task in tasks %}<a class="lead-linked-task" href="/tasks/{{ task.id }}/edit" data-record-editor><span>{{ task.title }}</span><small>{{ task.data.dueDate|default('') ? task.data.dueDate|date('d.m.Y') : task.data.status|default('Offen') }}</small></a>{% endfor %}</section>
<details class="planning-editor-section" id="followup-drafts"><summary>Check-up-Entwurf</summary><form method="post" action="/leads/{{ item.id }}/followup" data-planning-form data-refresh-dialog="/leads/{{ item.id }}?fragment=1#followup-drafts"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary btn-small">Entwurf erstellen</button></form>{% for draft in drafts %}<article class="lead-followup-draft"><label for="draft-{{ draft.id }}">{{ draft.title }}</label><small class="muted">{{ draft.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Nicht versendet</small><textarea id="draft-{{ draft.id }}" readonly rows="7">{{ draft.data.content }}</textarea><div class="planning-record-actions"><button type="button" class="btn btn-secondary btn-small" data-planning-copy="#draft-{{ draft.id }}">Kopieren</button><a href="/studio/content/{{ draft.id }}">Bearbeiten →</a></div></article>{% endfor %}<small class="muted">Lokale Vorlage aus bekannten Angaben. Kein Versand.</small></details>
<details class="planning-editor-section"><summary>Aktivitäten <span class="muted">{{ item.data.activities|default([])|length }}</span></summary>{% for activity in item.data.activities|default([])|reverse %}<article class="lead-activity"><small class="muted">{{ activity.date|date('d.m.Y H:i','Europe/Berlin') }}</small><p>{{ activity.note }}</p></article>{% endfor %}{% if item.data.sourceProvenance|default(null) %}<small class="muted">Erfasst {{ item.data.sourceProvenance.recordedAt|date('d.m.Y H:i','Europe/Berlin') }} · {{ item.data.sourceProvenance.source }}</small>{% endif %}</details></div>
<form method="post" action="/leads/{{ item.id }}/delete" data-planning-form data-planning-confirm="Demo-Lead löschen?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="planning-icon" aria-label="Demo-Lead löschen" title="Demo-Lead löschen">{{ icon('trash') }}</button></form>{% endif %}
</div>
