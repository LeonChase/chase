{% extends 'base.html.twig' %}
{% block title %}Demo-Lead · CHASE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/planning.css">{% endblock %}
{% block body %}
<div class="page-heading"><div><a href="/leads" class="muted">← Akquise & Leads</a><h1>{{ item.title ? item.title : 'Neuer Demo-Lead' }}</h1><p class="muted">Ausschließlich erfundene Kontaktdaten verwenden.</p></div>{% if item.title %}<a class="btn btn-primary" href="/tasks/new?lead={{ item.id }}{{ data.nextFollowUp|default('') ? '&date=' ~ data.nextFollowUp : '' }}">{{ icon('plus') }} Nächste Aufgabe</a>{% endif %}</div>
{% if errors %}<div class="alert" role="alert"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
<div class="grid grid-2" style="align-items:start"><form method="post" class="card stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><h2>Kontakt & Pipeline</h2>
<div class="form-grid"><div class="field"><label for="name">Name (Demo) *</label><input id="name" name="name" required maxlength="250" value="{{ data.name|default('') }}" placeholder="Alex Beispiel (Demo)"></div><div class="field"><label for="email">E-Mail (nur .test)</label><input type="email" id="email" name="email" maxlength="250" value="{{ data.email|default('') }}" placeholder="alex@example.test"></div><div class="field"><label for="phone">Telefon (fiktiv, optional)</label><input id="phone" name="phone" maxlength="250" value="{{ data.phone|default('') }}" placeholder="Keine echte Telefonnummer"></div><div class="field"><label for="source">Quelle (manuell)</label><input id="source" name="source" maxlength="250" value="{{ data.source|default('Manuelle Demo-Erfassung') }}" list="lead-sources"><datalist id="lead-sources"><option value="Empfehlung (Demo)"><option value="Hausgold (manuelle Demo-Erfassung)"><option value="Aroundhome (manuelle Demo-Erfassung)"><option value="Privatanzeige (manuelle Demo-Erfassung)"></datalist></div><div class="field"><label for="interest">Interesse *</label><input id="interest" name="interest" required maxlength="250" value="{{ data.interest|default('') }}"></div><div class="field"><label for="status">Pipeline-Status</label><select id="status" name="status">{% for status in statuses %}<option {{ data.status|default('Neu') == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></div><div class="field"><label for="nextFollowUp">Nächster Kontakt (intern)</label><input type="date" id="nextFollowUp" name="nextFollowUp" value="{{ data.nextFollowUp|default('') }}"></div><div class="field"><label for="propertyId">Verknüpftes Objekt</label><select id="propertyId" name="propertyId"><option value="">Kein Objekt</option>{% for property in properties %}<option value="{{ property.id }}" {{ data.propertyId|default('') == property.id ? 'selected' }}>{{ property.title }}</option>{% endfor %}</select></div></div>
<div class="field"><label for="notes">Interne Notizen</label><textarea id="notes" name="notes" rows="4" maxlength="5000">{{ data.notes|default('') }}</textarea></div><div class="field"><label for="activityNote">Neue Aktivitätsnotiz</label><textarea id="activityNote" name="activityNote" rows="3" maxlength="5000" placeholder="Was ist der aktuelle Stand?">{{ data.activityNote|default('') }}</textarea><small class="muted">Wird beim Speichern mit Datum zum Verlauf hinzugefügt.</small></div><div class="form-actions"><button class="btn btn-primary">Demo-Lead speichern</button><a href="/leads" class="btn btn-secondary">Abbrechen</a></div>
{% if item.data.sourceProvenance|default(null) %}<p class="lead-source-note">Ursprünglich erfasst: {{ item.data.sourceProvenance.recordedAt|date('d.m.Y H:i','Europe/Berlin') }} · {{ item.data.sourceProvenance.source }} · manuell, kein Portalabruf.</p>{% endif %}</form>
<div class="stack"><section class="card"><h2>Nächste Schritte</h2>{% for task in tasks %}<p><a href="/tasks/{{ task.id }}/edit">{{ task.title }}</a><br><span class="badge">{{ task.data.status|default('Offen') }}</span> <small class="muted">{{ task.data.dueDate|default('') ? task.data.dueDate|date('d.m.Y') : 'Ohne Termin' }}</small></p>{% else %}<p class="muted">Noch keine Aufgabe verknüpft.</p>{% endfor %}{% if item.title %}<a href="/tasks/new?lead={{ item.id }}{{ data.nextFollowUp|default('') ? '&date=' ~ data.nextFollowUp : '' }}">Follow-up-Aufgabe anlegen →</a>{% endif %}</section>
{% if item.title %}<section class="card" id="followup-drafts"><span class="eyebrow">SCHNELL VORBEREITET</span><h2>Check-up-Textentwurf</h2><p class="muted">Eine lokale Vorlage aus gespeichertem Namen und Interesse. Keine externen KI-Aufrufe, keine Kontaktaufnahme.</p><form method="post" action="/leads/{{ item.id }}/followup"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Entwurf aus bekannten Angaben erstellen</button></form>{% for draft in drafts %}<article class="lead-followup-draft"><strong>{{ draft.title }}</strong><p class="muted">{{ draft.createdAt|date('d.m.Y H:i','Europe/Berlin') }} · Version {{ draft.data.version|default(1) }} · Nicht versendet</p><label class="sr-only" for="draft-{{ draft.id }}">Gespeicherter Check-up-Textentwurf</label><textarea id="draft-{{ draft.id }}" readonly rows="9">{{ draft.data.content }}</textarea><div class="toolbar"><button type="button" class="btn btn-secondary btn-small" data-copy-target="#draft-{{ draft.id }}">Text kopieren</button><a href="/studio/content/{{ draft.id }}">Bearbeiten / Version speichern →</a></div></article>{% else %}<p class="muted">Ihr gespeicherter Entwurf erscheint hier und kann vor einer manuellen Verwendung bearbeitet werden.</p>{% endfor %}</section>{% endif %}
<section class="card"><h2>Aktivitätsverlauf</h2>{% for activity in item.data.activities|default([])|reverse %}<article style="border-bottom:1px solid var(--line);padding:15px 0"><small class="muted">{{ activity.date|date('d.m.Y H:i','Europe/Berlin') }}</small><p style="white-space:pre-line">{{ activity.note }}</p></article>{% else %}<p class="muted">Neue Aktivitätsnotizen erscheinen hier nach dem Speichern.</p>{% endfor %}</section><section class="card"><h3>Quellen & Integrationen</h3><p class="muted">Hausgold, Aroundhome und Marktbeobachtung sind nicht verbunden. Quellen werden manuell dokumentiert; es werden keine Anzeigen oder Kontaktdaten automatisch abgerufen. Vor echtem Einsatz sind Anbindung, Datenschutz und Kontaktfreigaben einzurichten.</p></section></div></div>
{% if item.title %}<form method="post" action="/leads/{{ item.id }}/delete" style="margin-top:24px" data-confirm="Diesen Demo-Lead wirklich löschen?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="btn btn-secondary">Demo-Lead löschen</button></form>{% endif %}
{% endblock %}
