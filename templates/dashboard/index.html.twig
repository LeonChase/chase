{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block breadcrumb %}Dashboard{% endblock %}
{% block body %}
<section class="dashboard-hero">
    <div class="hero-copy"><div class="hero-eyebrow"><span class="eyebrow">IHR CHASE PARTNERPORTAL</span><span class="hero-date">{{ today|default('now')|date('d.m.Y') }}</span></div><h1>Schön, dass Sie da sind,<br> <span>{{ app.user.name|split(' ')|first }}.</span></h1><p>Ihr nächster Erfolg beginnt hier. Alles für Ihre Immobilienvermarktung an einem Ort.</p><div class="hero-actions"><a class="btn btn-primary" href="/properties/new">{{ icon('plus') }}Objekt anlegen</a><a class="btn btn-quiet" href="/studio">Exposé erstellen {{ icon('arrow-up-right') }}</a></div></div>
    <div class="hero-art" aria-hidden="true"><span class="hero-tagline">Gemeinsam<br><i>mehr erreichen.</i></span><svg class="architecture-svg" viewBox="0 0 490 240" fill="none"><defs><linearGradient id="wall" x1="200" y1="20" x2="440" y2="200" gradientUnits="userSpaceOnUse"><stop stop-color="#eadbc8"/><stop offset="1" stop-color="#faf6f0"/></linearGradient><linearGradient id="glass" x1="250" y1="80" x2="400" y2="200" gradientUnits="userSpaceOnUse"><stop stop-color="#58696c"/><stop offset="1" stop-color="#b8c3bf"/></linearGradient><linearGradient id="roof" x1="300" y1="50" x2="480" y2="200"><stop stop-color="#d7bfa1"/><stop offset="1" stop-color="#f1e5d6"/></linearGradient></defs><path d="M10 237L238 199L489 228V240H10Z" fill="#e9e5dc"/><path d="M220 82L436 24L488 44V226L220 203Z" fill="url(#wall)"/><path d="M284 96L446 66V183L284 174Z" fill="url(#glass)"/><path d="M315 91V177M361 83V180M407 74V182" stroke="#394244" stroke-width="5"/><path d="M212 79L432 20L489 41V62L217 112Z" fill="url(#roof)"/><path d="M212 79V94L432 41L489 59V41L432 20Z" fill="#fdfbf7"/><path d="M242 147L489 148V166L242 171Z" fill="#f6eee4"/><path d="M242 147V136L489 129V148Z" fill="#fffdfa"/><path d="M243 128L489 119M253 149V110M290 148V109M330 148V107M370 148V105M412 148V103M454 148V101M488 147V100" stroke="#a09587" stroke-width="1.4"/><path d="M254 188L449 191V216L254 202Z" fill="#b3b8ad"/><path d="M176 211L235 205M161 217L254 208M195 223L273 212" stroke="#d1c8b9" stroke-width="3"/><path d="M204 217V175M204 195L192 181M204 185L215 173M206 207L220 191" stroke="#ab996b" stroke-width="2"/><circle cx="193" cy="179" r="8" fill="#c2ba88"/><circle cx="215" cy="172" r="9" fill="#c2ba88"/><circle cx="221" cy="192" r="7" fill="#b3ad7a"/><path d="M269 218V178M269 194L257 183M269 189L281 177" stroke="#918866" stroke-width="2"/><circle cx="256" cy="181" r="7" fill="#aeb481"/><circle cx="281" cy="176" r="8" fill="#b5b98a"/></svg></div>
</section>

<section class="stats-grid" aria-label="Ihr Arbeitsplatz in Zahlen">
    {% set metrics = [
        {label:'Immobilien im Portfolio',value:stats.properties|default(0),icon:'building',href:'/properties',note:'Ihr Objektportfolio'},
        {label:'Offene Aufgaben',value:stats.tasks|default(0),icon:'check-square',href:'/tasks',note:'Die nächsten Schritte'},
        {label:'Neue Leads',value:stats.leads|default(0),icon:'users',href:'/leads?status=Neu',note:'Chancen im Blick'},
        {label:'Vorbereitete Beiträge',value:stats.posts|default(0),icon:'calendar',href:'/marketing',note:'Ihre nächste Sichtbarkeit'}
    ] %}
    {% for metric in metrics %}<a class="stat-card" href="{{ metric.href }}"><span class="stat-icon">{{ icon(metric.icon) }}</span><div><span class="stat-label">{{ metric.label }}</span><strong class="stat-value">{{ metric.value }}</strong><span class="stat-note">{{ metric.note }}</span></div>{{ icon('arrow-up-right') }}</a>{% endfor %}
</section>

<section class="dashboard-tools" aria-labelledby="tools-heading">
    <div class="section-heading"><div><span class="eyebrow">ALLES FÜR IHREN ERFOLG</span><h2 id="tools-heading">Ihre Möglichkeiten. Ein Portal.</h2></div><span class="section-caption">Der passende nächste Schritt für Sie.</span></div>
    <div class="module-grid">
        {% set moduleLinks = {'dokumente':'/documents','immobilienbewertung':'/valuation','ki-tools':'/studio','academy':'/academy','werbekatalog':'/advertising','visualisierung':'/studio/visuals'} %}
        {% set moduleFootIcons = {'dokumente':'layers','immobilienbewertung':'house','ki-tools':'sparkles','academy':'graduation-cap','werbekatalog':'images','visualisierung':'images'} %}
        {% for module in portal.brand.modules %}
            <a class="module-card {{ module.highlight|default(false) ? 'module-highlight' : '' }}" href="{{ moduleLinks[module.slug] }}"><div class="module-top"><span class="module-icon">{{ icon(module.icon) }}</span><span class="module-arrow">{{ icon('arrow-right') }}</span></div><h3>{{ module.title }}</h3><p>{{ module.description }}</p><div class="module-footer"><span>{{ icon(moduleFootIcons[module.slug]) }}{{ module.cta }}</span>{{ icon('chevron-right') }}</div></a>
        {% endfor %}
    </div>
</section>

<div class="dashboard-widgets">
    <section class="card dashboard-news" aria-labelledby="news-heading"><div class="card-heading"><div><span class="eyebrow">GUT INFORMIERT</span><h2 id="news-heading">News aus der Zentrale</h2></div><a class="text-link" href="/news">Alle News {{ icon('arrow-right') }}</a></div><div class="news-widget-list">{% for item in news|slice(0,3) %}<a class="news-widget-item" href="/news/{{ item.id }}"><span class="news-category-icon {{ loop.index == 2 ? 'is-purple' : (loop.index == 3 ? 'is-blue' : '') }}">{{ icon(loop.index == 2 ? 'graduation-cap' : (loop.index == 3 ? 'megaphone' : 'newspaper')) }}</span><div><span class="news-meta">{{ item.data.category|default('Unternehmen') }} <span>·</span> {{ item.data.publishedAt|default('now')|date('d.m.Y') }}</span><h3>{{ item.title }}</h3><p>{{ item.data.summary|default('Neuigkeiten für Ihren Arbeitsalltag.') }}</p></div>{{ icon('chevron-right') }}</a>{% else %}<div class="empty-state compact">{{ icon('newspaper') }}<p>Sie sind auf dem neuesten Stand.</p></div>{% endfor %}</div><div class="widget-footnote"><span class="status-dot"></span>Synthetische interne Demo-News</div></section>
    <section class="card dashboard-tasks" aria-labelledby="tasks-heading"><div class="card-heading"><div><span class="eyebrow">HEUTE IM FOKUS</span><h2 id="tasks-heading">Meine Aufgaben</h2></div><a class="text-link" href="/tasks">Alle Aufgaben {{ icon('arrow-right') }}</a></div><div class="task-widget-list">{% for item in tasks|slice(0,4) %}<a href="/tasks/{{ item.id }}/edit" class="task-widget-item"><span class="task-check {{ item.data.status|default('') == 'Erledigt' ? 'checked' : '' }}">{% if item.data.status|default('') == 'Erledigt' %}{{ icon('check') }}{% endif %}</span><div><strong>{{ item.title }}</strong><small>{{ item.data.dueDate|default(null) ? item.data.dueDate|date('d.m.Y') : 'Ohne Fälligkeit' }} <span>·</span> {{ item.data.status|default('Offen') }}</small></div><span class="priority-dot {{ item.data.priority|default('Mittel') == 'Hoch' ? 'priority-high' : '' }}" title="Priorität {{ item.data.priority|default('Mittel') }}"></span></a>{% else %}<div class="empty-state compact">{{ icon('check-square') }}<h3>Freier Kopf für Neues.</h3><p>Aktuell sind keine offenen Aufgaben vorhanden.</p></div>{% endfor %}</div><a class="widget-add" href="/tasks/new">{{ icon('plus') }}Aufgabe hinzufügen</a></section>
</div>

<div class="dashboard-lower">
    <section class="card marketing-widget"><div class="card-heading"><div><span class="eyebrow">SICHTBAR BLEIBEN</span><h2>Nächste Marketingaktionen</h2></div><a class="text-link" href="/marketing">Zum Kalender {{ icon('arrow-right') }}</a></div>{% for item in posts|slice(0,2) %}<a class="marketing-widget-item" href="/marketing/{{ item.id }}/edit"><span class="calendar-chip"><strong>{{ item.data.plannedAt|default(null) ? item.data.plannedAt|date('d') : '–' }}</strong><small>{{ item.data.plannedAt|default(null) ? item.data.plannedAt|date('m.Y') : 'OFFEN' }}</small></span><div><strong>{{ item.title }}</strong><small>{{ item.data.channel|default('Social Media') }} · {{ item.data.status|default('Entwurf') }}</small></div>{{ icon('chevron-right') }}</a>{% else %}<div class="empty-state compact"><p>Geben Sie Ihrer nächsten Idee einen Platz im Kalender.</p><a class="text-link" href="/marketing/new">Beitrag vorbereiten {{ icon('arrow-right') }}</a></div>{% endfor %}<div class="widget-footnote">Interne Planung · keine automatische Veröffentlichung</div></section>
    <section class="support-card"><span class="support-icon">{{ icon('help-circle') }}</span><div><span class="eyebrow">WIR SIND AN IHRER SEITE</span><h2>Ansprechpartner<br>CHASE Zentrale</h2><p>Gemeinsam finden wir den nächsten Schritt.<br>Kontakt wird für den Pilotbetrieb hinterlegt.</p><a class="btn btn-secondary" href="/help">Hilfe & Ansprechpartner {{ icon('arrow-up-right') }}</a></div></section>
</div>
{% endblock %}
