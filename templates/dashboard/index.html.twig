{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block breadcrumb %}Dashboard{% endblock %}
{% block body %}
<section class="dashboard-hero dashboard-hero-planner">
    <div class="hero-copy"><div class="hero-eyebrow"><span class="eyebrow">IHR CHASE PARTNERPORTAL</span><span class="hero-date">{{ today|date('d.m.Y') }}</span></div><h1>Schön, dass Sie da sind,<br> <span>{{ app.user.name|split(' ')|first }}.</span></h1><p>Mit einem klaren Plan in den Tag. Ihre Aufgaben, Immobilien und nächsten Schritte im Blick.</p></div>
    <div class="hero-art" aria-hidden="true"><span class="hero-tagline">Gemeinsam<br><i>mehr erreichen.</i></span><svg class="architecture-svg" viewBox="0 0 490 240" fill="none"><defs><linearGradient id="wall" x1="200" y1="20" x2="440" y2="200"><stop stop-color="#eadbc8"/><stop offset="1" stop-color="#faf6f0"/></linearGradient><linearGradient id="glass"><stop stop-color="#58696c"/><stop offset="1" stop-color="#b8c3bf"/></linearGradient></defs><path d="M10 237L238 199L489 228V240H10Z" fill="#e9e5dc"/><path d="M220 82L436 24L488 44V226L220 203Z" fill="url(#wall)"/><path d="M284 96L446 66V183L284 174Z" fill="url(#glass)"/><path d="M315 91V177M361 83V180M407 74V182" stroke="#394244" stroke-width="5"/><path d="M212 79L432 20L489 41V62L217 112Z" fill="#e3d0b7"/><path d="M212 79V94L432 41L489 59V41L432 20Z" fill="#fdfbf7"/><path d="M242 147L489 148V166L242 171Z" fill="#f6eee4"/><path d="M242 147V136L489 129V148Z" fill="#fffdfa"/><path d="M243 128L489 119M253 149V110M290 148V109M330 148V107M370 148V105M412 148V103M454 148V101M488 147V100" stroke="#a09587" stroke-width="1.4"/><path d="M254 188L449 191V216L254 202Z" fill="#b3b8ad"/><path d="M176 211L235 205M161 217L254 208M195 223L273 212" stroke="#d1c8b9" stroke-width="3"/><path d="M204 217V175M204 195L192 181M204 185L215 173M206 207L220 191" stroke="#ab996b" stroke-width="2"/><circle cx="193" cy="179" r="8" fill="#c2ba88"/><circle cx="215" cy="172" r="9" fill="#c2ba88"/><circle cx="221" cy="192" r="7" fill="#b3ad7a"/></svg></div>
</section>
<section class="stats-grid planner-stats" aria-label="Ihr Arbeitsplatz in Zahlen">
    {% set metrics = [
        {label:'Immobilien im Portfolio',value:stats.properties|default(0),icon:'building',href:'/properties',note:'Ihre Immobilien im Überblick'},
        {label:'Offene Aufgaben',value:stats.tasks|default(0),icon:'check-square',href:'/tasks',note:overdue|length ? overdue|length ~ ' davon überfällig' : 'Ihre nächsten Schritte'},
        {label:'Neue Leads',value:stats.leads|default(0),icon:'users',href:'/leads?status=Neu',note:'Chancen im Blick'}
    ] %}
    {% for metric in metrics %}<a class="stat-card" href="{{ metric.href }}"><span class="stat-icon">{{ icon(metric.icon) }}</span><div><span class="stat-label">{{ metric.label }}</span><strong class="stat-value">{{ metric.value }}</strong><span class="stat-note">{{ metric.note }}</span></div>{{ icon('arrow-up-right') }}</a>{% endfor %}
</section>
<div class="dashboard-planner">
    <section class="card today-planner"><div class="card-heading"><div><span class="eyebrow">FOKUS & NÄCHSTE SCHRITTE</span><h2>Heute wichtig</h2></div><a class="text-link" href="/tasks">Planer öffnen {{ icon('arrow-right') }}</a></div>
        <div class="planner-summary"><span class="planner-summary-item"><strong>{{ dueToday|length }}</strong><small>heute fällig</small></span><span class="planner-summary-item {{ overdue|length ? 'has-overdue' : '' }}"><strong>{{ overdue|length }}</strong><small>überfällig</small></span><a href="/tasks/new" class="btn btn-secondary btn-small">{{ icon('plus') }}Aufgabe</a></div>
        <div class="task-widget-list">{% for item in tasks|slice(0,3) %}<a href="/tasks/{{ item.id }}/edit" class="task-widget-item"><span class="task-check"></span><div><strong>{{ item.title }}</strong><small>{{ item.data.dueDate|default(null) ? item.data.dueDate|date('d.m.Y') : 'Ohne Fälligkeit' }} <span>·</span> {{ item.data.status|default('Offen') }}</small></div><span class="priority-dot {{ item.data.priority|default('Mittel') == 'Hoch' ? 'priority-high' : '' }}" title="Priorität {{ item.data.priority|default('Mittel') }}"></span></a>{% else %}<div class="empty-state compact">{{ icon('check-square') }}<h3>Alles im grünen Bereich.</h3><p>Ihre offenen Aufgaben erscheinen hier, sobald Sie welche anlegen.</p></div>{% endfor %}</div>
    </section>
    <section class="card week-planner"><div class="card-heading"><div><span class="eyebrow">GUT VORBEREITET</span><h2>Ihre Woche</h2></div><span class="week-range">{{ week[0].date|date('d.m.') }} – {{ week[6].date|date('d.m.Y') }}</span></div><div class="week-day-grid">{% for day in week %}<a href="/tasks?date={{ day.date|date('Y-m-d') }}" class="week-day {{ day.today ? 'is-today' : '' }}" aria-label="{{ day.date|date('d.m.Y') }}: {{ day.count }} Aufgaben"><small>{{ day.label }}</small><strong>{{ day.date|date('d') }}</strong><span class="week-dot {{ day.count ? 'has-tasks' : '' }}">{{ day.count ?: '' }}</span></a>{% endfor %}</div><div class="week-planner-note">{{ icon('calendar') }}<p>Fälligkeiten direkt im Kalender auswählen.<br><span>Ihr vollständiger Aufgabenplaner hält alle Details bereit.</span></p></div><a class="text-link" href="/tasks?period=week">Diese Woche organisieren {{ icon('arrow-right') }}</a></section>
</div>
<section class="dashboard-tools" aria-labelledby="tools-heading"><div class="section-heading"><div><span class="eyebrow">ALLES FÜR IHREN ALLTAG</span><h2 id="tools-heading">Der passende nächste Schritt.</h2></div><span class="section-caption">Wissen, Werkzeuge und Unterstützung.</span></div><div class="module-grid">
    {% set moduleLinks = {'dokumente':'/documents','immobilienbewertung':'/valuation','ki-tools':'/properties?focus=texts','academy':'/academy','werbekatalog':'/advertising','visualisierung':'/properties?focus=media'} %}
    {% set moduleFootIcons = {'dokumente':'layers','immobilienbewertung':'house','ki-tools':'sparkles','academy':'graduation-cap','werbekatalog':'images','visualisierung':'images'} %}
    {% for module in portal.brand.modules %}<a class="module-card {{ module.highlight|default(false) ? 'module-highlight' : '' }}" href="{{ moduleLinks[module.slug] }}"><div class="module-top"><span class="module-icon">{{ icon(module.icon) }}</span><span class="module-arrow">{{ icon('arrow-right') }}</span></div><h3>{{ module.title }}</h3><p>{{ module.slug == 'ki-tools' ? 'Exposé-Texte direkt aus den Fakten Ihrer Immobilie vorbereiten.' : (module.slug == 'visualisierung' ? 'Bilder, Grundrisse und Visualisierungen in Ihrer Objektakte bearbeiten.' : module.description) }}</p><div class="module-footer"><span>{{ icon(moduleFootIcons[module.slug]) }}{{ module.slug in ['ki-tools','visualisierung'] ? 'Immobilie auswählen' : module.cta }}</span>{{ icon('chevron-right') }}</div></a>{% endfor %}
</div></section>
<div class="dashboard-lower dashboard-updates"><section class="card dashboard-news" aria-labelledby="news-heading"><div class="card-heading"><div><span class="eyebrow">GUT INFORMIERT</span><h2 id="news-heading">Neues aus der Zentrale</h2></div><a class="text-link" href="/news">Alle News {{ icon('arrow-right') }}</a></div><div class="news-widget-list">{% for item in news|slice(0,3) %}<a class="news-widget-item" href="/news/{{ item.id }}"><span class="news-category-icon">{{ icon('newspaper') }}</span><div><span class="news-meta">{{ item.data.category|default('Unternehmen') }} <span>·</span> {{ item.data.publishedAt|default('now')|date('d.m.Y') }}{% if item.data.isDemo|default(false) %} · Demo{% endif %}</span><h3>{{ item.title }}</h3><p>{{ item.data.summary|default('Neuigkeiten für Ihren Arbeitsalltag.') }}</p></div>{{ icon('chevron-right') }}</a>{% else %}<div class="empty-state compact"><p>Hier erscheinen neue Mitteilungen der Zentrale.</p></div>{% endfor %}</div></section><section class="support-card"><span class="support-icon">{{ icon('message-circle') }}</span><div><span class="eyebrow">WIR SIND AN IHRER SEITE</span><h2>Kurzer Weg.<br>Gute Zusammenarbeit.</h2><p>Fragen an Ihr Netzwerk oder das Partnermanagement? Nutzen Sie die interne Nachrichtenfunktion.</p><a class="btn btn-secondary" href="/messages">Nachrichten öffnen {{ icon('arrow-up-right') }}</a><a class="support-assistant" href="/help/assistant">Wo finde ich was? Portalhilfe {{ icon('help-circle') }}</a></div></section></div>
{% endblock %}
