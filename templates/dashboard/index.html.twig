{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block breadcrumb %}Dashboard{% endblock %}
{% block body %}
<div class="dashboard-compact">
    <div class="dashboard-compact-heading"><h1>Schön, dass du da bist{% if firstName %}, {{ firstName }}{% endif %}.</h1><div class="dashboard-quick-stats"><a href="/properties" title="Meine Immobilien">{{ icon('building') }}<strong>{{ stats.properties }}</strong><span>Immobilien</span></a><a href="/tasks" title="Offene Aufgaben">{{ icon('check-square') }}<strong>{{ stats.tasks }}</strong><span>Aufgaben</span></a><a href="/leads?status=Neu" title="Neue Leads">{{ icon('users') }}<strong>{{ stats.leads }}</strong><span>Leads</span></a></div></div>
    <div class="dashboard-compact-planner"><section class="card compact-today"><div class="card-heading"><h2>Meine Aufgaben</h2><div class="compact-task-counts">{% if dueToday|length %}<a class="badge" href="/tasks?period=today">{{ dueToday|length }} heute</a>{% endif %}{% if overdue|length %}<a class="badge badge-red" href="/tasks?period=overdue">{{ overdue|length }} überfällig</a>{% endif %}<a class="icon-button" href="/tasks" aria-label="Aufgabenplaner öffnen">{{ icon('arrow-up-right') }}</a></div></div><div class="compact-task-list">{% for item in tasks|slice(0,3) %}<a class="task-widget-item" href="/tasks/{{ item.id }}/edit"><span class="task-check"></span><strong>{{ item.title }}</strong><small>{{ item.data.dueDate|default(null) ? item.data.dueDate|date('d.m.') : '–' }}</small><span class="priority-dot {{ item.data.priority|default('Mittel') == 'Hoch' ? 'priority-high' : '' }}"></span></a>{% else %}<div class="compact-empty">{{ icon('check') }}Keine offenen Aufgaben</div>{% endfor %}</div></section>
    <section class="card compact-week"><div class="card-heading"><h2>Diese Woche</h2><span class="week-range">{{ week[0].date|date('d.m.') }} – {{ week[6].date|date('d.m.Y') }}</span></div><div class="week-day-grid">{% for day in week %}<a href="/tasks?date={{ day.date|date('Y-m-d') }}" class="week-day {{ day.today ? 'is-today' : '' }}" aria-label="{{ day.date|date('d.m.Y') }}: {{ day.count }} Aufgaben"><small>{{ day.label }}</small><strong>{{ day.date|date('d') }}</strong><span class="week-dot {{ day.count ? 'has-tasks' : '' }}">{{ day.count ?: '' }}</span></a>{% endfor %}</div></section></div>
    <div class="module-grid compact-module-grid" aria-label="Arbeitsbereiche">
        {% set links={'dokumente':'/documents','immobilienbewertung':'/valuation','ki-tools':'/properties?focus=texts','academy':'/academy','werbekatalog':'/advertising','visualisierung':'/properties?focus=media'} %}
        {% set labels={'dokumente':'Dokumente','immobilienbewertung':'Immobilienbewertung','ki-tools':'KI-Tools','academy':'Wissen / Academy','werbekatalog':'Werbekatalog','visualisierung':'Visualisierung'} %}
        {% for module in portal.brand.modules %}<a class="module-card {{ module.highlight|default(false) ? 'module-highlight' : '' }}" href="{{ links[module.slug] }}"><span class="module-icon">{{ icon(module.icon) }}</span><h2>{{ labels[module.slug] }}</h2><span class="module-arrow">{{ icon('arrow-up-right') }}</span></a>{% endfor %}
    </div>
</div>
{% endblock %}
