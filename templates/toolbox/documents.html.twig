{% extends 'base.html.twig' %}{% block title %}Unterlagen prüfen{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="/assets/toolbox.css">{% endblock %}
{% block body %}<section class="toolbox-workspace toolbox-documents">{% include 'toolbox/_head.html.twig' with {heading:'Unterlagen prüfen',mode:'Eigene Prüfung · keine KI- oder Rechtsprüfung'} %}{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
<div class="toolbox-document-layout"><aside class="toolbox-panel toolbox-document-list"><form action="/tools/documents" method="post" enctype="multipart/form-data" class="toolbox-document-upload"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><label for="toolbox-document-file">Originaldatei</label><input id="toolbox-document-file" type="file" name="document" accept=".pdf,.jpg,.jpeg,.png,.webp" required><small class="toolbox-small">PDF oder Bild · bis 8 MB · privat gespeichert</small><button class="btn btn-primary">{{ icon('plus') }} Datei hinzufügen</button></form><nav aria-label="Eigene Prüfunterlagen">{% for document in documents %}<a href="/tools/documents/{{ document.id }}" class="toolbox-draft {{ asset and asset.id == document.id ? 'is-active' : '' }}"><strong>{{ document.title }}</strong><small>{{ document.updatedAt|date('d.m.Y','Europe/Berlin') }} · {{ document.data.checks|default([])|length }}/{{ checks|length }} geprüft</small>{{ icon('chevron-right') }}</a>{% else %}<p class="toolbox-small">Noch keine Prüfunterlagen.</p>{% endfor %}</nav></aside>
<section class="toolbox-panel toolbox-document-review">{% if asset %}<header class="toolbox-document-title"><div><h2>{{ asset.title }}</h2><small class="toolbox-small">{{ (asset.data.bytes / 1024)|number_format(0,',','.') }} KB · {{ asset.data.mime }}</small></div><a class="icon-button" href="/tools/documents/{{ asset.id }}/download" title="Original herunterladen" aria-label="Original herunterladen">{{ icon('download') }}</a></header><form method="post" class="toolbox-review-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="toolbox-checks">{% for key,label in checks %}<label><input type="checkbox" name="checks[]" value="{{ key }}" {{ key in asset.data.checks|default([]) ? 'checked' : '' }}><span>{{ label }}</span></label>{% endfor %}</div><div class="field toolbox-review-notes"><label for="review-notes">Deine Prüfnotizen</label><textarea id="review-notes" name="notes" maxlength="5000" rows="6">{{ asset.data.notes|default('') }}</textarea></div><div class="toolbox-form-bottom"><button class="btn btn-primary">Prüfstand speichern</button><small>{{ asset.data.reviewedAt|default('') ? 'Gespeichert: ' ~ asset.data.reviewedAt|date('d.m.Y H:i','Europe/Berlin') : 'Noch keine Prüfnotizen gespeichert' }}</small></div></form><form method="post" action="/tools/documents/{{ asset.id }}/delete" class="toolbox-delete-form" data-toolbox-confirm="Datei und Prüfnotizen dauerhaft löschen?"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><button class="text-link">Datei und Notizen löschen</button></form>{% else %}<div class="toolbox-document-empty">{{ icon('check-square') }}<h2>Original und Prüfstand zusammen.</h2><p>Datei hinzufügen, selbst prüfen, Notizen festhalten.</p></div>{% endif %}</section></div></section>{% endblock %}{% block javascripts %}<script src="/assets/toolbox.js" defer></script>{% endblock %}
