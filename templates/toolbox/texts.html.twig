{% extends 'base.html.twig' %}{% block title %}Exposé & Texte{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="/assets/toolbox.css">{% endblock %}
{% block body %}<section class="toolbox-workspace" data-toolbox-texts>
{% include 'toolbox/_head.html.twig' with {heading:'Exposé & Texte',mode:'Regelbasierte Textdemo · 0,00 €'} %}
<div class="toolbox-text-layout"><section class="toolbox-panel toolbox-text-entry"><form method="post" action="/tools/texts/generate" class="toolbox-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">
<div class="toolbox-field-row"><div class="field"><label for="toolbox-text-tool">Werkzeug</label><select id="toolbox-text-tool" name="tool" data-toolbox-tool>{% for key,label in tools %}<option value="{{ key }}" {{ key == tool ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><div class="field"><label for="toolbox-tone">Stil</label><select id="toolbox-tone" name="tone">{% for key,label in tones %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></div></div>
<div class="field"><label for="toolbox-property">Immobilie</label><select id="toolbox-property" name="propertyId" data-toolbox-property><option value="">Eigene Fakten eingeben</option>{% for item in properties %}<option value="{{ item.id }}" {{ property and property.id == item.id ? 'selected' : '' }}>{{ item.title }}</option>{% endfor %}</select></div>
<div data-toolbox-manual class="toolbox-manual-grid" {{ property ? 'hidden' : '' }}><div class="field"><label for="toolbox-title">Bezeichnung</label><input id="toolbox-title" name="title" maxlength="200" placeholder="Wohnung mit Balkon"></div><div class="field"><label for="toolbox-type">Objektart</label><input id="toolbox-type" name="propertyType" maxlength="200" placeholder="Eigentumswohnung"></div><div class="field"><label for="toolbox-city">Ort</label><input id="toolbox-city" name="city" maxlength="200"></div><div class="field"><label for="toolbox-area">Wohnfläche (m²)</label><input id="toolbox-area" name="areaSqm" type="number" min="0.01" max="1000000" step="0.01"></div><div class="field"><label for="toolbox-rooms">Zimmer</label><input id="toolbox-rooms" name="rooms" type="number" min="0.5" max="10000" step="0.5"></div><div class="field"><label for="toolbox-price">Preis (€)</label><input id="toolbox-price" name="priceEur" type="number" min="0.01" max="1000000000" step="0.01"></div><div class="field toolbox-full"><label for="toolbox-features">Bestätigte Ausstattung</label><textarea id="toolbox-features" name="features" rows="2" maxlength="2000" placeholder="Nur bekannte Merkmale"></textarea></div></div>
<div class="field" data-toolbox-only="lage" {{ tool != 'lage' ? 'hidden' : '' }}><label for="toolbox-location">Geprüfte Lagefakten</label><textarea id="toolbox-location" name="verifiedLocation" rows="2" maxlength="4000"></textarea></div>
<div class="field" data-toolbox-only="blog social" {{ tool not in ['blog','social'] ? 'hidden' : '' }}><label for="toolbox-topic">Thema</label><input id="toolbox-topic" name="topic" maxlength="200"></div>
<div class="toolbox-field-row" data-toolbox-only="social" {{ tool != 'social' ? 'hidden' : '' }}><div class="field"><label for="toolbox-channel">Kanal</label><select id="toolbox-channel" name="channel"><option>Instagram</option><option>Facebook</option><option>LinkedIn</option></select></div><div class="field"><label for="toolbox-format">Format</label><select id="toolbox-format" name="format"><option>Feed</option><option>Story</option><option>Reel</option><option>Textpost</option></select></div></div>
<div class="toolbox-form-bottom"><button class="btn btn-primary" {{ balance < 1 ? 'disabled' : '' }}>Entwurf erstellen {{ icon('arrow-right') }}</button><small>{{ balance }} Demo-Credits · 1 je Entwurf</small></div>
</form></section><aside class="toolbox-panel toolbox-recent"><h2>Letzte Entwürfe</h2><div>{% for post in posts %}<a href="{{ post.data.tool|default('') in ['property_expose','property_social'] and post.data.propertyId|default('') ? '/properties/' ~ post.data.propertyId ~ (post.data.tool == 'property_expose' ? '#texts' : '#marketing') : '/tools/texts/' ~ post.id ~ '/edit' }}" class="toolbox-draft"><strong>{{ post.title }}</strong><small>{{ post.updatedAt|date('d.m.Y','Europe/Berlin') }} · {{ post.data.status|default('Entwurf') }}</small>{{ icon('chevron-right') }}</a>{% else %}<p class="toolbox-small">Deine gespeicherten Texte erscheinen hier.</p>{% endfor %}</div><p class="toolbox-small">Fehlende Fakten werden nicht ergänzt. Entwürfe vor Verwendung prüfen.</p></aside></div>
</section>{% endblock %}{% block javascripts %}<script src="/assets/toolbox.js" defer></script>{% endblock %}
