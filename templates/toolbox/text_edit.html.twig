{% extends 'base.html.twig' %}{% block title %}{{ post.title }}{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="/assets/toolbox.css">{% endblock %}
{% block body %}<section class="toolbox-workspace toolbox-editor">
{% include 'toolbox/_head.html.twig' with {heading:'Textentwurf',mode:'Version ' ~ post.data.version|default(1) ~ ' · ' ~ post.data.status|default('Entwurf')} %}
{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
<form method="post" class="toolbox-panel toolbox-edit-form"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><div class="toolbox-field-row"><div class="field"><label for="title">Titel</label><input id="title" name="title" maxlength="200" required value="{{ app.request.method == 'POST' ? app.request.request.get('title') : post.title }}"></div><div class="field"><label for="status">Prüfstatus</label><select id="status" name="status">{% for status in ['Entwurf','Freigegeben','Geplant intern'] %}<option {{ post.data.status|default('Entwurf') == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select></div></div>
<label class="sr-only" for="content">Text bearbeiten</label><textarea class="toolbox-edit-text" id="content" name="content" required maxlength="30000">{{ app.request.method == 'POST' ? app.request.request.get('content') : post.data.content|default(post.data.caption|default('')) }}</textarea>
<div class="toolbox-edit-toolbar"><button class="btn btn-primary" type="submit">Version speichern</button><button class="btn btn-secondary" type="button" data-toolbox-copy="#content">Kopieren</button><a class="btn btn-secondary" href="{{ path('studio_pdf',{id:post.id}) }}">{{ icon('download') }} PDF</a><a class="btn btn-secondary" href="{{ path('studio_export',{id:post.id}) }}">Textdatei</a><button class="icon-button" type="button" data-toolbox-dialog="toolbox-text-info" title="Quelle und Versionen" aria-label="Quelle und Versionen">{{ icon('clock') }}</button><a class="text-link" href="/tools/texts">Neuer Text {{ icon('arrow-right') }}</a></div>
<details class="toolbox-optional"><summary>Interne Planung</summary><div class="toolbox-field-row"><div class="field"><label for="plannedAt">Termin</label><input id="plannedAt" name="plannedAt" type="datetime-local" value="{{ post.data.plannedAt|default(null) ? post.data.plannedAt|date('Y-m-d\\TH:i','Europe/Berlin') : '' }}"></div><div class="field"><label for="channel">Kanal</label><select name="channel" id="channel">{% for channel in ['Instagram','Facebook','LinkedIn'] %}<option {{ post.data.channel|default('Instagram') == channel ? 'selected' : '' }}>{{ channel }}</option>{% endfor %}</select></div><div class="field"><label for="format">Format</label><select id="format" name="format">{% for format in ['Feed','Story','Reel','Textpost'] %}<option {{ post.data.format|default('Feed') == format ? 'selected' : '' }}>{{ format }}</option>{% endfor %}</select></div></div></details>
<span class="toolbox-small" data-toolbox-status role="status"></span></form>
<dialog id="toolbox-text-info" class="toolbox-dialog"><header><h2>Quelle & Versionen</h2><button class="icon-button" type="button" data-toolbox-close aria-label="Schließen">{{ icon('x') }}</button></header><p class="toolbox-small">{{ post.data.mode|default('Textdemo') }} · Keine automatische Veröffentlichung.</p>{% if sourceProperty %}<a href="/properties/{{ sourceProperty.id }}" class="text-link">{{ sourceProperty.title }}</a>{% else %}<p class="toolbox-small">Manuelle Fakten oder nicht mehr zugängliche Quelle.</p>{% endif %}<details><summary>Vor Verwendung prüfen</summary><ul>{% for check in post.data.checklist|default([]) %}<li>{{ check }}</li>{% endfor %}</ul></details>{% for version in post.data.versions|default([])|reverse %}<details><summary>Version {{ version.number }} · {{ version.time|date('d.m.Y H:i','Europe/Berlin') }}</summary><pre>{{ version.text }}</pre></details>{% endfor %}</dialog>
</section>{% endblock %}{% block javascripts %}<script src="/assets/toolbox.js" defer></script>{% endblock %}
