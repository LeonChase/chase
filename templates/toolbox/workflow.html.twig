{% extends 'base.html.twig' %}{% block title %}{{ details[0] }}{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="/assets/toolbox.css">{% endblock %}
{% block body %}<section class="toolbox-workspace">{% include 'toolbox/_head.html.twig' with {heading:details[0],mode:type == 'social' ? 'Lokaler Textentwurf' : 'Vorbereitung · Anbieter nicht verbunden'} %}
<div class="toolbox-workflow-picker toolbox-panel"><span class="toolbox-card-icon">{{ icon(type == 'social' ? 'megaphone' : 'layers') }}</span><h2>In der Immobilienakte fortsetzen</h2><p>{{ details[1] }}</p><form action="{{ path('toolbox_workflow',{type:type}) }}" method="get" data-toolbox-jump data-section="{{ details[2] }}"><label class="sr-only" for="workflow-property">Immobilie auswählen</label><select id="workflow-property" name="property" required><option value="">Immobilie auswählen …</option>{% for property in properties %}<option value="{{ property.id }}">{{ property.title }}</option>{% endfor %}</select><button class="btn btn-primary">Werkzeug öffnen {{ icon('arrow-right') }}</button></form>{% if not properties %}<a class="text-link" href="/properties/new">Immobilie anlegen {{ icon('plus') }}</a>{% endif %}{% if type != 'social' %}<p class="toolbox-small">Es entsteht noch {{ type == 'redaction' ? 'keine sicher geschwärzte Datei' : (type == 'video' ? 'kein Video' : 'kein neues Bild') }}. Der externe Verarbeitungsanbieter ist nicht verbunden.</p>{% endif %}{% if type == 'redaction' %}<a href="/tools/documents" class="text-link">Ohne Objekt Prüfnotizen anlegen {{ icon('arrow-right') }}</a>{% elseif type == 'staging' %}<a href="/tools/images" class="text-link">Bild lokal bearbeiten {{ icon('arrow-right') }}</a>{% endif %}</div></section>{% endblock %}{% block javascripts %}<script src="/assets/toolbox.js" defer></script>{% endblock %}
