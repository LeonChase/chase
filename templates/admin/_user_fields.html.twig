<div class="form-grid">
    <div class="field"><label for="name">Name / Demo-Bezeichnung</label><input id="name" name="name" value="{{ values.name }}" required minlength="2" maxlength="100" autocomplete="name"></div>
    <div class="field"><label for="email">E-Mail-Adresse zur Anmeldung</label><input id="email" type="email" name="email" value="{{ values.email }}" required maxlength="180" autocomplete="email"><small class="muted">Für synthetische Demo-Konten empfehlen wir die Endung @example.test. Kein E-Mail-Versand.</small></div>
    <div class="field"><label for="role">Rolle</label><select id="role" name="role" required>{% for key,label in roles %}<option value="{{ key }}" {{ values.role == key ? 'selected' }}>{{ label }}</option>{% endfor %}</select><small class="muted">Administrationsrollen können nur durch die technische Administration vergeben werden.</small></div>
    <div class="field"><label for="region">Region</label><select id="region" name="region" required><option value="">Bitte wählen</option>{% if values.region and values.region not in regions|map(r => r.title) %}<option value="{{ values.region }}" selected>{{ values.region }}</option>{% endif %}{% for region in regions %}<option value="{{ region.title }}" {{ values.region == region.title ? 'selected' }}>{{ region.title }}</option>{% endfor %}</select><small class="muted">Die Region allein gewährt keine Teamdaten-Rechte.</small></div>
    <div class="field"><label for="budgetCredits">Fiktives Gesamtbudget (Demo-Credits)</label><input id="budgetCredits" type="number" name="budgetCredits" value="{{ values.budgetCredits }}" required min="0" max="1000000" step="1"><small class="muted">Gesamtlimit einschließlich bisheriger Nutzung. Kein Eurobetrag und keine Aufladung mit echtem Geld.</small></div>
    <div class="field"><label for="active"><input id="active" type="checkbox" name="active" value="1" {{ values.active ? 'checked' }}> Konto aktiv</label><small class="muted">Deaktivierte Konten können sich nicht anmelden und erhalten keinen Portalzugriff.</small></div>
</div>
