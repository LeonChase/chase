{% extends 'base.html.twig' %}
{% block title %}News verwalten · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="badge">Interne Kommunikation</span><h1>News aus der Zentrale</h1><p class="muted">Synthetische Demo-Nachrichten erstellen, freigeben und archivieren.</p></div><a class="btn btn-primary" href="/admin/news/new">Nachricht erstellen</a></div>
{% include 'admin/_nav.html.twig' %}
<div class="stack">{% for post in posts %}<article class="card"><div class="toolbar"><span class="badge">{{ post.data.status|default('Entwurf') }}</span><span class="muted">{{ post.data.category|default('Unternehmen') }}{% if post.data.pinned|default(false) %} · Angepinnt{% endif %}</span></div><h2>{{ post.title }}</h2><p>{{ post.data.summary|default('') }}</p><div class="toolbar"><a class="btn btn-secondary" href="{{ path('app_admin_news_edit', {id: post.id}) }}">Bearbeiten</a>{% if post.data.status|default('') != 'Veröffentlicht' %}<form method="post" action="{{ path('app_admin_news_status', {id: post.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="Veröffentlicht"><button class="btn btn-primary" type="submit">Intern veröffentlichen</button></form>{% endif %}{% if post.data.status|default('') != 'Archiviert' %}<form method="post" action="{{ path('app_admin_news_status', {id: post.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="status" value="Archiviert"><button class="btn btn-secondary" type="submit">Archivieren</button></form>{% endif %}</div></article>{% else %}<div class="card empty-state"><h2>Noch keine internen Nachrichten</h2><p>Erstellen Sie die erste lokale Demo-Meldung für Ihre Partner.</p><a class="btn btn-primary" href="/admin/news/new">Nachricht erstellen</a></div>{% endfor %}</div>
{% endblock %}
