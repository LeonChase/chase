{% extends 'base.html.twig' %}
{% block title %}{{ label }} verwalten · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="badge">Lokale Inhalte</span><h1>{{ label }} verwalten</h1><p class="muted">Musterinhalte für Partner pflegen. Keine rechtsverbindlichen Dokumente, keine externe Veröffentlichung.</p></div></div>
{% include 'admin/_nav.html.twig' %}
<nav class="tabs" aria-label="Inhaltsarten"><a href="/admin/content/documents">Dokumente</a><a href="/admin/content/academy">Academy</a><a href="/admin/content/advertising">Werbekatalog</a></nav>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Titel</th><th>Kategorie</th><th>Zielgruppe</th><th>Aktion</th></tr></thead><tbody>{% for entry in items %}<tr><td>{{ entry.title }}</td><td>{{ entry.data.category|default('Allgemein') }}</td><td>{{ entry.data.audience|default('Alle Makler') }}</td><td><a class="btn btn-secondary" href="{{ path('app_admin_content', {type: type, edit: entry.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="4">Noch keine lokalen Inhalte.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card"><h2>{{ item ? 'Inhalt bearbeiten' : 'Neuen Demo-Inhalt anlegen' }}</h2>{% include 'admin/_errors.html.twig' %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="id" value="{{ item ? item.id : '' }}"><div class="form-grid">
<div class="field"><label for="title">Titel</label><input id="title" name="title" value="{{ values.title|default('') }}" required minlength="3" maxlength="180"></div>
<div class="field"><label for="category">Kategorie</label><input id="category" name="category" value="{{ values.category|default('') }}" required maxlength="100"></div>
{% if type == 'documents' %}<div class="field"><label for="audience">Freigegeben für</label><select id="audience" name="audience">{% for audience in ['Alle Makler', 'Regionalleitung, Admin', 'Admin'] %}<option {{ values.audience|default('Alle Makler') == audience ? 'selected' }}>{{ audience }}</option>{% endfor %}</select></div>{% else %}<input type="hidden" name="audience" value="Alle Makler">{% endif %}
{% if type == 'advertising' %}<div class="field"><label for="unit">Einheit</label><input id="unit" name="unit" value="{{ values.unit|default('') }}" maxlength="120" placeholder="Zum Beispiel: 100 Stück"></div>{% endif %}
</div><div class="field"><label for="description">{{ type == 'academy' ? 'Kurzbeschreibung / Teaser' : 'Beschreibung' }}</label><textarea id="description" name="description" rows="3" maxlength="1000">{{ values.description|default(values.teaser|default('')) }}</textarea></div>
{% if type != 'advertising' %}<div class="field"><label for="content">{{ type == 'documents' ? 'Unverbindlicher Musterinhalt' : 'Lerninhalt' }}</label><textarea id="content" name="content" rows="12" required maxlength="30000">{{ values.content|default('') }}</textarea><small class="muted">Klartext. Dokumente werden ausschließlich über geschützte Portalrouten als Muster angeboten.</small></div>{% else %}<input type="hidden" name="content" value=""><p class="muted">Preise bleiben „auf Anfrage“. Produkte können nur in lokalen Anfrageentwürfen vorgemerkt werden; es wird keine reale Bestellung ausgelöst.</p>{% endif %}
<div class="toolbar"><button class="btn btn-primary" type="submit">Lokal speichern</button>{% if item %}<a class="btn btn-secondary" href="{{ path('app_admin_content', {type: type}) }}">Neuen Inhalt anlegen</a>{% endif %}</div></form></section>
{% endblock %}
