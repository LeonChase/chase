{% extends 'base.html.twig' %}
{% block title %}Teamfreigaben · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="badge">Ausdrückliche Datenfreigabe</span><h1>Zusammenarbeit sicher regeln</h1><p class="muted">Nur eine hier eingetragene Regionalleitung erhält zusätzlich Zugriff auf die lokalen Objekte, Leads und Arbeitsdaten des gewählten Mitglieds.</p></div></div>
{% include 'admin/_nav.html.twig' %}
<section class="card"><h2>Bestehende Teamfreigaben</h2><div class="table-wrap"><table><thead><tr><th>Regionalleitung</th><th>Freigegebenes Mitglied</th><th>Umfang</th><th>Aktion</th></tr></thead><tbody>{% for grant in grants %}<tr><td>{{ names[grant.data.managerId|default(grant.ownerId)]|default('Nicht verfügbares Konto') }}</td><td>{{ names[grant.data.memberId|default('')]|default('Nicht verfügbares Konto') }}</td><td>Teamdaten lesen & bearbeiten</td><td><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="action" value="revoke"><input type="hidden" name="id" value="{{ grant.id }}"><button class="btn btn-secondary" type="submit">Freigabe widerrufen</button></form></td></tr>{% else %}<tr><td colspan="4">Keine ausdrücklichen Teamfreigaben. Jeder Partner sieht seine eigenen Arbeitsdaten.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card"><h2>Teamfreigabe erteilen</h2><p class="muted">Diese Änderung erweitert den Datenzugriff. Bitte nur für die tatsächlich benötigte Zusammenarbeit freigeben. Beide Konten müssen aktiv sein und zum selben Portal gehören.</p>{% include 'admin/_errors.html.twig' %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="action" value="grant"><div class="form-grid"><div class="field"><label for="managerId">Regionalleitung erhält Zugriff</label><select id="managerId" name="managerId" required><option value="">Bitte wählen</option>{% for manager in managers %}<option value="{{ manager.id }}">{{ manager.name }} · {{ manager.region }}</option>{% endfor %}</select></div><div class="field"><label for="memberId">Auf Teamdaten dieses Mitglieds</label><select id="memberId" name="memberId" required><option value="">Bitte wählen</option>{% for member in accounts %}<option value="{{ member.id }}">{{ member.name }} · {{ member.region }}</option>{% endfor %}</select></div></div><button class="btn btn-primary" type="submit">Ausdrücklich freigeben</button></form></section>
{% endblock %}
