{% extends 'base.html.twig' %}
{% block title %}{{ post.title }} · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">{{ isMarketing ? 'Content Creator' : 'Textstudio' }} · Entwurf</span><h1>Ihr Text. Ihr Feinschliff.</h1><p class="muted">{{ post.data.mode|default('Synthetischer Demo-Entwurf') }} · Version {{ post.data.version|default(1) }} · {{ post.data.status|default('Entwurf') }}</p></div><a class="btn btn-secondary" href="{{ path(isMarketing ? 'marketing' : 'studio') }}">{{ isMarketing ? 'Zum Marketingkalender' : 'Zum KI-Studio' }}</a></div>
{% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
<div class="grid grid-2" style="align-items:start"><section class="card"><form method="post" class="stack"><input type="hidden" name="_token" value="{{ csrf_token('portal') }}">
<div class="field"><label for="title">Titel</label><input name="title" id="title" maxlength="200" required value="{{ app.request.method == 'POST' ? app.request.request.get('title') : post.title }}"></div>
<div class="field"><label for="content">{{ isMarketing ? 'Beitragstext' : 'Text' }}</label><textarea name="content" id="content" rows="19" maxlength="30000" required>{{ app.request.method == 'POST' ? app.request.request.get('content') : post.data.content|default(post.data.caption|default('')) }}</textarea></div>
<div class="form-grid"><div class="field"><label for="status">Prüfstatus</label><select name="status" id="status">{% for status in ['Entwurf','Freigegeben','Geplant intern'] %}<option {{ post.data.status|default('Entwurf') == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}</select><small class="muted">Mit „Freigegeben“ bestätigen Sie Ihre fachliche Prüfung.</small></div>
<div class="field"><label for="plannedAt">Interner Planungstermin</label><input type="datetime-local" name="plannedAt" id="plannedAt" value="{{ post.data.plannedAt|default(null) ? post.data.plannedAt|date('Y-m-d\\TH:i', 'Europe/Berlin') : '' }}"><small class="muted">Deutsche Ortszeit · keine automatische Veröffentlichung</small></div></div>
{% if isMarketing %}<div class="form-grid"><div class="field"><label for="channel">Kanal</label><select name="channel" id="channel">{% for channel in ['Instagram','Facebook','LinkedIn'] %}<option {{ post.data.channel|default('Instagram') == channel ? 'selected' : '' }}>{{ channel }}</option>{% endfor %}</select></div><div class="field"><label for="format">Format</label><select name="format" id="format">{% for format in ['Feed','Story','Reel','Textpost'] %}<option {{ post.data.format|default('Feed') starts with format ? 'selected' : '' }}>{{ format }}</option>{% endfor %}</select></div></div>{% else %}<input type="hidden" name="channel" value="{{ post.data.channel|default('Instagram') }}"><input type="hidden" name="format" value="{{ post.data.format|default('Feed') }}">{% endif %}
<div class="toolbar"><button class="btn btn-primary" type="submit">Neue Version speichern</button><button class="btn btn-secondary" type="button" id="copy-text">Text kopieren</button><a class="btn btn-secondary" href="{{ path('studio_export', {id:post.id}) }}">Markdown herunterladen</a><a class="btn btn-secondary" href="{{ path('studio_pdf', {id:post.id}) }}">PDF herunterladen · Demo</a></div><span id="copy-status" aria-live="polite" class="muted"></span>
</form></section><div class="stack">
{% if isMarketing %}<section class="card"><div class="toolbar"><h2>Beitragsvorschau</h2><span class="badge">{{ post.data.channel|default('Instagram') }} · {{ post.data.format|default('Feed') }}</span></div><div style="border:1px solid var(--border,#e4e5e8);border-radius:16px;overflow:hidden;max-width:420px;margin:auto"><div style="padding:16px"><strong>CHASE Immobilien</strong><span class="muted" style="display:block">Lokale Vorschau · nicht veröffentlicht</span></div><div style="background:linear-gradient(135deg,#151923,#333b4d);color:white;padding:48px 24px;min-height:{{ post.data.format|default('Feed') in ['Story','Reel'] ? '300' : '180' }}px;display:flex;align-items:center"><h3 id="preview-title">{{ post.title }}</h3></div><p id="preview-text" style="padding:18px;white-space:pre-wrap;overflow-wrap:anywhere">{{ post.data.content|default(post.data.caption|default('')) }}</p></div><p class="muted">Formatvorschau mit Textkarte, kein erzeugtes Foto oder Video. Veröffentlichungs-API nicht verbunden.</p></section>{% endif %}
<section class="card"><h2>Faktenquelle & Prüfung</h2>{% if sourceProperty %}<p>Verknüpft mit <a href="/properties/{{ sourceProperty.id }}">{{ sourceProperty.title }}</a>.</p>{% else %}<p class="muted">{{ post.data.source.type|default('fixture') == 'manual' ? 'Manuelle Angaben des Nutzers.' : 'Synthetische Demo-Daten oder nicht mehr zugängliche Quelle.' }}</p>{% endif %}<ul>{% for item in post.data.checklist|default(['Angaben vor Verwendung fachlich prüfen.','Energiekennwerte und Pflichtangaben ergänzen.','Keine automatische Veröffentlichung.']) %}<li>{{ item }}</li>{% endfor %}</ul><span class="badge">{{ post.data.approved|default(false) ? 'Vom Makler freigegeben' : 'Fachliche Freigabe offen' }}</span></section>
<section class="card"><h2>Versionshistorie</h2>{% for version in post.data.versions|default([])|reverse %}<details><summary>Version {{ version.number }} · {{ version.time|date('d.m.Y H:i', 'Europe/Berlin') }} · {{ version.approved ? 'Freigegeben' : 'Entwurf' }}</summary><h3>{{ version.title }}</h3><p style="white-space:pre-wrap;overflow-wrap:anywhere">{{ version.text }}</p></details>{% else %}<p class="muted">Beim nächsten Speichern wird eine neue Textversion angelegt.</p>{% endfor %}</section></div></div>
<script>
(() => {
const input = document.getElementById('content');
document.getElementById('copy-text').addEventListener('click', async () => {
const status = document.getElementById('copy-status');
try { await navigator.clipboard.writeText(input.value); status.textContent = 'Text in die Zwischenablage kopiert.'; }
catch { input.focus(); input.select(); status.textContent = 'Text markiert. Bitte mit Strg+C oder ⌘C kopieren.'; }
});
input.addEventListener('input', () => { const preview = document.getElementById('preview-text'); if (preview) preview.textContent = input.value; });
document.getElementById('title').addEventListener('input', event => { const preview = document.getElementById('preview-title'); if (preview) preview.textContent = event.target.value; });
})();
</script>
{% endblock %}
