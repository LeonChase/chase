{% extends 'base.html.twig' %}
{% block title %}{{ marketingMode ? 'Social-Media-Creator' : 'KI-Studio' }} · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">{{ marketingMode ? 'Marketing & Social Media' : 'Ihr kreativer Arbeitsplatz' }}</span><h1>{{ marketingMode ? 'Ein guter Beitrag beginnt mit Ihren Fakten.' : 'Mehr Zeit für das Wesentliche.' }}</h1><p class="muted">{{ marketingMode ? 'Objekt übernehmen, Text vorbereiten und intern planen.' : 'Aus geprüften Objektdaten werden bearbeitbare Texte für Ihre Vermarktung.' }}</p></div><a class="btn btn-secondary" href="{{ path('usage') }}">{{ balance }} Demo-Credits</a></div>
<div class="alert"><strong>Regelbasierte Offline-Demo</strong> · Kein echtes KI-Modell und keine externen Anfragen. Eine Erstellung kostet 1 Demo-Credit und tatsächlich 0,00 €. Bitte jeden Text fachlich prüfen.</div>
{% if not marketingMode %}<nav class="tabs" aria-label="Textwerkzeuge">{% for key,label in tools %}<a class="{{ tool == key ? 'active' : '' }}" href="{{ path('studio', {tool:key, property: property ? property.id : ''}) }}">{{ label }}</a>{% endfor %}<a href="{{ path('studio_visuals') }}">Bild & Dokumente ↗</a></nav>{% endif %}
<div class="grid grid-2" style="align-items:start">
<section class="card"><h2>{{ marketingMode ? 'Social-Media-Creator' : tools[tool] }}</h2>
<form method="post" action="{{ path('studio_generate') }}" class="stack">
<input type="hidden" name="_token" value="{{ csrf_token('portal') }}"><input type="hidden" name="tool" value="{{ tool }}">
{% if tool == 'social' %}<div class="field"><label for="social-topic">Beitragsthema (optional)</label><input id="social-topic" name="topic" maxlength="200" value="{{ app.request.query.get('topic','') }}" placeholder="Zum Beispiel: Neue Immobilie im Angebot"><small class="muted">Kampagnenvorlage oder eigene Überschrift für Beiträge ohne verknüpftes Objekt.</small></div>{% endif %}
<div class="field"><label for="property-source">Faktenquelle</label><select name="propertyId" id="property-source"><option value="">Manuelle Eingabe</option>{% for item in properties %}<option value="{{ item.id }}" {{ property and item.id == property.id ? 'selected' : '' }}>{{ item.title }}</option>{% endfor %}</select><small class="muted">Bei Objektübernahme werden die gespeicherten Objektdaten verwendet. Die manuelle Eingabe wird dann ignoriert.</small></div>
{% if property %}<div class="alert"><strong>Objekt verknüpft:</strong> {{ property.title }}<br>{{ property.data.city|default('Ort: Angabe fehlt') }} · {{ property.data.areaSqm|default('–') }} m² · {{ property.data.rooms|default('–') }} Zimmer</div>{% endif %}
<details {{ not property ? 'open' : '' }}><summary>Manuelle Objektdaten</summary><div class="form-grid" style="margin-top:16px">
<div class="field"><label for="manual-title">Bezeichnung</label><input id="manual-title" name="title" maxlength="200" placeholder="Zum Beispiel: Wohnung mit Balkon (Demo)"></div>
<div class="field"><label for="propertyType">Objektart</label><input id="propertyType" name="propertyType" maxlength="200" placeholder="Zum Beispiel: Eigentumswohnung"></div>
<div class="field"><label for="city">Ort</label><input id="city" name="city" maxlength="200"></div><div class="field"><label for="district">Ortsteil</label><input id="district" name="district" maxlength="200"></div>
<div class="field"><label for="areaSqm">Wohnfläche in m²</label><input id="areaSqm" name="areaSqm" type="number" min="0.01" max="1000000000" step="0.01"></div><div class="field"><label for="rooms">Zimmer</label><input id="rooms" name="rooms" type="number" min="0.5" max="100000" step="0.5"></div>
<div class="field"><label for="yearBuilt">Baujahr</label><input id="yearBuilt" name="yearBuilt" type="number" min="1000" max="2200"></div><div class="field"><label for="priceEur">Preis in €</label><input id="priceEur" name="priceEur" type="number" min="0.01" max="1000000000" step="0.01"></div>
<div class="field" style="grid-column:1/-1"><label for="features">Bestätigte Ausstattung</label><textarea id="features" name="features" rows="3" maxlength="2000" placeholder="Balkon, Tageslichtbad – nur tatsächlich belegte Merkmale"></textarea></div>
</div></details>
{% if tool == 'lage' %}<div class="field"><label for="verifiedLocation">Von Ihnen überprüfte Lagefakten</label><textarea name="verifiedLocation" id="verifiedLocation" rows="4" maxlength="4000" placeholder="Nur Angaben eintragen, die Sie mit einer Quelle geprüft haben."></textarea><small class="muted">Unbestätigte Entfernungen, Infrastruktur und Verkehrsverbindungen werden nicht ergänzt.</small></div>{% endif %}
{% if tool == 'blog' %}<div class="field"><label for="topic">Ratgeberthema</label><input name="topic" id="topic" maxlength="200" value="{{ app.request.query.get('topic', 'Immobilienverkauf vorbereiten') }}"><small class="muted">Die Demo verwendet eine feste redaktionelle Gliederung. Fachinformationen und Quellen ergänzen Sie selbst.</small></div>{% endif %}
<div class="form-grid"><div class="field"><label for="tone">Ton & Länge</label><select id="tone" name="tone">{% for key,label in tones %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></div>
{% if tool == 'social' %}<div class="field"><label for="channel">Kanal</label><select id="channel" name="channel"><option>Instagram</option><option>Facebook</option><option>LinkedIn</option></select></div><div class="field"><label for="format">Format</label><select id="format" name="format"><option>Feed</option><option>Story</option><option>Reel</option><option>Textpost</option></select></div>{% else %}<input type="hidden" name="channel" value="Instagram"><input type="hidden" name="format" value="Feed">{% endif %}</div>
<div class="field"><label for="cta">Handlungsaufforderung (optional)</label><input name="cta" id="cta" maxlength="300" value="{{ app.request.query.get('cta', '') }}" placeholder="Zum Beispiel: Exposé anfordern"></div>
<button class="btn btn-primary" type="submit" {{ balance < 1 ? 'disabled' : '' }}>{{ marketingMode ? 'Beitrag erstellen & Entwurf speichern' : 'Demo-Text erstellen & speichern' }} <span aria-hidden="true">↗</span></button>
</form></section>
<div class="stack"><section class="card"><span class="badge">Fakten statt Vermutungen</span><h2>Sie geben die Richtung vor.</h2><p>Der Textgenerator übernimmt ausschließlich Ihre Eingaben oder Daten aus einem freigegebenen Objekt. Fehlende Informationen bleiben als <strong>„Angabe fehlt“</strong> sichtbar.</p><ol><li>Objekt auswählen oder Fakten eingeben.</li><li>Stil und optional einen Kanal wählen.</li><li>Entwurf bearbeiten, prüfen und freigeben.</li></ol><p class="muted">Ihre Inhalte bleiben in dieser lokalen Anwendung. Es wird nichts veröffentlicht oder verschickt.</p></section>
<section class="card"><div class="toolbar"><h2>Ihre letzten Entwürfe</h2><a href="{{ path('marketing') }}">Zum Kalender →</a></div>{% set count = 0 %}{% for post in posts|slice(0,8) %}{% set count = count + 1 %}<a class="list-row" style="display:block;padding:14px 0;border-bottom:1px solid var(--border,#e8e8e8)" href="{{ path('studio_edit', {id:post.id}) }}"><strong>{{ post.title }}</strong><br><span class="muted">{{ post.data.status|default('Entwurf') }} · {{ post.data.tool|default('Social') }} · Version {{ post.data.version|default(1) }}</span></a>{% endfor %}{% if not count %}<p class="empty-state">Ihr erster Entwurf wartet auf Sie. Starten Sie mit einem Objekt oder Ihren eigenen Fakten.</p>{% endif %}</section></div>
</div>
{% endblock %}
