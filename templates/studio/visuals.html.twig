{% extends 'base.html.twig' %}
{% block title %}Bild- & Dokumentenstudio · CHASE{% endblock %}
{% block body %}
{% set labels = {image:'Bildoptimierung',staging:'Virtuelles Home Staging',video:'Bild-zu-Video',floorplan:'Grundriss',doccheck:'Dokumentenprüfung',redaction:'Dokumentenschwärzung'} %}
<div class="page-heading"><div><span class="eyebrow">Visualisierung & Dokumente</span><h1>Das Potenzial sichtbar machen.</h1><p class="muted">Originale ansehen, Workflows vorbereiten und Grenzen transparent erkennen.</p></div><a class="btn btn-secondary" href="{{ path('studio') }}">Zum Textstudio</a></div>
<nav class="tabs" aria-label="Bild- und Dokumentenwerkzeuge">{% for key,label in labels %}<a href="{{ path('studio_visuals',{tool:key,property:property ? property.id : ''}) }}" class="{{ tool == key ? 'active' : '' }}">{{ label }}</a>{% endfor %}</nav>
<div class="alert"><strong>Externe API nicht verbunden.</strong> Diese Seite bietet eine echte lokale Dateivorschau{% if tool == 'video' %} und eine Bildersequenz{% endif %}. Keine KI-Verarbeitung, kein externer Upload und keine kostenpflichtige Aktion. Ihre Auswahl bleibt nur im aktuellen Browserfenster.</div>
{% if property %}<p>Vorbereitung für <strong>{{ property.title }}</strong>. Die Vorschau wird nicht automatisch in der Objektakte gespeichert.</p>{% endif %}
<div class="grid grid-2" style="align-items:start"><section class="card"><span class="badge">{{ tool == 'doccheck' or tool == 'redaction' ? 'Lokale Vorschau & manuelle Prüfung' : 'Lokale Vorschau' }}</span><h2>{{ labels[tool] }}</h2>
<div class="field"><label for="local-files">{{ tool == 'video' ? 'Bis zu 10 eigene Objektfotos auswählen' : 'Datei für die lokale Vorschau auswählen' }}</label><input id="local-files" type="file" {{ tool == 'video' ? 'multiple' : '' }} accept="{{ tool in ['doccheck','redaction','floorplan'] ? '.pdf,.jpg,.jpeg,.png,.webp' : '.jpg,.jpeg,.png,.webp' }}"><small class="muted">JPEG, PNG, WebP{{ tool in ['doccheck','redaction','floorplan'] ? ' oder PDF' : '' }} · maximal 10 MB je Datei. Keine SVG- oder Office-Dateien.</small></div>
<p id="file-status" class="muted" aria-live="polite">Noch keine Datei ausgewählt.</p>
{% if tool == 'image' %}<div class="form-grid"><div class="field"><label for="brightness">Helligkeit der Bildschirmvorschau</label><input id="brightness" type="range" min="60" max="140" value="100"><output for="brightness" id="brightness-output">100 %</output></div><div class="field"><label for="contrast">Kontrast der Bildschirmvorschau</label><input id="contrast" type="range" min="60" max="140" value="100"><output for="contrast" id="contrast-output">100 %</output></div></div><p class="muted">Reine CSS-Anzeige im Browser. Das Original bleibt unverändert; dies ist keine KI-Optimierung und kein bearbeiteter Bildexport.</p>{% endif %}
{% if tool == 'video' %}<div class="form-grid"><div class="field"><label for="duration">Vorschau je Bild</label><select id="duration"><option value="2000">2 Sekunden</option><option value="3000" selected>3 Sekunden</option><option value="5000">5 Sekunden</option></select></div><div class="field"><label for="orientation">Sequenzformat</label><select id="orientation"><option value="16/9">Querformat 16:9</option><option value="9/16">Hochformat 9:16</option><option value="1/1">Quadrat 1:1</option></select></div></div><button id="play-sequence" class="btn btn-primary" type="button" disabled>Bildersequenz abspielen</button><p class="muted">Lokales Storyboard aus Ihren Fotos. Kein Video wird erzeugt oder exportiert.</p>{% endif %}
{% if tool == 'doccheck' %}<div class="field"><label for="document-type">Manuelle Prüfhilfe auswählen</label><select id="document-type">{% for type in checks.types|default([]) %}<option value="{{ loop.index0 }}">{{ type.type }}</option>{% endfor %}</select></div><div id="document-questions" class="stack">{% for type in checks.types|default([]) %}<div data-checklist="{{ loop.index0 }}" {{ not loop.first ? 'hidden' : '' }}><h3>{{ type.type }} – Prüffragen</h3>{% for question in type.items %}<label style="display:flex;gap:10px;align-items:flex-start;margin:14px 0"><input type="checkbox" style="width:auto;margin-top:5px"><span>{{ question }}</span></label>{% endfor %}<div class="field"><label for="notes-{{ loop.index0 }}">Eigene Notizen / Quelle / Seitenzahl</label><textarea id="notes-{{ loop.index0 }}" rows="3" placeholder="Nur lokale Notizen für diese Sitzung, nicht gespeichert."></textarea></div></div>{% endfor %}</div><p class="muted">{{ checks.disclaimer|default('Manuelle Beispielcheckliste. Keine automatische Analyse und keine Rechtsberatung.') }} Der Inhalt Ihrer Datei wird nicht ausgelesen oder geprüft.</p>{% endif %}
<div class="toolbar" style="margin-top:20px"><button id="reset-preview" type="button" class="btn btn-secondary">Auswahl & Vorschau zurücksetzen</button></div>
</section><section class="card"><div class="toolbar"><h2>{{ tool == 'video' ? 'Storyboard / Sequenz' : 'Originalvorschau' }}</h2><span class="badge">Nur im Browser</span></div><div id="preview-area" class="empty-state" style="min-height:300px">Wählen Sie eine Datei aus. Die Vorschau erscheint hier.</div><div id="storyboard" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px"></div></section></div>
<section class="card" style="margin-top:24px"><h2>So geht es später weiter</h2>
{% if tool == 'image' %}<ol><li>Original sicher in der Objektakte speichern.</li><li>Bearbeitungsziel und Datenschutzfreigabe festlegen.</li><li>Erst nach eingerichteter Backend-API eine Verarbeitung beauftragen.</li><li>Ergebnis mit dem Original vergleichen und als Bearbeitung kennzeichnen.</li></ol>{% elseif tool == 'staging' %}<ol><li>Originalraum und gewünschte Einrichtung festlegen.</li><li>Keine baulichen Eigenschaften oder Größen stillschweigend verändern.</li><li>Provider einrichten und Nutzungsrechte prüfen.</li><li>Generiertes Ergebnis nach Prüfung als Visualisierung kennzeichnen.</li></ol>{% elseif tool == 'video' %}<ol><li>Eigene Fotos in gewünschter Reihenfolge auswählen.</li><li>Bildersequenz lokal ansehen und Format abstimmen.</li><li>Für echten Export später ein lokales Video-Backend oder einen freigegebenen Provider anbinden.</li><li>Musik-, Bild- und Veröffentlichungsrechte prüfen.</li></ol>{% elseif tool == 'floorplan' %}<ol><li>Vorhandenen Grundriss als Bild oder PDF ansehen.</li><li>Maße und Quelle manuell prüfen; fehlende Maße nicht ergänzen.</li><li>Neuzeichnung erst nach fachlich geprüfter Backend-Anbindung.</li></ol><div class="alert">Keine Flächenberechnung, keine neue Bemaßung und keine Aussage zur WoFlV-Konformität.</div>{% elseif tool == 'doccheck' %}<ol><li>Original lokal ansehen.</li><li>Fragen anhand der Quelle mit Seitenangaben manuell prüfen.</li><li>Offene oder unsichere Punkte an eine fachlich zuständige Person weitergeben.</li></ol>{% else %}<div class="alert"><strong>Eine schwarze Box auf einem PDF ist keine sichere Schwärzung.</strong> Diese Demo entfernt keine Inhalte und bietet keinen geschwärzten Export an.</div><ol><li>Schutzbedürftige Inhalte im Original identifizieren.</li><li>Später Inhalte mit einem geeigneten Backend unwiderruflich entfernen.</li><li>Metadaten, Textschicht und endgültigen Export gesondert prüfen.</li></ol>{% endif %}
<span class="badge">API-Anbindung folgt</span>
</section>
<script>
(() => {
const picker = document.getElementById('local-files');
const preview = document.getElementById('preview-area');
const status = document.getElementById('file-status');
const storyboard = document.getElementById('storyboard');
const playButton = document.getElementById('play-sequence');
const allowPdf = {{ tool in ['doccheck','redaction','floorplan'] ? 'true' : 'false' }};
const isVideo = {{ tool == 'video' ? 'true' : 'false' }};
let urls = [], sequence = [], timer = null, frame = 0;
const stop = () => { if (timer) clearInterval(timer); timer = null; if (playButton) playButton.textContent = 'Bildersequenz abspielen'; };
const release = () => { stop(); urls.forEach(url => URL.revokeObjectURL(url)); urls = []; sequence = []; frame = 0; storyboard.replaceChildren(); preview.replaceChildren(); if (playButton) playButton.disabled = true; };
const show = index => { const image = preview.querySelector('img'); if (image && sequence[index]) { image.src = sequence[index].url; image.alt = sequence[index].name; status.textContent = 'Bild ' + (index + 1) + ' von ' + sequence.length + ' · ' + sequence[index].name; } };
const filters = () => { const image = preview.querySelector('img'); const b = document.getElementById('brightness'); const c = document.getElementById('contrast'); if (image && b && c) image.style.filter = 'brightness(' + b.value + '%) contrast(' + c.value + '%)'; };
picker.addEventListener('change', () => {
release();
const files = Array.from(picker.files || []);
if (!files.length) { status.textContent = 'Keine Datei ausgewählt.'; return; }
if (files.length > 10) { status.textContent = 'Bitte höchstens 10 Dateien auswählen.'; picker.value = ''; return; }
const supportedImages = ['image/jpeg','image/png','image/webp'];
const valid = files.every(file => file.size <= 10 * 1024 * 1024 && ((supportedImages.includes(file.type) && /\.(jpe?g|png|webp)$/i.test(file.name)) || (allowPdf && file.type === 'application/pdf' && /\.pdf$/i.test(file.name))));
if (!valid) { status.textContent = 'Dateityp nicht unterstützt oder Datei größer als 10 MB. Bitte JPEG, PNG, WebP' + (allowPdf ? ' oder PDF' : '') + ' wählen.'; picker.value = ''; return; }
const first = files[0];
if (first.type === 'application/pdf') { const url = URL.createObjectURL(first); urls.push(url); const pdf = document.createElement('iframe'); pdf.src = url; pdf.title = 'Lokale PDF-Originalvorschau'; pdf.setAttribute('sandbox',''); pdf.style.cssText = 'width:100%;height:520px;border:0'; preview.append(pdf); status.textContent = first.name + ' · PDF wird nur lokal angezeigt. Kein Scan oder Textauslesen.'; }
else {
sequence = files.map(file => { const url = URL.createObjectURL(file); urls.push(url); return {url, name:file.name}; });
const image = document.createElement('img'); image.style.cssText = 'display:block;width:100%;max-height:520px;object-fit:contain;border-radius:10px'; preview.append(image); show(0); filters();
if (isVideo) { sequence.forEach((item,index) => { const button = document.createElement('button'); button.type = 'button'; button.className = 'btn btn-secondary'; const thumb = document.createElement('img'); thumb.src = item.url; thumb.alt = 'Bild ' + (index + 1) + ': ' + item.name; thumb.style.cssText = 'width:72px;height:55px;object-fit:cover'; button.append(thumb); button.addEventListener('click',() => { stop(); frame = index; show(frame); }); storyboard.append(button); }); playButton.disabled = false; }
}
preview.classList.remove('empty-state');
});
if (playButton) playButton.addEventListener('click', () => { if (timer) { stop(); return; } if (!sequence.length) return; playButton.textContent = 'Sequenz anhalten'; timer = setInterval(() => { frame = (frame + 1) % sequence.length; show(frame); }, Number(document.getElementById('duration').value)); });
document.getElementById('orientation')?.addEventListener('change', event => { const image = preview.querySelector('img'); if (image) { image.style.aspectRatio = event.target.value; image.style.objectFit = 'contain'; } });
['brightness','contrast'].forEach(id => { const input = document.getElementById(id); input?.addEventListener('input', () => { document.getElementById(id + '-output').textContent = input.value + ' %'; filters(); }); });
document.getElementById('document-type')?.addEventListener('change',event => document.querySelectorAll('[data-checklist]').forEach(item => { item.hidden = item.dataset.checklist !== event.target.value; }));
document.getElementById('reset-preview').addEventListener('click', () => { release(); picker.value = ''; preview.classList.add('empty-state'); preview.textContent = 'Wählen Sie eine Datei aus. Die Vorschau erscheint hier.'; status.textContent = 'Auswahl zurückgesetzt.'; ['brightness','contrast'].forEach(id => { const input = document.getElementById(id); if (input) { input.value = 100; document.getElementById(id + '-output').textContent = '100 %'; } }); });
window.addEventListener('pagehide',release);
})();
</script>
{% endblock %}
