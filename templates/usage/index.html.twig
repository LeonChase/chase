{% extends 'base.html.twig' %}
{% block title %}Mein KI-Guthaben & Verbrauch · CHASE{% endblock %}
{% block body %}
<div class="page-heading"><div><span class="eyebrow">Transparent & unter Ihrer Kontrolle</span><h1>Ihr KI-Guthaben.</h1><p class="muted">Ausschließlich Ihre persönliche Nutzung. Keine realen Abrechnungen.</p></div><a class="btn btn-primary" href="{{ path('studio') }}">Zum KI-Studio →</a></div>
<div class="grid grid-3"><section class="card"><span class="muted">Verfügbare Demo-Credits</span><h2 style="font-size:42px;margin:12px 0">{{ balance }}</h2><span class="badge">1 Credit pro Demo-Text</span></section><section class="card"><span class="muted">Demo-Basisbudget</span><h2 style="font-size:42px;margin:12px 0">{{ budget }}</h2><span class="muted">Vom Administrator festgelegt</span></section><section class="card"><span class="muted">Tatsächliche API-Kosten</span><h2 style="font-size:42px;margin:12px 0">0,00 €</h2><span class="muted">Keine externe API verbunden</span></section></div>
<div class="alert" style="margin-top:24px"><strong>Demo-Credits sind keine Währung.</strong> Es gibt keine Zahlungsfunktion oder kostenpflichtige Nutzung. Jede Texterstellung wird serverseitig geprüft und gemeinsam mit dem Entwurf protokolliert. Bei leerem Guthaben wird die Erstellung gesperrt.</div>
<section class="card"><h2>Ihre Nutzung</h2><div class="table-wrap"><table><thead><tr><th>Zeitpunkt</th><th>Werkzeug</th><th>Modus</th><th>Demo-Credits</th><th>Tatsächliche Kosten</th></tr></thead><tbody>{% for event in events %}<tr><td>{{ event.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</td><td>{{ event.data.tool|default(event.title) }}</td><td><span class="badge">{{ event.data.mode|default('Demo') }}</span></td><td>{{ event.data.creditUnits|default(0) }}</td><td>0,00 €</td></tr>{% else %}<tr><td colspan="5" class="empty-state">Noch keine Nutzung. Ihr erster Text wartet im KI-Studio.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card" style="margin-top:24px"><h2>Credit-Verlauf</h2>{% for entry in ledger %}<div class="toolbar" style="padding:12px 0;border-bottom:1px solid var(--border,#e6e7ea)"><span>{{ entry.data.reason|default(entry.title) }}<br><small class="muted">{{ entry.createdAt|date('d.m.Y H:i','Europe/Berlin') }}</small></span><strong>{{ entry.data.delta|default(0) > 0 ? '+' : '' }}{{ entry.data.delta|default(0) }} Credits</strong></div>{% else %}<p class="empty-state">Noch keine Bewegungen im Demo-Guthaben.</p>{% endfor %}</section>
{% endblock %}
